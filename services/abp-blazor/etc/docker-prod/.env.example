# Copy to .env and fill real values. Never commit .env.
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------
IMAGE_REGISTRY=registry.example/hcs
IMAGE_TAG=1.0.0

# ---------------------------------------------------------------------------
# Public URLs (must match DNS + TLS + OpenIddict seed)
# ---------------------------------------------------------------------------
PUBLIC_APP_URL=https://app.hcs.benhvien.vn
PUBLIC_AUTH_URL=https://auth.hcs.benhvien.vn
PUBLIC_GATEWAY_URL=https://gateway.hcs.benhvien.vn
# Optional Elsa Studio (profile full + studio host)
PUBLIC_STUDIO_URL=https://studio.hcs.benhvien.vn

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=hcs
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection strings (Host=postgres inside compose network)
CS_IDENTITY=Host=postgres;Port=5432;Database=hanhchinhso_Identity;User ID=hcs;Password=CHANGE_ME_STRONG_POSTGRES;Timeout=240;
CS_ADMINISTRATION=Host=postgres;Port=5432;Database=hanhchinhso_Administration;User ID=hcs;Password=CHANGE_ME_STRONG_POSTGRES;Timeout=240;
CS_BLOB=Host=postgres;Port=5432;Database=hanhchinhso_BlobStoring;User ID=hcs;Password=CHANGE_ME_STRONG_POSTGRES;Timeout=240;
CS_AUDIT=Host=postgres;Port=5432;Database=hanhchinhso_AuditLogging;User ID=hcs;Password=CHANGE_ME_STRONG_POSTGRES;Timeout=240;
CS_GDPR=Host=postgres;Port=5432;Database=hanhchinhso_Gdpr;User ID=hcs;Password=CHANGE_ME_STRONG_POSTGRES;Timeout=240;
CS_LANGUAGE=Host=postgres;Port=5432;Database=hanhchinhso_Language;User ID=hcs;Password=CHANGE_ME_STRONG_POSTGRES;Timeout=240;
CS_AIMANAGEMENT=Host=postgres;Port=5432;Database=hanhchinhso_AIManagement;User ID=hcs;Password=CHANGE_ME_STRONG_POSTGRES;Timeout=240;
CS_ORGANIZATION=Host=postgres;Port=5432;Database=hanhchinhso_Organization;User ID=hcs;Password=CHANGE_ME_STRONG_POSTGRES;Timeout=240;
CS_WORKFLOW=Host=postgres;Port=5432;Database=hanhchinhso_Workflow;User ID=hcs;Password=CHANGE_ME_STRONG_POSTGRES;Timeout=240;

# ---------------------------------------------------------------------------
# Redis / RabbitMQ
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS
# ABP format: host:port,password=...
REDIS_CONFIGURATION=redis:6379,password=CHANGE_ME_STRONG_REDIS

RABBITMQ_USER=hcs
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBIT

# ---------------------------------------------------------------------------
# AuthServer / encryption
# ---------------------------------------------------------------------------
# Must match passphrase used when creating certs/openiddict.pfx
AUTHSERVER_CERTIFICATE_PASSPHRASE=CHANGE_ME_PFX_PASSPHRASE
STRING_ENCRYPTION_PASSPHRASE=CHANGE_ME_STRING_ENCRYPTION

# Require HTTPS metadata on public AuthServer
AUTHSERVER_REQUIRE_HTTPS_METADATA=true

# ---------------------------------------------------------------------------
# Keycloak external IdP (optional — leave empty to disable)
# ---------------------------------------------------------------------------
KEYCLOAK_AUTHORITY=https://sso.hcs.benhvien.vn/realms/bd
KEYCLOAK_CLIENT_ID=abp-auth
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_CALLBACK_PATH=/signin-oidc

# ---------------------------------------------------------------------------
# MinIO (profile: full)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=hcsminio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO

# ---------------------------------------------------------------------------
# Observability toggles
# ---------------------------------------------------------------------------
ELASTICSEARCH_LOGGING_ENABLED=false
ENABLE_PII=false
SWAGGER_ENABLED=false
