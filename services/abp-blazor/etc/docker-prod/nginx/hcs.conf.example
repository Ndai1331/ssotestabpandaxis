# Host Nginx — TLS terminate → loopback Compose ports
# Install: copy to /etc/nginx/sites-available/hcs.conf
#   sudo ln -s /etc/nginx/sites-available/hcs.conf /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d app.hcs.benhvien.vn -d auth.hcs.benhvien.vn -d gateway.hcs.benhvien.vn
#
# Replace server_name with your real DNS names.

upstream hcs_blazor  { server 127.0.0.1:8080; keepalive 16; }
upstream hcs_auth    { server 127.0.0.1:8081; keepalive 16; }
upstream hcs_gateway { server 127.0.0.1:8082; keepalive 16; }
# Optional (profile full): Elsa Workflow API for Studio
# upstream hcs_workflow { server 127.0.0.1:8085; keepalive 8; }

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name app.hcs.benhvien.vn auth.hcs.benhvien.vn gateway.hcs.benhvien.vn;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name app.hcs.benhvien.vn;

    # ssl_certificate /etc/letsencrypt/live/app.hcs.benhvien.vn/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/app.hcs.benhvien.vn/privkey.pem;

    location / {
        proxy_pass http://hcs_blazor;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl http2;
    server_name auth.hcs.benhvien.vn;

    # ssl_certificate /etc/letsencrypt/live/auth.hcs.benhvien.vn/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/auth.hcs.benhvien.vn/privkey.pem;

    location / {
        proxy_pass http://hcs_auth;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name gateway.hcs.benhvien.vn;

    client_max_body_size 50m;

    # ssl_certificate /etc/letsencrypt/live/gateway.hcs.benhvien.vn/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/gateway.hcs.benhvien.vn/privkey.pem;

    location / {
        proxy_pass http://hcs_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
