{
  "id": "d5aff72d-6c6e-4e6d-9d0c-6d0ac313f5c5",
  "template": "microservice",
  "versions": {
    "LeptonX": "5.5.0",
    "AbpFramework": "10.5.0",
    "AbpCommercial": "10.5.0",
    "AbpStudio": "3.0.7",
    "TargetDotnetFramework": "net10.0"
  },
  "folders": {
    "items": {
      "services": {},
      "apps": {},
      "gateways": {},

    }
  },
  "defaultRunProfile": "Default",
  "runProfiles": {
    "Default": {
      "path": "etc/abp-studio/run-profiles/Default.abprun.json"
    },
  },
  "modules": {
    "abptestwithsso.AdministrationService": {
      "path": "services/administration/abptestwithsso.AdministrationService.abpmdl",
      "folder": "services"
    },
    "abptestwithsso.IdentityService": {
      "path": "services/identity/abptestwithsso.IdentityService.abpmdl",
      "folder": "services"
    },
    "abptestwithsso.AuditLoggingService": {
      "path": "services/audit-logging/abptestwithsso.AuditLoggingService.abpmdl",
      "folder": "services"
    },
    "abptestwithsso.GdprService": {
      "path": "services/gdpr/abptestwithsso.GdprService.abpmdl",
      "folder": "services"
    },
    "abptestwithsso.AIManagementService": {
      "path": "services/ai-management/abptestwithsso.AIManagementService.abpmdl",
      "folder": "services"
    },
    "abptestwithsso.LanguageService": {
      "path": "services/language/abptestwithsso.LanguageService.abpmdl",
      "folder": "services"
    },
    "abptestwithsso.Blazor": {
      "path": "apps/blazor/abptestwithsso.Blazor.abpmdl",
      "folder": "apps"
    },
    "abptestwithsso.AuthServer": {
      "path": "apps/auth-server/abptestwithsso.AuthServer.abpmdl",
      "folder": "apps"
    },
    "abptestwithsso.WebGateway": {
      "path": "gateways/web/abptestwithsso.WebGateway.abpmdl",
      "folder": "gateways"
    },
  },
  "k8sProfiles": {
    "local": {
      "path": "etc/abp-studio/k8s-profiles/local.abpk8s.json"
    }
  },
  "commands": {
    "helmBuildDotnetImage": {
      "triggerTargets": [
        "HELM_CHARTS_ROOT",
        "HELM_MAIN_CHART",
        "HELM_SUB_CHART"
      ],
      "executionTargets": [
        "HELM_MAIN_CHART",
        "HELM_SUB_CHART"
      ],
      "displayName": "Build Docker Image(s)",
      "description": "Builds Docker image(s) for the selected Helm chart(s) using the build-image.ps1 script. This prepares the microservice for Kubernetes deployment by containerizing the .NET or Angular projects.",
      "workingDirectory": "etc/helm",
      "terminalCommand": "./build-image.ps1 -ProjectPath {{metadata.projectPath}} -ImageName {{metadata.imageName}} -ProjectType {{metadata.projectType}}",
      "condition": "{{metadata.projectPath != null && metadata.imageName != null && metadata.projectType != null}}"
    },
    "helmInstallChart": {
      "triggerTargets": [
        "HELM_CHARTS_ROOT",
        "HELM_MAIN_CHART"
      ],
      "executionTargets": [
        "HELM_MAIN_CHART"
      ],
      "displayName": "Install Chart(s)",
      "description": "Deploys the selected Helm chart(s) to the Kubernetes cluster using helm install. This creates or updates the Kubernetes resources (pods, services, configmaps, etc.) defined in the chart.",
      "workingDirectory": "etc/helm",
      "terminalCommand": "./install.ps1 -ChartName {{chart.name}} -Namespace {{profile.namespace}} -ReleaseName {{chart.name}}-{{profile.name}} -DotnetEnvironment {{metadata.dotnetEnvironment}} {{~if metadata.k8ssuffix}} -User {{metadata.k8ssuffix}}{{end}}",
      "requireConfirmation": "true",
      "confirmationText": "Are you sure to install the chart(s) for the profile {{ profile.name }}?"
    },
    "helmUninstallChart": {
      "triggerTargets": [
        "HELM_CHARTS_ROOT",
        "HELM_MAIN_CHART"
      ],
      "executionTargets": [
        "HELM_MAIN_CHART"
      ],
      "displayName": "Uninstall Chart(s)",
      "description": "Removes the selected Helm chart(s) from the Kubernetes cluster using helm uninstall. This deletes all Kubernetes resources (pods, services, configmaps, etc.) associated with the release.",
      "workingDirectory": "etc/helm",
      "terminalCommand": "./uninstall.ps1 -Namespace {{profile.namespace}} -ReleaseName {{chart.name}}-{{profile.name}} {{~if metadata.k8ssuffix}} -User {{metadata.k8ssuffix}}{{end}}",
      "requireConfirmation": "true",
      "confirmationText": "Are you sure to uninstall the chart(s) for the profile {{profile.name}}?"
    },
    "kubernetesRedeploy": {
      "triggerTargets": [
        "KUBERNETES_SERVICE"
      ],
      "executionTargets": [
        "KUBERNETES_SERVICE"
      ],
      "displayName": "Redeploy",
      "description": "Rebuilds the Docker image for the microservice and redeploys it to Kubernetes in one step. This is a convenient shortcut that combines 'Build Docker Image' and 'Install Chart' operations for quick iterative development.",
      "workingDirectory": "etc/helm",
      "terminalCommand": "./build-image.ps1 -ProjectPath {{chart.metadata.projectPath}} -ImageName {{chart.metadata.imageName}} -ProjectType {{chart.metadata.projectType}} &&& ./install.ps1 -ChartName {{mainChart.name}} -Namespace {{profile.namespace}} -ReleaseName {{mainChart.name}}-{{profile.name}} -DotnetEnvironment {{mainChart.metadata.dotnetEnvironment}} {{~if metadata.k8ssuffix}} -User {{metadata.k8ssuffix}}{{end}}",
      "requireConfirmation": "true",
      "confirmationText": "Are you sure to redeploy the related chart '{{chart.name}}' for the service '{{name}}'?",
      "condition": "{{chart != null && chart.metadata.projectPath != null && chart.metadata.imageName != null && chart.metadata.projectType != null}}"
    },
    "createTlsSecret": {
      "triggerTargets": [
        "HELM_CHARTS_ROOT"
      ],
      "executionTargets": [
        "HELM_CHARTS_ROOT"
      ],
      "displayName": "Create Self-Signed TLS secret",
      "description": "Creates a self-signed TLS certificate and stores it as a Kubernetes secret. This is required for HTTPS endpoints in the local development Kubernetes environment.",
      "workingDirectory": "etc/helm",
      "terminalCommand": "./create-tls-secrets.ps1 -Namespace {{profile.namespace}} {{~if metadata.k8ssuffix}} -User {{metadata.k8ssuffix}}{{end}}"
    }
  },
  "helm": {
    "charts": {
      "abptestwithsso": {
        "name": "abptestwithsso",
        "path": "etc/helm/abptestwithsso",
        "charts": {
          "administration": {
            "name": "administration",
            "path": "etc/helm/abptestwithsso/charts/administration",
            "metadata": {
              "projectPath": "../../services/administration/abptestwithsso.AdministrationService/abptestwithsso.AdministrationService.csproj",
              "imageName": "abptestwithsso/administration",
              "projectType": "dotnet"
