{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "HCS Hành chính số",
  "primitive": {
    "color": {
      "teal": {
        "50": { "$value": "#EAF5F4", "$type": "color" },
        "100": { "$value": "#C5E6E5", "$type": "color" },
        "200": { "$value": "#8DCECC", "$type": "color" },
        "300": { "$value": "#4AADAA", "$type": "color" },
        "400": { "$value": "#1A938F", "$type": "color" },
        "500": { "$value": "#007f7c", "$type": "color" },
        "600": { "$value": "#006866", "$type": "color" },
        "700": { "$value": "#004F4D", "$type": "color" },
        "800": { "$value": "#003B3A", "$type": "color" },
        "900": { "$value": "#002827", "$type": "color" }
      },
      "gray": {
        "50": { "$value": "#F8FAFC", "$type": "color" },
        "100": { "$value": "#F1F5F9", "$type": "color" },
        "200": { "$value": "#E2E8F0", "$type": "color" },
        "300": { "$value": "#CBD5E1", "$type": "color" },
        "400": { "$value": "#94A3B8", "$type": "color" },
        "500": { "$value": "#64748B", "$type": "color" },
        "600": { "$value": "#475569", "$type": "color" },
        "700": { "$value": "#334155", "$type": "color" },
        "800": { "$value": "#1E293B", "$type": "color" },
        "900": { "$value": "#0F172A", "$type": "color" }
      },
      "blue": {
        "400": { "$value": "#60A5FA", "$type": "color" },
        "500": { "$value": "#3B6FF5", "$type": "color" },
        "600": { "$value": "#2563EB", "$type": "color" }
      },
      "green": {
        "500": { "$value": "#22C55E", "$type": "color" },
        "600": { "$value": "#16A34A", "$type": "color" }
      },
      "red": {
        "500": { "$value": "#EF4444", "$type": "color" },
        "600": { "$value": "#DC2626", "$type": "color" }
      },
      "amber": { "500": { "$value": "#F59E0B", "$type": "color" } },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "black": { "$value": "#000000", "$type": "color" },
      "htl": { "$value": "#4E9BC7", "$type": "color" }
    },
    "fontFamily": {
      "sans": { "$value": "Inter, Segoe UI, system-ui, sans-serif", "$type": "fontFamily" }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.8125rem", "$type": "dimension" },
      "md": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "$type": "dimension" }
    },
    "spacing": {
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "6px", "$type": "dimension" },
      "md": { "$value": "8px", "$type": "dimension" },
      "lg": { "$value": "12px", "$type": "dimension" },
      "xl": { "$value": "16px", "$type": "dimension" },
      "2xl": { "$value": "20px", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "xs": { "$value": "0 1px 2px rgba(15, 23, 42, 0.05)", "$type": "shadow" },
      "sm": { "$value": "0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04)", "$type": "shadow" },
      "md": { "$value": "0 8px 24px rgba(15, 23, 42, 0.08)", "$type": "shadow" },
      "lg": { "$value": "0 20px 50px rgba(15, 23, 42, 0.16)", "$type": "shadow" },
      "focus": { "$value": "0 0 0 3px rgba(0, 127, 124, 0.28)", "$type": "shadow" }
    }
  },
  "semantic": {
    "color": {
      "primary": { "$value": "{primitive.color.teal.500}" },
      "primaryHover": { "$value": "{primitive.color.teal.600}" },
      "primaryActive": { "$value": "{primitive.color.teal.700}" },
      "primaryForeground": { "$value": "{primitive.color.white}" },
      "primarySoft": { "$value": "#E6F3F2" },
      "background": { "$value": "#F3F7F8" },
      "foreground": { "$value": "{primitive.color.gray.800}" },
      "muted": { "$value": "{primitive.color.gray.500}" },
      "surface": { "$value": "{primitive.color.white}" },
      "border": { "$value": "#E6EEF0" },
      "input": { "$value": "#D7E2E6" },
      "success": { "$value": "{primitive.color.green.600}" },
      "danger": { "$value": "{primitive.color.red.600}" },
      "warning": { "$value": "{primitive.color.amber.500}" },
      "info": { "$value": "{primitive.color.blue.500}" },
      "nav": { "$value": "{primitive.color.teal.500}" }
    }
  },
  "component": {
    "button": {
      "bg": { "$value": "{semantic.color.primary}" },
      "fg": { "$value": "{semantic.color.primaryForeground}" },
      "hoverBg": { "$value": "{semantic.color.primaryHover}" },
      "height": { "$value": "44px", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.md}" }
    },
    "input": {
      "bg": { "$value": "{primitive.color.white}" },
      "border": { "$value": "{semantic.color.input}" },
      "height": { "$value": "44px", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.md}" }
    },
    "card": {
      "bg": { "$value": "{semantic.color.surface}" },
      "radius": { "$value": "{primitive.radius.xl}" },
      "padding": { "$value": "{primitive.spacing.5}" },
      "border": { "$value": "{semantic.color.border}" }
    }
  }
}
