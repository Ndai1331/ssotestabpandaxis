{
  "info": {
    "title": "HCS Mobile API",
    "version": "2026-09-23",
    "source": "Blazor Client + Gateway /api/* (không gọi port 44411–44415)",
    "note": "Web dùng cookie BFF. Mobile dùng PKCE client hcs-mobile + Authorization: Bearer. Không password grant, không nhúng secret HCS_App."
  },
  "servers": {
    "local": {
      "auth": "https://localhost:44401",
      "gateway": "https://localhost:44402"
    },
    "production": {
      "auth": "https://auth-hcs.htltech.vn",
      "gateway": "https://api-hcs.htltech.vn"
    }
  },
  "conventions": {
    "headers": {
      "Authorization": "Bearer {access_token}",
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "paging": {
      "workDocumentChatSocial": { "query": ["skip", "take"], "maxTake": 100, "socialFeedMaxTake": 50 },
      "identity": { "query": ["skipCount", "maxResultCount"], "max": 100 }
    },
    "pagedResponse": { "totalCount": 42, "items": [] },
    "dates": "UTC ISO-8601 (2026-09-23T01:00:00.0000000Z). Social from/to = yyyy-MM-dd.",
    "error": {
      "error": {
        "code": "Work:CannotRemoveSelf",
        "message": "...",
        "details": null,
        "validationErrors": []
      }
    },
    "statusCodes": {
      "200": "JSON hoặc binary",
      "201": "Tạo thành công",
      "204": "Thành công, không body",
      "400": "Validation",
      "401": "Refresh token một lần, rồi login",
      "403": "Thiếu permission — không đẩy về login",
      "404": "Không có / empty",
      "409": "Conflict",
      "413": "File quá lớn"
    },
    "fileLimitsMb": {
      "avatarSignatureSealCsv": 2,
      "chatSocialEventSurvey": 25,
      "documentWorkflow": 50
    }
  },
  "modules": {
    "login": {
      "clientId": "hcs-mobile",
      "pkce": "S256",
      "scopes": "openid profile email roles HCS offline_access",
      "redirectUri": "com.htltech.hcs:/oauth/callback",
      "postLogoutRedirectUri": "com.htltech.hcs:/oauth/logout",
      "discovery": "GET {auth}/.well-known/openid-configuration",
      "authorize": {
        "method": "GET",
        "url": "{auth}/connect/authorize",
        "query": {
          "client_id": "hcs-mobile",
          "response_type": "code",
          "redirect_uri": "{registered_redirect_uri}",
          "scope": "openid profile email roles HCS offline_access",
          "state": "{random}",
          "code_challenge": "{BASE64URL(SHA256(code_verifier))}",
          "code_challenge_method": "S256"
        }
      },
      "token": {
        "method": "POST",
        "url": "{auth}/connect/token",
        "contentType": "application/x-www-form-urlencoded",
        "body": "grant_type=authorization_code&client_id=hcs-mobile&redirect_uri={uri}&code={code}&code_verifier={verifier}",
        "response": {
          "access_token": "ey...",
          "token_type": "Bearer",
          "expires_in": 3600,
          "refresh_token": "...",
          "scope": "openid profile email roles HCS offline_access"
        }
      },
      "refresh": {
        "method": "POST",
        "url": "{auth}/connect/token",
        "body": "grant_type=refresh_token&client_id=hcs-mobile&refresh_token={refresh_token}"
      },
      "bootstrapAfterLogin": [
        "GET {gateway}/api/abp/application-configuration",
        "GET {gateway}/api/abp/application-localization?cultureName=vi",
        "GET {gateway}/api/language-management/languages/enabled"
      ],
      "doNotCall": ["/bff/login", "/bff/logout", "/bff/user", "/bff/antiforgery"]
    },
    "account": {
      "permission": "Authenticated",
      "endpoints": [
        {
          "name": "getProfile",
          "method": "GET",
          "path": "/api/account/my-profile",
          "response": {
            "userName": "admin",
            "email": "admin@abp.io",
            "name": "Admin",
            "surname": null,
            "phoneNumber": null,
            "isExternal": false,
            "hasPassword": true,
            "concurrencyStamp": "abc"
          }
        },
        {
          "name": "updateProfile",
          "method": "PUT",
          "path": "/api/account/my-profile",
          "request": {
            "userName": "admin",
            "email": "admin@abp.io",
            "name": "Nguyễn",
            "surname": "Văn A",
            "phoneNumber": "0900000000",
            "concurrencyStamp": "abc"
          }
        },
        {
          "name": "changePassword",
          "method": "POST",
          "path": "/api/account/my-profile/change-password",
          "request": { "currentPassword": "old", "newPassword": "new" },
          "response": "204",
          "note": "Ẩn form nếu isExternal=true"
        },
        {
          "name": "getMyAvatar",
          "method": "GET",
          "path": "/api/identity/profile/avatar",
          "response": "binary; 404 nếu chưa có; có thể 304 nếu gửi If-None-Match"
        },
        {
          "name": "uploadAvatar",
          "method": "POST",
          "path": "/api/identity/profile/avatar",
          "contentType": "multipart/form-data",
          "field": "file",
          "maxBytes": 2097152,
          "types": ["image/jpeg", "image/png", "image/webp", "image/gif"],
          "response": "204"
        },
        {
          "name": "deleteAvatar",
          "method": "DELETE",
          "path": "/api/identity/profile/avatar",
          "response": "204"
        },
        {
          "name": "getUserAvatar",
          "method": "GET",
          "path": "/api/identity/users/{userId}/avatar",
          "response": "binary; 404 nếu chưa có"
        }
      ]
    },
    "config": {
      "note": "Public. Logo/favicon/background URL là path Gateway, thêm query v=revision. Tải asset kèm Bearer hoặc anonymous.",
      "endpoints": [
        {
          "name": "getPublicBranding",
          "method": "GET",
          "path": "/api/hcs/system-branding/public",
          "auth": "optional",
          "response": {
            "title": "HCS",
            "description": "Hệ thống hành chính số",
            "showBrandingText": true,
            "showSsoLoginButton": true,
            "revision": 3,
            "logo": {
              "slot": "logo",
              "url": "/api/hcs/system-branding/assets/logo?v=3",
              "fileName": "logo.png",
              "contentType": "image/png",
              "size": 12345,
              "revision": 3
            },
            "favicon": null,
            "background": null
          }
        },
        {
          "name": "getBrandingAsset",
          "method": "GET",
          "path": "/api/hcs/system-branding/assets/{slot}",
          "slot": ["logo", "favicon", "background"],
          "response": "binary; Cache-Control immutable; ETag sha256"
        }
      ]
    },
    "workspace": {
      "permission": "WorkManagement.Dashboard",
      "note": "Không gọi GET /api/dashboard. Load song song; lỗi một widget không chặn widget khác. Lọc ngày phía client trừ notifications (server from/toExclusive).",
      "parallelGets": [
        "GET /api/calendar?from={utc}&to={utc}",
        "GET /api/projects?skip=0&take=100",
        "GET /api/project-tasks?skip=0&take=100",
        "GET /api/signing/queue-page?skip=0&take=200",
        "GET /api/notifications?unreadOnly=false&skip=0&take=20&from={utc}&toExclusive={utc}",
        "GET /api/identity/organization-unit-lookup"
      ]
    },
