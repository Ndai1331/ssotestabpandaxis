{
  "source": "HCS.Blazor.Client",
  "runtime": "Blazor WebAssembly",
  "httpClient": "HCS.Bff",
  "baseUrlConfig": "RemoteServices:Default:BaseUrl",
  "notes": [
    "FE does not call microservices directly. All HTTP goes through the Web Gateway.",
    "Pages use typed *Client wrappers, not injected IXxxAppService proxies.",
    "ABP still calls application-configuration and application-localization via dynamic proxies."
  ],
  "realtime": {
    "hub": "/hubs/chat",
    "invoke": ["GetOnlineUserIds"],
    "events": ["ReceiveMessage", "MessageDeleted", "NotificationReceived", "PresenceChanged"]
  },
  "groups": [
    {
      "id": "bff-auth",
      "name": "BFF / Auth / ABP",
      "clients": [
        "BffAuthenticationStateProvider",
        "BffHttpMessageHandler",
        "BffLoginUrlBuilder",
        "BffLogoutUrlBuilder"
      ],
      "endpoints": [
        { "method": "GET", "path": "/bff/user" },
        { "method": "GET", "path": "/bff/antiforgery" },
        { "method": "GET", "path": "/bff/login", "note": "browser navigation" },
        { "method": "GET", "path": "/bff/logout", "note": "browser navigation" },
        { "method": "GET", "path": "/api/abp/application-configuration" },
        { "method": "GET", "path": "/api/abp/application-localization" }
      ]
    },
