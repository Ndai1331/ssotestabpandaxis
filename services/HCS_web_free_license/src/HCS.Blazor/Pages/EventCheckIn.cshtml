@page "/event-check-in/{code}"
@model EventCheckInModel
@{
    Layout = "/Pages/Shared/_EventCheckInLayout.cshtml";
    ViewData["Title"] = Model.Event?.Name ?? Model.T("Event:CheckIn");
}
@if (Model.Event is null)
{
    <section class="hcs-event-checkin__card">
        <div class="hcs-empty">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/></svg>
            <h1 id="checkin-title">@Model.T("Event:PublicUnavailable")</h1>
            <p>@Model.ErrorMessage</p>
        </div>
    </section>
}
else
{
    <article class="hcs-event-checkin__card">
        <partial name="_EventCheckInEventMeta" model="Model" />
        <div class="hcs-event-checkin__notice" role="status">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
            <span>@Model.T("Event:ChooseCheckInRole")</span>
        </div>
        <div class="hcs-event-checkin__actions">
            <a class="btn btn-primary" href="@Model.StaffUrl">@Model.T("Event:InternalStaff")</a>
            <a class="btn btn-outline" href="@Model.GuestUrl">@Model.T("Event:Guest")</a>
        </div>
    </article>
}
