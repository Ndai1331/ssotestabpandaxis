@implements IAsyncDisposable
<select id="@selectId" class="hcs-catalog-select2 form-select"></select>
<style>
    select.hcs-catalog-select2 + .select2-container { width: 100% !important; }
    select.hcs-catalog-select2 + .select2-container .select2-selection--single {
        height: auto !important;
        min-height: 2.4rem;
        display: flex;
        align-items: center;
    }
    select.hcs-catalog-select2 + .select2-container .select2-selection--single .select2-selection__rendered {
        line-height: 1.4 !important;
        padding: 0.4rem 2.2rem 0.4rem 0.65rem !important;
    }
</style>
@code {
    private readonly string selectId = "hcs-cs2-" + Guid.NewGuid().ToString("n");
    private DotNetObjectReference<CatalogSelect2>? dotNetRef;
    private bool initialized;
    private string lastSignature = "";

    [Inject] private IJSRuntime Js { get; set; } = default!;

    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? SelectedText { get; set; }
    [Parameter] public Func<string, int, Task<CatalogSelect2SearchResponse>> Search { get; set; } = default!;

    [JSInvokable]
    public Task<CatalogSelect2SearchResponse> SearchAsync(string term, int page) =>
        Search.Invoke(term ?? string.Empty, page <= 0 ? 1 : page);

    [JSInvokable]
    public async Task OnSelectionChangeAsync(string[]? rawIds)
    {
        Guid? next = null;
        if (rawIds is { Length: > 0 } && Guid.TryParse(rawIds[0], out var id))
        {
            next = id;
        }
        var signature = next?.ToString("N") ?? "";
        if (signature == lastSignature) return;
        lastSignature = signature;
        await ValueChanged.InvokeAsync(next);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            lastSignature = Value?.ToString("N") ?? "";
            await Js.InvokeVoidAsync("hcsCatalogSelect2.init", selectId, dotNetRef, new
            {
                placeholder = Placeholder ?? string.Empty,
                minimumInputLength = 0
            }, InitialItems());
            initialized = true;
            return;
        }

        if (!initialized) return;
        var signature = Value?.ToString("N") ?? "";
        if (signature == lastSignature) return;
        lastSignature = signature;
        await Js.InvokeVoidAsync("hcsCatalogSelect2.setSelection", selectId, InitialItems());
    }

    private List<CatalogSelect2Item> InitialItems()
    {
        if (Value is not { } id) return [];
        var text = string.IsNullOrWhiteSpace(SelectedText) ? id.ToString() : SelectedText;
        return [new CatalogSelect2Item(id.ToString(), text)];
    }

    public async ValueTask DisposeAsync()
    {
        if (initialized)
        {
            try { await Js.InvokeVoidAsync("hcsCatalogSelect2.destroy", selectId); }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
        dotNetRef?.Dispose();
    }
}
