@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inject NavigationManager Navigation
@inject IStringLocalizer<HCSResource> L

<nav class="hcs-rating-subnav" aria-label="@L["Menu:EmployeeRatingResults"]">
    <AuthorizeView Policy="WorkManagement.EmployeeRatings.Management">
        <Authorized>
            <a class="hcs-rating-subnav__link @(IsList ? "is-active" : null)" href="/employee-ratings/results/list" aria-current="@(IsList ? "page" : null)">
                <i class="fa fa-star" aria-hidden="true"></i>@L["EmployeeRatings:NavList"]
            </a>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Policy="WorkManagement.EmployeeRatings.Dashboard">
        <Authorized>
            <a class="hcs-rating-subnav__link @(IsDashboard ? "is-active" : null)" href="/employee-ratings/results/dashboard" aria-current="@(IsDashboard ? "page" : null)">
                <i class="fa fa-chart-pie" aria-hidden="true"></i>@L["EmployeeRatings:NavDashboard"]
            </a>
        </Authorized>
    </AuthorizeView>
</nav>

@code {
    private string Path => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('#', '?')[0].Trim('/');

    private bool IsDashboard => Path.Contains("employee-ratings-dashboard", StringComparison.OrdinalIgnoreCase)
        || Path.EndsWith("/employee-ratings/results/dashboard", StringComparison.OrdinalIgnoreCase);

    private bool IsList => !IsDashboard
        && (Path.StartsWith("/administration/employee-ratings", StringComparison.OrdinalIgnoreCase)
            || Path.StartsWith("/employee-ratings/results", StringComparison.OrdinalIgnoreCase));
}
