@namespace HCS.Blazor.Client.Components

<svg class="hcs-loading-icon @CssClass"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     aria-hidden="true">
    <circle cx="12" cy="12" r="9" stroke-dasharray="40 20" stroke-linecap="round" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 22;
    [Parameter] public string? CssClass { get; set; }
}
