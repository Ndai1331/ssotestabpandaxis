@namespace HCS.Blazor.Client.Components
@using System
@inject NotificationBadgeState Badges
@implements IDisposable

@if (Badges.UnreadChat > 0)
{
    <span class="hcs-icon-badge">@Badges.UnreadChat</span>
}

@code {
    protected override void OnInitialized() => Badges.Changed += OnBadgesChanged;

    public void Dispose() => Badges.Changed -= OnBadgesChanged;

    private void OnBadgesChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);
}
