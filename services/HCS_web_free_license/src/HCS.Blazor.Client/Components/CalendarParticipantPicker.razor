@inherits HCSComponentBase
@inject CollaborationClient Chat

<div class="hcs-cal-people-picker">
    <div class="hcs-cal-people-toolbar">
        <label class="sr-only" for="@SearchId">@L["Catalog:Search"]</label>
        <input id="@SearchId" class="form-control" type="search" value="@contactSearch"
               placeholder="@L["Chat:Search"]" autocomplete="off" disabled="@Disabled"
               @oninput="OnSearchInputAsync" @onkeydown="OnSearchKeyAsync" />
        <button class="btn btn-outline btn-sm" type="button" @onclick="SearchAsync" disabled="@Disabled">
            @L["Catalog:Search"]
        </button>
        <label class="hcs-cal-people-select-all">
            <input type="checkbox" checked="@AllVisibleSelected"
                   disabled="@(Disabled || !VisibleContacts.Any())"
                   @onchange="OnSelectAllChanged" />
            <span>@L["Users:SelectAll"]</span>
        </label>
    </div>
    @if (isLoading)
    {
        <p class="hcs-form-note mb-0">@L["Chat:LoadingContacts"]</p>
    }
    else if (!VisibleContacts.Any())
    {
        <p class="hcs-form-note mb-0">@L["Catalog:EmptyTitle"]</p>
    }
    else
    {
        <div class="hcs-cal-people">
            @foreach (var contact in VisibleContacts)
            {
                <label class="form-check" @key="contact.Id">
                    <input class="form-check-input" type="checkbox"
                           checked="@Selected.Contains(contact.Id)"
                           disabled="@Disabled"
                           @onchange="args => Toggle(contact.Id, IsChecked(args.Value))" />
                    <span class="form-check-label">@contact.DisplayName</span>
                </label>
            }
        </div>
    }
</div>

@code {
    [Parameter] public HashSet<Guid> Selected { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private readonly List<ChatContactDto> contacts = [];
    private readonly string SearchId = $"hcs-cal-people-search-{Guid.NewGuid():N}";
    private string contactSearch = string.Empty;
    private bool isLoading = true;

    private IEnumerable<ChatContactDto> VisibleContacts
    {
        get
        {
            var term = contactSearch.Trim();
            return string.IsNullOrWhiteSpace(term)
                ? contacts
                : contacts.Where(contact =>
                    contact.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || contact.UserName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
    }

    private bool AllVisibleSelected
    {
        get
        {
            var visible = VisibleContacts.ToArray();
            return visible.Length > 0 && visible.All(contact => Selected.Contains(contact.Id));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            contacts.AddRange(await Chat.GetContactsAsync(null, 50));
        }
        catch (Exception exception)
        {
            await NotifyErrorAsync(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchInputAsync(ChangeEventArgs args)
    {
        contactSearch = args.Value?.ToString() ?? string.Empty;
        if (contactSearch.Trim().Length >= 2)
            await SearchAsync();
    }

    private Task OnSearchKeyAsync(KeyboardEventArgs args) =>
        args.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private async Task SearchAsync()
    {
        if (Disabled) return;
        var term = contactSearch.Trim();
        if (term.Length == 0) return;
        try
        {
            foreach (var contact in await Chat.GetContactsAsync(term, 50))
            {
                if (contacts.All(existing => existing.Id != contact.Id))
                    contacts.Add(contact);
            }
        }
        catch (Exception exception)
        {
            await NotifyErrorAsync(exception);
        }
    }

    private async Task OnSelectAllChanged(ChangeEventArgs args)
    {
        if (Disabled) return;
        var select = IsChecked(args.Value);
        foreach (var contact in VisibleContacts.ToArray())
        {
            if (select) Selected.Add(contact.Id);
            else Selected.Remove(contact.Id);
        }
        await Changed.InvokeAsync();
    }

    private async Task Toggle(Guid id, bool selected)
    {
        if (Disabled) return;
        if (selected) Selected.Add(id);
        else Selected.Remove(id);
        await Changed.InvokeAsync();
    }

    private static bool IsChecked(object? value) =>
        value is bool flag && flag
        || value is string text && bool.TryParse(text, out var parsed) && parsed;
}
