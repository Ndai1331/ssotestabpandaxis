@inherits HCSComponentBase
@inject CollaborationClient Chat

<div class="list-search-select">
    <UserSelect2 Multiple="true"
                 Values="SelectedIds"
                 ValuesChanged="OnValuesChanged"
                 SelectedItems="SelectedItems"
                 SelectedTexts="SelectedTexts"
                 Placeholder="@L["Chat:SelectContacts"]"
                 Disabled="@Disabled"
                 Search="SearchContactsAsync" />
</div>

@code {
    [Parameter] public HashSet<Guid> Selected { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private readonly List<ChatContactDto> contacts = [];
    private IReadOnlyList<Guid> SelectedIds => Selected.ToList();
    private IReadOnlyList<CatalogSelect2Item> SelectedItems =>
        Selected.Select(ContactItem).OfType<CatalogSelect2Item>().ToList();
    private IReadOnlyList<string> SelectedTexts =>
        Selected.Select(id => ChatContactDirectory.Name(contacts, id)).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            contacts.AddRange(await Chat.GetContactsAsync(null, 50));
            await ChatContactDirectory.EnsureAsync(Chat, contacts, Selected, CurrentUser);
        }
        catch (Exception exception)
        {
            await NotifyErrorAsync(exception);
        }
    }

    private async Task OnValuesChanged(IReadOnlyList<Guid> ids)
    {
        if (Disabled)
            return;

        Selected.Clear();
        foreach (var id in ids)
            Selected.Add(id);
        await Changed.InvokeAsync();
    }

    private CatalogSelect2Item? ContactItem(Guid id) =>
        contacts.FirstOrDefault(contact => contact.Id == id) is { } contact
            ? CatalogSelect2Cache.UserItem(contact)
            : null;

    private async Task<CatalogSelect2SearchResponse> SearchContactsAsync(string term, int page)
    {
        var found = ChatContactDirectory.WithCurrentUser(
            await Chat.GetContactsAsync(term, 50), contacts, CurrentUser, term);
        return CatalogSelect2Cache.Merge(
            contacts, found, contact => contact.Id, contact => contact.DisplayName, more: false,
            itemOf: CatalogSelect2Cache.UserItem);
    }
}
