@inherits HCSComponentBase

<ModalFooter Class="@Class">
    <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="OnClose">
        @L["Catalog:Cancel"]
    </Button>
    @if (ShowAssignTask)
    {
        <AuthorizeView Policy="WorkManagement.ProjectTasks">
            <Authorized>
                <Button Color="Color.Primary" Outline="true" Clicked="OnAssignTask" Disabled="@DisableAssignTask">
                    <Icon Name="IconName.Users" Class="me-1" />
                    @L["Work:AssignTask"]
                </Button>
            </Authorized>
        </AuthorizeView>
    }
    @if (!string.IsNullOrWhiteSpace(ViewDetailHref))
    {
        <a class="btn btn-primary hcs-catalog-save" href="@ViewDetailHref">
            <i class="fa fa-arrow-up-right-from-square me-1" aria-hidden="true"></i>@L["Work:ViewDetail"]
        </a>
    }
    @ChildContent
</ModalFooter>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnAssignTask { get; set; }
    [Parameter] public bool ShowAssignTask { get; set; } = true;
    [Parameter] public bool DisableAssignTask { get; set; }
    [Parameter] public string? ViewDetailHref { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
