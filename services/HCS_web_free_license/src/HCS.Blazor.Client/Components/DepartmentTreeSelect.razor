@inherits HCSComponentBase

@if (Items.Count == 0)
{
    <small class="hcs-department-tree__empty">@EmptyMessage</small>
}
else
{
    <div class="hcs-department-tree">
        <button type="button" class="hcs-department-tree__expand" @onclick="ExpandAll">@L["Work:ExpandAll"]</button>
        @foreach (var node in Items)
        {
            @RenderNode(node, 0)
        }
    </div>
}

@code {
    [Parameter] public List<DepartmentTreeNode> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<Guid> SelectedIds { get; set; } = [];
    [Parameter] public EventCallback<IReadOnlyList<Guid>> SelectedIdsChanged { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = string.Empty;

    private RenderFragment RenderNode(DepartmentTreeNode node, int depth) => __builder =>
    {
        <div class="hcs-department-tree__row" style="@($"padding-left:{depth * 1.1}rem")">
            @if (node.HasChildren)
            {
                <button type="button" class="hcs-department-tree__toggle" @onclick="() => Toggle(node)" aria-expanded="@((!node.Collapsed).ToString().ToLowerInvariant())">
                    <i class="fa @(node.Collapsed ? "fa-chevron-right" : "fa-chevron-down")"></i>
                </button>
            }
            else
            {
                <span class="hcs-department-tree__spacer"></span>
            }
            <input type="checkbox" class="form-check-input" checked="@SelectedIds.Contains(node.Id)"
                   @onchange="args => OnToggleAsync(node.Id, args.Value is true)" />
            <span class="hcs-department-tree__label">@node.Name</span>
        </div>
        if (!node.Collapsed)
        {
            foreach (var child in node.Children)
            {
                @RenderNode(child, depth + 1)
            }
        }
    };

    private void ExpandAll()
    {
        DepartmentTreeSelectHelper.ExpandAll(Items);
        StateHasChanged();
    }

    private void Toggle(DepartmentTreeNode node) => node.Collapsed = !node.Collapsed;

    private async Task OnToggleAsync(Guid id, bool selected)
    {
        var next = SelectedIds.ToHashSet();
        if (selected) next.Add(id);
        else next.Remove(id);
        await SelectedIdsChanged.InvokeAsync(next.ToList());
    }
}
