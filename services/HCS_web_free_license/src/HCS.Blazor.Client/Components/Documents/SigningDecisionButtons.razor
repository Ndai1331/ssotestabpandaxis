@inherits HCSComponentBase

@if (Show)
{
    @if (CanReturn)
    {
        <button class="btn btn-outline" type="button" @onclick="ReturnAsync" disabled="@Disabled">@L["Work:Return"]</button>
    }
    @if (CanExtend)
    {
        <button class="btn btn-outline" type="button" @onclick="ExtendAsync" disabled="@Disabled">@L["Work:ExtendDueDate"]</button>
    }
    <button class="btn btn-danger" type="button" @onclick="RejectAsync" disabled="@Disabled">@L["Feature:Reject"]</button>
    <button class="btn btn-primary" type="button" @onclick="ApproveAsync" disabled="@(Disabled || ApproveDisabled)">@ApproveText</button>
}
@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public bool CanReturn { get; set; }
    [Parameter] public bool CanExtend { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ApproveDisabled { get; set; }
    [Parameter] public string ApproveText { get; set; } = "";
    [Parameter] public EventCallback OnReturn { get; set; }
    [Parameter] public EventCallback OnExtend { get; set; }
    [Parameter] public EventCallback OnReject { get; set; }
    [Parameter] public EventCallback OnApprove { get; set; }

    private Task ReturnAsync() => OnReturn.InvokeAsync();
    private Task ExtendAsync() => OnExtend.InvokeAsync();
    private Task RejectAsync() => OnReject.InvokeAsync();
    private Task ApproveAsync() => OnApprove.InvokeAsync();
}
