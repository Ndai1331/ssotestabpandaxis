@namespace HCS.Blazor.Client.Components

@if (!string.IsNullOrWhiteSpace(Source))
{
    <div class="hcs-pdf-frame hcs-pdf-frame--fill" title="@Title">
        @if (EffectiveHeight is null)
        {
            <PdfViewerContainer>
                <PdfViewerToolbar ShowDownloading="false" />
                <PdfViewer @key="Source" Source="@Source" />
            </PdfViewerContainer>
        }
        else
        {
            <PdfViewerContainer Height="EffectiveHeight">
                <PdfViewerToolbar ShowDownloading="false" />
                <PdfViewer @key="Source" Source="@Source" />
            </PdfViewerContainer>
        }
    </div>
}
@code {
    [Parameter] public string? Source { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public IFluentSizing? ViewerHeight { get; set; }
    [Parameter] public bool MatchParent { get; set; }

    private IFluentSizing? EffectiveHeight => MatchParent ? null : ViewerHeight ?? Height.Rem(50);
}
