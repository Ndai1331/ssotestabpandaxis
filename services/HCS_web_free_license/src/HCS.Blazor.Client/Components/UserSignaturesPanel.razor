@inherits HCSComponentBase
@inject DocumentClient Documents
@inject IUiMessageService UiMessage
@using System.Globalization
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

<section class="hcs-signatures-panel" aria-labelledby="personal-signatures-title" aria-busy="@isSaving">
    <div class="hcs-signatures-panel__toolbar">
        <div>
            <p class="hcs-account-eyebrow">@L["Account:SignaturesEyebrow"]</p>
            <h2 id="personal-signatures-title">@L["Account:SignatureSection"]</h2>
            <p class="hcs-form-note">@L["Feature:SignatureImage"]</p>
        </div>
        <button type="button" class="hcs-signature-button hcs-signature-button--primary" @onclick="OpenCreateAsync" disabled="@isSaving">
            <i class="fa fa-plus" aria-hidden="true"></i>@L["Account:AddSignature"]
        </button>
    </div>

    @if (isLoading)
    {
        <div class="hcs-signature-grid" aria-live="polite">
            @for (var index = 0; index < 3; index++)
            {
                <div class="hcs-signature-card hcs-signature-card--skeleton" aria-hidden="true">
                    <span></span><span></span><span></span>
                </div>
            }
            <span class="visually-hidden">@L["Catalog:Loading"]</span>
        </div>
    }
    else if (loadFailed)
    {
        <div class="hcs-signatures-empty hcs-signatures-empty--error" role="alert">
            <i class="fa fa-triangle-exclamation" aria-hidden="true"></i>
            <h3>@L["Account:SignaturesLoadFailed"]</h3>
            <p>@L["Account:SignaturesLoadFailedHint"]</p>
            <button type="button" class="hcs-signature-button hcs-signature-button--primary" @onclick="LoadAsync">
                <i class="fa fa-rotate-right" aria-hidden="true"></i>@L["Catalog:Retry"]
            </button>
        </div>
    }
    else if (items.Count == 0)
    {
        <div class="hcs-signatures-empty">
            <span class="hcs-signatures-empty__icon"><i class="fa fa-signature" aria-hidden="true"></i></span>
            <h3>@L["Account:NoSignatures"]</h3>
            <p>@L["Account:NoSignaturesHint"]</p>
            <button type="button" class="hcs-signature-button hcs-signature-button--primary" @onclick="OpenCreateAsync">
                <i class="fa fa-plus" aria-hidden="true"></i>@L["Account:AddSignature"]
            </button>
        </div>
        @if (isSaving)
        {
            <span class="visually-hidden" role="status" aria-live="polite">@L["Account:Saving"]</span>
        }
    }
    else
    {
        <div class="hcs-signature-grid">
            @foreach (var item in items)
            {
                <article class="hcs-signature-card @(item.IsDefault ? "is-default" : null)">
                    <div class="hcs-signature-card__preview">
                        @if (previews.TryGetValue(item.Id, out var preview))
                        {
                            <img src="@preview" alt='@string.Format(L["Account:SignaturePreviewAlt"].Value, item.FileName)' loading="lazy" />
                        }
                        else
                        {
                            <span class="hcs-signature-card__preview-fallback"><i class="fa fa-image" aria-hidden="true"></i>@L["Account:PreviewUnavailable"]</span>
                        }
                        @if (item.IsDefault)
                        {
                            <span class="hcs-signature-card__badge"><i class="fa fa-star" aria-hidden="true"></i>@L["Feature:DefaultSignature"]</span>
                        }
                    </div>
                    <div class="hcs-signature-card__body">
                        <div class="hcs-signature-card__title-row">
                            <h3 title="@item.FileName">@item.FileName</h3>
                            <span class="hcs-signature-card__type">@item.ContentType.Replace("image/", "", StringComparison.OrdinalIgnoreCase).ToUpperInvariant()</span>
                        </div>
                        <span class="hcs-signature-card__kind"><i class="fa fa-fingerprint" aria-hidden="true"></i>@SignatureTypeLabel(item.Type)</span>
                        @if (!string.IsNullOrWhiteSpace(item.ProviderCode)) { <span class="hcs-signature-card__kind">@item.ProviderCode @(item.IsActive ? "· Active" : "· Inactive")</span> }
                        @if (item.HasSealImage) { <span class="hcs-signature-card__kind"><i class="fa fa-stamp" aria-hidden="true"></i>@L["Account:SealImage"]</span> }
                        <dl class="hcs-signature-card__meta">
                            <div><dt>@L["Account:SignatureSize"]</dt><dd>@FormatSize(item.Size)</dd></div>
                            <div><dt>@L["Account:SignatureCreated"]</dt><dd>@FormatDate(item.CreationTime)</dd></div>
                        </dl>
                        <div class="hcs-signature-card__actions">
                            @if (!item.IsDefault)
                            {
                                <button type="button" class="hcs-signature-button hcs-signature-button--quiet" @onclick="() => SetDefaultAsync(item)" disabled="@isSaving">
                                    <i class="fa fa-star" aria-hidden="true"></i>@L["Account:SetDefault"]
                                </button>
                            }
                            <button type="button" class="hcs-signature-icon-button" @onclick="() => OpenEditAsync(item)" aria-label='@string.Format(L["Account:EditSignature"].Value, item.FileName)' title='@L["Catalog:Edit"]' disabled="@isSaving">
                                <i class="fa fa-pen" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="hcs-signature-icon-button hcs-signature-icon-button--danger" @onclick="() => DeleteAsync(item)" aria-label='@string.Format(L["Account:DeleteSignature"].Value, item.FileName)' title='@L["Catalog:Delete"]' disabled="@isSaving">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<Modal @ref="editModal" Closing="OnEditModalClosing">
    <ModalContent Centered Class="hcs-catalog-modal">
        <ModalHeader Class="hcs-catalog-modal__header">
            <ModalTitle>@(isCreateOpen ? L["Account:AddSignature"] : L["Account:EditSignatureTitle"])</ModalTitle>
            <CloseButton Clicked="CloseEditAsync" />
        </ModalHeader>
        <ModalBody Class="hcs-catalog-modal__body">
            <form class="hcs-catalog-form" @onsubmit="SaveEditAsync" @onsubmit:preventDefault>
                <Field>
                    <FieldLabel>@L["Account:SignatureFileName"]</FieldLabel>
                    <input id="signature-file-name" class="form-control" @bind="editForm.FileName" maxlength="256" required />
                    <p class="hcs-form-note mb-0">@L["Account:SignatureFileNameHint"]</p>
                </Field>
                <Field>
                    <FieldLabel>@L["Account:SignatureType"]</FieldLabel>
                    <select id="signature-type" class="form-select" value="@editForm.Type" @onchange="HandleTypeChanged">
                        <option value="@UserSignatureType.Electronic">@L["Account:ElectronicSignature"]</option>
                        <option value="@UserSignatureType.Digital">@L["Account:DigitalSignature"]</option>
                    </select>
                </Field>
                @if (editForm.Type == UserSignatureType.Digital)
                {
                    <Field>
                        <FieldLabel>@L["Account:SelectProvider"]</FieldLabel>
                        <ProviderSelect2 Value="editForm.ProviderCode" ValueChanged="SetProviderCode" Items="ProviderItems"
                                         Search="SearchProvidersAsync" Placeholder='@L["Account:SelectProvider"]' />
                        @if (ProviderItems.Count == 0)
                        {
                            <p class="hcs-form-note text-danger mb-0">@L["Account:ProviderNotConfigured"]</p>
                        }
                    </Field>
                    <Field>
                        <FieldLabel>@L["Account:TokenApi"]</FieldLabel>
                        <input class="form-control" @bind="editForm.TokenRef" required="@isCreateOpen" placeholder='@L["Account:TokenKeepHint"]' />
                    </Field>
                    <Field>
                        <FieldLabel>@L["Feature:SigningSecret"]</FieldLabel>
                        <input class="form-control" type="password" @bind="editForm.Secret" autocomplete="new-password" required="@isCreateOpen" />
                    </Field>
                    <Field>
                        <FieldLabel>@L["Account:SealImage"]</FieldLabel>
                        <label class="vb-drop vb-file-chip @(sealFile is not null ? "has-file" : null)">
                            <InputFile @key="sealInputKey" accept="image/jpeg,image/png,image/webp" OnChange="SelectSealAsync" />
                            <span class="vb-file-icon" aria-hidden="true">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/></svg>
                            </span>
                            <span class="vb-file-copy">
                                <strong>@L["Account:SealImage"]</strong>
                                <span class="vb-file-chosen">@(sealFile?.Name ?? L["Work:DropFileHere"])</span>
                            </span>
                            <span class="vb-file-cta">@L["Work:ChooseFile"]</span>
                        </label>
                    </Field>
                }
                else
                {
                    <p class="hcs-form-note mb-0">@L["Account:ElectronicSignatureHint"]</p>
                }
                <Field>
                    <FieldLabel>@(isCreateOpen ? L["Account:SignatureImage"] : L["Account:ReplaceSignatureImage"])</FieldLabel>
                    <label class="vb-drop vb-file-chip @(replacementFile is not null ? "has-file" : null)">
                        <InputFile @key="editInputKey" id="signature-replacement-file" accept="image/jpeg,image/png,image/webp,image/gif" OnChange="SelectReplacementFile" />
                        <span class="vb-file-icon" aria-hidden="true">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/></svg>
                        </span>
                        <span class="vb-file-copy">
                            <strong>@(isCreateOpen ? L["Account:SignatureImage"] : L["Account:ReplaceSignatureImage"])</strong>
                            <span class="vb-file-chosen">@SignatureFileLabel</span>
                        </span>
                        <span class="vb-file-cta">@L["Work:ChooseFile"]</span>
                    </label>
                </Field>
                <div class="hcs-form-row hcs-form-row--equal">
                    <Field>
                        <FieldLabel>@L["Account:ValidFrom"]</FieldLabel>
                        <HcsDatePicker TValue="DateTime?" @bind-Value="editForm.ValidFrom" InputMode="DateInputMode.DateTime" ShowClearButton="true" />
                    </Field>
                    <Field>
                        <FieldLabel>@L["Account:ValidTo"]</FieldLabel>
                        <HcsDatePicker TValue="DateTime?" @bind-Value="editForm.ValidTo" InputMode="DateInputMode.DateTime" ShowClearButton="true" />
                    </Field>
                </div>
                <label class="hcs-signature-check">
                    <input type="checkbox" @bind="editForm.IsActive" />
                    <span>@L["Account:IsActive"]</span>
                </label>
            </form>
        </ModalBody>
        <ModalFooter Class="hcs-catalog-modal__footer">
            <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="CloseEditAsync" Disabled="@isSaving">@L["Catalog:Cancel"]</Button>
            <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveEditAsync" Disabled="@isSaving">
                <i class="fa @(isSaving ? "fa-spinner fa-spin" : "fa-floppy-disk")" aria-hidden="true"></i>@L["Catalog:SaveChanges"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    [Parameter] public Guid? UserId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private readonly List<UserSignatureDto> items = [];
    private readonly List<SigningCredentialDto> providerCredentials = [];
    private readonly Dictionary<Guid, string> previews = new();
    private readonly EditSignatureModel editForm = new();
    private UserSignatureDto? editingSignature;
    private IBrowserFile? replacementFile;
    private IBrowserFile? sealFile;
    private Modal? editModal;
    private bool isLoading = true;
    private bool loadFailed;
    private bool isSaving;
    private bool isCreateOpen;
    private int editInputKey;
    private int sealInputKey;
    private string SignatureFileLabel =>
        replacementFile?.Name
        ?? (isCreateOpen ? L["Work:DropFileHere"] : editingSignature?.FileName ?? L["Work:DropFileHere"]);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;
        try
        {
            items.Clear();
            providerCredentials.Clear();
            previews.Clear();
            providerCredentials.AddRange(await Documents.GetCredentialsAsync(UserId));
            items.AddRange(await Documents.GetSignaturesAsync(UserId));
            foreach (var item in items)
            {
                try
                {
                    var content = await Documents.GetSignatureContentAsync(item.Id, UserId);
                    previews[item.Id] = $"data:{content.ContentType};base64,{Convert.ToBase64String(content.Bytes)}";
                }
                catch
                {
                    // Keep the metadata card visible when a preview is unavailable.
                }
            }
        }
        catch (Exception ex)
        {
            loadFailed = true;
            await NotifyErrorAsync(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenCreateAsync()
    {
        isCreateOpen = true;
        editingSignature = null;
        editForm.Reset();
        replacementFile = null;
        sealFile = null;
        editInputKey++;
        sealInputKey++;
        if (editModal is not null) await editModal.Show();
    }

    private async Task OpenEditAsync(UserSignatureDto item)
    {
        editingSignature = item;
        isCreateOpen = false;
        editForm.FileName = item.FileName;
        editForm.Type = item.Type;
        editForm.ProviderCode = item.ProviderCode;
        editForm.TokenRef = item.TokenRef;
        editForm.Secret = "";
        sealFile = null;
        editForm.ValidFrom = item.ValidFrom?.ToLocalTime();
        editForm.ValidTo = item.ValidTo?.ToLocalTime();
        editForm.IsActive = item.IsActive;
        replacementFile = null;
        editInputKey++;
        if (editModal is not null) await editModal.Show();
    }

    private Task CloseEditAsync() => isSaving ? Task.CompletedTask : editModal?.Hide() ?? Task.CompletedTask;

    private Task OnEditModalClosing(ModalClosingEventArgs args)
    {
        if (isSaving)
        {
            args.Cancel = true;
            return Task.CompletedTask;
        }

        editingSignature = null;
        isCreateOpen = false;
        replacementFile = null;
        sealFile = null;
        return Task.CompletedTask;
    }

    private void SelectReplacementFile(InputFileChangeEventArgs args)
    {
        replacementFile = args.File;
        if (string.IsNullOrWhiteSpace(editForm.FileName) && args.File is not null)
        {
            editForm.FileName = Path.GetFileNameWithoutExtension(args.File.Name);
        }
    }

    private async Task SelectSealAsync(InputFileChangeEventArgs args)
    {
        sealFile = args.File;
    }

    private void HandleTypeChanged(ChangeEventArgs args)
    {
        if (!Enum.TryParse<UserSignatureType>(args.Value?.ToString(), out var type)) return;
        editForm.Type = type;
        if (type == UserSignatureType.Electronic)
        {
            editForm.ProviderCode = "";
            editForm.TokenRef = "";
            editForm.Secret = "";
            sealFile = null;
        }
    }

    private void SetProviderCode(string? value) => editForm.ProviderCode = value ?? "";

    private async Task SaveEditAsync()
    {
        if ((!isCreateOpen && editingSignature is null) || string.IsNullOrWhiteSpace(editForm.FileName)) return;
        if (isCreateOpen && replacementFile is null) return;
        if (isCreateOpen && IsSealImageRequired && sealFile is null) return;
        var creating = isCreateOpen;
        isSaving = true;
        try
        {
            var providerCode = editForm.Type == UserSignatureType.Digital ? editForm.ProviderCode : null;
            var tokenRef = editForm.Type == UserSignatureType.Digital ? editForm.TokenRef : null;
            var secret = editForm.Type == UserSignatureType.Digital ? editForm.Secret : null;
            var sealImage = editForm.Type == UserSignatureType.Digital ? sealFile : null;
            if (isCreateOpen)
            {
                await Documents.UploadSignatureAsync(replacementFile!, UserId, type: editForm.Type,
                    providerCode: providerCode, tokenRef: tokenRef, secret: secret, sealImage: sealImage,
                    validFrom: editForm.ValidFrom?.ToUniversalTime(), validTo: editForm.ValidTo?.ToUniversalTime(), isActive: editForm.IsActive);
            }
            else
            {
                await Documents.UpdateSignatureAsync(editingSignature!.Id, editForm.FileName.Trim(), replacementFile, UserId, type: editForm.Type,
                    providerCode: providerCode, tokenRef: tokenRef, secret: secret, sealImage: sealImage,
                    validFrom: editForm.ValidFrom?.ToUniversalTime(), validTo: editForm.ValidTo?.ToUniversalTime(), isActive: editForm.IsActive);
            }
            editingSignature = null;
            isCreateOpen = false;
            replacementFile = null;
            sealFile = null;
            await NotifySuccessAsync(L[creating ? "Catalog:Created" : "Account:SignatureUpdated"]);
            await LoadAsync();
            await OnChanged.InvokeAsync();
            isSaving = false;
            if (editModal is not null) await editModal.Hide();
        }
        catch (Exception ex)
        {
            await NotifyErrorAsync(ex, BffErrorKind.Save);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SetDefaultAsync(UserSignatureDto item)
    {
        isSaving = true;
        try
        {
            await Documents.SetDefaultSignatureAsync(item.Id, UserId);
            await NotifySuccessAsync(L["Account:DefaultSignatureUpdated"]);
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            await NotifyErrorAsync(ex, BffErrorKind.Save);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAsync(UserSignatureDto item)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], item.FileName))) return;
        isSaving = true;
        try
        {
            await Documents.DeleteSignatureAsync(item.Id, UserId);
            await NotifySuccessAsync(L["Catalog:Deleted"]);
            await LoadAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            await NotifyErrorAsync(ex, BffErrorKind.Delete);
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string FormatSize(long size)
    {
        if (size < 1024) return $"{size} B";
        if (size < 1024 * 1024) return $"{size / 1024d:0.#} KB";
        return $"{size / (1024d * 1024):0.##} MB";
    }

    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.CurrentCulture);

    private IReadOnlyList<CatalogSelect2Item> ProviderItems => providerCredentials
        .Where(x => x.Kind != 0 && !string.IsNullOrWhiteSpace(x.ProviderCode))
        .Select(x => new CatalogSelect2Item(x.ProviderCode, $"{x.ProviderCode} · {KindName(x.Kind)}", x.Endpoint))
        .GroupBy(x => x.Id, StringComparer.OrdinalIgnoreCase)
        .Select(x => x.First())
        .ToList();

    private bool IsSealImageRequired =>
        editForm.Type == UserSignatureType.Digital
        && providerCredentials.FirstOrDefault(credential =>
            string.Equals(credential.ProviderCode, editForm.ProviderCode, StringComparison.OrdinalIgnoreCase))?.Kind
            is 2 or 3;

    private Task<CatalogSelect2SearchResponse> SearchProvidersAsync(string term, int page)
    {
        var query = term.Trim();
        var results = ProviderItems
            .Where(x => string.IsNullOrWhiteSpace(query)
                || x.Id.Contains(query, StringComparison.OrdinalIgnoreCase)
                || x.Text.Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToList();
        return Task.FromResult(new CatalogSelect2SearchResponse(results, false));
    }

    private string KindName(int kind) => kind switch
    {
        1 => L["Feature:RemoteCa"].Value,
        2 => L["Feature:Hsm"].Value,
        3 => L["Feature:UsbToken"].Value,
        _ => L["Feature:Electronic"].Value
    };

    private string SignatureTypeLabel(UserSignatureType type) => type switch
    {
        UserSignatureType.Digital => L["Account:DigitalSignature"].Value,
        _ => L["Account:ElectronicSignature"].Value
    };

    private sealed class EditSignatureModel
    {
        public string FileName { get; set; } = "";
        public UserSignatureType Type { get; set; } = UserSignatureType.Electronic;
        public string ProviderCode { get; set; } = "";
        public string TokenRef { get; set; } = "";
        public string Secret { get; set; } = "";
        public DateTime? ValidFrom { get; set; }
        public DateTime? ValidTo { get; set; }
        public bool IsActive { get; set; } = true;

        public void Reset()
        {
            FileName = ""; Type = UserSignatureType.Electronic; ProviderCode = ""; TokenRef = "";
            Secret = ""; ValidFrom = null; ValidTo = null; IsActive = true;
        }
    }
}
