@using System.Globalization
@using HCS.Localization
@using Microsoft.Extensions.Localization
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<HCSResource> Localizer
@inject LanguageCatalogState LanguageState
@implements IDisposable

<div class="hcs-lang-switch @(isOpen ? "hcs-lang-switch--open" : null)" @onkeydown="OnKeyDown">
    <button class="hcs-lang-switch__trigger"
            type="button"
            aria-haspopup="menu"
            aria-expanded="@isOpen.ToString().ToLowerInvariant()"
            aria-controls="hcs-lang-switch-menu"
            aria-label="@Localizer["Auth:SelectLanguage"]"
            title="@Localizer["Auth:SelectLanguage"]"
            @onclick="Toggle">
        <span class="hcs-lang-switch__flag" aria-hidden="true">@FlagIcon(CurrentCulture)</span>
        <span class="hcs-lang-switch__code">@CurrentCode</span>
    </button>

    @if (isOpen)
    {
        <div class="hcs-lang-switch__backdrop" @onclick="Close"></div>
        <div id="hcs-lang-switch-menu" class="hcs-lang-switch__panel" role="menu">
            @foreach (var language in availableLanguages)
            {
                var isCurrent = string.Equals(language.CultureName, CurrentCulture, StringComparison.OrdinalIgnoreCase);
                <button class="hcs-lang-switch__item @(isCurrent ? "hcs-lang-switch__item--current" : null)"
                        type="button"
                        role="menuitem"
                        aria-current="@(isCurrent ? "true" : "false")"
                        @onclick="@(() => ChangeCultureAsync(language.CultureName))">
                    <span class="hcs-lang-switch__flag" aria-hidden="true">@FlagIcon(language.CultureName)</span>
                    <span>@language.DisplayName</span>
                    <small>@language.CultureName</small>
                </button>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<LanguageOptionDto> availableLanguages = [];
    private bool isOpen;
    private bool isDisposed;

    private string CurrentCulture
    {
        get
        {
            var current = CultureInfo.CurrentUICulture.Name;
            return availableLanguages.FirstOrDefault(language =>
                       string.Equals(language.CultureName, current, StringComparison.OrdinalIgnoreCase))?.CultureName
                   ?? availableLanguages.FirstOrDefault(language => language.IsDefault)?.CultureName
                   ?? availableLanguages.FirstOrDefault()?.CultureName
                   ?? "en";
        }
    }

    private string CurrentCode => CurrentCulture;

    protected override async Task OnInitializedAsync()
    {
        LanguageState.Changed += OnLanguageStateChanged;
        try
        {
            availableLanguages = await LanguageState.EnsureLoadedAsync();
            if (availableLanguages.Count == 0) availableLanguages = GetEmergencyLanguage();
        }
        catch
        {
            availableLanguages = GetEmergencyLanguage();
        }
    }

    public void Dispose()
    {
        isDisposed = true;
        LanguageState.Changed -= OnLanguageStateChanged;
    }

    private void OnLanguageStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (isDisposed) return;
            availableLanguages = LanguageState.Languages.Count == 0 ? GetEmergencyLanguage() : LanguageState.Languages;
            var currentCulture = CultureInfo.CurrentUICulture.Name;
            var currentStillEnabled = availableLanguages.Any(language =>
                string.Equals(language.CultureName, currentCulture, StringComparison.OrdinalIgnoreCase));
            if (!currentStillEnabled)
            {
                var fallback = CurrentCulture;
                await JS.InvokeVoidAsync("hcsSetCulture", fallback);
                Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
                return;
            }

            StateHasChanged();
        });
    }

    private void Toggle() => isOpen = !isOpen;

    private void Close() => isOpen = false;

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") Close();
    }

    private async Task ChangeCultureAsync(string culture)
    {
        var selected = availableLanguages.FirstOrDefault(language =>
            string.Equals(language.CultureName, culture, StringComparison.OrdinalIgnoreCase));
        if (selected is null || string.Equals(selected.CultureName, CurrentCulture, StringComparison.OrdinalIgnoreCase))
        {
            Close();
            return;
        }

        await JS.InvokeVoidAsync("hcsSetCulture", selected.CultureName);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private static IReadOnlyList<LanguageOptionDto> GetEmergencyLanguage()
    {
        var cultureName = CultureInfo.CurrentUICulture.Name;
        if (string.IsNullOrWhiteSpace(cultureName)) cultureName = "en";
        return [new LanguageOptionDto { CultureName = cultureName, DisplayName = cultureName, IsDefault = true }];
    }

    private static RenderFragment FlagIcon(string culture) => __builder =>
    {
        if (string.Equals(culture, "vi", StringComparison.OrdinalIgnoreCase) || culture.StartsWith("vi-", StringComparison.OrdinalIgnoreCase))
        {
            <svg viewBox="0 0 60 60" width="24" height="24" focusable="false" aria-hidden="true">
                <rect width="60" height="60" fill="#DA251D" />
                <polygon fill="#FFCD00" points="30,11 33.53,22.45 45.53,22.45 35.85,29.55 39.53,41.18 30,34.4 20.47,41.18 24.15,29.55 14.47,22.45 26.47,22.45" />
            </svg>
        }
        else if (string.Equals(culture, "en", StringComparison.OrdinalIgnoreCase) || culture.StartsWith("en-", StringComparison.OrdinalIgnoreCase))
        {
            <svg viewBox="0 0 60 60" width="24" height="24" focusable="false" aria-hidden="true">
                <rect width="60" height="60" fill="#B31942" />
                <rect y="4.62" width="60" height="4.62" fill="#fff" />
                <rect y="13.85" width="60" height="4.62" fill="#fff" />
                <rect y="23.08" width="60" height="4.62" fill="#fff" />
                <rect y="32.31" width="60" height="4.62" fill="#fff" />
                <rect y="41.54" width="60" height="4.62" fill="#fff" />
                <rect y="50.77" width="60" height="4.62" fill="#fff" />
                <rect width="26" height="32.31" fill="#0A3161" />
                <g fill="#fff">
                    <circle cx="4.3" cy="4.3" r=".7" /><circle cx="8.7" cy="4.3" r=".7" /><circle cx="13" cy="4.3" r=".7" /><circle cx="17.4" cy="4.3" r=".7" /><circle cx="21.7" cy="4.3" r=".7" />
                    <circle cx="6.5" cy="8" r=".7" /><circle cx="10.8" cy="8" r=".7" /><circle cx="15.2" cy="8" r=".7" /><circle cx="19.5" cy="8" r=".7" />
                    <circle cx="4.3" cy="11.7" r=".7" /><circle cx="8.7" cy="11.7" r=".7" /><circle cx="13" cy="11.7" r=".7" /><circle cx="17.4" cy="11.7" r=".7" /><circle cx="21.7" cy="11.7" r=".7" />
                    <circle cx="6.5" cy="15.4" r=".7" /><circle cx="10.8" cy="15.4" r=".7" /><circle cx="15.2" cy="15.4" r=".7" /><circle cx="19.5" cy="15.4" r=".7" />
                    <circle cx="4.3" cy="19.1" r=".7" /><circle cx="8.7" cy="19.1" r=".7" /><circle cx="13" cy="19.1" r=".7" /><circle cx="17.4" cy="19.1" r=".7" /><circle cx="21.7" cy="19.1" r=".7" />
                    <circle cx="6.5" cy="22.8" r=".7" /><circle cx="10.8" cy="22.8" r=".7" /><circle cx="15.2" cy="22.8" r=".7" /><circle cx="19.5" cy="22.8" r=".7" />
                    <circle cx="4.3" cy="26.5" r=".7" /><circle cx="8.7" cy="26.5" r=".7" /><circle cx="13" cy="26.5" r=".7" /><circle cx="17.4" cy="26.5" r=".7" /><circle cx="21.7" cy="26.5" r=".7" />
                </g>
            </svg>
        }
        else
        {
            <i class="fa fa-globe" aria-hidden="true"></i>
        }
    };
}
