@page "/document-detail"
@page "/document-detail/{DocumentId:guid}"
@page "/view-document-detail/{DocumentId:guid}"
@attribute [Authorize(Policy = "Documents.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject OrganizationCatalogClient Catalog
@inject CollaborationClient Chat
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation
@inject IJSRuntime Js
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable

<PageTitle>@(string.IsNullOrWhiteSpace(form.Title) ? L["Feature:DocumentTitle"] : form.Title) · HCS</PageTitle>
<section class="hcs-catalog-page">
    <header class="hcs-catalog-titlebar">
        <div>
            <h1>@(IsCreate ? L["Catalog:Create"] : (string.IsNullOrWhiteSpace(form.Title) ? L["Feature:DocumentTitle"] : form.Title))</h1>
            @if (document is not null) { <p class="mb-0 text-muted">@document.Number · @document.Status</p> }
        </div>
        <a class="btn btn-outline-primary" href="@BackHref">@L["Feature:BackToList"]</a>
    </header>

    <div class="row g-3">
        <div class="col-lg-6">
            <Card>
                <CardHeader>@L["Feature:DocumentTitle"]</CardHeader>
                <CardBody>
                    <div class="hcs-catalog-form">
                        <div class="hcs-form-row">
                            <Field><FieldLabel>@L["Feature:DocumentNumber"]</FieldLabel>
                                <HcsIsolatedTextInput @bind-Value="form.Number" Name="hcsDocumentNumber" MaxLength="64" Disabled="@(!IsCreate)" />
                            </Field>
                            <Field><FieldLabel>@L["Feature:DocumentTitleField"]</FieldLabel>
                                <HcsIsolatedTextInput @bind-Value="form.Title" Name="hcsDocumentTitle" />
                            </Field>
                        </div>
                        <Field><FieldLabel>@L["Feature:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="form.Description" autocomplete="off"></textarea></Field>
                        <div class="hcs-form-row hcs-form-row--equal">
                            <Field><FieldLabel>@L["Menu:DocumentTypes"]</FieldLabel>
                                <CatalogSelect2 Value="form.DocumentTypeId" ValueChanged="value => form.DocumentTypeId = value"
                                                Placeholder="@L["Catalog:SearchPlaceholder"]" SelectedText="@MasterText(documentTypes, form.DocumentTypeId)"
                                                Search="SearchDocumentTypesAsync" />
                            </Field>
                            <Field><FieldLabel>@L["Menu:Sectors"]</FieldLabel>
                                <CatalogSelect2 Value="form.SectorId" ValueChanged="value => form.SectorId = value"
                                                Placeholder="@L["Catalog:SearchPlaceholder"]" SelectedText="@MasterText(sectors, form.SectorId)"
                                                Search="SearchSectorsAsync" />
                            </Field>
                        </div>
                        <div class="hcs-form-row hcs-form-row--equal">
                            <Field><FieldLabel>@L["Menu:UrgencyLevels"]</FieldLabel>
                                <CatalogSelect2 Value="form.UrgencyId" ValueChanged="value => form.UrgencyId = value"
                                                Placeholder="@L["Catalog:SearchPlaceholder"]" SelectedText="@MasterText(urgencies, form.UrgencyId)"
                                                Search="SearchUrgenciesAsync" />
                            </Field>
                            <Field><FieldLabel>@L["Menu:ConfidentialityLevels"]</FieldLabel>
                                <CatalogSelect2 Value="form.ConfidentialityId" ValueChanged="value => form.ConfidentialityId = value"
                                                Placeholder="@L["Catalog:SearchPlaceholder"]" SelectedText="@MasterText(confidentialities, form.ConfidentialityId)"
                                                Search="SearchConfidentialitiesAsync" />
                            </Field>
                        </div>
                        <AuthorizeView Policy="Documents.Create">
                            <Authorized>
                                @if (IsCreate)
                                {
                                    <Button Color="Color.Primary" Clicked="SaveAsync" Disabled="@isSaving">@L["Catalog:Create"]</Button>
                                }
                            </Authorized>
                        </AuthorizeView>
                        <AuthorizeView Policy="Documents.Update">
                            <Authorized>
                                @if (!IsCreate)
                                {
                                    <Button Color="Color.Primary" Clicked="SaveAsync" Disabled="@isSaving">@L["Catalog:SaveChanges"]</Button>
                                }
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </CardBody>
            </Card>
            @if (!IsCreate)
            {
                <Card Class="mt-3">
                    <CardHeader>@L["Feature:Files"]</CardHeader>
                    <CardBody>
                        <InputFile class="form-control mb-2" OnChange="UploadAsync" />
                        @if (document?.Files.Count is null or 0) { <p>@L["Catalog:EmptyTitle"]</p> }
                        else {
                            <ul class="list-group">
                            @foreach (var file in document!.Files)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@file.FileName <small>(@(file.Size / 1024) KB)</small></span>
                                    <span class="d-flex gap-1">
                                        <Button Size="Size.Small" Color="Color.Primary" Outline="true" Clicked="() => PreviewFileAsync(file)">@L["Work:PdfPreview"]</Button>
                                        @if (SourceType is 0 or 1)
                                        {
                                            <Button Size="Size.Small" Color="Color.Danger" Outline="true" Clicked="() => DeleteFileAsync(file.Id)">@L["Catalog:Delete"]</Button>
                                        }
                                    </span>
                                </li>
                            }
                            </ul>
                        }
                    </CardBody>
                </Card>
            }
        </div>
        <div class="col-lg-6">
            @if (!string.IsNullOrWhiteSpace(pdfUrl))
            {
                <Card>
                    <CardHeader>@L["Work:PdfPreview"]</CardHeader>
                    <CardBody>
                        <iframe src="@pdfUrl" title="@L["Work:PdfPreview"]" style="width:100%;min-height:28rem;border:1px solid #d7e2e8;border-radius:.5rem;"></iframe>
                    </CardBody>
                </Card>
            }
            @if (!IsCreate && document is not null)
            {
                <Card Class="mt-3">
                    <CardHeader>@L["Feature:Assign"]</CardHeader>
                    <CardBody>
                        <Select TValue="Guid?" @bind-Value="assigneeId">
                            <SelectItem TValue="Guid?" Value="null">@L["Chat:SelectContacts"]</SelectItem>
                            @foreach (var contact in contacts) { <SelectItem TValue="Guid?" Value="@contact.Id">@contact.DisplayName</SelectItem> }
                        </Select>
                        <HcsIsolatedTextInput CssClass="form-control mt-2" @bind-Value="responsibility" Name="hcsDocumentResponsibility" Placeholder="@L["Feature:Responsibility"].Value" />
                        <Button Color="Color.Primary" Class="mt-2" Clicked="AssignAsync">@L["Feature:Assign"]</Button>
                        <ul class="mt-3 mb-0">
                            @foreach (var assignment in document.Assignments)
                            {
                                <li>@ContactName(assignment.AssigneeUserId) · @assignment.Responsibility</li>
                            }
                        </ul>
                    </CardBody>
                </Card>
                <Card Class="mt-3">
                    <CardHeader>@L["Feature:StartWorkflow"]</CardHeader>
                    <CardBody>
                        <div class="d-flex gap-2">
                            <Button Color="Color.Primary" Clicked="SubmitAsync" Disabled="@(document.Status != DocumentStatus.Draft)">@L["Feature:SubmitDocument"]</Button>
                            <AuthorizeView Policy="Documents.Workflow.Start">
                                <Authorized>
                                    <Button Color="Color.Primary" Outline="true" Clicked="OpenSubmitWorkflow">@L["Work:SubmitWorkflow"]</Button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </CardBody>
                </Card>
                <Card Class="mt-3">
                    <CardHeader>@L["Feature:History"]</CardHeader>
                    <CardBody>
                        <ul class="mb-0">
                            @foreach (var item in document.History.OrderByDescending(x => x.OccurredAt))
                            {
                                <li>@item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @item.Action @item.Detail</li>
                            }
                        </ul>
                    </CardBody>
                </Card>
            }
        </div>
    </div>
</section>
<SubmitWorkflowModal @ref="submitModal" OnSubmitted="ReloadExistingAsync" />
@code {
    [Parameter] public Guid DocumentId { get; set; }
    [SupplyParameterFromQuery(Name = "sourceType")] public int? SourceTypeQuery { get; set; }
    private DocumentDto? document;
    private readonly DocumentForm form = new();
    private readonly List<MasterDataCatalogDto> documentTypes = [];
    private readonly List<MasterDataCatalogDto> sectors = [];
    private readonly List<MasterDataCatalogDto> urgencies = [];
    private readonly List<MasterDataCatalogDto> confidentialities = [];
    private readonly List<ChatContactDto> contacts = [];
    private SubmitWorkflowModal? submitModal;
    private Guid? assigneeId;
    private string responsibility = "reviewer";
    private string? pdfUrl;
    private bool isSaving;
    private bool IsCreate => DocumentId == Guid.Empty;
    private int SourceType => SourceTypeQuery is >= 0 and <= 2 ? SourceTypeQuery.Value : 0;
    private string BackHref => $"/manage-documents?sourceType={SourceType}";

    protected override async Task OnParametersSetAsync()
    {
        await LoadLookupsAsync();
        if (IsCreate)
        {
            document = null;
            form.Reset();
            await RevokePdfAsync();
            return;
        }
        await ReloadExistingAsync();
    }

    private async Task LoadLookupsAsync()
    {
        if (documentTypes.Count > 0) return;
        try
        {
            var query = new OrganizationCatalogQuery(null, true, 0, 100);
            documentTypes.AddRange((await Catalog.GetMasterDataAsync("DocumentType", query)).Items);
            sectors.AddRange((await Catalog.GetMasterDataAsync("Sector", query)).Items);
            urgencies.AddRange((await Catalog.GetMasterDataAsync("UrgencyLevel", query)).Items);
            confidentialities.AddRange((await Catalog.GetMasterDataAsync("ConfidentialityLevel", query)).Items);
        }
        catch { /* catalog permission is optional */ }
        if (contacts.Count == 0)
        {
            try { contacts.AddRange(await Chat.GetContactsAsync(null, 50)); }
            catch { /* contacts optional on create */ }
        }
    }

    private async Task ReloadExistingAsync()
    {
        try
        {
            document = await Documents.GetDocumentAsync(DocumentId);
            form.Number = document.Number;
            form.Title = document.Title;
            form.Description = document.Description ?? "";
            form.DocumentTypeId = document.DocumentTypeId;
            form.SectorId = document.SectorId;
            form.UrgencyId = document.UrgencyId;
            form.ConfidentialityId = document.ConfidentialityId;
            await LoadPreviewAsync(document.Files.FirstOrDefault(x => x.ContentType.Contains("pdf", StringComparison.OrdinalIgnoreCase)) ?? document.Files.FirstOrDefault());
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        try
        {
            if (IsCreate)
            {
                var created = await Documents.CreateDocumentAsync(new CreateDocumentRequest(
                    form.Number.Trim(), form.Title.Trim(),
                    string.IsNullOrWhiteSpace(form.Description) ? null : form.Description,
                    form.DocumentTypeId, form.SectorId, form.UrgencyId, form.ConfidentialityId,
                    SourceType == 1 ? DocumentSourceType.Personal : DocumentSourceType.Archive));
                await NotifySuccessAsync(L["Catalog:Created"]);
                Navigation.NavigateTo($"/document-detail/{created.Id}?sourceType={SourceType}");
                return;
            }
            document = await Documents.UpdateDocumentAsync(DocumentId, new UpdateDocumentRequest(
                form.Title.Trim(),
                string.IsNullOrWhiteSpace(form.Description) ? null : form.Description,
                form.DocumentTypeId, form.SectorId, form.UrgencyId, form.ConfidentialityId));
            await NotifySuccessAsync(L["Catalog:Updated"]);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSaving = false; }
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await Documents.UploadFileAsync(DocumentId, args.File);
            await NotifySuccessAsync(L["Catalog:Created"]);
            await ReloadExistingAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }

    private async Task DeleteFileAsync(Guid fileId)
    {
        if (!await UiMessage.Confirm(L["Catalog:DeleteConfirmation"].Value.Replace("{0}", L["Feature:Files"]))) return;
        try { await Documents.DeleteFileAsync(DocumentId, fileId); await ReloadExistingAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }

    private Task PreviewFileAsync(DocumentFileDto file) => LoadPreviewAsync(file);

    private async Task LoadPreviewAsync(DocumentFileDto? file)
    {
        await RevokePdfAsync();
        if (file is null) return;
        try
        {
            var content = await Documents.GetFileContentAsync(DocumentId, file.Id);
            var type = string.IsNullOrWhiteSpace(content.ContentType) ? "application/pdf" : content.ContentType;
            pdfUrl = await Js.InvokeAsync<string>("hcsCreateObjectUrl", type, content.Bytes);
        }
        catch { pdfUrl = null; }
    }

    private async Task AssignAsync()
    {
        if (assigneeId is not { } userId) return;
        try { document = await Documents.AssignAsync(DocumentId, new AssignDocumentRequest(userId, string.IsNullOrWhiteSpace(responsibility) ? "reviewer" : responsibility.Trim())); await NotifySuccessAsync(L["Catalog:Updated"]); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }

    private async Task SubmitAsync()
    {
        try { document = await Documents.SubmitAsync(DocumentId); await NotifySuccessAsync(L["Feature:SubmitDocument"]); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }

    private Task OpenSubmitWorkflow() => submitModal?.ShowAsync(DocumentId) ?? Task.CompletedTask;
    private string ContactName(Guid id) => contacts.FirstOrDefault(x => x.Id == id)?.DisplayName ?? id.ToString("N")[..8];
    private static string MasterText(IEnumerable<MasterDataCatalogDto> items, Guid? id) =>
        CatalogSelect2Cache.TextFor(items, id, x => x.Id, x => CatalogSelect2Text.CodeName(x.Code, x.Name));
    private async Task<CatalogSelect2SearchResponse> SearchMasterAsync(string type, List<MasterDataCatalogDto> cache, string term, int page)
    {
        var skip = Math.Max(page - 1, 0) * 20;
        var result = await Catalog.SearchMasterDataAsync(type, term, skip, 20);
        return CatalogSelect2Cache.Merge(cache, result.Items, x => x.Id,
            x => CatalogSelect2Text.CodeName(x.Code, x.Name), more: skip + result.Items.Count < result.TotalCount);
    }
    private Task<CatalogSelect2SearchResponse> SearchDocumentTypesAsync(string term, int page) => SearchMasterAsync("DocumentType", documentTypes, term, page);
    private Task<CatalogSelect2SearchResponse> SearchSectorsAsync(string term, int page) => SearchMasterAsync("Sector", sectors, term, page);
    private Task<CatalogSelect2SearchResponse> SearchUrgenciesAsync(string term, int page) => SearchMasterAsync("UrgencyLevel", urgencies, term, page);
    private Task<CatalogSelect2SearchResponse> SearchConfidentialitiesAsync(string term, int page) => SearchMasterAsync("ConfidentialityLevel", confidentialities, term, page);

    private async Task RevokePdfAsync()
    {
        if (string.IsNullOrWhiteSpace(pdfUrl)) return;
        await Js.InvokeVoidAsync("hcsRevokeObjectUrl", pdfUrl);
        pdfUrl = null;
    }

    public async ValueTask DisposeAsync() => await RevokePdfAsync();

    private sealed class DocumentForm
    {
        public string Number { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public Guid? DocumentTypeId { get; set; }
        public Guid? SectorId { get; set; }
        public Guid? UrgencyId { get; set; }
        public Guid? ConfidentialityId { get; set; }
        public void Reset()
        {
            Number = Title = Description = "";
            DocumentTypeId = SectorId = UrgencyId = ConfidentialityId = null;
        }
    }
}
