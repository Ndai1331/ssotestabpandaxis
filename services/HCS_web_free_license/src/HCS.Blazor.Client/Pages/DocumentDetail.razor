@page "/document-detail/{DocumentId:guid}"
@page "/view-document-detail/{DocumentId:guid}"
@attribute [Authorize(Policy = "Documents.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject CollaborationClient Chat
@inject IUiMessageService UiMessage
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@(document?.Title ?? L["Feature:DocumentTitle"]) · HCS</PageTitle>
<section class="hcs-document-page">
    <header class="hcs-document-page__header">
        <div>
            
            <h1>@(document?.Title ?? L["Feature:DocumentTitle"])</h1>
            @if (document is not null) { <p>@document.Number · @document.Status</p> }
        </div>
        <a class="btn btn-outline-primary" href="/manage-documents">@L["Feature:BackToList"]</a>
    </header>
    @if (document is not null)
    {
        <div class="row g-3">
            <div class="col-lg-6">
                <Card>
                    <CardHeader>@L["Feature:Files"]</CardHeader>
                    <CardBody>
                        <InputFile class="form-control mb-2" OnChange="UploadAsync" />
                        @if (document.Files.Count == 0) { <p>@L["Catalog:EmptyTitle"]</p> }
                        else {
                            <ul class="list-group">
                            @foreach (var file in document.Files)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@file.FileName <small>(@(file.Size / 1024) KB)</small></span>
                                    <Button Size="Size.Small" Color="Color.Danger" Outline="true" Clicked="() => DeleteFileAsync(file.Id)">@L["Catalog:Delete"]</Button>
                                </li>
                            }
                            </ul>
                        }
                    </CardBody>
                </Card>
                <Card Class="mt-3">
                    <CardHeader>@L["Feature:Assign"]</CardHeader>
                    <CardBody>
                        <Select TValue="Guid?" @bind-Value="assigneeId">
                            <SelectItem TValue="Guid?" Value="null">@L["Chat:SelectContacts"]</SelectItem>
                            @foreach (var contact in contacts) { <SelectItem TValue="Guid?" Value="@contact.Id">@contact.DisplayName</SelectItem> }
                        </Select>
                        <TextInput Class="mt-2" @bind-Value="responsibility" Placeholder="@L["Feature:Responsibility"]" />
                        <Button Color="Color.Primary" Class="mt-2" Clicked="AssignAsync">@L["Feature:Assign"]</Button>
                        <ul class="mt-3">
                            @foreach (var assignment in document.Assignments)
                            {
                                <li>@ContactName(assignment.AssigneeUserId) · @assignment.Responsibility</li>
                            }
                        </ul>
                    </CardBody>
                </Card>
            </div>
            <div class="col-lg-6">
                <Card>
                    <CardHeader>@L["Feature:StartWorkflow"]</CardHeader>
                    <CardBody>
                        <div class="d-flex gap-2 mb-3">
                            <Button Color="Color.Primary" Clicked="SubmitAsync" Disabled="@(document.Status != DocumentStatus.Draft)">@L["Feature:SubmitDocument"]</Button>
                            <AuthorizeView Policy="Documents.Workflow.Start">
                                <Authorized>
                                    <Button Color="Color.Primary" Outline="true" Clicked="OpenSubmitWorkflow">@L["Work:SubmitWorkflow"]</Button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </CardBody>
                </Card>
                <Card Class="mt-3">
                    <CardHeader>@L["Feature:History"]</CardHeader>
                    <CardBody>
                        <ul class="mb-0">
                            @foreach (var item in document.History.OrderByDescending(x => x.OccurredAt))
                            {
                                <li>@item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @item.Action @item.Detail</li>
                            }
                        </ul>
                    </CardBody>
                </Card>
            </div>
        </div>
    }
</section>
<SubmitWorkflowModal @ref="submitModal" OnSubmitted="LoadAsync" />
@code {
    [Parameter] public Guid DocumentId { get; set; }
    private DocumentDto? document;
    private readonly List<ChatContactDto> contacts = [];
    private SubmitWorkflowModal? submitModal;
    private Guid? assigneeId;
    private string responsibility = "reviewer";

    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
                try
        {
            document = await Documents.GetDocumentAsync(DocumentId);
            if (contacts.Count == 0) contacts.AddRange(await Chat.GetContactsAsync(null, 50));
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
    }
    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        try { await Documents.UploadFileAsync(DocumentId, args.File); await NotifySuccessAsync(L["Catalog:Created"]); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task DeleteFileAsync(Guid fileId)
    {
        if (!await UiMessage.Confirm(L["Catalog:DeleteConfirmation"].Value.Replace("{0}", L["Feature:Files"]))) return;
        try { await Documents.DeleteFileAsync(DocumentId, fileId); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private async Task AssignAsync()
    {
        if (assigneeId is not { } userId) return;
        try { document = await Documents.AssignAsync(DocumentId, new AssignDocumentRequest(userId, string.IsNullOrWhiteSpace(responsibility) ? "reviewer" : responsibility.Trim())); await NotifySuccessAsync(L["Catalog:Updated"]); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task SubmitAsync()
    {
        try { document = await Documents.SubmitAsync(DocumentId); await NotifySuccessAsync(L["Feature:SubmitDocument"]); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private Task OpenSubmitWorkflow() => submitModal?.ShowAsync(DocumentId) ?? Task.CompletedTask;
    private string ContactName(Guid id) => contacts.FirstOrDefault(x => x.Id == id)?.DisplayName ?? id.ToString("N")[..8];
}
