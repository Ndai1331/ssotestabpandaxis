@page "/document-detail"
@page "/document-detail/{DocumentId:guid}"
@page "/view-document-detail/{DocumentId:guid}"
@attribute [Authorize]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject OrganizationCatalogClient Catalog
@inject CollaborationClient Chat
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject SystemFeatureState Features
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@implements IAsyncDisposable

<PageTitle>@DocumentTitle · HCS</PageTitle>
<section class="page page-wf page-vb">
    <form class="vb-card" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <header class="vb-chrome">
            <div class="vb-chrome-id">
                <button class="icon-btn" type="button" @onclick="GoBack" aria-label="@L["Feature:BackToList"]">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 18 9 12l6-6"/></svg>
                </button>
                <div class="vb-editor-head">
                    <h1 title="@(IsCreate ? L["Catalog:Create"].Value : DocumentTitle)">@(IsCreate ? L["Catalog:Create"] : DocumentTitle)</h1>
                    <p class="vb-editor-sub">
                        <span>@(string.IsNullOrWhiteSpace(form.Number) ? "—" : form.Number)</span>
                        @if (document is not null)
                        {
                            <span class="badge @DocumentStatusBadge(document.Status)">@L[DocumentStatusUi.TextKey(document.Status)]</span>
                        }
                        else if (IsCreate)
                        {
                            <span class="badge badge-info">@L["Document:Status.Draft"]</span>
                        }
                    </p>
                </div>
            </div>
            <div class="vb-chrome-actions">
                @if (!IsCreate)
                {
                    <div class="vb-flow">
                        <AuthorizeView Policy="Documents.Assign">
                            <Authorized>
                                @if (document is not null && SourceType is 0 or 1)
                                {
                                    <button class="btn btn-ghost" type="button" @onclick="OpenSendAsync" disabled="@isMutating">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg>
                                        @L["Feature:SendDocument"]
                                    </button>
                                    @if (document.IsSent)
                                    {
                                        <button class="btn btn-ghost" type="button" @onclick="RevokeAsync" disabled="@isMutating">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 1 1 0 11H11"/></svg>
                                            @L["Feature:RevokeSend"]
                                        </button>
                                    }
                                }
                            </Authorized>
                        </AuthorizeView>
                        @if (document is not null && SourceType is 0 or 1 && canDeleteDocument)
                        {
                            <button class="btn btn-ghost" type="button" @onclick="DeleteAsync" disabled="@isMutating">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                @L["Catalog:Delete"]
                            </button>
                        }
                        @if (Features.AllowSigningFromDocuments)
                        {
                        <AuthorizeView Policy="Documents.Workflow.Start">
                            <Authorized>
                                <button class="btn btn-ghost" type="button" @onclick="OpenSubmitWorkflow">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/></svg>
                                    @L["Work:SubmitWorkflow"]
                                </button>
                            </Authorized>
                        </AuthorizeView>
                        }
                    </div>
                }
                <div class="vb-foot">
                    <button class="btn btn-outline" type="button" @onclick="GoBack">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                        @L["Catalog:Cancel"]
                    </button>
                    @if (IsCreate && (IsPersonal || canCreateArchive))
                    {
                        <button class="btn btn-primary" type="submit" disabled="@isSaving">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                            @L["Catalog:Create"]
                        </button>
                    }
                    @if (!IsCreate && canUpdateDocument)
                    {
                        <button class="btn btn-primary" type="submit" disabled="@isSaving">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                            @L["Catalog:SaveChanges"]
                        </button>
                    }
                </div>
            </div>
        </header>

        <div class="vb-shell">
            <div class="vb-main">
                <div class="vb-tabs" role="tablist" aria-label="@L["Feature:DocumentTitle"]">
                    <button class="vb-tab @(activeTab == "info" ? "is-active" : null)" type="button" role="tab"
                            aria-selected="@(activeTab == "info")" @onclick='() => activeTab = "info"'>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
                        @L["Work:Info"]
                    </button>
                    @if (!IsCreate)
                    {
                        <button class="vb-tab @(activeTab == "history" ? "is-active" : null)" type="button" role="tab"
                                aria-selected="@(activeTab == "history")" @onclick='() => activeTab = "history"'>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                            @L["Feature:History"]
                            @if (document?.History.Count > 0)
                            {
                                <span class="vb-tab-count">@document.History.Count</span>
                            }
                        </button>
                    }
                </div>

                <div class="vb-pane @(activeTab == "info" ? "is-active" : null)" role="tabpanel" hidden="@(activeTab != "info")">
                    <div class="hcs-catalog-form">
                        <div class="vb-field-row hcs-form-row">
                            <Field>
                                <FieldLabel>@L["Feature:DocumentCode"]</FieldLabel>
                                <HcsIsolatedTextInput @bind-Value="form.DocumentCode" Name="hcsDocumentCode" MaxLength="64"
                                                     CssClass="form-control input" />
                            </Field>
                            <Field>
                                <FieldLabel>@L["Feature:ArchiveNumber"]</FieldLabel>
                                <HcsIsolatedTextInput @bind-Value="form.Number" Name="hcsArchiveNumber" MaxLength="64"
                                                     CssClass="form-control input"
                                                     Placeholder="@L["Feature:ArchiveNumberAuto"]"
                                                     Disabled="true" />
                            </Field>
                        </div>
                        <Field>
                            <FieldLabel>@L["Feature:DocumentTitleField"]</FieldLabel>
                            <HcsIsolatedTextInput @bind-Value="form.Title" Name="hcsDocumentTitle" />
                        </Field>
                        <Field>
                            <FieldLabel>@L["Feature:Description"]</FieldLabel>
                            <textarea class="form-control input" rows="4" @bind="form.Description" autocomplete="off"></textarea>
                        </Field>
                        <Field>
                            <FieldLabel>@L["Feature:IssuingUnit"]</FieldLabel>
                            <CatalogSelect2 Value="form.OrganizationUnitId" ValueChanged="value => form.OrganizationUnitId = value"
                                            Placeholder="@L["Catalog:SearchPlaceholder"]" SelectedText="@UnitText(form.OrganizationUnitId)"
                                            Search="SearchUnitsAsync" />
                        </Field>
                        <div class="vb-field-row hcs-form-row hcs-form-row--equal">
                            <Field>
                                <FieldLabel>@L["Menu:DocumentTypes"]</FieldLabel>
                                <CatalogSelect2 Value="form.DocumentTypeId" ValueChanged="value => form.DocumentTypeId = value"
                                                Placeholder="@L["Catalog:SearchPlaceholder"]" SelectedText="@MasterText(documentTypes, form.DocumentTypeId)"
                                                Search="SearchDocumentTypesAsync" />
                            </Field>
                            <Field>
                                <FieldLabel>@L["Menu:Sectors"]</FieldLabel>
                                <CatalogSelect2 Value="form.SectorId" ValueChanged="value => form.SectorId = value"
                                                Placeholder="@L["Catalog:SearchPlaceholder"]" SelectedText="@MasterText(sectors, form.SectorId)"
                                                Search="SearchSectorsAsync" />
                            </Field>
                        </div>
                        <div class="vb-field-row hcs-form-row hcs-form-row--equal">
                            <Field>
                                <FieldLabel>@L["Menu:UrgencyLevels"]</FieldLabel>
                                <CatalogSelect2 Value="form.UrgencyId" ValueChanged="value => form.UrgencyId = value"
                                                Placeholder="@L["Catalog:SearchPlaceholder"]" SelectedText="@MasterText(urgencies, form.UrgencyId)"
                                                Search="SearchUrgenciesAsync" />
                            </Field>
                            <Field>
                                <FieldLabel>@L["Menu:ConfidentialityLevels"]</FieldLabel>
                                <CatalogSelect2 Value="form.ConfidentialityId" ValueChanged="value => form.ConfidentialityId = value"
                                                Placeholder="@L["Catalog:SearchPlaceholder"]" SelectedText="@MasterText(confidentialities, form.ConfidentialityId)"
                                                Search="SearchConfidentialitiesAsync" />
                            </Field>
                        </div>
                        @if (!IsCreate && document?.Files.Count > 0)
                        {
                            <div class="docs-table-wrap vb-file-list">
                                <div class="docs-table-scroll">
                                <table class="docs-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">@L["Catalog:Name"]</th>
                                            <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var file in document!.Files)
                                    {
                                        <tr @key="file.Id">
                                            <td>@file.FileName <small class="text-muted">(@(file.Size / 1024) KB)</small></td>
                                            <td class="col-actions">
                                                <div class="doc-actions">
                                                    <button class="doc-action" type="button" title="@L["Work:PdfPreview"]" aria-label="@L["Work:PdfPreview"]" @onclick="() => PreviewFileAsync(file)">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                                    </button>
                                                    @if (SourceType is 0 or 1 && CanChangeFiles)
                                                    {
                                                        <button class="doc-action is-danger" type="button" title="@L["Catalog:Delete"]" aria-label="@L["Catalog:Delete"]" @onclick="() => DeleteFileAsync(file.Id)">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (!IsCreate)
                {
                    <div class="vb-pane @(activeTab == "history" ? "is-active" : null)" role="tabpanel" hidden="@(activeTab != "history")">
                        @if (document is null || document.History.Count == 0)
                        {
                            <DocsEmpty Compact="true" />
                        }
                        else
                        {
                            <ol class="vb-timeline">
                                @foreach (var item in document.History.OrderByDescending(x => x.OccurredAt))
                                {
                                    <li class="vb-timeline-item">
                                        <time datetime="@item.OccurredAt.ToString("o")">@item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                                        <strong>@HistoryTitle(item)</strong>
                                        @if (!string.IsNullOrWhiteSpace(HistoryDetailText(item)))
                                        {
                                            <p>@HistoryDetailText(item)</p>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                }
            </div>

            <aside class="vb-aside" aria-label="@L["Feature:Files"]">
                <label class="vb-drop vb-file-chip @(HasChosenFile ? "has-file" : null)">
                    @if (IsCreate && canManageFiles)
                    {
                        <InputFile OnChange="SelectPendingFileAsync" accept=".docx,.pdf" />
                    }
                    else if (CanChangeFiles)
                    {
                        <InputFile OnChange="UploadAsync" accept=".docx,.pdf" />
                    }
                    <span class="vb-file-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/></svg>
                    </span>
                    <span class="vb-file-copy">
                        <strong>@L["Feature:Files"]</strong>
                        <span class="vb-file-chosen">@ChosenFileLabel</span>
                    </span>
                    @if (IsCreate ? canManageFiles : CanChangeFiles)
                    {
                        <span class="vb-file-cta">@L["Work:ChooseFile"]</span>
                    }
                </label>
                <div class="vb-preview" aria-label="@L["Document:PreviewTitle"]">
                    @if (!string.IsNullOrWhiteSpace(pdfUrl))
                    {
                        <HcsPdfFrame Source="@pdfUrl" Title="@L["Work:PdfPreview"]" MatchParent="true" FileName="@PdfDownloadName" />
                    }
                    else if (pendingFile is not null)
                    {
                        <div class="vb-preview-stage vb-preview-file-card">
                            <i class="fa @FileIcon(pendingFile.Name) hcs-file-preview-card__icon" aria-hidden="true"></i>
                            <p><strong>@pendingFile.Name</strong></p>
                            <p>@FormatFileSize(pendingFile.Size) · @pendingFile.ContentType</p>
                            <p>@L["Work:NoPdfAvailable"]</p>
                        </div>
                    }
                    else if (previewFile is not null)
                    {
                        <div class="vb-preview-stage vb-preview-file-card">
                            <i class="fa @FileIcon(previewFile.FileName) hcs-file-preview-card__icon" aria-hidden="true"></i>
                            <p><strong>@previewFile.FileName</strong></p>
                            <p>@FormatFileSize(previewFile.Size) · @previewFile.ContentType</p>
                            <p>@L["Work:NoPdfAvailable"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="vb-preview-stage">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
                            <p><strong>@L["Document:PreviewEmptyTitle"]</strong></p>
                            <p>@L["Document:PreviewEmptyHint"]</p>
                            <p>@L["Document:PreviewSupportedHint"]</p>
                        </div>
                    }
                </div>
            </aside>
        </div>
    </form>
</section>

<SubmitWorkflowModal @ref="submitModal" OnSubmitted="ReloadExistingAsync" />
<SendDocumentModal @ref="sendModal" OnSent="ReloadExistingAsync" />

@code {
    [Parameter] public Guid DocumentId { get; set; }
    [SupplyParameterFromQuery(Name = "sourceType")] public int? SourceTypeQuery { get; set; }
    private DocumentDto? document;
    private readonly DocumentForm form = new();
    private readonly List<MasterDataCatalogDto> documentTypes = [];
    private readonly List<MasterDataCatalogDto> sectors = [];
    private readonly List<MasterDataCatalogDto> urgencies = [];
    private readonly List<MasterDataCatalogDto> confidentialities = [];
    private readonly List<UnitCatalogDto> units = [];
    private readonly List<ChatContactDto> contacts = [];
    private readonly Dictionary<Guid, string> userNames = [];
    private SubmitWorkflowModal? submitModal;
    private SendDocumentModal? sendModal;
    private string? pdfUrl;
    private DocumentFileDto? previewFile;
    private bool isSaving;
    private bool isMutating;
    private bool canCreateArchive;
    private bool canUpdateDocument;
    private bool canDeleteDocument;
    private bool canManageFiles;
    private bool CanChangeFiles => canManageFiles && document?.Status is not (DocumentStatus.Approved or DocumentStatus.Archived);
    private IBrowserFile? pendingFile;
    private DocumentFileDto? pendingPreviewFile;
    private string activeTab = "info";
    private bool IsCreate => DocumentId == Guid.Empty;
    private int SourceType => SourceTypeQuery is >= 0 and <= 2 ? SourceTypeQuery.Value : 0;
    private bool IsPersonal => SourceType == 1;
    // The signing queue uses sourceType=3 as navigation context, not a document source type.
    private string BackHref => SourceTypeQuery == 3
        ? "/document-signing"
        : $"/manage-documents?sourceType={SourceType}";
    private string DocumentTitle => string.IsNullOrWhiteSpace(form.Title) ? L["Feature:DocumentTitle"] : form.Title;
    private string? DescriptionOrNull => string.IsNullOrWhiteSpace(form.Description) ? null : form.Description;
    private bool HasChosenFile => pendingFile is not null || previewFile is not null || document?.Files.Count > 0;
    private string ChosenFileLabel =>
        pendingFile?.Name
        ?? previewFile?.FileName
        ?? document?.Files.LastOrDefault()?.FileName
        ?? L["Work:DropFileHere"];
    private string PdfDownloadName => DocumentDownloadFileName.For(
        form.DocumentCode, form.Number, form.Title, pendingFile?.Name ?? previewFile?.FileName);

    protected override async Task OnParametersSetAsync()
    {
        var featuresTask = Features.EnsureLoadedAsync();
        var authStateTask = AuthenticationStateProvider.GetAuthenticationStateAsync();
        await Task.WhenAll(featuresTask, authStateTask);
        var user = (await authStateTask).User;
        var viewTask = AuthorizationService.AuthorizeAsync(user, null, "Documents.View");
        var createTask = AuthorizationService.AuthorizeAsync(user, null, "Documents.Create");
        var updateTask = AuthorizationService.AuthorizeAsync(user, null, "Documents.Update");
        var deleteTask = AuthorizationService.AuthorizeAsync(user, null, "Documents.Delete");
        var filesTask = AuthorizationService.AuthorizeAsync(user, null, "Documents.ManageFiles");
        await Task.WhenAll(viewTask, createTask, updateTask, deleteTask, filesTask);
        var canBrowseArchive = (await viewTask).Succeeded;
        canCreateArchive = (await createTask).Succeeded;
        canUpdateDocument = (await updateTask).Succeeded || IsPersonal;
        canDeleteDocument = (await deleteTask).Succeeded || IsPersonal;
        canManageFiles = (await filesTask).Succeeded || IsPersonal;
        if (SourceType == 0 && !canBrowseArchive)
        {
            Navigation.NavigateTo("/manage-documents?sourceType=1", replace: true);
            return;
        }
        if (IsCreate && SourceType == 0 && !canCreateArchive)
        {
            Navigation.NavigateTo("/manage-documents?sourceType=1", replace: true);
            return;
        }
        if (!IsCreate && SourceType == 2)
        {
            Navigation.NavigateTo($"/manage-documents?sourceType=2&preview={DocumentId:D}", replace: true);
            return;
        }
        await LoadLookupsAsync();
        if (IsCreate)
        {
            document = null;
            form.Reset();
            pendingFile = null;
            previewFile = null;
            pendingPreviewFile = null;
            activeTab = "info";
            ApplyCreateDefaults();
            await RevokePdfAsync();
            return;
        }
        await ReloadExistingAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingPreviewFile is null)
            return;
        var file = pendingPreviewFile;
        pendingPreviewFile = null;
        await LoadPreviewAsync(file);
        StateHasChanged();
    }

    private async Task LoadLookupsAsync()
    {
        var query = new OrganizationCatalogQuery(null, true, 0, 100);
        async Task<IReadOnlyList<MasterDataCatalogDto>> LoadMasterAsync(string type)
        {
            try { return (await Catalog.GetMasterDataAsync(type, query)).Items; }
            catch { return []; }
        }

        async Task<IReadOnlyList<UnitCatalogDto>> LoadUnitsAsync()
        {
            try { return await Catalog.GetUnitLookupAsync(); }
            catch { return []; }
        }

        async Task<IReadOnlyList<ChatContactDto>> LoadContactsAsync()
        {
            try { return await Chat.GetContactsAsync(null, 50); }
            catch { return []; }
        }

        var typesTask = documentTypes.Count == 0 ? LoadMasterAsync("DocumentType") : Task.FromResult<IReadOnlyList<MasterDataCatalogDto>>([]);
        var sectorsTask = sectors.Count == 0 ? LoadMasterAsync("Sector") : Task.FromResult<IReadOnlyList<MasterDataCatalogDto>>([]);
        var urgenciesTask = urgencies.Count == 0 ? LoadMasterAsync("UrgencyLevel") : Task.FromResult<IReadOnlyList<MasterDataCatalogDto>>([]);
        var confidentialitiesTask = confidentialities.Count == 0 ? LoadMasterAsync("ConfidentialityLevel") : Task.FromResult<IReadOnlyList<MasterDataCatalogDto>>([]);
        var unitsTask = units.Count == 0 ? LoadUnitsAsync() : Task.FromResult<IReadOnlyList<UnitCatalogDto>>([]);
        var contactsTask = contacts.Count == 0 ? LoadContactsAsync() : Task.FromResult<IReadOnlyList<ChatContactDto>>([]);
        await Task.WhenAll(typesTask, sectorsTask, urgenciesTask, confidentialitiesTask, unitsTask, contactsTask);
        documentTypes.AddRange(await typesTask);
        sectors.AddRange(await sectorsTask);
        urgencies.AddRange(await urgenciesTask);
        confidentialities.AddRange(await confidentialitiesTask);
        units.AddRange(await unitsTask);
        contacts.AddRange(await contactsTask);
        ApplyCreateDefaults();
    }

    private async Task ReloadExistingAsync()
    {
        try
        {
            document = await Documents.GetDocumentAsync(DocumentId);
            userNames.Clear();
            form.Number = document.Number;
            form.DocumentCode = document.DocumentCode ?? "";
            form.Title = document.Title;
            form.Description = document.Description ?? "";
            form.DocumentTypeId = document.DocumentTypeId;
            form.SectorId = document.SectorId;
            form.UrgencyId = document.UrgencyId;
            form.ConfidentialityId = document.ConfidentialityId;
            form.OrganizationUnitId = document.OrganizationUnitId;
            await LoadHistoryNamesAsync();
            if (activeTab == "assign")
                activeTab = "info";
            pendingPreviewFile = DocumentFilePick.PreferPdf(document.Files) ?? document.Files.LastOrDefault();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        try
        {
            if (IsCreate)
            {
                if (!IsPersonal && !canCreateArchive)
                {
                    await NotifyErrorAsync(L["Users:Forbidden"]);
                    return;
                }
                if (pendingFile is null)
                {
                    await NotifyErrorAsync(L["Feature:FileRequired"]);
                    return;
                }

                var created = await Documents.CreateDocumentAsync(new CreateDocumentRequest(
                    string.IsNullOrWhiteSpace(form.Number) ? null : form.Number.Trim(), form.Title.Trim(), DescriptionOrNull,
                    form.DocumentTypeId, form.SectorId, form.UrgencyId, form.ConfidentialityId,
                    SourceType == 1 ? DocumentSourceType.Personal : DocumentSourceType.Archive,
                    string.IsNullOrWhiteSpace(form.DocumentCode) ? null : form.DocumentCode.Trim(),
                    form.OrganizationUnitId));
                try
                {
                    await Documents.UploadFileAsync(created.Id, pendingFile);
                }
                catch (Exception ex)
                {
                    await NotifyErrorAsync(ex, BffErrorKind.Save);
                    Navigation.NavigateTo($"/document-detail/{created.Id}?sourceType={SourceType}", replace: true);
                    return;
                }
                await NotifySuccessAsync(L["Catalog:Created"]);
                Navigation.NavigateTo(BackHref);
                return;
            }
            if (!canUpdateDocument)
            {
                await NotifyErrorAsync(L["Users:Forbidden"]);
                return;
            }
            document = await Documents.UpdateDocumentAsync(DocumentId, new UpdateDocumentRequest(
                form.Title.Trim(), DescriptionOrNull,
                form.DocumentTypeId, form.SectorId, form.UrgencyId, form.ConfidentialityId,
                string.IsNullOrWhiteSpace(form.DocumentCode) ? null : form.DocumentCode.Trim(),
                form.OrganizationUnitId));
            await NotifySuccessAsync(L["Catalog:Updated"]);
            Navigation.NavigateTo(BackHref);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSaving = false; }
    }

    private async Task SelectPendingFileAsync(InputFileChangeEventArgs args)
    {
        if (!canManageFiles) return;
        pendingFile = args.File;
        previewFile = null;
        await RevokePdfAsync();
        if (!IsPdfFile(pendingFile.Name, pendingFile.ContentType)) return;

        try
        {
            await using var stream = pendingFile.OpenReadStream(50 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            pdfUrl = await Js.InvokeAsync<string>("hcsCreateObjectUrl", "application/pdf", buffer.ToArray());
        }
        catch
        {
            pdfUrl = null;
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        if (!CanChangeFiles) return;
        try
        {
            await Documents.UploadFileAsync(DocumentId, args.File);
            await NotifySuccessAsync(L["Catalog:Updated"]);
            await ReloadExistingAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }

    private async Task DeleteFileAsync(Guid fileId)
    {
        if (!CanChangeFiles) return;
        if (!await UiMessage.Confirm(L["Catalog:DeleteConfirmation"].Value.Replace("{0}", L["Feature:Files"]))) return;
        try { await Documents.DeleteFileAsync(DocumentId, fileId); await ReloadExistingAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }

    private Task PreviewFileAsync(DocumentFileDto file)
    {
        if (document is null) return Task.CompletedTask;
        var pdf = DocumentFilePick.IsPdf(file) ? file : DocumentFilePick.PreferPdf(document.Files);
        return LoadPreviewAsync(pdf);
    }

    private async Task LoadPreviewAsync(DocumentFileDto? file)
    {
        await RevokePdfAsync();
        previewFile = file;
        if (file is null || !DocumentFilePick.IsPdf(file)) return;
        try
        {
            var content = await Documents.GetWatermarkedFileContentAsync(DocumentId, file.Id);
            pdfUrl = await Js.InvokeAsync<string>("hcsCreateObjectUrl", "application/pdf", content.Bytes);
        }
        catch { pdfUrl = null; }
    }

    private string AssignmentRoleText(string responsibility) =>
        string.Equals(responsibility, "VIEW", StringComparison.OrdinalIgnoreCase) ? L["Work:StepType.VIEW"]
        : string.Equals(responsibility, "reviewer", StringComparison.OrdinalIgnoreCase) ? L["Feature:Responsibility.Reviewer"]
        : responsibility;

    private Task OpenSendAsync() =>
        document is null ? Task.CompletedTask : sendModal?.ShowAsync(document.Id, form.Title, form.Number) ?? Task.CompletedTask;

    private Task OpenSubmitWorkflow() => submitModal?.ShowAsync(DocumentId) ?? Task.CompletedTask;
    private void GoBack() => Navigation.NavigateTo(BackHref);

    private async Task RevokeAsync()
    {
        if (document is null || isMutating) return;
        if (!await UiMessage.Confirm(string.Format(L["Feature:RevokeSendConfirm"], form.Title))) return;
        isMutating = true;
        try
        {
            await Documents.RevokeDocumentAsync(document.Id);
            await NotifySuccessAsync(L["Feature:RevokeSendDone"]);
            await ReloadExistingAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isMutating = false; }
    }

    private async Task DeleteAsync()
    {
        if (!canDeleteDocument) return;
        if (document is null || isMutating) return;
        if (!await UiMessage.Confirm(string.Format(L["Feature:DeleteDocumentConfirm"], form.Title))) return;
        isMutating = true;
        try
        {
            await Documents.DeleteDocumentAsync(document.Id);
            await NotifySuccessAsync(L["Feature:DeleteDocumentDone"]);
            Navigation.NavigateTo(BackHref);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isMutating = false; }
    }

    private async Task LoadHistoryNamesAsync()
    {
        if (document is null) return;
        var ids = document.History
            .SelectMany(HistoryUserIds)
            .Concat(document.Assignments.Select(x => x.AssigneeUserId))
            .Where(id => id != Guid.Empty)
            .Distinct()
            .ToList();
        if (ids.Count == 0) return;
        try
        {
            var users = await Documents.GetWorkflowUserLookupAsync(ids);
            foreach (var user in users)
            {
                var name = UserDisplayNames.FirstReal(user.DisplayName, user.UserName);
                if (!string.IsNullOrWhiteSpace(name)) userNames[user.UserId] = name;
            }
        }
        catch { /* lookup is best-effort for display names */ }
        foreach (var contact in contacts)
        {
            var name = UserDisplayNames.FirstReal(contact.DisplayName, contact.UserName);
            if (!string.IsNullOrWhiteSpace(name) && !userNames.ContainsKey(contact.Id))
                userNames[contact.Id] = name;
        }
    }

    private static IEnumerable<Guid> HistoryUserIds(DocumentHistoryDto item)
    {
        if (item.ActorUserId is { } actor) yield return actor;
        if (TryHistoryTargetId(item, out var target)) yield return target;
    }

    private static bool TryHistoryTargetId(DocumentHistoryDto item, out Guid id)
    {
        id = Guid.Empty;
        if (string.Equals(item.Action, "DuplicatedForWorkflow", StringComparison.OrdinalIgnoreCase))
            return false;
        if (string.IsNullOrWhiteSpace(item.Detail)) return false;
        var raw = item.Detail;
        var colon = raw.IndexOf(':');
        var token = colon > 0 ? raw[..colon] : raw;
        return Guid.TryParse(token, out id);
    }

    private string HistoryTitle(DocumentHistoryDto item)
    {
        var action = HistoryActionText(item.Action);
        var actor = PersonName(item.ActorUserId);
        return string.IsNullOrWhiteSpace(actor) ? action : $"{action} · {actor}";
    }

    private string HistoryActionText(string action)
    {
        var key = $"Document:History.{action}";
        var text = L[key];
        return text.Value == key ? action : text.Value;
    }

    private string HistoryDetailText(DocumentHistoryDto item)
    {
        if (string.Equals(item.Action, "Assigned", StringComparison.OrdinalIgnoreCase)
            && TryHistoryTargetId(item, out var assigneeId))
        {
            var name = PersonName(assigneeId);
            var colon = item.Detail!.IndexOf(':');
            var role = colon > 0 ? AssignmentRoleText(item.Detail[(colon + 1)..]) : "";
            if (string.IsNullOrWhiteSpace(name)) return role;
            return string.IsNullOrWhiteSpace(role) ? name : $"{name} · {role}";
        }

        if (string.Equals(item.Action, "Sent", StringComparison.OrdinalIgnoreCase)
            && TryHistoryTargetId(item, out var receiverId))
            return PersonName(receiverId);

        if (string.Equals(item.Action, "DuplicatedForWorkflow", StringComparison.OrdinalIgnoreCase))
            return "";

        if (string.IsNullOrWhiteSpace(item.Detail)) return "";
        return Guid.TryParse(item.Detail, out var maybeId) ? PersonName(maybeId) : item.Detail;
    }

    private string PersonName(Guid? id)
    {
        if (id is not { } userId) return "";
        if (userNames.TryGetValue(userId, out var name) && !string.IsNullOrWhiteSpace(name)) return name;
        var contact = contacts.FirstOrDefault(x => x.Id == userId);
        if (contact is not null)
        {
            var fromContact = UserDisplayNames.FirstReal(contact.DisplayName, contact.UserName);
            if (!string.IsNullOrWhiteSpace(fromContact)) return fromContact;
        }
        return UnitText(userId);
    }

    private static string MasterText(IEnumerable<MasterDataCatalogDto> items, Guid? id) =>
        CatalogSelect2Cache.TextFor(items, id, x => x.Id, x => CatalogSelect2Text.CodeName(x.Code, x.Name));
    private string UnitText(Guid? id) =>
        CatalogSelect2Cache.TextFor(units, id, x => x.Id, x => CatalogSelect2Text.CodeName(x.Code, x.Name));
    private static bool IsPdfFile(string fileName, string? contentType) =>
        contentType?.Contains("pdf", StringComparison.OrdinalIgnoreCase) == true
        || fileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
    private static string FormatFileSize(long size) => size < 1024 * 1024
        ? $"{Math.Max(1, size / 1024)} KB"
        : $"{size / (1024d * 1024d):0.##} MB";
    private static string FileIcon(string fileName) =>
        fileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ? "fa-file-pdf" : "fa-file-word";
    private static string DocumentStatusBadge(DocumentStatus status) => status switch
    {
        DocumentStatus.Approved => "badge-success",
        DocumentStatus.Rejected => "badge-danger",
        DocumentStatus.InReview or DocumentStatus.Submitted => "badge-warning",
        DocumentStatus.Archived => "badge-muted",
        _ => "badge-info"
    };
    private async Task<CatalogSelect2SearchResponse> SearchMasterAsync(string type, List<MasterDataCatalogDto> cache, string term, int page)
    {
        var skip = Math.Max(page - 1, 0) * 20;
        var result = await Catalog.SearchMasterDataAsync(type, term, skip, 20);
        return CatalogSelect2Cache.Merge(cache, result.Items, x => x.Id,
            x => CatalogSelect2Text.CodeName(x.Code, x.Name), more: skip + result.Items.Count < result.TotalCount);
    }
    private Task<CatalogSelect2SearchResponse> SearchDocumentTypesAsync(string term, int page) => SearchMasterAsync("DocumentType", documentTypes, term, page);
    private Task<CatalogSelect2SearchResponse> SearchSectorsAsync(string term, int page) => SearchMasterAsync("Sector", sectors, term, page);
    private Task<CatalogSelect2SearchResponse> SearchUrgenciesAsync(string term, int page) => SearchMasterAsync("UrgencyLevel", urgencies, term, page);
    private Task<CatalogSelect2SearchResponse> SearchConfidentialitiesAsync(string term, int page) => SearchMasterAsync("ConfidentialityLevel", confidentialities, term, page);
    private async Task<CatalogSelect2SearchResponse> SearchUnitsAsync(string term, int page)
    {
        var skip = Math.Max(page - 1, 0) * 20;
        var result = await Catalog.SearchUnitsAsync(term, skip, 20);
        return CatalogSelect2Cache.Merge(units, result.Items, x => x.Id,
            x => CatalogSelect2Text.CodeName(x.Code, x.Name), more: skip + result.Items.Count < result.TotalCount);
    }

    private void ApplyCreateDefaults()
    {
        if (!IsCreate) return;
        form.DocumentTypeId ??= LowestId(documentTypes);
        form.SectorId ??= LowestId(sectors);
        form.UrgencyId ??= LowestId(urgencies);
        form.ConfidentialityId ??= LowestId(confidentialities);
        form.OrganizationUnitId ??= units.Where(x => x.IsActive).OrderBy(x => x.SortOrder).ThenBy(x => x.Name)
            .Select(x => (Guid?)x.Id).FirstOrDefault();
        if (string.IsNullOrWhiteSpace(form.Number))
            form.Number = DateTime.Now.ToString("yyyyMMdd-HHmmss");
    }

    private static Guid? LowestId(IEnumerable<MasterDataCatalogDto> items) =>
        items.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).Select(x => (Guid?)x.Id).FirstOrDefault();

    private async Task RevokePdfAsync()
    {
        var previous = pdfUrl;
        pdfUrl = null;
        if (string.IsNullOrWhiteSpace(previous)) return;
        try { await Js.InvokeVoidAsync("hcsRevokeObjectUrl", previous); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await RevokePdfAsync(); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    private sealed class DocumentForm
    {
        public string Number { get; set; } = "";
        public string DocumentCode { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public Guid? DocumentTypeId { get; set; }
        public Guid? SectorId { get; set; }
        public Guid? UrgencyId { get; set; }
        public Guid? ConfidentialityId { get; set; }
        public Guid? OrganizationUnitId { get; set; }
        public void Reset()
        {
            Number = DocumentCode = Title = Description = "";
            DocumentTypeId = SectorId = UrgencyId = ConfidentialityId = OrganizationUnitId = null;
        }
    }
}
