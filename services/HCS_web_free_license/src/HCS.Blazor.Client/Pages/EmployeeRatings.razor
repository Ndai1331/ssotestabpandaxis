@page "/employee-ratings"
@attribute [Authorize(Policy = "WorkManagement.EmployeeRatings")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject EmployeeRatingDirectoryService Directory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@L["Feature:EmployeeRatings"] · HCS</PageTitle>

<section class="hcs-rating-page" aria-labelledby="employee-ratings-title">
    <header class="hcs-rating-page__header">
        <div>
            <p class="hcs-rating-page__kicker">@L["Menu:Social"]</p>
            <h1 id="employee-ratings-title">@L["Feature:EmployeeRatings"]</h1>
            <p class="hcs-rating-page__lede">@L["EmployeeRatings:Subtitle"]</p>
        </div>
    </header>

    <div class="hcs-rating-filters" role="search">
        <label class="visually-hidden" for="employee-rating-search">@L["EmployeeRatings:Search"]</label>
        <div class="hcs-rating-filters__search">
            <i class="fa fa-search" aria-hidden="true"></i>
            <input id="employee-rating-search" class="form-control" type="search"
                   placeholder="@L["EmployeeRatings:SearchPlaceholder"]" value="@searchText"
                   @oninput="OnSearchInput" />
        </div>
        <div class="hcs-rating-filters__department" role="group" aria-label="@L["EmployeeRatings:Department"]">
            <CatalogSelect2 Value="selectedDepartmentId"
                            ValueChanged="OnDepartmentChanged"
                            Placeholder="@L["EmployeeRatings:AllDepartments"]"
                            SelectedText="@DepartmentText"
                            Search="SearchDepartmentsAsync" />
        </div>
    </div>

    @if (!isLoading && !hasError)
    {
        <div class="hcs-rating-stats" aria-live="polite">
            <div class="hcs-rating-stat">
                <strong>@totalCount</strong>
                <span>@L["EmployeeRatings:ColleagueCount"]</span>
            </div>
            <div class="hcs-rating-stat">
                <strong>@PendingTodayCount</strong>
                <span>@L["EmployeeRatings:PendingToday"]</span>
            </div>
            <div class="hcs-rating-stat hcs-rating-stat--hint">
                <i class="fa fa-clock" aria-hidden="true"></i>
                <span>@L["EmployeeRatings:OnePerDay"]</span>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <HcsLoading CssClass="py-5" />
    }
    else if (hasError)
    {
        <div class="hcs-empty py-5" role="alert"><i class="fa fa-circle-exclamation" aria-hidden="true"></i><h2>@L["EmployeeRatings:LoadErrorTitle"]</h2><p>@L["EmployeeRatings:LoadError"]</p><button class="btn btn-primary" type="button" @onclick="LoadAsync">@L["Catalog:Retry"]</button></div>
    }
    else if (people.Count == 0)
    {
        <DocsEmpty Title="@L["EmployeeRatings:EmptyTitle"]" Hint="@L["EmployeeRatings:Empty"]">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 11a4 4 0 1 0-8 0"/><path d="M4 20a8 8 0 0 1 16 0"/></svg>
        </DocsEmpty>
    }
    else
    {
        <div class="hcs-rating-grid">
            @foreach (var person in people)
            {
                var ratedToday = person.Summary.MyTodayScore.HasValue;
                var interactiveScore = person.HoverScore ?? person.Summary.MyTodayScore ?? 0;
                var averageStars = person.Summary.ReviewCount <= 0
                    ? 0
                    : (int)Math.Round(person.Summary.AverageScore, MidpointRounding.AwayFromZero);
                <article class="hcs-rating-card @(ratedToday ? "is-rated" : null)">
                    <div class="hcs-rating-card__identity">
                        @if (!string.IsNullOrWhiteSpace(person.User.AvatarUrl) && !person.AvatarFailed)
                        {
                            <img class="hcs-rating-avatar" src="@person.User.AvatarUrl" alt="" @onerror="() => OnAvatarError(person)" />
                        }
                        else
                        {
                            <span class="hcs-rating-avatar hcs-rating-avatar--fallback" aria-hidden="true">@person.Initials</span>
                        }
                        <div class="hcs-rating-card__who min-w-0">
                            <h2>@person.User.DisplayName</h2>
                            @if (person.HasDepartment)
                            {
                                <span class="hcs-rating-chip">@person.DepartmentName</span>
                            }
                        </div>
                        <div class="hcs-rating-card__scorebox" aria-label="@ScoreSummary(person)">
                            @if (person.Summary.ReviewCount == 0)
                            {
                                <span class="hcs-rating-card__noscore">@L["EmployeeRatings:NoScore"]</span>
                            }
                            else
                            {
                                <div class="hcs-rating-meter" aria-hidden="true">
                                    @foreach (var score in Enumerable.Range(1, 5))
                                    {
                                        <i class="@(score <= averageStars ? "fa-solid" : "fa-regular") fa-star"></i>
                                    }
                                </div>
                                <strong>@person.Summary.AverageScore.ToString("0.0")</strong>
                                <span>@person.Summary.ReviewCount @L["EmployeeRatings:Reviews"]</span>
                            }
                        </div>
                    </div>
                    <div class="hcs-rating-card__action">
                        <div class="hcs-rating-card__action-head">
                            <span class="hcs-rating-card__action-label">@(ratedToday ? L["EmployeeRatings:YourScore"] : L["EmployeeRatings:RatePrompt"])</span>
                            @if (ratedToday)
                            {
                                <span class="hcs-rating-card__locked"><i class="fa fa-check-circle" aria-hidden="true"></i>@L["EmployeeRatings:RatedToday"]</span>
                            }
                        </div>
                        <div class="hcs-rating-stars" role="group" aria-label="@L["EmployeeRatings:RatePrompt"]" @onmouseleave="() => ClearHover(person)">
                            @foreach (var score in Enumerable.Range(1, 5))
                            {
                                var starScore = score;
                                var active = interactiveScore >= starScore;
                                <button type="button" class="hcs-rating-star @(active ? "is-active" : null)"
                                        aria-label="@($"{L["EmployeeRatings:Rate"]} {starScore}/5")"
                                        title="@($"{starScore}/5")"
                                        disabled="@(person.IsSubmitting || ratedToday)"
                                        @onmouseenter="() => SetHover(person, starScore)"
                                        @onfocus="() => SetHover(person, starScore)"
                                        @onclick="() => RateAsync(person, starScore)">
                                    <i class="@(active ? "fa-solid" : "fa-regular") fa-star" aria-hidden="true"></i>
                                </button>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
        <HcsPager TotalCount="totalCount" PageSize="pageSize" PageSizeId="employee-ratings-page-size"
                  CanPrev="CanPrev" CanNext="CanNext" Disabled="@isLoading"
                  FirstClicked="GoFirst" PrevClicked="GoPrev" NextClicked="GoNext" LastClicked="GoLast"
                  PageSizeChanged="OnPageSizeChanged" />
    }
</section>

@code {
    private readonly List<EmployeeRatingPerson> people = [];
    private readonly List<DepartmentCatalogDto> departments = [];
    private string searchText = string.Empty;
    private Guid? selectedDepartmentId;
    private bool isLoading = true;
    private bool hasError;
    private Guid currentUserId;
    private long totalCount;
    private int pageSize = 20;
    private int currentPage = 1;
    private CancellationTokenSource? searchCts;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)Math.Max(pageSize, 1)));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < PageCount;
    private Guid? SelectedUnitId => selectedDepartmentId;
    private string DepartmentText => departments.FirstOrDefault(x => x.Id == selectedDepartmentId)?.Name ?? "";
    private int PendingTodayCount => people.Count(person => !person.Summary.MyTodayScore.HasValue);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            departments.AddRange((await Directory.GetDepartmentsAsync())
                .Where(department => department.IsActive)
                .ToList());
        }
        catch (Exception exception)
        {
            await NotifyErrorAsync(exception);
        }

        await LoadAsync();
    }

    private string ScoreSummary(EmployeeRatingPerson person) =>
        person.Summary.ReviewCount == 0
            ? L["EmployeeRatings:NoScore"]
            : $"{L["EmployeeRatings:Average"]}: {person.Summary.AverageScore:0.0}/5, {person.Summary.ReviewCount} {L["EmployeeRatings:Reviews"]}";

    private async Task LoadAsync()
    {
        isLoading = true;
        hasError = false;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _ = Guid.TryParse(state.User.FindFirst("sub")?.Value
                ?? state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out currentUserId);
            var skip = (Math.Max(1, currentPage) - 1) * pageSize;
            var page = await Directory.GetPeoplePageAsync(
                searchText, skip, pageSize, currentUserId, SelectedUnitId);
            await ApplySummariesAsync(page.People);
            people.Clear();
            people.AddRange(page.People);
            totalCount = page.TotalCount;
            currentPage = Math.Clamp(currentPage, 1, PageCount);
        }
        catch (Exception exception)
        {
            hasError = true;
            await NotifyErrorAsync(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RateAsync(EmployeeRatingPerson person, int score)
    {
        if (person.IsSubmitting || person.Summary.MyTodayScore.HasValue) return;
        person.IsSubmitting = true;
        person.HoverScore = score;
        try
        {
            await Work.SubmitEmployeeRatingAsync(new SubmitEmployeeRatingRequest(person.User.UserId, score));
            person.Summary = person.Summary with
            {
                MyTodayScore = score,
                ReviewCount = person.Summary.ReviewCount + 1,
                AverageScore = person.Summary.ReviewCount <= 0
                    ? score
                    : Math.Round(((person.Summary.AverageScore * person.Summary.ReviewCount) + score)
                        / (person.Summary.ReviewCount + 1), 1, MidpointRounding.AwayFromZero)
            };
            await NotifySuccessAsync(L["EmployeeRatings:SaveSuccess"]);
            await RefreshSummariesAsync();
        }
        catch (Exception exception)
        {
            if (exception is HCS.Blazor.Client.Services.BffApiException { StatusCode: System.Net.HttpStatusCode.Conflict })
                await NotifyErrorAsync(L["EmployeeRatings:AlreadyRatedToday"]);
            else
                await NotifyErrorAsync(exception, BffErrorKind.Save);
        }
        finally
        {
            person.IsSubmitting = false;
            person.HoverScore = null;
        }
    }

    private async Task RefreshSummariesAsync() => await ApplySummariesAsync(people);

    private async Task ApplySummariesAsync(IReadOnlyList<EmployeeRatingPerson> pagePeople)
    {
        var ids = pagePeople.Select(person => person.User.UserId).ToArray();
        if (ids.Length == 0)
            return;

        var summaries = await Work.GetEmployeeRatingSummariesAsync(0, ids.Length, userIds: ids);
        var map = summaries.Items.ToDictionary(item => item.TargetUserId);
        foreach (var person in pagePeople)
            person.Summary = map.TryGetValue(person.User.UserId, out var summary)
                ? summary
                : EmployeeRatingPerson.EmptySummary(person.User.UserId);
    }

    private Task OnSearchInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        return QueueSearchAsync();
    }

    private async Task QueueSearchAsync()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        var cts = new CancellationTokenSource();
        searchCts = cts;
        try
        {
            await Task.Delay(300, cts.Token);
            currentPage = 1;
            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task<CatalogSelect2SearchResponse> SearchDepartmentsAsync(string term, int page)
    {
        var found = OrganizationUnitCatalogMapper.FilterTree(departments, term);
        return Task.FromResult(CatalogSelect2Cache.Merge(departments, found, x => x.Id,
            OrganizationUnitCatalogMapper.OptionText(departments), false));
    }

    private Task OnDepartmentChanged(Guid? value)
    {
        selectedDepartmentId = value;
        currentPage = 1;
        return LoadAsync();
    }

    private Task GoFirst() { currentPage = 1; return LoadAsync(); }
    private Task GoPrev() { if (!CanPrev) return Task.CompletedTask; currentPage--; return LoadAsync(); }
    private Task GoNext() { if (!CanNext) return Task.CompletedTask; currentPage++; return LoadAsync(); }
    private Task GoLast() { currentPage = PageCount; return LoadAsync(); }
    private Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return Task.CompletedTask;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        return LoadAsync();
    }

    private static void SetHover(EmployeeRatingPerson person, int score)
    {
        if (person.Summary.MyTodayScore.HasValue) return;
        person.HoverScore = score;
    }

    private static void ClearHover(EmployeeRatingPerson person)
    {
        if (person.Summary.MyTodayScore.HasValue) return;
        person.HoverScore = null;
    }

    private static void OnAvatarError(EmployeeRatingPerson person) => person.AvatarFailed = true;
}
