@page "/reports"
@attribute [Authorize(Policy = "WorkManagement.Reports")]
@using System.Net.Http.Json
@inherits HCSComponentBase
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Báo cáo · HCS</PageTitle>
<section class="page page-wf" aria-labelledby="reports-title">
    <div class="page-head">
        <div>
            <h1 id="reports-title">Báo cáo vận hành</h1>
            <p class="event-panel-kicker">Tổng hợp số liệu đã được materialize từ Dự án, Công việc, Lịch và Khảo sát.</p>
        </div>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="LoadAsync" disabled="@loading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                @(loading ? "Đang tải…" : "Làm mới")
            </button>
        </div>
    </div>
    <div class="docs-table-wrap">
        @if (loading)
        {
            <DocsEmpty Loading="true" Title="Đang tải báo cáo…" />
        }
        else if (rows.Count == 0)
        {
            <DocsEmpty Title="Chưa có số liệu" Hint="Dữ liệu báo cáo sẽ xuất hiện khi nghiệp vụ phát sinh và read-model được làm mới." />
        }
        else
        {
            <table class="docs-table">
                <thead>
                    <tr>
                        <th scope="col">Nhóm</th>
                        <th scope="col">Chỉ tiêu</th>
                        <th scope="col">Giá trị</th>
                        <th scope="col">Cập nhật</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td>@row.Dimension</td>
                            <td><strong>@row.Label</strong><br /><small>@row.Key</small></td>
                            <td>@row.Value</td>
                            <td>@row.RefreshedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>
@code {private readonly List<ReportRow> rows=[];private bool loading;protected override Task OnInitializedAsync()=>LoadAsync();private async Task LoadAsync(){loading=true;try{using var c=HttpClientFactory.CreateClient("HCS.Bff");rows.Clear();rows.AddRange(await c.GetFromJsonAsync<List<ReportRow>>("/api/reports")??[]);}catch{await NotifyErrorAsync("Không thể tải báo cáo. Hãy kiểm tra quyền truy cập.");}finally{loading=false;}}private sealed record ReportRow(string Dimension,string Key,string Label,decimal Value,DateTime RefreshedAt);}
