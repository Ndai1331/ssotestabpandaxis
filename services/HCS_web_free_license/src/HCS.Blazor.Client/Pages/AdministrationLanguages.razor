@page "/administration/languages"
@attribute [Authorize(Roles = "admin")]
@using System.Globalization
@using HCS.Permissions
@using Microsoft.AspNetCore.Authorization
@inherits HCSComponentBase
@inject LanguageManagementClient LanguageClient
@inject LanguageCatalogState LanguageState
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>@L["Languages:Title"] · HCS</PageTitle>

<AuthorizeView Roles="admin">
    <Authorized>
        <main class="hcs-admin-page hcs-language-page" aria-labelledby="languages-title" @onclick="CloseActionMenu">
            <header class="hcs-admin-heading hcs-language-heading">
                <div>
                    <p class="hcs-page-eyebrow">@L["Languages:Eyebrow"]</p>
                    <h1 id="languages-title">@L["Languages:Title"]</h1>
                    <p>@L["Languages:Description"]</p>
                </div>
                <div class="hcs-language-heading__actions">
                    @if (canCreate)
                    {
                        <Button Color="Color.Primary" Clicked="OpenCreateModalAsync" Disabled="@isSaving">
                            <i class="fa fa-plus me-1" aria-hidden="true"></i> @L["Languages:Create"]
                        </Button>
                    }
                    <Button Color="Color.Light" Outline="true" Clicked="RefreshAsync" Disabled="@isLoading">
                        <i class="fa fa-rotate me-1" aria-hidden="true"></i> @L["Languages:Refresh"]
                    </Button>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="hcs-admin-alert" role="alert">
                    <span>@errorMessage</span>
                    <Button Color="Color.Light" Size="Size.Small" Clicked="RefreshAsync" Disabled="@isLoading">
                        @L["Languages:Retry"]
                    </Button>
                </div>
            }

            <Card Class="hcs-language-filter-card">
                <CardBody>
                    <div class="hcs-language-filter-row">
                        <Field Class="hcs-language-filter-field">
                            <FieldLabel>@L["Languages:Search"]</FieldLabel>
                            <TextInput @bind-Value="filterText" Placeholder='@L["Languages:SearchPlaceholder"].Value' />
                        </Field>
                        <Field Class="hcs-language-filter-field hcs-language-status-field">
                            <FieldLabel>@L["Languages:Status"]</FieldLabel>
                            <Select TValue="string" @bind-Value="statusFilter">
                                <SelectItem Value="@string.Empty">@L["Languages:AllStatuses"]</SelectItem>
                                <SelectItem Value="true">@L["Languages:Enabled"]</SelectItem>
                                <SelectItem Value="false">@L["Languages:Disabled"]</SelectItem>
                            </Select>
                        </Field>
                        <div class="hcs-language-filter-actions">
                            <Button Color="Color.Primary" Clicked="SearchAsync" Disabled="@isLoading">
                                <i class="fa fa-search me-1" aria-hidden="true"></i> @L["Languages:SearchButton"]
                            </Button>
                            <Button Color="Color.Light" Outline="true" Clicked="ResetSearchAsync" Disabled="@isLoading">
                                <i class="fa fa-rotate-left me-1" aria-hidden="true"></i> @L["Languages:Reset"]
                            </Button>
                        </div>
                    </div>
                </CardBody>
            </Card>

            <Card Class="hcs-language-grid-card">
                <CardBody>
                    <DataGrid TItem="LanguageDto" @ref="dataGrid" Data="@rows" ReadData="OnDataGridReadAsync"
                              TotalItems="@totalCount" ShowPager="true" ShowPageSizes="true" PageSizes="@pageSizes"
                              PageSize="@pageSize" Responsive="true" Striped="true" Hoverable="true" Class="hcs-language-grid">
                        <EmptyTemplate>
                            <DocsEmpty Title="@L["Languages:EmptyTitle"]" Hint="@L["Languages:EmptyDescription"]" />
                        </EmptyTemplate>
                        <LoadingTemplate>
                            <div class="hcs-loading py-5" role="status" aria-live="polite">
                                <i class="fa fa-spinner fa-spin" aria-hidden="true"></i>
                                <span>@L["Languages:Loading"]</span>
                            </div>
                        </LoadingTemplate>
                        <DataGridColumns>
                            <DataGridColumn TItem="LanguageDto" Field="DisplayName" Caption='@L["Languages:DisplayName"].Value' />
                            <DataGridColumn TItem="LanguageDto" Field="CultureName" Caption='@L["Languages:CultureName"].Value' />
                            <DataGridColumn TItem="LanguageDto" Caption='@L["Languages:Status"].Value'>
                                <DisplayTemplate Context="cell">
                                    <span class="hcs-language-status @(cell.Item.IsEnabled ? "is-enabled" : "is-disabled")">
                                        <i class="fa @(cell.Item.IsEnabled ? "fa-circle-check" : "fa-circle-pause")" aria-hidden="true"></i>
                                        @(cell.Item.IsEnabled ? L["Languages:Enabled"] : L["Languages:Disabled"])
                                    </span>
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="LanguageDto" Caption='@L["Languages:Default"].Value'>
                                <DisplayTemplate Context="cell">
                                    @if (cell.Item.IsDefault)
                                    {
                                        <span class="hcs-language-default"><i class="fa fa-star" aria-hidden="true"></i> @L["Languages:Default"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="LanguageDto" Caption='@L["Languages:UpdatedAt"].Value'>
                                <DisplayTemplate Context="cell">
                                    @(cell.Item.LastModificationTime?.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)
                                        ?? cell.Item.CreationTime.ToLocalTime().ToString("g", CultureInfo.CurrentCulture))
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="LanguageDto" Caption='@L["Languages:Actions"].Value'>
                                <DisplayTemplate Context="cell">
                                    <HcsDismissible Class="@($"hcs-more-pop {(actionMenuId == cell.Item.Id ? "is-open" : null)}")"
                                                    IsOpen="actionMenuId == cell.Item.Id"
                                                    OnClose="CloseActionMenu"
                                                    @onclick:stopPropagation="true">
                                        <button class="msg-more" type="button" data-lang-more="@cell.Item.Id" aria-haspopup="menu"
                                                aria-expanded="@(actionMenuId == cell.Item.Id ? "true" : "false")"
                                                aria-label='@L["Languages:Actions"].Value' @onclick="() => ToggleActionMenu(cell.Item.Id)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="5" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="12" cy="19" r="1.3"/></svg>
                                        </button>
                                    </HcsDismissible>
                                </DisplayTemplate>
                            </DataGridColumn>
                        </DataGridColumns>
                    </DataGrid>
                </CardBody>
            </Card>
            @if (actionMenuId is { } menuLangId && rows.FirstOrDefault(x => x.Id == menuLangId) is { } menuLang)
            {
                <div class="msg-menu" id="language-row-menu" role="menu" aria-label='@L["Languages:Actions"].Value' @onclick:stopPropagation="true">
                    @if (canUpdate)
                    {
                        <button type="button" role="menuitem" @onclick="() => OpenEditFromMenuAsync(menuLang)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                            @L["Languages:Edit"]
                        </button>
                    }
                    @if (canManageTexts)
                    {
                        <button type="button" role="menuitem" @onclick="() => OpenTranslationsFromMenu(menuLang)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h16"/><path d="M14 9l6 3-6 3z"/></svg>
                            @L["Languages:Translations"]
                        </button>
                    }
                    @if (canDelete && !menuLang.IsDefault)
                    {
                        <button class="is-danger" type="button" role="menuitem" @onclick="() => DeleteFromMenuAsync(menuLang)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M6 7l1 13h10l1-13"/></svg>
                            @L["Languages:Delete"]
                        </button>
                    }
                </div>
            }
        </main>
    </Authorized>
</AuthorizeView>

<Modal @ref="editModal" Size="ModalSize.Default">
    <ModalContent Centered="true" Class="hcs-language-modal">
        <ModalHeader Class="hcs-language-modal__header">
            <ModalTitle>@(editingId.HasValue ? L["Languages:EditTitle"] : L["Languages:CreateTitle"])</ModalTitle>
            <CloseButton Disabled="@isSaving" />
        </ModalHeader>
        <ModalBody Class="hcs-language-modal__body">
            @if (!string.IsNullOrWhiteSpace(formErrorMessage))
            {
                <div class="hcs-form-error" role="alert">@formErrorMessage</div>
            }
            <Field>
                <FieldLabel for="language-culture">@L["Languages:CultureName"]</FieldLabel>
                <TextInput id="language-culture" @bind-Value="form.CultureName" ReadOnly="@editingId.HasValue" MaxLength="20" />
                @if (!string.IsNullOrWhiteSpace(cultureError)) { <div class="hcs-field-error">@cultureError</div> }
                @if (editingId.HasValue) { <div class="hcs-field-hint">@L["Languages:CultureReadonly"]</div> }
            </Field>
            <Field>
                <FieldLabel for="language-display-name">@L["Languages:DisplayName"]</FieldLabel>
                <TextInput id="language-display-name" @bind-Value="form.DisplayName" MaxLength="64" />
                @if (!string.IsNullOrWhiteSpace(displayNameError)) { <div class="hcs-field-error">@displayNameError</div> }
            </Field>
            <Field Class="hcs-language-checks">
                <Check TValue="bool" Value="@form.IsEnabled" ValueChanged="OnEnabledChanged" Disabled="@form.IsDefault">
                    @L["Languages:IsEnabled"]
                </Check>
                <Check TValue="bool" Value="@form.IsDefault" ValueChanged="OnDefaultChanged" Disabled="@isEditingCurrentDefault">
                    @L["Languages:IsDefault"]
                </Check>
                @if (form.IsDefault)
                {
                    <div class="hcs-field-hint">@L["Languages:DefaultEnabledHint"]</div>
                }
            </Field>
        </ModalBody>
        <ModalFooter Class="hcs-language-modal__footer">
            <Button Color="Color.Light" Clicked="CloseModalAsync" Disabled="@isSaving">@L["Languages:Cancel"]</Button>
            <Button Color="Color.Primary" Clicked="SaveAsync" Loading="@isSaving" Disabled="@isSaving">
                @(editingId.HasValue ? L["Languages:Save"] : L["Languages:Create"])
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>
