@page "/administration/languages"
@attribute [Authorize(Policy = HCSPermissions.Languages.Default)]
@using System.Globalization
@using HCS.Permissions
@using Microsoft.AspNetCore.Authorization
@inherits HCSComponentBase
@inject LanguageManagementClient LanguageClient
@inject LanguageCatalogState LanguageState
@inject NavigationManager Navigation

<PageTitle>@L["Languages:Title"] · HCS</PageTitle>

<AuthorizeView Policy="@HCSPermissions.Languages.Default">
    <Authorized>
        <section class="page page-wf page-admin-languages" aria-labelledby="languages-title">
            <div class="page-head">
                <h1 id="languages-title">@L["Languages:Title"]</h1>
                <div class="page-actions">
                    <button class="btn btn-outline" type="button" @onclick="RefreshAsync" disabled="@isLoading">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                        @L["Languages:Refresh"]
                    </button>
                    @if (canCreate)
                    {
                        <button class="btn btn-primary" type="button" @onclick="OpenCreateModalAsync" disabled="@isSaving">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                            @L["Languages:Create"]
                        </button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="hcs-admin-alert" role="alert">
                    <span>@errorMessage</span>
                    <button class="btn btn-outline" type="button" @onclick="RefreshAsync" disabled="@isLoading">@L["Languages:Retry"]</button>
                </div>
            }

            <form class="docs-toolbar list-search" id="languages-search-form" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <label class="sr-only" for="languages-q">@L["Languages:SearchPlaceholder"]</label>
                <input class="input docs-search" id="languages-q" type="search" @bind="filterText" @bind:event="oninput"
                       placeholder="@L["Languages:SearchPlaceholder"]" autocomplete="off" />
                <label class="sr-only" for="languages-status-filter">@L["Languages:Status"]</label>
                <select class="select input page-admin-languages__status" id="languages-status-filter" @bind="statusFilter">
                    <option value="">@L["Languages:AllStatuses"]</option>
                    <option value="true">@L["Languages:Enabled"]</option>
                    <option value="false">@L["Languages:Disabled"]</option>
                </select>
                <button class="btn btn-primary" type="submit" disabled="@isLoading">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                    @L["Languages:SearchButton"]
                </button>
                <button class="btn btn-outline" type="button" @onclick="ResetSearchAsync" disabled="@isLoading">
                    @L["Languages:Reset"]
                </button>
            </form>

            <div class="docs-table-wrap">
                <div class="docs-table-scroll">
                    @if (isLoading && rows.Count == 0)
                    {
                        <DocsEmpty Loading="true" Title="@L["Languages:Loading"]" />
                    }
                    else if (rows.Count == 0)
                    {
                        <DocsEmpty Title="@L["Languages:EmptyTitle"]" Hint="@L["Languages:EmptyDescription"]" />
                    }
                    else
                    {
                        <table class="docs-table">
                            <thead>
                                <tr>
                                    <th class="col-actions" scope="col">@L["Languages:Actions"]</th>
                                    <th scope="col">@L["Languages:DisplayName"]</th>
                                    <th scope="col">@L["Languages:CultureName"]</th>
                                    <th class="col-status" scope="col">@L["Languages:Status"]</th>
                                    <th scope="col">@L["Languages:Default"]</th>
                                    <th scope="col">@L["Languages:UpdatedAt"]</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var language in rows)
                            {
                                <tr @key="language.Id">
                                    <td class="col-actions">
                                        <div class="doc-actions">
                                            @if (canUpdate)
                                            {
                                                <button class="doc-action" type="button" title="@L["Languages:Edit"]" aria-label="@L["Languages:Edit"]" @onclick="() => OpenEditModalAsync(language)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                                </button>
                                            }
                                            @if (canManageTexts)
                                            {
                                                <button class="doc-action" type="button" title="@L["Languages:Translations"]" aria-label="@L["Languages:Translations"]" @onclick="() => OpenTranslations(language)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h16"/><path d="M14 9l6 3-6 3z"/></svg>
                                                </button>
                                            }
                                            @if (canDelete && !language.IsDefault)
                                            {
                                                <button class="doc-action is-danger" type="button" title="@L["Languages:Delete"]" aria-label="@L["Languages:Delete"]" @onclick="() => DeleteAsync(language)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (canUpdate)
                                        {
                                            <button type="button" class="doc-title-open" @onclick="() => OpenEditModalAsync(language)">@language.DisplayName</button>
                                        }
                                        else
                                        {
                                            @language.DisplayName
                                        }
                                    </td>
                                    <td><span class="doc-code">@language.CultureName</span></td>
                                    <td>
                                        <span class="@(language.IsEnabled ? "badge hcs-status-badge--success" : "badge badge-muted")">
                                            @(language.IsEnabled ? L["Languages:Enabled"] : L["Languages:Disabled"])
                                        </span>
                                    </td>
                                    <td>
                                        @if (language.IsDefault)
                                        {
                                            <span class="badge badge-info">@L["Languages:Default"]</span>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td>@(language.LastModificationTime?.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.CurrentCulture)
                                        ?? language.CreationTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.CurrentCulture))</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
                <HcsPager TotalCount="totalCount" PageSize="pageSize" PageSizeId="languages-page-size" PageSizes="PageSizeOptions"
                          CanPrev="CanPrevPage" CanNext="CanNextPage" Disabled="@isLoading"
                          FirstClicked="GoFirstPage" PrevClicked="GoPrevPage" NextClicked="GoNextPage" LastClicked="GoLastPage"
                          PageSizeChanged="OnPageSizeChanged" />
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        <section class="page page-wf"><div class="hcs-admin-alert" role="alert">@L["Users:NoAdminPermission"]</div></section>
    </NotAuthorized>
</AuthorizeView>

<Modal @ref="editModal" Size="ModalSize.Default">
    <ModalContent Centered="true" Class="hcs-catalog-modal">
        <ModalHeader Class="hcs-catalog-modal__header">
            <ModalTitle>@(editingId.HasValue ? L["Languages:EditTitle"] : L["Languages:CreateTitle"])</ModalTitle>
            <CloseButton Clicked="CloseModalAsync" Disabled="@isSaving" />
        </ModalHeader>
        <ModalBody Class="hcs-catalog-modal__body">
            @if (!string.IsNullOrWhiteSpace(formErrorMessage))
            {
                <div class="hcs-admin-alert" role="alert">@formErrorMessage</div>
            }
            <div class="hcs-language-form">
                <Field>
                    <FieldLabel for="language-culture">@L["Languages:CultureName"]</FieldLabel>
                    <TextInput id="language-culture" @bind-Value="form.CultureName" ReadOnly="@editingId.HasValue" MaxLength="20" />
                    @if (!string.IsNullOrWhiteSpace(cultureError)) { <div class="hcs-field-error">@cultureError</div> }
                    @if (editingId.HasValue) { <div class="hcs-field-hint">@L["Languages:CultureReadonly"]</div> }
                </Field>
                <Field>
                    <FieldLabel for="language-display-name">@L["Languages:DisplayName"]</FieldLabel>
                    <TextInput id="language-display-name" @bind-Value="form.DisplayName" MaxLength="64" />
                    @if (!string.IsNullOrWhiteSpace(displayNameError)) { <div class="hcs-field-error">@displayNameError</div> }
                </Field>
                <Field Class="hcs-language-checks">
                    <Check TValue="bool" Value="@form.IsEnabled" ValueChanged="OnEnabledChanged" Disabled="@form.IsDefault">
                        @L["Languages:IsEnabled"]
                    </Check>
                    <Check TValue="bool" Value="@form.IsDefault" ValueChanged="OnDefaultChanged" Disabled="@isEditingCurrentDefault">
                        @L["Languages:IsDefault"]
                    </Check>
                    @if (form.IsDefault)
                    {
                        <div class="hcs-field-hint">@L["Languages:DefaultEnabledHint"]</div>
                    }
                </Field>
            </div>
        </ModalBody>
        <ModalFooter Class="hcs-catalog-modal__footer">
            <button class="btn btn-outline" type="button" @onclick="CloseModalAsync" disabled="@isSaving">@L["Languages:Cancel"]</button>
            <button class="btn btn-primary" type="button" @onclick="SaveAsync" disabled="@isSaving">
                @(editingId.HasValue ? L["Languages:Save"] : L["Languages:Create"])
            </button>
        </ModalFooter>
    </ModalContent>
</Modal>
