@page "/event-check-in/{Code}"
@inherits HCSComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject WorkManagementClient Work

<PageTitle>@(eventInfo?.Name ?? L["Event:CheckIn"]) · HCS</PageTitle>
<main class="hcs-event-checkin" aria-labelledby="checkin-title">
    <section class="hcs-event-checkin__card">
        @if (isLoading) { <div class="hcs-loading py-5" role="status"><i class="fa fa-spinner fa-spin" aria-hidden="true"></i><span>@L["Catalog:Loading"]</span></div> }
        else if (eventInfo is null) { <div class="hcs-empty"><i class="fa fa-triangle-exclamation" aria-hidden="true"></i><h1 id="checkin-title">@L["Event:PublicUnavailable"]</h1><p>@errorMessage</p></div> }
        else if (checkedIn is not null) { <div class="hcs-event-checkin__success"><span class="hcs-event-checkin__success-icon"><i class="fa fa-check" aria-hidden="true"></i></span><h1 id="checkin-title">@L["Event:CheckInSuccess"]</h1><p>@string.Format(L["Event:CheckInSuccessDescription"], checkedIn.FullName)</p><time>@checkedIn.CheckedInAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div> }
        else
        {
            <div class="hcs-event-checkin__brand"><span><i class="fa fa-calendar-check" aria-hidden="true"></i></span><small>HCS · @L["Menu:EventManagement"]</small></div>
            <h1 id="checkin-title">@eventInfo.Name</h1><p class="hcs-event-checkin__meta">@eventInfo.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm") – @eventInfo.EndTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")<br />@(eventInfo.Location ?? L["Event:OnlineOrNotSet"])</p>
            <div class="hcs-event-checkin__notice"><i class="fa fa-circle-info me-2" aria-hidden="true"></i>@L["Event:CheckInAuthenticatedPrompt"]</div>
            @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-danger" role="alert">@errorMessage</div> }
            @if (eventInfo.Attachments is { Count: > 0 })
            {
                <section class="hcs-event-checkin__attachments" aria-labelledby="event-attachments-title">
                    <h2 id="event-attachments-title"><i class="fa fa-paperclip me-2" aria-hidden="true"></i>@L["Event:Attachments"]</h2>
                    <div class="hcs-event-checkin__attachment-list">
                        @foreach (var file in eventInfo.Attachments)
                        {
                            <a class="hcs-event-checkin__attachment" href="@PublicAttachmentUrl(file.Id)" target="_blank" rel="noopener">
                                <span class="hcs-event-checkin__attachment-name"><i class="fa fa-file-lines me-2" aria-hidden="true"></i>@file.FileName</span>
                                <span class="hcs-event-checkin__attachment-download">@L["Event:DownloadAttachment"]<i class="fa fa-download ms-1" aria-hidden="true"></i></span>
                            </a>
                        }
                    </div>
                </section>
            }
            <div class="hcs-event-checkin__form">
                <Button Color="Color.Primary" Class="w-100" Clicked="ConfirmParticipationAsync" Disabled="@isSubmitting"><i class="fa fa-check me-2" aria-hidden="true"></i>@L["Event:ConfirmParticipation"]</Button>
            </div>
        }
    </section>
</main>

@code {
    [Parameter] public string Code { get; set; } = "";
    [SupplyParameterFromQuery] public string? Token { get; set; }
    private PublicEventDto? eventInfo; private PublicEventCheckInResultDto? checkedIn; private string? errorMessage; private bool isLoading, isSubmitting, isAuthenticated;
    protected override async Task OnParametersSetAsync()
    {
        isLoading = true; checkedIn = null; errorMessage = null; isAuthenticated = false;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = state.User.Identity?.IsAuthenticated == true;
            if (!isAuthenticated)
            {
                LoginAsync();
                return;
            }

            if (string.IsNullOrWhiteSpace(Token)) throw new InvalidOperationException(L["Event:InvalidQr"].Value);
            eventInfo = await Work.GetPublicEventAsync(Code, Token);
        }
        catch (InvalidOperationException ex) { eventInfo = null; errorMessage = ex.Message; }
        catch (Exception ex) { eventInfo = null; errorMessage = MapBffError(ex); }
        finally { isLoading = false; }
    }

    private void LoginAsync() => LoginNavigation.NavigateTo(
        BffLoginUrlBuilder.Build(Configuration, LoginNavigation.Uri), forceLoad: true);

    private async Task ConfirmParticipationAsync()
    {
        isSubmitting = true; errorMessage = null;
        try { checkedIn = await Work.CheckInPublicEventAsync(Code, Token ?? "", new()); }
        catch (Exception ex) { errorMessage = MapBffError(ex); }
        finally { isSubmitting = false; }
    }

    private string PublicAttachmentUrl(Guid fileId) => Work.BuildResourceUrl(
        $"/api/events/public/{Uri.EscapeDataString(Code)}/attachments/{fileId:D}?token={Uri.EscapeDataString(Token ?? string.Empty)}");
}
