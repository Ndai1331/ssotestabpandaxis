@page "/projects"
@attribute [Authorize(Policy = "WorkManagement.Projects")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject OrganizationCatalogClient Catalog
@inject CollaborationClient Chat
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>@L["Feature:ProjectsTitle"] · HCS</PageTitle>
<section class="page page-wf page-pj" aria-labelledby="projects-title">
    <div class="page-head">
        <h1 id="projects-title">@L["Feature:ProjectsTitle"]</h1>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="ExportAsync" disabled="@(items.Count == 0 || isLoading)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/></svg>
                @L["Catalog:Export"]
            </button>
            <button class="btn btn-outline" type="button" @onclick="OpenCreateTask">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                @L["Work:NewTask"]
            </button>
            <button class="btn btn-primary" type="button" @onclick="OpenCreate">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                @L["Work:NewProject"]
            </button>
            <button class="btn btn-outline @(showSearch ? "is-open" : null) @(IsSearchFiltered ? "is-filtered" : null)"
                    type="button" aria-expanded="@showSearch.ToString().ToLowerInvariant()"
                    aria-controls="pj-search-form" @onclick="ToggleSearch">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:Search"]
            </button>
            <HcsDismissible Class="filter-pop" @bind-IsOpen="showFilters">
                <button class="btn btn-outline @(string.IsNullOrEmpty(status) ? null : "is-filtered")" type="button"
                        aria-expanded="@showFilters.ToString().ToLowerInvariant()"
                        aria-controls="pj-filter-menu" @onclick="ToggleFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                    @L["Catalog:Filter"]
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="filter-menu @(showFilters ? "is-open" : null)" id="pj-filter-menu" role="menu">
                    <button type="button" class="@(string.IsNullOrEmpty(status) ? "is-active" : null)" @onclick="FilterAll">@L["Catalog:AllStatuses"]</button>
                    @foreach (var value in WorkUi.ProjectStatuses)
                    {
                        <button type="button" class="@(status == value ? "is-active" : null)" @onclick="() => SetStatus(value)">
                            @L[WorkUi.ProjectStatusKey(value)]
                        </button>
                    }
                </div>
            </HcsDismissible>
        </div>
    </div>

    <section class="docs-main">
        <form class="docs-toolbar list-search" id="pj-search-form" hidden="@(!showSearch)" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <label class="sr-only" for="pj-q">@L["Catalog:SearchPlaceholder"]</label>
            <input class="input docs-search" id="pj-q" type="search" @bind="filter" @bind:event="oninput"
                   placeholder="@L["Catalog:SearchPlaceholder"]" autocomplete="off" />
            <button class="btn btn-primary" type="submit" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:SearchButton"]
            </button>
        </form>

        <div class="docs-table-wrap">
            @if (isLoading && items.Count == 0)
            {
                <DocsEmpty Loading="true" />
            }
            else if (items.Count == 0)
            {
                <DocsEmpty Title="@L["Feature:ProjectsEmpty"]" Hint="@L["Catalog:EmptyDescription"]" />
            }
            else
            {
                <table class="docs-table">
                    <thead>
                        <tr>
                            <th scope="col">@L["Catalog:Code"]</th>
                            <th scope="col">@L["Work:DateRange"]</th>
                            <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                            <th scope="col">@L["Catalog:Department"]</th>
                            <th scope="col">@L["Work:Members"]</th>
                            <th scope="col">@L["Menu:Tasks"]</th>
                            <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in items)
                    {
                        <tr @key="item.Id">
                            <td>
                                <div class="pj-name" title="@item.Name">
                                    <a href="@($"/project-detail/{item.Id}")">@item.Name</a>
                                    <span>#@item.Code</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <span>@item.Description</span>
                                    }
                                </div>
                            </td>
                            <td>@WorkUi.FormatRange(item.StartDate, item.EndDate)</td>
                            <td><span class="@WorkUi.ProjectBadgeDs(item.Status)">@L[WorkUi.ProjectStatusKey(item.Status)]</span></td>
                            <td>@DepartmentName(item.OwnerDepartmentId)</td>
                            <td>@item.MemberCount</td>
                            <td>@item.TaskCount</td>
                            <td>
                                <div class="doc-actions">
                                    <button class="doc-action" type="button" title="@L["Catalog:Edit"]" aria-label="@L["Catalog:Edit"]" @onclick="() => Edit(item)">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                    </button>
                                    <a class="doc-action" href="@($"/project-detail/{item.Id}")" title="@L["Menu:Tasks"]" aria-label="@L["Menu:Tasks"]">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12"/><path d="M4 6h.01M4 12h.01M4 18h.01"/></svg>
                                    </a>
                                    <a class="doc-action" href="@($"/project-detail/{item.Id}")" title="@L["Work:Members"]" aria-label="@L["Work:Members"]">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M16 11a3 3 0 1 0-4-5 3 3 0 0 0 4 5z"/><path d="M8 14a3 3 0 1 0-4-5 3 3 0 0 0 4 5z"/><path d="M20 20a5 5 0 0 0-8 0"/><path d="M12 20a5 5 0 0 0-8 0"/></svg>
                                    </a>
                                    <AuthorizeView Policy="Collaboration.Chat">
                                        <Authorized>
                                            <button class="doc-action" type="button" title="@L["Chat:OpenProjectChat"]" aria-label="@L["Chat:OpenProjectChat"]" @onclick="() => OpenProjectChatAsync(item)" disabled="@isOpeningChat">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                    @if (item.CanDelete)
                                    {
                                        <button class="doc-action is-danger" type="button" title="@L["Catalog:Delete"]" aria-label="@L["Catalog:Delete"]" @onclick="() => DeleteAsync(item)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            <div class="pager" aria-label="@L["Catalog:PageSize"]">
                <button type="button" disabled="@(!CanPrev)" @onclick="GoFirst">@L["Catalog:PagerFirst"]</button>
                <button type="button" disabled="@(!CanPrev)" @onclick="GoPrev">@L["Catalog:PagerPrev"]</button>
                <button type="button" disabled="@(!CanNext)" @onclick="GoNext">@L["Catalog:PagerNext"]</button>
                <button type="button" disabled="@(!CanNext)" @onclick="GoLast">@L["Catalog:PagerLast"]</button>
                <label class="sr-only" for="pj-page-size">@L["Catalog:PageSize"]</label>
                <select id="pj-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>
    </section>
</section>

<Modal @ref="modal" Size="ModalSize.Default">
    <ModalContent Centered Class="hcs-catalog-modal">
        <ModalHeader Class="hcs-catalog-modal__header">
            <ModalTitle>@(editingId is null ? L["Feature:ProjectCreate"] : L["Feature:ProjectEdit"])</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody Class="hcs-catalog-modal__body">
            <div class="hcs-catalog-form">
                <div class="hcs-form-row">
                    <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Code" Name="hcsProjectCode" MaxLength="64" Disabled="@(editingId is not null)" /></Field>
                    <Field><FieldLabel>@L["Feature:ProjectName"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Name" Name="hcsProjectName" /></Field>
                </div>
                <Field><FieldLabel>@L["Feature:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="form.Description" autocomplete="off"></textarea></Field>
                <div class="hcs-form-row hcs-form-row--equal">
                    <Field><FieldLabel>@L["Feature:StartDate"]</FieldLabel><HcsDatePicker TValue="DateTime" @bind-Value="form.StartDate" InputMode="DateInputMode.DateTime" ShowTodayButton ShowClearButton /></Field>
                    <Field><FieldLabel>@L["Feature:EndDate"]</FieldLabel><HcsDatePicker TValue="DateTime" @bind-Value="form.EndDate" InputMode="DateInputMode.DateTime" ShowTodayButton ShowClearButton /></Field>
                </div>
                <div class="hcs-form-row hcs-form-row--equal">
                    <Field><FieldLabel>@L["Catalog:Status"]</FieldLabel>
                        <Select TValue="string" @bind-Value="form.Status">
                            @foreach (var value in WorkUi.ProjectStatuses) { <SelectItem Value="@value">@L[WorkUi.ProjectStatusKey(value)]</SelectItem> }
                        </Select>
                    </Field>
                    <Field><FieldLabel>@L["Catalog:Department"]</FieldLabel>
                        <CatalogSelect2 Value="form.OwnerDepartmentId"
                                        ValueChanged="value => form.OwnerDepartmentId = value"
                                        Placeholder="@L["Catalog:SearchPlaceholder"]"
                                        SelectedText="@DepartmentSelectText(form.OwnerDepartmentId)"
                                        Search="SearchDepartmentsAsync" />
                    </Field>
                </div>
            </div>
        </ModalBody>
        <ModalFooter Class="hcs-catalog-modal__footer">
            <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => modal!.Hide()">@L["Catalog:Cancel"]</Button>
            <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveAsync" Disabled="@isSaving">@L["Catalog:SaveChanges"]</Button>
        </ModalFooter>
    </ModalContent>
</Modal>
<ProjectTaskCreateModal @ref="createTaskModal" OnCreated="LoadAsync" />
@code {
    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<ProjectDto> items = [];
    private readonly List<DepartmentCatalogDto> departments = [];
    private readonly ProjectForm form = new();
    private Modal? modal;
    private ProjectTaskCreateModal? createTaskModal;
    private Guid? editingId;
    private string? filter, status;
    private bool isLoading, isSaving, showFilters, showSearch, isOpeningChat;
    private int totalCount, pageSize = 20, currentPage = 1;

    private bool IsSearchFiltered => !string.IsNullOrWhiteSpace(filter);
    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < PageCount;

    protected override async Task OnInitializedAsync()
    {
        try { departments.AddRange(await Catalog.GetDepartmentLookupAsync()); } catch { }
        await LoadAsync();
    }

    private void ToggleSearch()
    {
        showSearch = !showSearch;
        if (showSearch) showFilters = false;
    }
    private void ToggleFilters()
    {
        showFilters = !showFilters;
        if (showFilters) showSearch = false;
    }
    private Task FilterAll() => SetStatus(null);
    private Task SetStatus(string? value)
    {
        status = value;
        showFilters = false;
        currentPage = 1;
        return LoadAsync();
    }
    private Task SearchAsync() { currentPage = 1; return LoadAsync(); }
    private Task GoFirst() { currentPage = 1; return LoadAsync(); }
    private Task GoPrev() { if (!CanPrev) return Task.CompletedTask; currentPage--; return LoadAsync(); }
    private Task GoNext() { if (!CanNext) return Task.CompletedTask; currentPage++; return LoadAsync(); }
    private Task GoLast() { currentPage = PageCount; return LoadAsync(); }
    private Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return Task.CompletedTask;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var result = await Work.GetProjectsAsync(new WorkListQuery(filter, string.IsNullOrWhiteSpace(status) ? null : status, (currentPage - 1) * pageSize, pageSize));
            items.Clear(); items.AddRange(result.Items);
            totalCount = (int)result.TotalCount;
            currentPage = Math.Clamp(currentPage, 1, PageCount);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }

    private async Task OpenCreate()
    {
        editingId = null;
        form.Reset();
        if (modal is not null) await modal.Show();
    }

    private void Edit(ProjectDto item) => Navigation.NavigateTo($"/project-detail/{item.Id}");
    private Task OpenCreateTask() => createTaskModal?.ShowAsync() ?? Task.CompletedTask;

    private async Task OpenProjectChatAsync(ProjectDto project)
    {
        if (isOpeningChat) return;
        isOpeningChat = true;
        try
        {
            await Work.SyncProjectChatAccessAsync(project.Id);
            var conversation = await Chat.FindByProjectIdAsync(project.Id);
            if (conversation is null)
            {
                var detail = await Work.GetProjectAsync(project.Id);
                var memberIds = detail.Members.Where(x => x.IsActive).Select(x => x.UserId).Distinct().ToList();
                conversation = await CreateProjectConversationWithRetryAsync(project, memberIds);
                await NotifySuccessAsync(L["Chat:ProjectChatCreated"]);
            }
            Navigation.NavigateTo($"/chat/{conversation.Id}");
        }
        catch (Exception ex)
        {
            if (ex is CollaborationApiException api &&
                api.ResponseBody?.Contains("WorkSubjectNotProvisioned", StringComparison.OrdinalIgnoreCase) == true)
                await NotifyErrorAsync(L["Chat:WorkSubjectNotProvisioned"]);
            else if (ex is CollaborationApiException { StatusCode: System.Net.HttpStatusCode.Forbidden })
                await NotifyErrorAsync(L["Chat:YouAreNotAMemberOfThisProjectChat"]);
            else
                await NotifyErrorAsync(ChatErrorMapper.From(L, ex, "Chat:ProjectChatCreateFailed"));
        }
        finally { isOpeningChat = false; }
    }

    private async Task<ConversationDto> CreateProjectConversationWithRetryAsync(ProjectDto project, IReadOnlyList<Guid> memberIds)
    {
        CollaborationApiException? lastProvisioned = null;
        for (var attempt = 0; attempt < 4; attempt++)
        {
            try
            {
                return await Chat.CreateConversationAsync(new CreateConversationInput
                {
                    Type = ConversationType.Project,
                    ProjectId = project.Id,
                    Name = project.Name,
                    MemberUserIds = memberIds
                });
            }
            catch (CollaborationApiException api) when (
                api.ResponseBody?.Contains("WorkSubjectNotProvisioned", StringComparison.OrdinalIgnoreCase) == true)
            {
                lastProvisioned = api;
                await Task.Delay(800);
                await Work.SyncProjectChatAccessAsync(project.Id);
            }
        }
        if (lastProvisioned is not null) throw lastProvisioned;
        throw new InvalidOperationException("Project chat could not be created.");
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        try
        {
            if (editingId is { } id)
                await Work.UpdateProjectAsync(id, new UpdateProjectRequest(form.Name.Trim(), Blank(form.Description), WorkUi.FormTimeToUtc(form.StartDate), WorkUi.FormTimeToUtc(form.EndDate), form.Status, form.OwnerDepartmentId));
            else
                await Work.CreateProjectAsync(new CreateProjectRequest(form.Code.Trim(), form.Name.Trim(), Blank(form.Description), WorkUi.FormTimeToUtc(form.StartDate), WorkUi.FormTimeToUtc(form.EndDate), form.Status, form.OwnerDepartmentId));
            await NotifySuccessAsync(editingId is null ? L["Catalog:Created"] : L["Catalog:Updated"]);
            if (modal is not null) await modal.Hide();
            await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSaving = false; }
    }

    private async Task DeleteAsync(ProjectDto item)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], item.Name))) return;
        try { await Work.DeleteProjectAsync(item.Id); await NotifySuccessAsync(L["Catalog:Deleted"]); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }

    private async Task ExportAsync()
    {
        try
        {
            await CsvDownload.DownloadAsync(JsRuntime, $"projects-{DateTime.Now:yyyyMMdd-HHmm}.csv",
                [L["Catalog:Code"], L["Feature:ProjectName"], L["Catalog:Status"], L["Catalog:Department"], L["Work:Members"], L["Menu:Tasks"]],
                items.Select(item => (IReadOnlyList<string>)[item.Code, item.Name, L[WorkUi.ProjectStatusKey(item.Status)], DepartmentName(item.OwnerDepartmentId), item.MemberCount.ToString(), item.TaskCount.ToString()]));
            await UiMessage.Success(L["Catalog:Exported"]);
        }
        catch { await UiMessage.Error(L["Catalog:ExportError"]); }
    }

    private string DepartmentName(Guid? id)
    {
        var text = DepartmentSelectText(id);
        return string.IsNullOrWhiteSpace(text) ? "—" : text;
    }

    private string DepartmentSelectText(Guid? id) =>
        CatalogSelect2Cache.TextFor(departments, id, x => x.Id, x => CatalogSelect2Text.CodeName(x.Code, x.Name));

    private async Task<CatalogSelect2SearchResponse> SearchDepartmentsAsync(string term, int page)
    {
        var skip = Math.Max(page - 1, 0) * 20;
        var result = await Catalog.SearchDepartmentsAsync(term, skip, 20);
        return CatalogSelect2Cache.Merge(departments, result.Items, x => x.Id,
            x => CatalogSelect2Text.CodeName(x.Code, x.Name), more: skip + result.Items.Count < result.TotalCount);
    }
    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class ProjectForm
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddMonths(1);
        public string Status { get; set; } = "Draft";
        public Guid? OwnerDepartmentId { get; set; }
        public void Reset() { Code = Name = Description = ""; StartDate = DateTime.Today; EndDate = DateTime.Today.AddMonths(1); Status = "Draft"; OwnerDepartmentId = null; }
    }
}
