@page "/document-signing"
@page "/document-signing/{RelatedId:guid}"
@attribute [Authorize(Policy = "Documents.Signing.Execute")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject CollaborationClient Chat
@inject OrganizationCatalogClient Catalog
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>@L["Menu:DocumentSigning"] · HCS</PageTitle>
<section class="page page-wf page-sign" aria-labelledby="sign-queue-title">
    <div class="page-head">
        <h1 id="sign-queue-title">@L["Feature:SigningQueue"]</h1>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="ExportAsync" disabled="@(VisibleQueue.Count == 0)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/></svg>
                @L["Catalog:Export"]
            </button>
            <button class="btn btn-outline" type="button" @onclick="LoadAsync" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                @L["Catalog:Refresh"]
            </button>
            <AuthorizeView Policy="Documents.Workflow.Start">
                <Authorized>
                    <button class="btn btn-primary" type="button" @onclick="OpenSubmit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                        @L["Work:CreateSigning"]
                    </button>
                </Authorized>
            </AuthorizeView>
            <button class="btn btn-outline @(showSearch ? "is-open" : null) @(IsSearchFiltered ? "is-filtered" : null)"
                    type="button" aria-expanded="@showSearch.ToString().ToLowerInvariant()"
                    aria-controls="queue-search-form" @onclick="ToggleSearch">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:Search"]
            </button>
            <HcsDismissible Class="filter-pop" @bind-IsOpen="showFilters">
                <button class="btn btn-outline @(showFilters ? "is-open" : null) @(IsAdvancedFiltered ? "is-filtered" : null)" type="button"
                        aria-expanded="@showFilters.ToString().ToLowerInvariant()"
                        aria-controls="queue-filter-panel" @onclick="ToggleFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                    @L["Catalog:Filter"]
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <DocumentSigningFilterBar IsOpen="showFilters"
                                          StatusFilter="@statusFilter" StatusFilterChanged="OnStatusFilterChanged"
                                          DateFilterField="@dateFilterField" DateFilterFieldChanged="OnDateFilterFieldChanged"
                                          SubmitterUserId="submitterId" SubmitterUserIdChanged="OnSubmitterChanged"
                                          SubmitterText="@ContactName(submitterId)"
                                          DepartmentId="departmentId" DepartmentIdChanged="OnDepartmentChanged"
                                          DepartmentText="@DepartmentName(departmentId)"
                                          FromDate="fromDate" FromDateChanged="OnFromDateChanged"
                                          ToDate="toDate" ToDateChanged="OnToDateChanged"
                                          SearchClicked="ApplyFilter"
                                          ResetClicked="ResetSearch"
                                          SearchUsers="SearchContactsAsync"
                                          SearchDepartments="SearchDepartmentsAsync" />
            </HcsDismissible>
        </div>
    </div>

    <form class="docs-toolbar list-search" id="queue-search-form" hidden="@(!showSearch)" @onsubmit="ApplyFilter" @onsubmit:preventDefault>
        <label class="sr-only" for="queue-q">@L["Work:SearchByTitleOrNumber"]</label>
        <input class="input docs-search" id="queue-q" type="search" @bind="filter" @bind:event="oninput"
               placeholder="@L["Work:SearchByTitleOrNumber"]" autocomplete="off" />
        <button class="btn btn-primary" type="submit" disabled="@isLoading">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
            @L["Catalog:SearchButton"]
        </button>
    </form>

    <div class="queue-tabs" role="tablist" aria-label="@L["Feature:SigningQueue"]">
        @foreach (var tab in InboxTabs)
        {
            <button type="button" class="queue-tab @(inboxFilter == tab.Key ? "is-active" : null)"
                    role="tab" aria-selected="@(inboxFilter == tab.Key)" @onclick="@(() => SetInbox(tab.Key))">
                @tab.Label
                <span class="count">@tab.Count</span>
            </button>
        }
    </div>

    <div class="docs-table-wrap">
            @if (isLoading)
            {
                <DocsEmpty Loading="true" />
            }
            else if (PageItems.Count == 0)
            {
                <DocsEmpty Hint="@L["Catalog:EmptyDescription"]" />
            }
            else
            {
                <table class="docs-table queue-table">
                    <thead>
                        <tr>
                            <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                            <th scope="col">@L["Feature:DocumentTitleField"]</th>
                            <th scope="col">@L["Work:FilterSubmitter"]</th>
                            <th scope="col">@L["Work:FilterDepartment"]</th>
                            <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                            <th scope="col">@L["Work:CurrentStep"]</th>
                            <th scope="col">@L["Work:ReceivedDate"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in PageItems)
                    {
                        <tr @key="item.Task.Id">
                            <td class="col-actions">
                                <div class="doc-actions">
                                    <button class="doc-action" type="button" title="@L["Work:WorkflowInfo"]" aria-label="@L["Work:WorkflowInfo"]" @onclick="() => OpenInfo(item)">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/></svg>
                                    </button>
                                    <button class="doc-action" type="button" title="@L["Work:PdfPreview"]" aria-label="@L["Work:PdfPreview"]" @onclick="() => PreviewAsync(item)">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    @if (CanActOn(item))
                                    {
                                        <button class="doc-action" type="button" title="@SignActionTitle(item)" aria-label="@SignActionTitle(item)" @onclick="() => OpenSign(item)">
                                            @if (IsSignStep(item))
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                            }
                                            else
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                                            }
                                        </button>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="doc-title" title="@item.Document.Title">
                                    <a href="@($"/document-detail/{item.Document.Id}?sourceType=3")">@item.Document.Title</a>
                                    <span class="doc-code">#@item.Document.Number</span>
                                </div>
                            </td>
                            <td>@SubmitterName(item)</td>
                            <td>@DepartmentName(DepartmentId(item))</td>
                            <td><span class="@StatusClass(item)">@StatusText(item)</span></td>
                            <td>@CurrentStepLabel(item)</td>
                            <td>@item.Document.CreationTime.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            <div class="pager" aria-label="@L["Catalog:PageSize"]">
                <button type="button" disabled="@(!CanPrevPage || isLoading)" @onclick="GoFirstPage">@L["Catalog:PagerFirst"]</button>
                <button type="button" disabled="@(!CanPrevPage || isLoading)" @onclick="GoPrevPage">@L["Catalog:PagerPrev"]</button>
                <button type="button" disabled="@(!CanNextPage || isLoading)" @onclick="GoNextPage">@L["Catalog:PagerNext"]</button>
                <button type="button" disabled="@(!CanNextPage || isLoading)" @onclick="GoLastPage">@L["Catalog:PagerLast"]</button>
                <label class="sr-only" for="sign-page-size">@L["Catalog:PageSize"]</label>
                <select id="sign-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>
</section>

<Modal @ref="modal" Size="ModalSize.ExtraLarge" Closing="OnSignModalClosing">
    <ModalContent Centered Class="hcs-catalog-modal signing-action-modal">
        <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@ActionModalTitle(selected)</ModalTitle><CloseButton Clicked="CloseSignAsync" /></ModalHeader>
        <ModalBody Class="hcs-catalog-modal__body">
            @if (selected is not null)
            {
                <div class="process-hero">
                    <div>
                        <p class="process-hero-title" title="@selected.Document.Title">@selected.Document.Title</p>
                        <p class="process-hero-code">#@selected.Document.Number</p>
                    </div>
                    <div class="process-hero-meta">
                        <span class="badge badge-info">@ApprovalStatusText(selected.Task.Status)</span>
                        <span>@L["Work:Assignee"]: @SignerName(selected.Task.AssigneeUserId)</span>
                    </div>
                </div>
                <div class="process-split">
                    <div class="process-flow">
                        <h3>@selected.Definition.Name</h3>
                        <ol class="flow-steps">
                            @foreach (var step in selected.Definition.Steps.OrderBy(x => x.Order))
                            {
                                var isCurrent = string.Equals(step.Code, selected.Task.StepCode, StringComparison.OrdinalIgnoreCase);
                                var stepTask = selected.Instance.Tasks.FirstOrDefault(x => string.Equals(x.StepCode, step.Code, StringComparison.OrdinalIgnoreCase));
                                <li class="flow-step @(isCurrent ? "is-current" : null)">
                                    <span class="flow-dot" aria-hidden="true"></span>
                                    <div class="flow-body">
                                        <div class="flow-title-row">
                                            <strong>@step.Name</strong>
                                            <span class="badge badge-info">@L[$"Work:StepType.{step.Type}"]</span>
                                        </div>
                                        @if (stepTask is not null)
                                        {
                                            <p class="flow-wait">
                                                @ApprovalStatusText(stepTask.Status)
                                                @if (step.SlaDays is { } sla) { <span> · @sla @L["Work:Days"]</span> }
                                            </p>
                                        }
                                        @if (isCurrent)
                                        {
                                            <p class="flow-actor">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
                                                @L["Work:Assignee"]: @SignerName(selected.Task.AssigneeUserId)
                                            </p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(stepTask?.Comment))
                                        {
                                            <div class="hcs-workflow-step-comment"><strong>@L["Feature:Comment"]:</strong> @stepTask.Comment</div>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                        <div class="field">
                            <label class="field-label" for="sign-comment">@L["Feature:Comment"]</label>
                            <textarea class="input" id="sign-comment" rows="3" @bind="form.Comment"></textarea>
                        </div>
                        @if (IsSignStep(selected))
                        {
                            <div class="field">
                                <label class="field-label" for="sign-kind">@L["Feature:Kind"]</label>
                                <select class="select" id="sign-kind" value="@form.Kind" @onchange="OnSigningKindSelectChanged">
                                    <option value="0">@L["Feature:Electronic"]</option>
                                    <option value="1">@L["Feature:RemoteCa"]</option>
                                    <option value="2">@L["Feature:Hsm"]</option>
                                    <option value="3">@L["Feature:UsbToken"]</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="field-label" for="sign-signature">@L["Feature:UserSignatures"]</label>
                                <select class="select" id="sign-signature" @bind="form.SignatureId">
                                    <option value="">—</option>
                                    @foreach (var signature in SignaturesForSelectedKind)
                                    {
                                        <option value="@signature.Id.ToString()">@signature.FileName · @SignatureTypeLabel(signature.Type) @(signature.IsDefault ? $"({L["Feature:DefaultSignature"]})" : "")</option>
                                    }
                                </select>
                                @if (SigningOptionsLoadFailed)
                                {
                                    <p class="hcs-catalog-desc" role="alert">
                                        @L["Feature:SigningOptionsLoadFailed"]
                                        <button type="button" class="btn btn-outline" @onclick="LoadSigningOptionsAsync" disabled="@isLoadingSigningOptions">@L["Catalog:Retry"]</button>
                                    </p>
                                }
                                else if (SignaturesForSelectedKind.Count == 0)
                                {
                                    <p class="hcs-catalog-desc">@L["Feature:NoMatchingSignature"]</p>
                                }
                            </div>
                            <div class="field">
                                <label class="field-label" for="sign-file">@L["Feature:Files"]</label>
                                <select class="select" id="sign-file" @bind="form.FileId">
                                    <option value="">@L["Catalog:ChooseType"]</option>
                                    @foreach (var file in selected.Document.Files.Where(DocumentFilePick.IsPdf))
                                    {
                                        <option value="@file.Id.ToString()">@file.FileName</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (report is not null)
                        {
                            <p class="hcs-catalog-desc">@L["Feature:Completed"]: @report.Completed · @L["Feature:Failed"]: @report.Failed</p>
                        }
                    </div>
                    <section class="process-side hcs-signing-side-pane" aria-label="@L["Feature:WorkflowHistory"]">
                        <div class="process-side-tabs" role="tablist" aria-label="@L["Feature:WorkflowHistory"]">
                            <button class="process-side-tab @(approvalSideTab == "history" ? "is-active" : null)" type="button" role="tab"
                                    aria-selected="@(approvalSideTab == "history")" aria-controls="sign-pane-history" id="sign-tab-history"
                                    @onclick="@(() => SetApprovalSideTab("history"))">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                                @L["Feature:WorkflowHistory"]
                            </button>
                            <button class="process-side-tab @(approvalSideTab == "files" ? "is-active" : null)" type="button" role="tab"
                                    aria-selected="@(approvalSideTab == "files")" aria-controls="sign-pane-files" id="sign-tab-files"
                                    @onclick="@(() => SetApprovalSideTab("files"))">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21.4 11.6 12.8 20a5 5 0 0 1-7.1-7.1l9.2-9.2a3.2 3.2 0 0 1 4.5 4.5L10.2 17.4a1.4 1.4 0 1 1-2-2l8.2-8.2"/></svg>
                                @L["Feature:Attachments"]
                            </button>
                        </div>
                        <div class="process-pane" id="sign-pane-history" role="tabpanel" aria-labelledby="sign-tab-history" hidden="@(approvalSideTab != "history")">
                            @{ var workflowHistory = BuildWorkflowHistory(selected); }
                            <div class="process-pane-head">
                                <h3>@L["Feature:WorkflowHistory"]</h3>
                                <span class="process-pane-count">@workflowHistory.Count</span>
                            </div>
                            @if (workflowHistory.Count == 0)
                            {
                                <p class="process-empty">@L["Catalog:EmptyDescription"]</p>
                            }
                            else
                            {
                                <ol class="history-list">
                                    @foreach (var entry in workflowHistory)
                                    {
                                        <li>
                                            <span class="history-dot" aria-hidden="true"></span>
                                            <div>
                                                <strong>@WorkflowHistoryLabel(entry)</strong>
                                                @if (!string.IsNullOrWhiteSpace(entry.StepName))
                                                {
                                                    <span class="hcs-catalog-desc"> · @entry.StepName</span>
                                                }
                                                <p>@WorkflowActorLabel(entry) · @entry.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                                @if (!string.IsNullOrWhiteSpace(entry.Detail))
                                                {
                                                    <p>@L["Feature:Comment"]: @entry.Detail</p>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ol>
                            }
                        </div>
                        <div class="process-pane" id="sign-pane-files" role="tabpanel" aria-labelledby="sign-tab-files" hidden="@(approvalSideTab != "files")">
                            <div class="process-pane-head">
                                <h3>@L["Feature:Attachments"]</h3>
                                <span class="process-pane-count">@selected.Document.Files.Count</span>
                            </div>
                            @if (selected.Document.Files.Count == 0)
                            {
                                <p class="process-empty">@L["Work:NoFileChosen"]</p>
                            }
                            else
                            {
                                <div class="hcs-workflow-files">
                                    @foreach (var file in selected.Document.Files)
                                    {
                                        <div class="hcs-workflow-file @(signPreviewFile?.Id == file.Id ? "hcs-workflow-file--active" : null)">
                                            <div class="min-w-0">
                                                <strong class="d-block text-truncate">@file.FileName</strong>
                                                <span class="hcs-catalog-desc">@file.ContentType · @FormatSize(file.Size)</span>
                                            </div>
                                            <button class="doc-action" type="button" title="@L["Work:PdfPreview"]" aria-label="@L["Work:PdfPreview"]" @onclick="() => PreviewSigningFileAsync(file)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                            </button>
                                        </div>
                                    }
                                </div>
                                @if (signPreviewFile is not null && !string.IsNullOrWhiteSpace(signPdfUrl))
                                {
                                    <div class="hcs-signing-preview"><HcsPdfFrame Source="@signPdfUrl" Title="@L["Work:PdfPreview"]" ViewerHeight="Height.Rem(28)" FileName="@SignPdfDownloadName" /></div>
                                }
                                else if (!string.IsNullOrWhiteSpace(signPdfError))
                                {
                                    <p class="hcs-catalog-desc" role="alert">@signPdfError</p>
                                }
                                else if (signPreviewFile is not null)
                                {
                                    <div class="hcs-file-preview-card"><i class="fa fa-file-lines" aria-hidden="true"></i><div class="min-w-0"><strong class="d-block text-truncate">@signPreviewFile.FileName</strong><span class="hcs-catalog-desc">@L["Work:PreviewPdfOnly"]</span></div></div>
                                }
                            }
                        </div>
                    </section>
                </div>
            }
        </ModalBody>
        <ModalFooter Class="hcs-catalog-modal__footer">
            <button class="btn btn-outline" type="button" @onclick="CloseSignAsync">@L["Catalog:Cancel"]</button>
            @if (selected is { } selectedItem)
            {
                <SigningDecisionButtons Show="CanActOn(selectedItem)"
                                        CanReturn="CanReturnOn(selectedItem)"
                                        CanExtend="selectedItem.Task.Status == ApprovalTaskStatus.Pending"
                                        Disabled="@isDecisionPending"
                                        ApproveDisabled="@(!HasValidSelectedSignature)"
                                        ApproveText="@ActionModalTitle(selectedItem)"
                                        OnReturn="ReturnSelectedAsync"
                                        OnExtend="ExtendDueDateAsync"
                                        OnReject="RejectSelectedAsync"
                                        OnApprove="ApproveAsync" />
            }
        </ModalFooter>
    </ModalContent>
</Modal>
<DocumentPdfPreviewModal @ref="previewModal" ShowAssignTask="true" OnAssignTask="AssignFromPreviewAsync">
    <FooterActions>
        @if (previewing is { } previewItem)
        {
            <SigningDecisionButtons Show="CanActOn(previewItem)"
                                    CanReturn="CanReturnOn(previewItem)"
                                    CanExtend="previewItem.Task.Status == ApprovalTaskStatus.Pending"
                                    Disabled="@isDecisionPending"
                                    ApproveText="@SignActionTitle(previewItem)"
                                    OnReturn="ReturnFromPreviewAsync"
                                    OnExtend="ExtendFromPreviewAsync"
                                    OnReject="RejectFromPreviewAsync"
                                    OnApprove="ProcessFromPreviewAsync" />
        }
    </FooterActions>
</DocumentPdfPreviewModal>
<ProjectTaskCreateModal @ref="taskModal" />
<SubmitWorkflowModal @ref="submitModal" OnSubmitted="LoadAsync" />
<WorkflowInfoModal @ref="infoModal" OnPreviewFile="PreviewInfoFileAsync" />
@code {
    [Parameter] public Guid? RelatedId { get; set; }
    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<SigningQueueItem> queue = [];
    private readonly List<ChatContactDto> contacts = [];
    private readonly List<DepartmentCatalogDto> departments = [];
    private readonly SignForm form = new();
    private readonly List<UserSignatureDto> signatures = [];
    private readonly List<SigningCredentialDto> signingCredentials = [];
    private Modal? modal;
    private SubmitWorkflowModal? submitModal;
    private DocumentPdfPreviewModal? previewModal;
    private ProjectTaskCreateModal? taskModal;
    private WorkflowInfoModal? infoModal;
    private SigningQueueItem? selected;
    private SigningQueueItem? previewing;
    private SigningQueueItem? infoItem;
    private SigningReportDto? report;
    private Guid? currentUserId, submitterId, departmentId;
    private string currentUserDisplayName = "";
    private DateTime? fromDate, toDate;
    private string dateFilterField = "IncomingDate";
    private string? signPdfUrl;
    private string? signPdfError;
    private DocumentFileDto? signPreviewFile;
    private string SignPdfDownloadName => selected is null
        ? DocumentDownloadFileName.For(null, null, null, signPreviewFile?.FileName)
        : DocumentDownloadFileName.For(selected.Document, signPreviewFile?.FileName);
    private string approvalSideTab = "history";
    private string filter = "", search = "", inboxFilter = "all", statusFilter = "";
    private bool showSearch, showFilters;
    private readonly Dictionary<Guid, string> workflowUserNames = [];
    private bool isDecisionPending, isLoading = true;
    private int pageSize = 20, currentPage = 1;
    private readonly Dictionary<Guid, Guid> submitterDepartmentIds = [];
    private readonly Dictionary<Guid, string> submitterDisplayNames = [];
    private readonly Dictionary<Guid, string> departmentNamesById = [];
    private bool signatureOptionsLoadFailed, credentialsLoadFailed, isLoadingSigningOptions;

    private int CountAll => queue.Count;
    private int CountToMe => currentUserId is { } me ? queue.Count(x => x.Task.AssigneeUserId == me) : 0;
    private int CountByMe => currentUserId is not null ? queue.Count(IsSentBy) : 0;

    private string SignatureTypeLabel(UserSignatureType type) => type switch
    {
        UserSignatureType.Digital => L["Account:DigitalSignature"].Value,
        _ => L["Account:ElectronicSignature"].Value
    };
    private IReadOnlyList<UserSignatureDto> SignaturesForSelectedKind =>
        signatures.Where(IsUsableSignatureForSelectedKind).ToList();
    private bool SigningOptionsLoadFailed => signatureOptionsLoadFailed
        || (form.Kind != (int)SigningKind.Electronic && credentialsLoadFailed);
    private (string Key, string Label, int Count)[] InboxTabs =>
    [
        ("all", L["Feature:SigningAll"], CountAll),
        ("toMe", L["Feature:SigningSentToMe"], CountToMe),
        ("byMe", L["Feature:SigningSentByMe"], CountByMe)
    ];

    private bool IsSearchFiltered => !string.IsNullOrWhiteSpace(filter) || !string.IsNullOrWhiteSpace(search);
    private bool IsAdvancedFiltered =>
        !string.IsNullOrWhiteSpace(statusFilter)
        || submitterId is not null
        || departmentId is not null
        || fromDate is not null
        || toDate is not null
        || dateFilterField != "IncomingDate";

    private List<SigningQueueItem> VisibleQueue =>
        queue.Where(MatchesFilters).ToList();

    private bool MatchesFilters(SigningQueueItem item)
    {
        if (!string.IsNullOrWhiteSpace(search)
            && !item.Document.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
            && !item.Document.Number.Contains(search, StringComparison.OrdinalIgnoreCase))
            return false;
        if (!string.IsNullOrWhiteSpace(statusFilter) && StatusFilterKey(item) != statusFilter)
            return false;
        var when = DateOf(item);
        if (fromDate is { } fromValue && (when is not { } fromWhen || fromWhen < fromValue.ToUniversalTime()))
            return false;
        if (toDate is { } toValue && (when is not { } toWhen || toWhen > toValue.ToUniversalTime().AddDays(1)))
            return false;
        if (submitterId is { } user && !IsSubmittedBy(item, user))
            return false;
        if (departmentId is { } dept && DepartmentId(item) != dept)
            return false;
        if (inboxFilter == "toMe" && currentUserId is { } me && item.Task.AssigneeUserId != me)
            return false;
        return inboxFilter != "byMe" || IsSentBy(item);
    }

