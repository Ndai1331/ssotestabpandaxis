    private void GoFirstPage() => currentPage = 1;
    private void GoPrevPage() => currentPage = Math.Max(1, currentPage - 1);
    private void GoNextPage() => currentPage = Math.Min(PageCount, currentPage + 1);
    private void GoLastPage() => currentPage = PageCount;
