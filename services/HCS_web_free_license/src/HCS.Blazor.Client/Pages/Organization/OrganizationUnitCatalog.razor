@using Blazorise
@using HCS.OrganizationUnits
@using HCS.Permissions
@inherits HCSComponentBase
@if (isAuthorized)
{
    <section class="page page-wf page-admin-ou" aria-labelledby="organization-unit-title">
        <div class="page-head">
            <div class="page-admin-ou__copy">
                <h1 id="organization-unit-title">@L["OrganizationUnit:Title"]</h1>
                <p>@L["OrganizationUnit:Description"]</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-outline" type="button" @onclick="() => LoadTreeAsync(selectedId)" disabled="@isLoading">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                    @L["Catalog:Refresh"]
                </button>
                @if (canCreate)
                {
                    <button class="btn btn-primary" type="button" @onclick="OpenCreateRootAsync" disabled="@isLoading">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        @L["OrganizationUnit:AddRoot"]
                    </button>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="hcs-admin-alert" role="alert">@errorMessage</div>
        }

        @if (isLoading && !hasLoaded)
        {
            <DocsEmpty Loading="true" Title="@L["OrganizationUnit:Loading"]" />
        }
        else
        {
            <div class="admin-ou-layout">
                <aside class="admin-ou-pane" aria-label='@L["OrganizationUnit:Tree"].Value'>
                    <h2>@L["OrganizationUnit:Tree"]</h2>
                    <div class="admin-ou-tree-scroll">
                        <OrganizationUnitTree Nodes="rootNodes" SelectedId="selectedId"
                                              CanCreate="canCreate" CanUpdate="canUpdate" CanDelete="canDelete"
                                              OpenMenuId="openMenuId" OpenMenuIdChanged="OnOpenMenuIdChanged"
                                              NodeSelected="SelectNodeAsync" ActionRequested="HandleActionAsync" />
                    </div>
                </aside>

                <section class="admin-ou-pane admin-ou-members">
                    @if (selectedNode is null)
                    {
                        <DocsEmpty Compact="true" Title="@L["OrganizationUnit:SelectTitle"]" Hint="@L["OrganizationUnit:SelectDescription"]" />
                    }
                    else
                    {
                        <header class="admin-ou-members__head">
                            <div>
                                <h2>@L["OrganizationUnit:Members"]</h2>
                                <p>@selectedNode.DisplayName · @totalMembers</p>
                            </div>
                            @if (canUpdate)
                            {
                                <button class="btn btn-primary" type="button" @onclick="OpenAddMemberAsync" disabled="@isMembersLoading">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                                    @L["OrganizationUnit:AddMember"]
                                </button>
                            }
                        </header>
                        <form class="docs-toolbar admin-ou-search" @onsubmit="SearchMembersAsync" @onsubmit:preventDefault>
                            <label class="sr-only" for="ou-member-q">@L["OrganizationUnit:SearchPlaceholder"]</label>
                            <input class="input docs-search" id="ou-member-q" type="search" @bind="memberFilter" @bind:event="oninput"
                                   placeholder="@L["OrganizationUnit:SearchPlaceholder"]" autocomplete="off" />
                            <button class="btn btn-primary" type="submit" disabled="@isMembersLoading">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                                @L["OrganizationUnit:Search"]
                            </button>
                        </form>
                        <div class="docs-table-wrap">
                            <div class="docs-table-scroll">
                                <table class="docs-table">
                                    <thead>
                                        <tr>
                                            <th class="col-actions" scope="col">@L["OrganizationUnit:Actions"]</th>
                                            <th scope="col">@L["OrganizationUnit:UserName"]</th>
                                            <th scope="col">@L["OrganizationUnit:Email"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (isMembersLoading)
                                        {
                                            <tr><td colspan="3"><DocsEmpty Loading="true" Compact="true" Title="@L["OrganizationUnit:Loading"]" /></td></tr>
                                        }
                                        else if (members.Count == 0)
                                        {
                                            <tr><td colspan="3" class="admin-ou-table-empty">@L["OrganizationUnit:EmptyMembers"]</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var member in members)
                                            {
                                                <tr>
                                                    <td class="col-actions">
                                                        @if (canUpdate)
                                                        {
                                                            <div class="doc-actions">
                                                                <button class="doc-action is-danger" type="button"
                                                                        title="@L["OrganizationUnit:RemoveMember"]"
                                                                        aria-label="@L["OrganizationUnit:RemoveMember"]"
                                                                        @onclick="() => RemoveMemberAsync(member)">
                                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                                                </button>
                                                            </div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <strong>@(string.IsNullOrWhiteSpace(member.FullName) ? member.UserName : member.FullName)</strong>
                                                        @if (!string.IsNullOrWhiteSpace(member.FullName))
                                                        {
                                                            <small class="admin-ou-username">@member.UserName</small>
                                                        }
                                                    </td>
                                                    <td>@member.Email</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        @if (TotalMemberPages > 1)
                        {
                            <div class="admin-ou-pagination">
                                <button class="btn btn-outline" type="button" @onclick="PreviousMembersPageAsync" disabled="@(currentMemberPage <= 1)">@L["OrganizationUnit:Previous"]</button>
                                <span>@currentMemberPage / @TotalMemberPages</span>
                                <button class="btn btn-outline" type="button" @onclick="NextMembersPageAsync" disabled="@(currentMemberPage >= TotalMemberPages)">@L["OrganizationUnit:Next"]</button>
                            </div>
                        }
                    }
                </section>
            </div>
        }
    </section>

    <Modal @ref="unitModal">
        <ModalContent Centered Class="hcs-catalog-modal">
            <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@UnitModalTitle</ModalTitle><CloseButton Clicked="CloseUnitModalAsync" /></ModalHeader>
            <ModalBody Class="hcs-catalog-modal__body">
                <Field>
                    <FieldLabel>@L["OrganizationUnit:Name"] *</FieldLabel>
                    <HcsIsolatedTextInput @bind-Value="unitForm.DisplayName" Name="hcsOuName" MaxLength="128" Autofocus="true" />
                </Field>
            </ModalBody>
            <ModalFooter Class="hcs-catalog-modal__footer">
                <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="CloseUnitModalAsync">@L["Catalog:Cancel"]</Button>
                <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveUnitAsync" Disabled="@isSaving">@L["Catalog:SaveChanges"]</Button>
            </ModalFooter>
        </ModalContent>
    </Modal>

    <Modal @ref="moveModal">
        <ModalContent Centered Class="hcs-catalog-modal">
            <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@L["OrganizationUnit:Move"]</ModalTitle><CloseButton Clicked="CloseMoveModalAsync" /></ModalHeader>
            <ModalBody Class="hcs-catalog-modal__body">
                <Field><FieldLabel>@L["OrganizationUnit:Parent"]</FieldLabel>
                    <select class="form-select" @bind="moveTargetValue">
                        <option value="">@L["OrganizationUnit:Root"]</option>
                        @foreach (var target in MoveTargetOptions)
                        {
                            <option value="@target.Id.ToString("D")">@target.DisplayName</option>
                        }
                    </select>
                </Field>
            </ModalBody>
            <ModalFooter Class="hcs-catalog-modal__footer">
                <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="CloseMoveModalAsync">@L["Catalog:Cancel"]</Button>
                <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="MoveUnitAsync" Disabled="@isSaving">@L["OrganizationUnit:Move"]</Button>
            </ModalFooter>
        </ModalContent>
    </Modal>

    <Modal @ref="moveAllModal">
        <ModalContent Centered Class="hcs-catalog-modal">
            <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@L["OrganizationUnit:MoveAllMembers"]</ModalTitle><CloseButton Clicked="CloseMoveAllModalAsync" /></ModalHeader>
            <ModalBody Class="hcs-catalog-modal__body">
                <Field><FieldLabel>@L["OrganizationUnit:Target"]</FieldLabel>
                    <select class="form-select" @bind="moveAllTargetValue">
                        @foreach (var target in MoveAllTargetOptions)
                        {
                            <option value="@target.Id.ToString("D")">@target.DisplayName</option>
                        }
                    </select>
                </Field>
            </ModalBody>
            <ModalFooter Class="hcs-catalog-modal__footer">
                <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="CloseMoveAllModalAsync">@L["Catalog:Cancel"]</Button>
                <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="MoveAllMembersAsync" Disabled="@isSaving">@L["OrganizationUnit:MoveAllMembers"]</Button>
            </ModalFooter>
        </ModalContent>
    </Modal>

    <Modal @ref="memberModal" Size="ModalSize.Large">
        <ModalContent Centered Class="hcs-catalog-modal">
            <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@L["OrganizationUnit:AddMember"]</ModalTitle><CloseButton Clicked="CloseMemberModalAsync" /></ModalHeader>
            <ModalBody Class="hcs-catalog-modal__body">
                <form class="docs-toolbar admin-ou-search" @onsubmit="SearchAvailableMembersAsync" @onsubmit:preventDefault>
                    <input class="input docs-search" type="search" @bind="availableMemberFilter" @bind:event="oninput"
                           placeholder="@L["OrganizationUnit:SearchPlaceholder"]" autocomplete="off" />
                    <button class="btn btn-primary" type="submit">@L["OrganizationUnit:Search"]</button>
                </form>
                <select class="form-select" @bind="selectedAvailableMemberValue">
                    <option value="">@L["OrganizationUnit:ChooseMember"]</option>
                    @foreach (var member in availableMembers)
                    {
                        <option value="@member.Id.ToString("D")">@member.FullName (@member.UserName)</option>
                    }
                </select>
            </ModalBody>
            <ModalFooter Class="hcs-catalog-modal__footer">
                <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="CloseMemberModalAsync">@L["Catalog:Cancel"]</Button>
                <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="AddMemberAsync" Disabled="@isSaving">@L["OrganizationUnit:AddMember"]</Button>
            </ModalFooter>
        </ModalContent>
    </Modal>
}
else
{
    <div class="hcs-empty py-5">
        <i class="fa fa-lock" aria-hidden="true"></i>
        <h2>@L["Catalog:ForbiddenTitle"]</h2>
        <p>@L["Catalog:ForbiddenDescription"]</p>
    </div>
}
