@using HCS.Permissions
@using Microsoft.AspNetCore.Authorization
@inherits HCSComponentBase

@if (isAuthorized)
{
        <section class="page page-wf page-dm" aria-labelledby="catalog-title">
            <div class="page-head">
                <h1 id="catalog-title">@Definition.Title</h1>
                <div class="page-actions">
                    @if (errorCanRetry)
                    {
                        <button class="btn btn-outline" type="button" @onclick="RefreshAsync">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                            @L["Catalog:Retry"]
                        </button>
                    }
                    <button class="btn btn-outline" type="button" @onclick="ExportCurrentPageAsync" disabled="@(!rows.Any() || isLoading)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/></svg>
                        @L["Catalog:Export"]
                    </button>
                    @if (canCreate)
                    {
                        <button class="btn btn-primary" type="button" @onclick="OpenCreateModalAsync" disabled="@isSaving">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                            @L["Catalog:New"]
                        </button>
                    }
                </div>
            </div>

            <section class="docs-main">
                <form class="docs-toolbar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                    <label class="sr-only" for="dm-q">@L["Catalog:SearchPlaceholder"]</label>
                    <input class="input docs-search" id="dm-q" type="search" @bind="filterText" @bind:event="oninput"
                           placeholder="@L["Catalog:SearchPlaceholder"]" autocomplete="off" />
                    <button class="btn btn-primary" type="submit" disabled="@isLoading">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                        @L["Catalog:SearchButton"]
                    </button>
                    <HcsDismissible Class="filter-pop" @bind-IsOpen="showAdvancedFilters">
                        <button class="btn btn-outline @(string.IsNullOrEmpty(statusFilter) ? null : "is-filtered")" type="button"
                                aria-expanded="@showAdvancedFilters.ToString().ToLowerInvariant()"
                                aria-controls="dm-filter-menu" @onclick="ToggleAdvancedFilters">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                            @L["Catalog:Filter"]
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                        <div class="filter-menu @(showAdvancedFilters ? "is-open" : null)" id="dm-filter-menu" role="menu">
                            <button type="button" class="@(string.IsNullOrEmpty(statusFilter) ? "is-active" : null)" @onclick="FilterAllAsync">@L["Catalog:AllStatuses"]</button>
                            <button type="button" class="@(statusFilter == "true" ? "is-active" : null)" @onclick="FilterActiveAsync">@L["Catalog:Active"]</button>
                            <button type="button" class="@(statusFilter == "false" ? "is-active" : null)" @onclick="FilterInactiveAsync">@L["Catalog:Inactive"]</button>
                        </div>
                    </HcsDismissible>
                </form>

                <div class="docs-table-wrap">
                    @if (isLoading && rows.Count == 0)
                    {
                        <DocsEmpty Loading="true" />
                    }
                    else if (rows.Count == 0)
                    {
                        <DocsEmpty Hint="@L["Catalog:EmptyDescription"]" />
                    }
                    else
                    {
                        <table class="docs-table">
                            <thead>
                                <tr>
                                    @if (Definition.Kind == OrganizationCatalogKind.MasterData && !Definition.IsTypedMasterData)
                                    {
                                        <th scope="col">@L["Catalog:Type"]</th>
                                    }
                                    <th scope="col">@L["Catalog:Code"]</th>
                                    <th scope="col">@L["Catalog:Name"]</th>
                                    @if (Definition.Kind is OrganizationCatalogKind.Department or OrganizationCatalogKind.Unit)
                                    {
                                        <th scope="col">@RelationColumnTitle</th>
                                    }
                                    @if (Definition.Kind == OrganizationCatalogKind.Position)
                                    {
                                        <th scope="col">@L["Catalog:SignOrder"]</th>
                                    }
                                    <th scope="col">@L["Catalog:SortOrder"]</th>
                                    <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                                    @if (canUpdate || canDelete)
                                    {
                                        <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in rows)
                            {
                                <tr @key="row.Id">
                                    @if (Definition.Kind == OrganizationCatalogKind.MasterData && !Definition.IsTypedMasterData)
                                    {
                                        <td>@row.Type</td>
                                    }
                                    <td class="doc-code">@row.Code</td>
                                    <td>@row.Name</td>
                                    @if (Definition.Kind is OrganizationCatalogKind.Department or OrganizationCatalogKind.Unit)
                                    {
                                        <td>@RelationName(row.RelationId)</td>
                                    }
                                    @if (Definition.Kind == OrganizationCatalogKind.Position)
                                    {
                                        <td>@row.SignOrder</td>
                                    }
                                    <td>@row.SortOrder</td>
                                    <td>
                                        <span class="dm-status @(row.IsActive ? "is-on" : "is-off")" title="@(row.IsActive ? L["Catalog:Active"] : L["Catalog:Inactive"])">
                                            @if (row.IsActive)
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                                            }
                                            else
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                                            }
                                            <span class="visually-hidden">@(row.IsActive ? L["Catalog:Active"] : L["Catalog:Inactive"])</span>
                                        </span>
                                    </td>
                                    @if (canUpdate || canDelete)
                                    {
                                        <td>
                                            <div class="doc-actions">
                                                @if (canUpdate)
                                                {
                                                    <button class="doc-action" type="button" title="@L["Catalog:Edit"]" aria-label="@L["Catalog:Edit"]" @onclick="() => OpenEditModalAsync(row)">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                                    </button>
                                                }
                                                @if (canDelete)
                                                {
                                                    <button class="doc-action is-danger" type="button" title="@L["Catalog:Delete"]" aria-label="@L["Catalog:Delete"]" disabled="@isDeleting.Contains(row.Id)" @onclick="() => DeleteAsync(row)">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    <div class="pager" aria-label="@L["Catalog:PageSize"]">
                        <button type="button" disabled="@(!CanPrev)" @onclick="GoFirst">@L["Catalog:PagerFirst"]</button>
                        <button type="button" disabled="@(!CanPrev)" @onclick="GoPrev">@L["Catalog:PagerPrev"]</button>
                        <button type="button" disabled="@(!CanNext)" @onclick="GoNext">@L["Catalog:PagerNext"]</button>
                        <button type="button" disabled="@(!CanNext)" @onclick="GoLast">@L["Catalog:PagerLast"]</button>
                        <label class="sr-only" for="dm-page-size">@L["Catalog:PageSize"]</label>
                        <select id="dm-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                            @foreach (var size in pageSizes)
                            {
                                <option value="@size">@size</option>
                            }
                        </select>
                    </div>
                </div>
            </section>
        </section>

        <Modal @ref="editModal" Size="ModalSize.Default">
            <ModalContent Centered="true" Class="hcs-catalog-modal">
                <ModalHeader Class="hcs-catalog-modal__header">
                    <ModalTitle>@(editingId.HasValue ? L["Catalog:EditTitle"] : L["Catalog:CreateTitle"]) @Definition.Title</ModalTitle>
                    <CloseButton Clicked="CloseModalAsync" />
                </ModalHeader>
                <ModalBody Class="hcs-catalog-modal__body">
                    <Validations @ref="validations" Mode="ValidationMode.Auto" Model="@form" ValidateOnLoad="false">
                        <div class="hcs-catalog-form">
                        @if (Definition.Kind == OrganizationCatalogKind.MasterData && !Definition.IsTypedMasterData)
                        {
                            <Validation>
                                <Field>
                                    <FieldLabel>@L["Catalog:Type"] *</FieldLabel>
                                    <Select TValue="string" @bind-Value="form.Type" Class="hcs-catalog-select">
                                        <SelectItem Value="@string.Empty">@L["Catalog:ChooseType"]</SelectItem>
                                        @foreach (var masterType in MasterTypeOptions)
                                        {
                                            <SelectItem Value="@masterType.Type">@L[masterType.TitleKey]</SelectItem>
                                        }
                                    </Select>
                                </Field>
                            </Validation>
                        }

                        @if (Definition.Kind == OrganizationCatalogKind.Department)
                        {
                            <Field>
                                <FieldLabel>@L["Catalog:ParentDepartment"]</FieldLabel>
                                <CatalogSelect2 Value="@ParseOptionalGuid(form.ParentId)"
                                                ValueChanged="OnParentDepartmentChanged"
                                                Placeholder="@L["Catalog:NoParent"]"
                                                SelectedItem="@DepartmentSelectItem(form.ParentId)"
                                                Search="SearchParentDepartmentsAsync" />
                                <FieldHelp>@L["Catalog:ParentDepartmentHelp"]</FieldHelp>
                            </Field>
                        }

                        @if (Definition.Kind == OrganizationCatalogKind.Unit)
                        {
                            <Field>
                                <FieldLabel>@L["Catalog:Department"] *</FieldLabel>
                                <CatalogSelect2 Value="@ParseOptionalGuid(form.DepartmentId)"
                                                ValueChanged="OnDepartmentChanged"
                                                Placeholder="@L["Catalog:ChooseDepartment"]"
                                                SelectedItem="@DepartmentSelectItem(form.DepartmentId)"
                                                Search="SearchDepartmentsAsync" />
                            </Field>
                        }

                        <div class="hcs-form-row">
                        @* HcsIsolatedTextInput is a plain input — do not wrap in Blazorise Validation
                           (ValidateAll requires IValidationInput and throws "Input component is not assigned"). *@
                        <Field>
                            <FieldLabel>@L["Catalog:Code"] *</FieldLabel>
                            <HcsIsolatedTextInput @bind-Value="form.Code"
                                                 Name="hcsCatalogCode"
                                                 MaxLength="50"
                                                 Autofocus="true"
                                                 CssClass="form-control hcs-catalog-input hcs-catalog-input--code" />
                        </Field>
                        <Field>
                            <FieldLabel>@L["Catalog:Name"] *</FieldLabel>
                            <HcsIsolatedTextInput @bind-Value="form.Name" Name="hcsCatalogName" MaxLength="256" CssClass="form-control hcs-catalog-input" />
                        </Field>
                        </div>
                        @if (Definition.Kind == OrganizationCatalogKind.Position)
                        {
                            <Validation>
                                <Field>
                                    <FieldLabel>@L["Catalog:SignOrder"]</FieldLabel>
                                    <NumericPicker TValue="int" @bind-Value="form.SignOrder" Min="0" Max="100" Decimals="0" Class="hcs-catalog-input" />
                                </Field>
                            </Validation>
                        }
                        <Validation>
                            <Field>
                                <FieldLabel>@L["Catalog:SortOrder"]</FieldLabel>
                                <NumericPicker TValue="int" @bind-Value="form.SortOrder" Min="0" Max="10000" Decimals="0" Class="hcs-catalog-input" />
                            </Field>
                        </Validation>
                        <Field Class="hcs-catalog-active-field">
                            <Check TValue="bool" @bind-Value="form.IsActive">@L["Catalog:Active"]</Check>
                        </Field>
                        </div>
                    </Validations>
                </ModalBody>
                <ModalFooter Class="hcs-catalog-modal__footer">
                    <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="CloseModalAsync">@L["Catalog:Cancel"]</Button>
                    <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveAsync" Loading="@isSaving" Disabled="@isSaving">
                        @(editingId.HasValue ? L["Catalog:SaveChanges"] : L["Catalog:Create"])
                    </Button>
                </ModalFooter>
            </ModalContent>
        </Modal>
}
else
{
        <div class="hcs-empty py-5">
            <i class="fa fa-lock" aria-hidden="true"></i>
            <h2>@L["Catalog:ForbiddenTitle"]</h2>
            <p>@L["Catalog:ForbiddenDescription"]</p>
        </div>
}
