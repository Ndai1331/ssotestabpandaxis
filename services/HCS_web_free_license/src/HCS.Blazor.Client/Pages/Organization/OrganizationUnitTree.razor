@using Microsoft.AspNetCore.Components
@inherits HCSComponentBase

@if (Nodes.Count == 0)
{
    <div class="hcs-ou-tree__empty">@L["OrganizationUnit:EmptyTree"]</div>
}
else
{
    <div class="hcs-ou-tree" role="tree" aria-label='@L["OrganizationUnit:Tree"].Value'>
        @foreach (var node in Nodes)
        {
            <div class="hcs-ou-tree__branch" role="treeitem" aria-expanded="@(node.HasChildren ? node.IsExpanded : null)">
                <div class="hcs-ou-tree__row @(SelectedId == node.Id ? "is-selected" : null)">
                    @if (node.HasChildren)
                    {
                        <button type="button" class="hcs-ou-tree__expand" @onclick="@(() => ToggleAsync(node))" @onclick:stopPropagation
                                aria-label='@L["OrganizationUnit:ToggleChildren"]'>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                @if (node.IsExpanded)
                                {
                                    <path d="m6 9 6 6 6-6" />
                                }
                                else
                                {
                                    <path d="m9 6 6 6-6 6" />
                                }
                            </svg>
                        </button>
                    }
                    else
                    {
                        <span class="hcs-ou-tree__expand-placeholder" aria-hidden="true"></span>
                    }

                    <button type="button" class="hcs-ou-tree__node" @onclick="@(() => SelectAsync(node))">
                        <span class="hcs-ou-tree__label">@node.DisplayName</span>
                    </button>

                    @if (CanCreate || CanUpdate || CanDelete)
                    {
                        <HcsDismissible Class="@($"hcs-more-pop hcs-ou-tree__actions {(OpenMenuId == node.Id ? "is-open" : null)}")"
                                        IsOpen="OpenMenuId == node.Id"
                                        OnClose="CloseMenuAsync"
                                        @onclick:stopPropagation="true">
                            <button class="msg-more" type="button" aria-haspopup="menu"
                                    aria-expanded="@(OpenMenuId == node.Id ? "true" : "false")"
                                    aria-label='@L["OrganizationUnit:Actions"].Value'
                                    @onclick="() => ToggleMenuAsync(node.Id)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="5" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="12" cy="19" r="1.3"/></svg>
                            </button>
                            @if (OpenMenuId == node.Id)
                            {
                                <div class="hcs-ou-tree__menu" role="menu" aria-label='@L["OrganizationUnit:Actions"].Value'>
                                    @if (CanCreate)
                                    {
                                        <button type="button" role="menuitem" @onclick="() => RequestAsync(node, OrganizationUnitAction.AddSubUnit)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                                            @L["OrganizationUnit:AddSubUnit"]
                                        </button>
                                    }
                                    @if (CanUpdate)
                                    {
                                        <button type="button" role="menuitem" @onclick="() => RequestAsync(node, OrganizationUnitAction.Edit)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                            @L["OrganizationUnit:Edit"]
                                        </button>
                                        <button type="button" role="menuitem" @onclick="() => RequestAsync(node, OrganizationUnitAction.Move)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 9h14M5 15h14M9 5v14M15 5v14"/></svg>
                                            @L["OrganizationUnit:Move"]
                                        </button>
                                        <button type="button" role="menuitem" @onclick="() => RequestAsync(node, OrganizationUnitAction.MoveAllMembers)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                            @L["OrganizationUnit:MoveAllMembers"]
                                        </button>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="is-danger" type="button" role="menuitem" @onclick="() => RequestAsync(node, OrganizationUnitAction.Delete)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                            @L["OrganizationUnit:Delete"]
                                        </button>
                                    }
                                </div>
                            }
                        </HcsDismissible>
                    }
                </div>

                @if (node.IsExpanded && node.HasChildren)
                {
                    <div class="hcs-ou-tree__children">
                        <OrganizationUnitTree Nodes="node.Children" SelectedId="SelectedId"
                                              CanCreate="CanCreate" CanUpdate="CanUpdate" CanDelete="CanDelete"
                                              OpenMenuId="OpenMenuId" OpenMenuIdChanged="OpenMenuIdChanged"
                                              NodeSelected="NodeSelected" ActionRequested="ActionRequested" />
                    </div>
                }
            </div>
        }
    </div>
}
