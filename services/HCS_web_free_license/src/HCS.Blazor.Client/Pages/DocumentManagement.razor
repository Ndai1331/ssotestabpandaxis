@page "/manage-documents"
@page "/my-documents"
@page "/document-assignments"
@page "/document-files"
@page "/document-histories"
@attribute [Authorize(Policy = "Documents.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject OrganizationCatalogClient Catalog
@inject NavigationManager Navigation
@implements IDisposable
@using System.Threading
@using HCS.Permissions

<PageTitle>@PageTitle · HCS</PageTitle>
<section class="page page-wf page-vb" @key="SourceType" aria-labelledby="docs-title">
    <div class="page-head">
        <h1 id="docs-title">@PageTitle</h1>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="LoadAsync" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                @L["Catalog:Refresh"]
            </button>
            @if (CanCreate)
            {
                <button class="btn btn-primary" type="button" @onclick="OpenCreate">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    @L["Catalog:New"]
                </button>
            }
            <button class="btn btn-outline @(showSearch ? "is-open" : null) @(IsSearchFiltered ? "is-filtered" : null)"
                    type="button" aria-expanded="@showSearch.ToString().ToLowerInvariant()"
                    aria-controls="docs-search-form" @onclick="ToggleSearch">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:Search"]
            </button>
            <HcsDismissible Class="filter-pop" @bind-IsOpen="showFilters">
                <button class="btn btn-outline @(showFilters ? "is-open" : null) @(IsAdvancedFiltered ? "is-filtered" : null)" type="button"
                        aria-expanded="@showFilters.ToString().ToLowerInvariant()"
                        aria-controls="docs-filter-panel" @onclick="ToggleFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                    @L["Catalog:Filter"]
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <form class="docs-filter-pop @(showFilters ? "is-open" : null)" id="docs-filter-panel" hidden="@(!showFilters)"
                      @onsubmit="SearchAsync" @onsubmit:preventDefault>
                    <div class="vb-field-row">
                        <div class="filter-menu-field">
                            <label class="field-label" for="docs-status-filter">@L["Catalog:Status"]</label>
                            <select class="select input" id="docs-status-filter" @bind="statusFilter">
                                <option value="">@L["Catalog:AllStatuses"]</option>
                                @foreach (var status in Enum.GetValues<DocumentStatus>())
                                {
                                    <option value="@status">@L[DocumentStatusUi.TextKey(status)]</option>
                                }
                            </select>
                        </div>
                        <div class="filter-menu-field">
                            <label class="field-label" for="docs-sector-filter">@L["Menu:Sectors"]</label>
                            <select class="select input" id="docs-sector-filter" @bind="sectorFilter">
                                <option value="">@L["Catalog:AllStatuses"]</option>
                                @foreach (var item in sectors)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="vb-field-row">
                        <div class="filter-menu-field">
                            <label class="field-label" for="docs-urgency-filter">@L["Menu:UrgencyLevels"]</label>
                            <select class="select input" id="docs-urgency-filter" @bind="urgencyFilter">
                                <option value="">@L["Catalog:AllStatuses"]</option>
                                @foreach (var item in urgencies)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                        </div>
                        <div class="filter-menu-field">
                            <label class="field-label" for="docs-confidentiality-filter">@L["Menu:ConfidentialityLevels"]</label>
                            <select class="select input" id="docs-confidentiality-filter" @bind="confidentialityFilter">
                                <option value="">@L["Catalog:AllStatuses"]</option>
                                @foreach (var item in confidentialities)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="vb-field-row">
                        <div class="filter-menu-field">
                            <label class="field-label">@L["Feature:StartDate"]</label>
                            <HcsDatePicker TValue="DateTime?" @bind-Value="fromDate" />
                        </div>
                        <div class="filter-menu-field">
                            <label class="field-label">@L["Feature:EndDate"]</label>
                            <HcsDatePicker TValue="DateTime?" @bind-Value="toDate" />
                        </div>
                    </div>
                    <div class="docs-filter-actions">
                        <button class="btn btn-outline" type="button" @onclick="ResetSearchAsync">@L["Catalog:Reset"]</button>
                        <button class="btn btn-primary" type="submit" disabled="@isLoading">@L["Catalog:SearchButton"]</button>
                    </div>
                </form>
            </HcsDismissible>
        </div>
    </div>

    <div class="docs-layout">
        <aside class="docs-side" aria-label="@L["Menu:DocumentTypes"]">
            <button class="docs-cat @(selectedTypeId is null ? "is-active" : null)" type="button" @onclick="() => SelectType(null)">
                @L["Catalog:AllStatuses"]
            </button>
            @foreach (var type in documentTypes)
            {
                <button class="docs-cat @(selectedTypeId == type.Id ? "is-active" : null)" type="button" @onclick="() => SelectType(type.Id)">
                    @type.Name
                </button>
            }
        </aside>

        <section class="docs-main">
            <form class="docs-toolbar list-search" id="docs-search-form" hidden="@(!showSearch)" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <label class="sr-only" for="docs-q">@L["Work:SearchByTitleOrNumber"]</label>
                <input class="input docs-search" id="docs-q" type="search" @bind="filter" @bind:event="oninput"
                       placeholder="@L["Work:SearchByTitleOrNumber"]" autocomplete="off" />
                <button class="btn btn-primary" type="submit" disabled="@isLoading">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                    @L["Catalog:SearchButton"]
                </button>
            </form>

            <div class="docs-table-wrap">
                @if (isLoading && items.Count == 0)
                {
                    <DocsEmpty Loading="true" />
                }
                else if (items.Count == 0)
                {
                    <DocsEmpty Hint="@L["Catalog:EmptyDescription"]" />
                }
                else
                {
                    <table class="docs-table">
                        <thead>
                            <tr>
                                <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                                <th scope="col">@L["Feature:DocumentTitleField"]</th>
                                <th scope="col">@L["Feature:DocumentCode"]</th>
                                <th scope="col">@L["Feature:ArchiveNumber"]</th>
                                <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                                <th scope="col">@L["Catalog:DocumentTypeTitle"]</th>
                                <th scope="col">@L["Catalog:SectorTitle"]</th>
                                @if (!IsInbox)
                                {
                                    <th scope="col">@L["Feature:Sent"]</th>
                                }
                                <th scope="col">@L["Feature:Files"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in items)
                        {
                            <tr @key="item.Id">
                                <td class="col-actions">
                                    <div class="doc-actions">
                                        <button class="doc-action" type="button" title="@L["Work:PdfPreview"]" aria-label="@L["Work:PdfPreview"]" @onclick="() => PreviewAsync(item)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </button>
                                        @if (!IsInbox)
                                        {
                                            <a class="doc-action" href="@DetailHref(item.Id)" title="@L["Catalog:Edit"]" aria-label="@L["Catalog:Edit"]">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                            </a>
                                        }
                                        @if (IsInbox)
                                        {
                                            <button class="doc-action" type="button" title="@L["Feature:SendDocument"]" aria-label="@L["Feature:SendDocument"]" @onclick="() => OpenSend(item)" disabled="@IsMutating(item.Id)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg>
                                            </button>
                                        }
                                        @if (CanManage)
                                        {
                                            <AuthorizeView Policy="Documents.Assign">
                                                <Authorized>
                                                    <button class="doc-action" type="button" title="@L["Feature:SendDocument"]" aria-label="@L["Feature:SendDocument"]" @onclick="() => OpenSend(item)" disabled="@IsMutating(item.Id)">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg>
                                                    </button>
                                                    @if (item.IsSent)
                                                    {
                                                        <button class="doc-action" type="button" title="@L["Feature:RevokeSend"]" aria-label="@L["Feature:RevokeSend"]" @onclick="() => RevokeAsync(item)" disabled="@IsMutating(item.Id)">
                                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 1 1 0 11H11"/></svg>
                                                        </button>
                                                    }
                                                </Authorized>
                                            </AuthorizeView>
                                            <AuthorizeView Policy="Documents.Workflow.Start">
                                                <Authorized>
                                                    <button class="doc-action" type="button" title="@L["Work:SubmitWorkflow"]" aria-label="@L["Work:SubmitWorkflow"]" @onclick="() => OpenSubmit(item)" disabled="@IsMutating(item.Id)">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/></svg>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                            <AuthorizeView Policy="Documents.Update">
                                                <Authorized>
                                                    <button class="doc-action is-danger" type="button" title="@L["Catalog:Delete"]" aria-label="@L["Catalog:Delete"]" @onclick="() => DeleteAsync(item)" disabled="@IsMutating(item.Id)">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="doc-title" title="@item.Title">
                                        @if (IsInbox)
                                        {
                                            <button type="button" class="doc-title-open" @onclick="() => PreviewAsync(item)">
                                                <strong>@item.Title</strong>
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="@DetailHref(item.Id)"><strong>@item.Title</strong></a>
                                        }
                                        <span>@item.CreationTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </td>
                                <td><span class="doc-code">@(string.IsNullOrWhiteSpace(item.DocumentCode) ? "—" : item.DocumentCode)</span></td>
                                <td><span class="doc-code">#@item.Number</span></td>
                                <td>
                                    <span class="badge @DocumentStatusBadge(item.Status)">@L[DocumentStatusUi.TextKey(item.Status)]</span>
                                </td>
                                <td>@CatalogName(documentTypes, item.DocumentTypeId)</td>
                                <td>@CatalogName(sectors, item.SectorId)</td>
                                @if (!IsInbox)
                                {
                                    <td>@(item.IsSent ? L["Catalog:Yes"] : L["Catalog:No"])</td>
                                }
                                <td>@item.FileCount</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                <div class="pager" aria-label="@L["Catalog:PageSize"]">
                    <button type="button" disabled="@(!CanPrev || isLoading)" @onclick="GoFirst">@L["Catalog:PagerFirst"]</button>
                    <button type="button" disabled="@(!CanPrev || isLoading)" @onclick="GoPrev">@L["Catalog:PagerPrev"]</button>
                    <button type="button" disabled="@(!CanNext || isLoading)" @onclick="GoNext">@L["Catalog:PagerNext"]</button>
                    <button type="button" disabled="@(!CanNext || isLoading)" @onclick="GoLast">@L["Catalog:PagerLast"]</button>
                    <label class="sr-only" for="docs-page-size">@L["Catalog:PageSize"]</label>
                    <select id="docs-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                        @foreach (var size in pageSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>
            </div>
        </section>
    </div>
</section>

<DocumentPdfPreviewModal @ref="previewModal" ShowAssignTask="true" OnAssignTask="AssignFromPreviewAsync" />
<ProjectTaskCreateModal @ref="taskModal" />
<SubmitWorkflowModal @ref="submitModal" OnSubmitted="LoadAsync" />
<SendDocumentModal @ref="sendModal" OnSent="LoadAsync" />

@code {
    [SupplyParameterFromQuery(Name = "sourceType")] public int? SourceTypeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "preview")] public Guid? PreviewDocumentId { get; set; }

    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<DocumentDto> items = [];
    private readonly List<MasterDataCatalogDto> documentTypes = [];
    private readonly List<MasterDataCatalogDto> sectors = [];
    private readonly List<MasterDataCatalogDto> urgencies = [];
    private readonly List<MasterDataCatalogDto> confidentialities = [];
    private readonly HashSet<Guid> mutatingIds = [];
    private DocumentPdfPreviewModal? previewModal;
    private ProjectTaskCreateModal? taskModal;
    private SubmitWorkflowModal? submitModal;
    private SendDocumentModal? sendModal;
    private DocumentDto? previewing;
    private Guid? selectedTypeId;
    private string filter = "", statusFilter = "", sectorFilter = "", urgencyFilter = "", confidentialityFilter = "";
    private DateTime? fromDate, toDate;
    private bool showFilters, showSearch, catalogsLoaded, isLoading;
    private int lastLoadedSource = int.MinValue;
    private Guid? openedPreviewId;
    private int loadGeneration, totalCount, pageSize = 20, currentPage = 1;

    private int SourceType
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (relative.Contains("my-documents", StringComparison.OrdinalIgnoreCase)) return 1;
            if (SourceTypeQuery is >= 0 and <= 2) return SourceTypeQuery.Value;
            return 0;
        }
    }
    private bool canManageArchive;
    private bool CanCreate => canManageArchive && SourceType is 0 or 1;
    private bool CanManage => canManageArchive && SourceType is 0 or 1;
    private bool IsInbox => SourceType == 2;
    private string PageTitle => SourceType switch
    {
        1 => L["Menu:DocumentsICreated"],
        2 => L["Menu:MyDocuments"],
        _ => L["Menu:DocumentList"]
    };
    private bool IsSearchFiltered => !string.IsNullOrWhiteSpace(filter);
    private bool IsAdvancedFiltered =>
        !string.IsNullOrWhiteSpace(statusFilter)
        || !string.IsNullOrWhiteSpace(sectorFilter)
        || !string.IsNullOrWhiteSpace(urgencyFilter)
        || !string.IsNullOrWhiteSpace(confidentialityFilter)
        || fromDate is not null
        || toDate is not null;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < PageCount;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;
    protected override async Task OnParametersSetAsync()
    {
        canManageArchive = await AuthorizationService.IsGrantedAsync(HCSPermissions.Documents.Create);
        await ReloadIfSourceChangedAsync(resetFilter: lastLoadedSource != int.MinValue);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) => await OpenInboxPreviewFromQueryAsync();
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(async () =>
        {
            await ReloadIfSourceChangedAsync(resetFilter: true);
            await OpenInboxPreviewFromQueryAsync();
        });
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private async Task ReloadIfSourceChangedAsync(bool resetFilter)
    {
        var source = SourceType;
        if (source is 0 or 1 && !canManageArchive)
        {
            Navigation.NavigateTo("/manage-documents?sourceType=2", replace: true);
            return;
        }
        if (source == lastLoadedSource) return;
        if (resetFilter) ResetFilters();
        lastLoadedSource = source;
        currentPage = 1;
        await EnsureCatalogsAsync();
        await LoadAsync();
    }

    private async Task EnsureCatalogsAsync()
    {
        if (catalogsLoaded) return;
        catalogsLoaded = true;
        var query = new OrganizationCatalogQuery(null, true, 0, 100);
        try
        {
            documentTypes.AddRange((await Catalog.GetMasterDataAsync("DocumentType", query)).Items);
            sectors.AddRange((await Catalog.GetMasterDataAsync("Sector", query)).Items);
            urgencies.AddRange((await Catalog.GetMasterDataAsync("UrgencyLevel", query)).Items);
            confidentialities.AddRange((await Catalog.GetMasterDataAsync("ConfidentialityLevel", query)).Items);
        }
        catch { /* catalog permission is optional */ }
    }

    private void ToggleSearch()
    {
        showSearch = !showSearch;
        if (showSearch) showFilters = false;
    }
    private void ToggleFilters()
    {
        showFilters = !showFilters;
        if (showFilters) showSearch = false;
    }
    private Task SearchAsync() { currentPage = 1; return LoadAsync(); }
    private Task ResetSearchAsync() { ResetFilters(); showFilters = false; currentPage = 1; return LoadAsync(); }
    private void ResetFilters()
    {
        filter = statusFilter = sectorFilter = urgencyFilter = confidentialityFilter = "";
        fromDate = toDate = null;
        selectedTypeId = null;
    }
    private Task SelectType(Guid? id) { selectedTypeId = id; currentPage = 1; return LoadAsync(); }

    private Task GoFirst() { currentPage = 1; return LoadAsync(); }
    private Task GoPrev() { currentPage = Math.Max(1, currentPage - 1); return LoadAsync(); }
    private Task GoNext() { currentPage = Math.Min(PageCount, currentPage + 1); return LoadAsync(); }
    private Task GoLast() { currentPage = PageCount; return LoadAsync(); }
    private Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return Task.CompletedTask;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        var generation = Interlocked.Increment(ref loadGeneration);
        isLoading = true;
        try
        {
            var search = CombinedFilter();
            DocumentStatus? status = Enum.TryParse<DocumentStatus>(statusFilter, out var parsed) ? parsed : null;
            var page = await Documents.GetDocumentsAsync(new DocumentListQuery(
                search, status?.ToString(), SourceType == 1, (currentPage - 1) * pageSize, pageSize, SourceType,
                selectedTypeId, ParseGuid(sectorFilter), ParseGuid(urgencyFilter), ParseGuid(confidentialityFilter),
                fromDate, toDate));
            if (generation != loadGeneration) return;
            items.Clear(); items.AddRange(page.Items);
            totalCount = (int)page.TotalCount;
        }
        catch (Exception ex) { if (generation == loadGeneration) await NotifyErrorAsync(ex); }
        finally { if (generation == loadGeneration) isLoading = false; }
    }

    private string? CombinedFilter() => SearchText.NormalizeOrNull(filter);

    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : null;
    private static string CatalogName(IEnumerable<MasterDataCatalogDto> items, Guid? id) =>
        id is { } value ? items.FirstOrDefault(x => x.Id == value)?.Name ?? "—" : "—";
    private static string DocumentStatusBadge(DocumentStatus status) => status switch
    {
        DocumentStatus.Approved => "badge-success",
        DocumentStatus.Rejected => "badge-danger",
        DocumentStatus.InReview or DocumentStatus.Submitted => "badge-warning",
        DocumentStatus.Archived => "badge-muted",
        _ => "badge-info"
    };
    private string DetailHref(Guid id) => $"/document-detail/{id}?sourceType={SourceType}";
    private void OpenCreate() => Navigation.NavigateTo($"/document-detail?sourceType={SourceType}");
    private Task PreviewAsync(DocumentDto item)
    {
        previewing = item;
        return previewModal?.ShowAsync(item.Id, item.Files, item.Title, showHistory: IsInbox) ?? Task.CompletedTask;
    }

    private async Task OpenInboxPreviewFromQueryAsync()
    {
        if (!IsInbox || previewModal is null)
            return;
        if (PreviewDocumentId is not { } id || id == Guid.Empty)
        {
            openedPreviewId = null;
            return;
        }
        if (openedPreviewId == id) return;
        openedPreviewId = id;
        var item = items.FirstOrDefault(x => x.Id == id);
        if (item is null)
        {
            try { item = await Documents.GetDocumentAsync(id); }
            catch (Exception ex)
            {
                openedPreviewId = null;
                await NotifyErrorAsync(ex);
                return;
            }
        }
        await PreviewAsync(item);
        Navigation.NavigateTo("/manage-documents?sourceType=2", replace: true);
    }
    private Task AssignFromPreviewAsync() =>
        taskModal?.ShowAsync(linkedDocumentId: previewing?.Id) ?? Task.CompletedTask;
    private Task OpenSubmit(DocumentDto item) => submitModal?.ShowAsync(item.Id) ?? Task.CompletedTask;
    private Task OpenSend(DocumentDto item) => sendModal?.ShowAsync(item.Id, item.Title, item.Number) ?? Task.CompletedTask;
    private bool IsMutating(Guid id) => mutatingIds.Contains(id);

    private async Task RevokeAsync(DocumentDto item)
    {
        if (IsMutating(item.Id)) return;
        if (!await UiMessageService.Confirm(string.Format(L["Feature:RevokeSendConfirm"], item.Title))) return;
        mutatingIds.Add(item.Id);
        try
        {
            await Documents.RevokeDocumentAsync(item.Id);
            await NotifySuccessAsync(L["Feature:RevokeSendDone"]);
            await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { mutatingIds.Remove(item.Id); }
    }

    private async Task DeleteAsync(DocumentDto item)
    {
        if (IsMutating(item.Id)) return;
        if (!await UiMessageService.Confirm(string.Format(L["Feature:DeleteDocumentConfirm"], item.Title))) return;
        mutatingIds.Add(item.Id);
        try
        {
            await Documents.DeleteDocumentAsync(item.Id);
            await NotifySuccessAsync(L["Feature:DeleteDocumentDone"]);
            await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { mutatingIds.Remove(item.Id); }
    }
}
