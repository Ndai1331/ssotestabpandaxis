@page "/manage-documents"
@page "/my-documents"
@page "/document-assignments"
@page "/document-files"
@page "/document-histories"
@attribute [Authorize(Policy = "Documents.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject CollaborationClient Chat
@inject NavigationManager Navigation
@implements IDisposable
@using System.Threading

<PageTitle>@PageTitle · HCS</PageTitle>
<section class="hcs-catalog-page" @key="SourceType">
    <header class="hcs-catalog-titlebar">
        <div><h1>@PageTitle</h1></div>
        <div class="hcs-catalog-page__actions">
            <Button Color="Color.Primary" Outline="true" Class="hcs-catalog-export" Clicked="LoadAsync">@L["Catalog:Refresh"]</Button>
            @if (CanCreate)
            {
                <Button Color="Color.Primary" Class="hcs-catalog-create" Clicked="OpenCreate"><Icon Name="@IconName.Add" /> @L["Catalog:New"]</Button>
            }
        </div>
    </header>
    <Card Class="mb-3 hcs-catalog-filter-card"><CardBody>
        <div class="hcs-catalog-filter-row">
            <Addons Class="hcs-catalog-search">
                <Addon AddonType="AddonType.Body"><TextInput @bind-Value="filter" Placeholder="@L["Catalog:SearchPlaceholder"]" /></Addon>
                <Addon AddonType="AddonType.End">
                    <Button Color="Color.Primary" Clicked="SearchAsync"><i class="fa fa-search me-1"></i> @L["Catalog:SearchButton"]</Button>
                </Addon>
            </Addons>
        </div>
    </CardBody></Card>
    <Card Class="hcs-catalog-grid-card"><CardBody Class="p-0">
        @if (isLoading) { <div class="hcs-loading py-5"><i class="fa fa-spinner fa-spin"></i><span>@L["Catalog:Loading"]</span></div> }
        else if (items.Count == 0) { <div class="hcs-empty py-5"><i class="fa fa-inbox"></i><h2>@L["Catalog:EmptyTitle"]</h2></div> }
        else {
            <div class="table-responsive"><table class="table table-hover align-middle mb-0 hcs-catalog-grid">
                <thead><tr>
                    <th>@L["Catalog:Actions"]</th>
                    <th>@L["Feature:DocumentNumber"]</th>
                    <th>@L["Feature:DocumentTitleField"]</th>
                    <th>@L["Catalog:Status"]</th>
                    <th>@L["Feature:Files"]</th>
                </tr></thead>
                <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>
                            <div class="hcs-row-actions">
                                <Button Size="Size.Small" Color="Color.Primary" Outline="true" Class="hcs-action-button" Clicked="() => PreviewAsync(item)" title="@L["Work:PdfPreview"]"><i class="fa fa-eye"></i></Button>
                                <a class="btn btn-sm btn-outline-primary hcs-action-button hcs-action-button--edit" href="@DetailHref(item.Id)" title="@L["Catalog:Edit"]"><i class="fa fa-pen"></i></a>
                                @if (CanManage)
                                {
                                    <AuthorizeView Policy="Documents.Assign">
                                        <Authorized>
                                            <Button Size="Size.Small" Color="Color.Secondary" Outline="true" Class="hcs-action-button" Clicked="() => OpenSend(item)" title="@L["Feature:SendDocument"]"><i class="fa fa-paper-plane"></i></Button>
                                        </Authorized>
                                    </AuthorizeView>
                                    <AuthorizeView Policy="Documents.Workflow.Start">
                                        <Authorized>
                                            <Button Size="Size.Small" Color="Color.Primary" Outline="true" Class="hcs-action-button" Clicked="() => OpenSubmit(item)" title="@L["Work:SubmitWorkflow"]"><i class="fa fa-signature"></i></Button>
                                        </Authorized>
                                    </AuthorizeView>
                                }
                            </div>
                        </td>
                        <td><span class="hcs-catalog-code">#@item.Number</span></td>
                        <td>
                            <a href="@DetailHref(item.Id)"><strong>@item.Title</strong></a>
                            <span class="hcs-catalog-desc">@item.CreationTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </td>
                        <td><span class="hcs-status-badge @StatusClass(item.Status)">@item.Status</span></td>
                        <td>@item.Files.Count</td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </CardBody></Card>
</section>
<DocumentPdfPreviewModal @ref="previewModal" ShowAssignTask="true" OnAssignTask="AssignFromPreviewAsync" />
<ProjectTaskCreateModal @ref="taskModal" />
<SubmitWorkflowModal @ref="submitModal" OnSubmitted="LoadAsync" />
<Modal @ref="sendModal"><ModalContent Centered Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@L["Feature:SendDocument"]</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        <Field><FieldLabel>@L["Chat:SelectContacts"]</FieldLabel>
            <UserSelect2 Value="sendReceiverId" ValueChanged="value => sendReceiverId = value"
                         Placeholder="@L["Chat:SelectContacts"]" SelectedText="@ContactName(sendReceiverId)"
                         Search="SearchContactsAsync" />
        </Field>
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => sendModal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SendAsync">@L["Feature:SendDocument"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    [SupplyParameterFromQuery(Name = "sourceType")] public int? SourceTypeQuery { get; set; }

    private readonly List<DocumentDto> items = [];
    private readonly List<ChatContactDto> contacts = [];
    private DocumentPdfPreviewModal? previewModal;
    private ProjectTaskCreateModal? taskModal;
    private SubmitWorkflowModal? submitModal;
    private Modal? sendModal;
    private DocumentDto? sending;
    private DocumentDto? previewing;
    private Guid? sendReceiverId;
    private string filter = "";
    private bool isLoading;
    private int lastLoadedSource = int.MinValue;
    private int loadGeneration;

    private int SourceType
    {
        get
        {
            var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (relative.Contains("my-documents", StringComparison.OrdinalIgnoreCase)) return 1;
            if (SourceTypeQuery is >= 0 and <= 2) return SourceTypeQuery.Value;
            return 0;
        }
    }
    private bool CanCreate => SourceType is 0 or 1;
    private bool CanManage => SourceType is 0 or 1;
    private string PageTitle => SourceType switch
    {
        1 => L["Menu:MyDocuments"],
        2 => L["Menu:DocumentsSentToMe"],
        _ => L["Menu:DocumentList"]
    };

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;
    protected override async Task OnParametersSetAsync() => await ReloadIfSourceChangedAsync(resetFilter: lastLoadedSource != int.MinValue);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(() => ReloadIfSourceChangedAsync(resetFilter: true));
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private async Task ReloadIfSourceChangedAsync(bool resetFilter)
    {
        var source = SourceType;
        if (source == lastLoadedSource) return;
        if (resetFilter) filter = "";
        lastLoadedSource = source;
        await LoadAsync();
    }

    private Task SearchAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        var generation = Interlocked.Increment(ref loadGeneration);
        isLoading = true;
        try
        {
            var page = await Documents.GetDocumentsAsync(new DocumentListQuery(
                string.IsNullOrWhiteSpace(filter) ? null : filter, null, SourceType == 1, 0, 50, SourceType));
            if (generation != loadGeneration) return;
            items.Clear(); items.AddRange(page.Items);
        }
        catch (Exception ex) { if (generation == loadGeneration) await NotifyErrorAsync(ex); }
        finally { if (generation == loadGeneration) isLoading = false; }
    }
    private string DetailHref(Guid id) => $"/document-detail/{id}?sourceType={SourceType}";
    private void OpenCreate() => Navigation.NavigateTo($"/document-detail?sourceType={SourceType}");
    private Task PreviewAsync(DocumentDto item)
    {
        previewing = item;
        return previewModal?.ShowAsync(item.Id, item.Files, item.Title) ?? Task.CompletedTask;
    }
    private Task AssignFromPreviewAsync() =>
        taskModal?.ShowAsync(linkedDocumentId: previewing?.Id) ?? Task.CompletedTask;
    private Task OpenSubmit(DocumentDto item) => submitModal?.ShowAsync(item.Id) ?? Task.CompletedTask;
    private async Task OpenSend(DocumentDto item)
    {
        sending = item;
        sendReceiverId = null;
        if (contacts.Count == 0)
        {
            try { contacts.AddRange(await Chat.GetContactsAsync(null, 50)); }
            catch { }
        }
        if (sendModal is not null) await sendModal.Show();
    }
    private async Task SendAsync()
    {
        if (sending is null || sendReceiverId is null) { await NotifyErrorAsync(L["Catalog:TypeRequired"]); return; }
        try
        {
            await Documents.SendDocumentAsync(sending.Id, new SendDocumentRequest(sendReceiverId));
            if (sendModal is not null) await sendModal.Hide();
            await NotifySuccessAsync(L["Catalog:Updated"]);
            await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private static string StatusClass(DocumentStatus status) => status switch
    {
        DocumentStatus.Approved => "hcs-status-badge--success",
        DocumentStatus.Rejected => "hcs-status-badge--danger",
        DocumentStatus.InReview or DocumentStatus.Submitted => "hcs-status-badge--warning",
        DocumentStatus.Archived => "hcs-status-badge--todo",
        _ => "hcs-status-badge--planning"
    };
    private string ContactName(Guid? id) => id is null ? "" : contacts.FirstOrDefault(x => x.Id == id)?.DisplayName ?? "";
    private async Task<CatalogSelect2SearchResponse> SearchContactsAsync(string term, int page)
    {
        var found = await Chat.GetContactsAsync(term, 50);
        return CatalogSelect2Cache.Merge(contacts, found, x => x.Id, x => x.DisplayName, false);
    }
}
