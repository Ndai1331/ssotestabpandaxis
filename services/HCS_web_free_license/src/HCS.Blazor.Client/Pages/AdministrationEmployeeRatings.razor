@page "/employee-ratings/results/list"
@page "/administration/employee-ratings"
@attribute [Authorize(Policy = "WorkManagement.EmployeeRatings.Management")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject EmployeeRatingDirectoryService Directory

<PageTitle>@L["Menu:EmployeeRatingResults"] · HCS</PageTitle>

<section class="hcs-rating-page" aria-labelledby="employee-rating-management-title">
    <header class="hcs-rating-page__header">
        <div>
            <p class="hcs-rating-page__kicker">@L["Menu:Social"]</p>
            <h1 id="employee-rating-management-title">@L["Menu:EmployeeRatingResults"]</h1>
            <p class="hcs-rating-page__lede">@L["EmployeeRatings:ManagementSubtitle"]</p>
        </div>
    </header>
    <EmployeeRatingNav />
    <div class="card hcs-rating-toolbar mb-3">
        <div class="card-body">
            <div class="hcs-rating-toolbar__fields">
                <div>
                    <label class="form-label" for="management-rating-search">@L["EmployeeRatings:Search"]</label>
                    <input id="management-rating-search" class="form-control" type="search" value="@searchText"
                           @oninput="OnSearchInput" placeholder="@L["EmployeeRatings:SearchPlaceholder"]" />
                </div>
                <div>
                    <div id="management-rating-department-label" class="form-label">@L["EmployeeRatings:Department"]</div>
                    <div role="group" aria-labelledby="management-rating-department-label">
                        <CatalogSelect2 Value="selectedDepartmentId"
                                        ValueChanged="OnDepartmentChanged"
                                        Placeholder="@L["EmployeeRatings:AllDepartments"]"
                                        SelectedText="@DepartmentText"
                                        Search="SearchDepartmentsAsync" />
                    </div>
                </div>
                <div>
                    <label class="form-label" for="management-rating-sort">@L["EmployeeRatings:Sort"]</label>
                    <select id="management-rating-sort" class="form-select" @bind="sortOrder" @bind:after="ApplySort">
                        <option value="desc">@L["EmployeeRatings:SortHighToLow"]</option>
                        <option value="asc">@L["EmployeeRatings:SortLowToHigh"]</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <HcsLoading CssClass="py-5" />
    }
    else if (hasError)
    {
        <div class="hcs-empty py-5" role="alert"><i class="fa fa-circle-exclamation" aria-hidden="true"></i><h2>@L["EmployeeRatings:LoadErrorTitle"]</h2><p>@L["EmployeeRatings:LoadError"]</p><button class="btn btn-primary" type="button" @onclick="LoadAsync">@L["Catalog:Retry"]</button></div>
    }
    else
    {
        <div class="card hcs-rating-table-card">
            <div class="card-body p-0">
                @if (people.Count == 0)
                {
                    <DocsEmpty Title="@L["EmployeeRatings:EmptyTitle"]" Hint="@L["EmployeeRatings:Empty"]" />
                }
                else
                {
                    <div class="table-responsive hcs-rating-table-wrap--stacked">
                        <table class="table table-hover align-middle mb-0">
                            <caption class="visually-hidden">@L["Menu:EmployeeRatingResults"]</caption>
                            <thead><tr><th>@L["EmployeeRatings:Employee"]</th><th>@L["EmployeeRatings:Department"]</th><th>@L["EmployeeRatings:Average"]</th><th>@L["EmployeeRatings:Reviews"]</th><th class="text-end">@L["EmployeeRatings:Action"]</th></tr></thead>
                            <tbody>
                                @foreach (var person in people)
                                {
                                    <tr>
                                        <td data-label="@L["EmployeeRatings:Employee"]"><div class="hcs-rating-table-person"><span class="hcs-rating-avatar hcs-rating-avatar--small">@person.Initials</span><strong>@person.User.DisplayName</strong></div></td>
                                        <td data-label="@L["EmployeeRatings:Department"]">@(person.HasDepartment ? person.DepartmentName : L["EmployeeRatings:NoDepartment"])</td>
                                        <td data-label="@L["EmployeeRatings:Average"]"><span class="hcs-rating-score">@(person.Summary.ReviewCount == 0 ? L["EmployeeRatings:NoScore"].Value : $"{person.Summary.AverageScore:0.0}/5")</span></td>
                                        <td data-label="@L["EmployeeRatings:Reviews"]">@person.Summary.ReviewCount</td>
                                        <td data-label="@L["EmployeeRatings:Action"]" class="text-end"><a class="btn btn-sm btn-outline-primary" href="/employee-ratings/results/@person.User.UserId"><i class="fa fa-eye me-1" aria-hidden="true"></i>@L["EmployeeRatings:ViewDetail"]</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <HcsPager TotalCount="totalCount" PageSize="pageSize" PageSizeId="management-ratings-page-size"
                              CanPrev="CanPrev" CanNext="CanNext" Disabled="@isLoading"
                              FirstClicked="GoFirst" PrevClicked="GoPrev" NextClicked="GoNext" LastClicked="GoLast"
                              PageSizeChanged="OnPageSizeChanged" />
                }
            </div>
        </div>
    }
</section>

@code {
    private readonly List<EmployeeRatingPerson> people = [];
    private readonly List<DepartmentCatalogDto> departments = [];
    private string searchText = string.Empty;
    private Guid? selectedDepartmentId;
    private string sortOrder = "desc";
    private bool isLoading = true;
    private bool hasError;
    private long totalCount;
    private int pageSize = 20;
    private int currentPage = 1;
    private CancellationTokenSource? searchCts;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)Math.Max(pageSize, 1)));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < PageCount;
    private Guid? SelectedUnitId => selectedDepartmentId;
    private string DepartmentText => departments.FirstOrDefault(x => x.Id == selectedDepartmentId)?.Name ?? "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            departments.AddRange((await Directory.GetDepartmentsAsync())
                .Where(department => department.IsActive)
                .ToList());
        }
        catch (Exception exception)
        {
            await NotifyErrorAsync(exception);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        hasError = false;
        try
        {
            var skip = (Math.Max(1, currentPage) - 1) * pageSize;
            var page = await Directory.GetPeoplePageAsync(searchText, skip, pageSize, organizationUnitId: SelectedUnitId);
            var ids = page.People.Select(person => person.User.UserId).ToArray();
            if (ids.Length > 0)
            {
                var summaries = await Work.GetEmployeeRatingSummariesAsync(0, ids.Length, userIds: ids);
                var map = summaries.Items.ToDictionary(item => item.TargetUserId);
                foreach (var person in page.People)
                    person.Summary = map.TryGetValue(person.User.UserId, out var summary)
                        ? summary
                        : EmployeeRatingPerson.EmptySummary(person.User.UserId);
            }

            people.Clear();
            people.AddRange(page.People);
            totalCount = page.TotalCount;
            currentPage = Math.Clamp(currentPage, 1, PageCount);
            ApplySort();
        }
        catch (Exception exception)
        {
            hasError = true;
            await NotifyErrorAsync(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplySort()
    {
        var ordered = sortOrder == "asc"
            ? people.OrderBy(person => person.Summary.AverageScore).ThenBy(person => person.User.DisplayName)
            : people.OrderByDescending(person => person.Summary.AverageScore).ThenBy(person => person.User.DisplayName);
        var snapshot = ordered.ToList();
        people.Clear();
        people.AddRange(snapshot);
    }

    private Task OnSearchInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        return QueueSearchAsync();
    }

    private async Task QueueSearchAsync()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        var cts = new CancellationTokenSource();
        searchCts = cts;
        try
        {
            await Task.Delay(300, cts.Token);
            currentPage = 1;
            await LoadAsync();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task<CatalogSelect2SearchResponse> SearchDepartmentsAsync(string term, int page)
    {
        var found = OrganizationUnitCatalogMapper.FilterTree(departments, term);
        return Task.FromResult(CatalogSelect2Cache.Merge(departments, found, x => x.Id,
            OrganizationUnitCatalogMapper.OptionText(departments), false));
    }

    private Task OnDepartmentChanged(Guid? value)
    {
        selectedDepartmentId = value;
        currentPage = 1;
        return LoadAsync();
    }

    private Task GoFirst() { currentPage = 1; return LoadAsync(); }
    private Task GoPrev() { if (!CanPrev) return Task.CompletedTask; currentPage--; return LoadAsync(); }
    private Task GoNext() { if (!CanNext) return Task.CompletedTask; currentPage++; return LoadAsync(); }
    private Task GoLast() { currentPage = PageCount; return LoadAsync(); }
    private Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return Task.CompletedTask;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        return LoadAsync();
    }
}
