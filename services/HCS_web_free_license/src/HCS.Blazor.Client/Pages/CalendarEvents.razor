@page "/calendar-events"
@attribute [Authorize(Policy = "WorkManagement.Calendar")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject OrganizationCatalogClient Catalog
@inject CollaborationClient Chat
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation

<PageTitle>@L["Menu:CalendarEvents"] · HCS</PageTitle>
<section class="hcs-catalog-page">
    <header class="hcs-catalog-titlebar">
        <div><h1>@L["Feature:CalendarTitle"]</h1></div>
        <div class="hcs-catalog-page__actions">
            <Button Color="Color.Light" Clicked="PreviousMonth">‹</Button>
            <strong class="align-self-center">@month.ToString("MMMM yyyy")</strong>
            <Button Color="Color.Light" Clicked="NextMonth">›</Button>
            <Button Color="Color.Primary" Class="hcs-catalog-create" Clicked="OpenCreate"><Icon Name="@IconName.Add" /> @L["Catalog:New"]</Button>
        </div>
    </header>
    @if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-warning">@error</div> }
    @if (isLoading) { <p>@L["Catalog:Loading"]</p> }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-bordered text-center">
                <thead><tr>@foreach (var day in days) { <th>@day</th> }</tr></thead>
                <tbody>
                @foreach (var week in Weeks())
                {
                    <tr>
                    @foreach (var day in week)
                    {
                        var daily = events.Where(x => x.StartTime.Date == day.Date).ToList();
                        <td class="@(day.Month == month.Month ? null : "text-muted")" style="min-width:8rem;height:7rem;vertical-align:top">
                            <div><strong>@day.Day</strong></div>
                            @foreach (var item in daily.Take(3))
                            {
                                <div><a href="@($"/calendar-event-detail/{item.Id}")">@item.Title</a></div>
                            }
                        </td>
                    }
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <Card><CardBody Class="p-0">
            <table class="table mb-0"><thead><tr><th>@L["Feature:Event"]</th><th>@L["Feature:Time"]</th><th>@L["Catalog:Status"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in events)
            {
                <tr>
                    <td><a href="@($"/calendar-event-detail/{item.Id}")"><strong>@item.Title</strong></a><br /><small>@item.EventType</small></td>
                    <td>@item.StartTime.ToLocalTime().ToString("dd/MM HH:mm") – @item.EndTime.ToLocalTime().ToString("HH:mm")</td>
                    <td>@item.Visibility</td>
                    <td><Button Size="Size.Small" Color="Color.Danger" Outline="true" Clicked="() => DeleteAsync(item)">@L["Catalog:Delete"]</Button></td>
                </tr>
            }
            </tbody></table>
        </CardBody></Card>
    }
</section>
<Modal @ref="modal"><ModalContent Centered>
    <ModalHeader><ModalTitle>@L["Feature:EventCreate"]</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody>
        <Field><FieldLabel>@L["Feature:Event"]</FieldLabel><TextInput @bind-Value="form.Title" /></Field>
        <Field><FieldLabel>@L["Feature:Description"]</FieldLabel><textarea class="form-control" rows="2" @bind="form.Description"></textarea></Field>
        <Field><FieldLabel>@L["Feature:StartDate"]</FieldLabel><DatePicker TValue="DateTime" @bind-Value="form.Start" /></Field>
        <Field><FieldLabel>@L["Feature:EndDate"]</FieldLabel><DatePicker TValue="DateTime" @bind-Value="form.End" /></Field>
        <Field><FieldLabel>@L["Catalog:EventTypeTitle"]</FieldLabel>
            <Select TValue="string" @bind-Value="form.EventType">
                <SelectItem Value="@("Meeting")">Meeting</SelectItem>
                @foreach (var type in eventTypes) { <SelectItem Value="@type.Name">@type.Name</SelectItem> }
            </Select>
        </Field>
        <Field><FieldLabel>@L["Feature:Visibility"]</FieldLabel>
            <Select TValue="string" @bind-Value="form.Visibility">
                <SelectItem Value="@("Private")">Private</SelectItem>
                <SelectItem Value="@("Participants")">Participants</SelectItem>
                <SelectItem Value="@("Public")">Public</SelectItem>
            </Select>
        </Field>
        <Field><FieldLabel>@L["Feature:RelatedType"]</FieldLabel>
            <Select TValue="string" @bind-Value="form.RelatedType">
                <SelectItem Value="@("NONE")">NONE</SelectItem>
                <SelectItem Value="@("PROJECT")">PROJECT</SelectItem>
                <SelectItem Value="@("TASK")">TASK</SelectItem>
            </Select>
        </Field>
        <Field><FieldLabel>@L["Chat:SelectContacts"]</FieldLabel>
            @foreach (var contact in contacts)
            {
                <Check TValue="bool" Checked="form.Participants.Contains(contact.Id)" CheckedChanged="@((bool value) => Toggle(contact.Id, value))">@contact.DisplayName</Check>
            }
        </Field>
    </ModalBody>
    <ModalFooter>
        <Button Color="Color.Secondary" Clicked="() => modal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Clicked="CreateAsync">@L["Catalog:Create"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    private static readonly string[] days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private DateTime month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private readonly List<CalendarEventDto> events = [];
    private readonly List<MasterDataCatalogDto> eventTypes = [];
    private readonly List<HCS.CollaborationService.Contracts.ChatContactDto> contacts = [];
    private readonly EventForm form = new();
    private Modal? modal;
    private bool isLoading;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true; error = null;
        try
        {
            var from = month.AddDays(-7); var to = month.AddMonths(1).AddDays(7);
            events.Clear(); events.AddRange(await Work.GetCalendarAsync(from, to));
            if (eventTypes.Count == 0)
            {
                var page = await Catalog.GetMasterDataAsync("EventType", new OrganizationCatalogQuery(null, true, 0, 100));
                eventTypes.AddRange(page.Items);
            }
            if (contacts.Count == 0) contacts.AddRange(await Chat.GetContactsAsync(null, 50));
        }
        catch { error = L["Catalog:LoadError"]; }
        finally { isLoading = false; }
    }

    private Task PreviousMonth() { month = month.AddMonths(-1); return LoadAsync(); }
    private Task NextMonth() { month = month.AddMonths(1); return LoadAsync(); }
    private async Task OpenCreate() { form.Reset(); if (modal is not null) await modal.Show(); }
    private IEnumerable<List<DateTime>> Weeks()
    {
        var start = month.AddDays(-(((int)month.DayOfWeek + 6) % 7));
        for (var w = 0; w < 6; w++)
        {
            yield return Enumerable.Range(0, 7).Select(d => start.AddDays(w * 7 + d)).ToList();
        }
    }
    private void Toggle(Guid id, bool selected) { if (selected) form.Participants.Add(id); else form.Participants.Remove(id); }
    private async Task CreateAsync()
    {
        try
        {
            await Work.CreateCalendarEventAsync(new UpsertCalendarEventRequest(form.Title.Trim(), string.IsNullOrWhiteSpace(form.Description) ? null : form.Description, form.Start, form.End, false, form.EventType, null, form.RelatedType, null, form.Visibility, form.Participants.ToList()));
            if (modal is not null) await modal.Hide();
            await LoadAsync();
        }
        catch { error = L["Catalog:SaveError"]; }
    }
    private async Task DeleteAsync(CalendarEventDto item)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], item.Title))) return;
        try { await Work.DeleteCalendarEventAsync(item.Id); await LoadAsync(); }
        catch { error = L["Catalog:DeleteError"]; }
    }
    private sealed class EventForm
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime Start { get; set; } = DateTime.Now;
        public DateTime End { get; set; } = DateTime.Now.AddHours(1);
        public string EventType { get; set; } = "Meeting";
        public string Visibility { get; set; } = "Private";
        public string RelatedType { get; set; } = "NONE";
        public HashSet<Guid> Participants { get; } = [];
        public void Reset() { Title = Description = ""; Start = DateTime.Now; End = DateTime.Now.AddHours(1); EventType = "Meeting"; Visibility = "Private"; RelatedType = "NONE"; Participants.Clear(); }
    }
}
