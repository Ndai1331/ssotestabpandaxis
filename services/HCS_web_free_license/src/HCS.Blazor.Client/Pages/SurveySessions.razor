@page "/survey-sessions"
@attribute [Authorize(Policy = "WorkManagement.Surveys")]
@using HCS.Permissions
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject IUiMessageService UiMessage

<PageTitle>@L["Menu:Surveys"] · HCS</PageTitle>
<section class="page page-wf page-dm">
    <div class="page-head">
        <h1>@L["Feature:SurveySessions"]</h1>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="LoadAsync" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                @L["Catalog:Refresh"]
            </button>
            @if (canManage)
            {
            <button class="btn btn-primary" type="button" @onclick="OpenCreate">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                @L["Catalog:New"]
            </button>
            }
        </div>
    </div>
    <section class="docs-main">
        <form class="docs-toolbar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <label class="sr-only" for="ss-q">@L["Catalog:SearchPlaceholder"]</label>
            <input class="input docs-search" id="ss-q" type="search" @bind="filter" @bind:event="oninput"
                   placeholder="@L["Catalog:SearchPlaceholder"]" autocomplete="off" />
            <button class="btn btn-primary" type="submit" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:SearchButton"]
            </button>
            <HcsDismissible Class="filter-pop" @bind-IsOpen="showFilters">
                <button class="btn btn-outline @(string.IsNullOrEmpty(statusFilter) ? null : "is-filtered")" type="button"
                        aria-expanded="@showFilters.ToString().ToLowerInvariant()"
                        @onclick="() => showFilters = !showFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                    @L["Catalog:Filter"]
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="filter-menu @(showFilters ? "is-open" : null)" role="menu">
                    <button type="button" class="@(string.IsNullOrEmpty(statusFilter) ? "is-active" : null)" @onclick="FilterAll">@L["Catalog:AllStatuses"]</button>
                    <button type="button" class="@(statusFilter == "Active" ? "is-active" : null)" @onclick="FilterActive">@L["Catalog:Active"]</button>
                    <button type="button" class="@(statusFilter == "Closed" ? "is-active" : null)" @onclick="FilterClosed">@L["Catalog:Closed"]</button>
                </div>
            </HcsDismissible>
        </form>
        <div class="docs-table-wrap">
            @if (isLoading && !loaded)
            {
                <DocsEmpty Loading="true" />
            }
            else if (pageItems.Count == 0)
            {
                <DocsEmpty Hint="@L["Catalog:EmptyDescription"]" />
            }
            else
            {
                <table class="docs-table">
                    <thead>
                        <tr>
                            <th scope="col">@L["Catalog:Code"]</th>
                            <th scope="col">@L["Feature:StartDate"]</th>
                            <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                            <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in pageItems)
                    {
                        <tr @key="item.Id">
                            <td>
                                <div class="pj-name" title="@item.Name">
                                    <strong>@item.Name</strong>
                                    <span>#@item.Code</span>
                                </div>
                            </td>
                            <td>@item.StartsAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") – @item.EndsAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="hcs-status-badge @SessionStatusClass(item.Status)">@SessionStatusText(item.Status)</span></td>
                            <td>
                                <div class="doc-actions">
                                    @if (canManage)
                                    {
                                    <button class="doc-action" type="button" title="@L["Catalog:Edit"]" aria-label="@L["Catalog:Edit"]" @onclick="() => Edit(item)">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                    </button>
                                    <button class="btn btn-outline btn-sm" type="button" @onclick="@(() => ChangeStatusAsync(item, "Active"))">@L["Catalog:Active"]</button>
                                    <button class="btn btn-outline btn-sm" type="button" @onclick="@(() => ChangeStatusAsync(item, "Closed"))">@L["Catalog:Closed"]</button>
                                    }
                                    @if (item.LocationId is { } locationId)
                                    {
                                        <a class="btn btn-outline btn-sm" href="@($"/survey-collections/{locationId}")">@L["Feature:Collect"]</a>
                                    }
                                    @if (canManage)
                                    {
                                    <button class="doc-action is-danger" type="button" title="@L["Catalog:Delete"]" aria-label="@L["Catalog:Delete"]" @onclick="() => DeleteAsync(item)">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                    </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            <div class="pager" aria-label="@L["Catalog:PageSize"]">
                <button type="button" disabled="@(!CanPrev)" @onclick="GoFirst">@L["Catalog:PagerFirst"]</button>
                <button type="button" disabled="@(!CanPrev)" @onclick="GoPrev">@L["Catalog:PagerPrev"]</button>
                <button type="button" disabled="@(!CanNext)" @onclick="GoNext">@L["Catalog:PagerNext"]</button>
                <button type="button" disabled="@(!CanNext)" @onclick="GoLast">@L["Catalog:PagerLast"]</button>
                <label class="sr-only" for="ss-page-size">@L["Catalog:PageSize"]</label>
                <select id="ss-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>
    </section>
</section>

<Modal @ref="modal" Size="ModalSize.Default"><ModalContent Centered Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@(editingId is null ? L["Catalog:Create"] : L["Catalog:Edit"])</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        <div class="hcs-catalog-form">
            <div class="hcs-form-row">
                <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Code" Name="hcsSurveySessionCode" MaxLength="64" Disabled="@(editingId is not null)" /></Field>
                <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Name" Name="hcsSurveySessionName" /></Field>
            </div>
            <Field><FieldLabel>@L["Menu:SurveyLocations"]</FieldLabel>
                <Select TValue="string" @bind-Value="form.LocationId">
                    <SelectItem Value="@string.Empty">@L["Catalog:NoParent"]</SelectItem>
                    @foreach (var location in locations) { <SelectItem Value="@location.Id.ToString()">@location.Name</SelectItem> }
                </Select>
            </Field>
            <div class="hcs-form-row hcs-form-row--equal">
                <Field><FieldLabel>@L["Feature:StartDate"]</FieldLabel><HcsDatePicker TValue="DateTime" @bind-Value="form.StartsAt" InputMode="DateInputMode.DateTime" ShowTodayButton ShowClearButton /></Field>
                <Field><FieldLabel>@L["Feature:EndDate"]</FieldLabel><HcsDatePicker TValue="DateTime" @bind-Value="form.EndsAt" InputMode="DateInputMode.DateTime" ShowTodayButton ShowClearButton /></Field>
            </div>
        </div>
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => modal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveAsync">@L["Catalog:SaveChanges"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<SurveySessionDto> sessions = [];
    private readonly List<SurveySessionDto> pageItems = [];
    private readonly List<SurveyLocationDto> locations = [];
    private readonly SessionForm form = new();
    private Modal? modal;
    private Guid? editingId;
    private string filter = "", statusFilter = "";
    private bool isLoading, showFilters, loaded, canManage;
    private int totalCount, pageSize = 20, currentPage = 1;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)Math.Max(pageSize, 1)));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < PageCount;

    protected override async Task OnInitializedAsync()
    {
        canManage = await AuthorizationService.IsGrantedAsync(HCSPermissions.WorkManagement.SurveyManagement);
        await LoadAsync();
    }

    private Task GoFirst() { currentPage = 1; ApplyPage(); return Task.CompletedTask; }
    private Task GoPrev() { if (!CanPrev) return Task.CompletedTask; currentPage--; ApplyPage(); return Task.CompletedTask; }
    private Task GoNext() { if (!CanNext) return Task.CompletedTask; currentPage++; ApplyPage(); return Task.CompletedTask; }
    private Task GoLast() { currentPage = PageCount; ApplyPage(); return Task.CompletedTask; }
    private Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return Task.CompletedTask;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        ApplyPage();
        return Task.CompletedTask;
    }
    private Task FilterAll() => SetStatusFilter(string.Empty);
    private Task FilterActive() => SetStatusFilter("Active");
    private Task FilterClosed() => SetStatusFilter("Closed");
    private Task SetStatusFilter(string value)
    {
        statusFilter = value;
        showFilters = false;
        currentPage = 1;
        ApplyPage();
        return Task.CompletedTask;
    }

    private Task SearchAsync() { currentPage = 1; ApplyPage(); return Task.CompletedTask; }
    private Task ResetSearchAsync() { filter = statusFilter = ""; showFilters = false; currentPage = 1; ApplyPage(); return Task.CompletedTask; }

    private void ApplyPage()
    {
        var filtered = sessions.Where(Matches).ToList();
        totalCount = filtered.Count;
        pageItems.Clear();
        pageItems.AddRange(filtered.Skip((currentPage - 1) * pageSize).Take(pageSize));
    }

    private bool Matches(SurveySessionDto item)
    {
        if (!string.IsNullOrWhiteSpace(filter))
        {
            var term = SearchText.Normalize(filter);
            if (item.Code.IndexOf(term, StringComparison.OrdinalIgnoreCase) < 0 &&
                item.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) < 0)
                return false;
        }
        if (!string.IsNullOrWhiteSpace(statusFilter) &&
            !string.Equals(item.Status, statusFilter, StringComparison.OrdinalIgnoreCase))
            return false;
        return true;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            sessions.Clear(); sessions.AddRange(await Work.GetSessionsAsync());
            locations.Clear(); locations.AddRange(await Work.GetLocationsAsync());
            loaded = true;
            ApplyPage();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }
    private async Task OpenCreate()
    {
        if (!canManage) return;
        editingId = null; form.Reset(); if (modal is not null) await modal.Show();
    }
    private async Task Edit(SurveySessionDto session)
    {
        if (!canManage) return;
        editingId = session.Id;
        form.Code = session.Code; form.Name = session.Name; form.LocationId = session.LocationId?.ToString() ?? "";
        form.StartsAt = session.StartsAt.ToLocalTime(); form.EndsAt = session.EndsAt.ToLocalTime();
        if (modal is not null) await modal.Show();
    }
    private async Task SaveAsync()
    {
        if (!canManage) return;
        try
        {
            Guid? location = Guid.TryParse(form.LocationId, out var id) ? id : null;
            if (editingId is { } sessionId) await Work.UpdateSessionAsync(sessionId, new UpdateSurveySessionRequest(form.Name.Trim(), form.StartsAt, form.EndsAt, location));
            else await Work.CreateSessionAsync(new CreateSurveySessionRequest(form.Code.Trim(), form.Name.Trim(), form.StartsAt, form.EndsAt, location));
            await NotifySuccessAsync(editingId is null ? L["Catalog:Created"] : L["Catalog:Updated"]);
            if (modal is not null) await modal.Hide();
            form.Reset(); await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task ChangeStatusAsync(SurveySessionDto session, string status)
    {
        if (!canManage) return;
        try { await Work.ChangeSessionStatusAsync(session.Id, status); await NotifySuccessAsync(L["Catalog:Updated"]); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }

    private string SessionStatusText(string status) => status switch
    {
        "Active" => L["SurveySession:Status.Active"].Value,
        "Closed" => L["SurveySession:Status.Closed"].Value,
        _ => status
    };

    private static string SessionStatusClass(string status) => status switch
    {
        "Active" => "hcs-status-badge--success",
        "Closed" => "hcs-status-badge--todo",
        _ => "hcs-status-badge--planning"
    };
    private async Task DeleteAsync(SurveySessionDto session)
    {
        if (!canManage) return;
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], session.Name))) return;
        try { await Work.DeleteSessionAsync(session.Id); await NotifySuccessAsync(L["Catalog:Deleted"]); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private sealed class SessionForm
    {
        public string Code { get; set; } = ""; public string Name { get; set; } = ""; public string LocationId { get; set; } = "";
        public DateTime StartsAt { get; set; } = DateTime.Now; public DateTime EndsAt { get; set; } = DateTime.Now.AddDays(7);
        public void Reset() { Code = Name = LocationId = ""; StartsAt = DateTime.Now; EndsAt = DateTime.Now.AddDays(7); }
    }
}
