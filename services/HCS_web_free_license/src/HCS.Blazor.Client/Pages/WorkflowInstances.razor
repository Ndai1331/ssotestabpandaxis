@page "/workflow-instances"
@page "/document-workflow-instances"
@page "/document-workflow-instances/{InstanceId:guid}"
@attribute [Authorize(Policy = "Documents.Workflow.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject NavigationManager Navigation

<PageTitle>@L["Menu:WorkflowInstances"] · HCS</PageTitle>
<section class="page page-wf wf-instances">
    @if (selected is null)
    {
        <div class="page-head">
            <h1>@L["Menu:WorkflowInstances"]</h1>
            <div class="page-actions">
                <button class="btn btn-outline" type="button" @onclick="LoadAsync" disabled="@isLoading">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                    @L["Catalog:Refresh"]
                </button>
                <AuthorizeView Policy="Documents.Workflow.Start">
                    <Authorized>
                        <button class="btn btn-primary" type="button" @onclick="OpenStart">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                            @L["Work:SubmitWorkflow"]
                        </button>
                    </Authorized>
                </AuthorizeView>
                <button class="btn btn-outline @(showSearch ? "is-open" : null) @(IsSearchFiltered ? "is-filtered" : null)"
                        type="button" aria-expanded="@showSearch.ToString().ToLowerInvariant()"
                        aria-controls="wf-instance-search" @onclick="ToggleSearch">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                    @L["Catalog:Search"]
                </button>
                <HcsDismissible Class="filter-pop" @bind-IsOpen="showFilters">
                    <button class="btn btn-outline" type="button" aria-expanded="@showFilters.ToString().ToLowerInvariant()"
                            aria-controls="wf-instance-filter" @onclick="ToggleFilters">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                        @L["Catalog:Filter"]
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    <div class="filter-menu @(showFilters ? "is-open" : null)" id="wf-instance-filter" role="menu">
                        <button type="button" class="@(string.IsNullOrEmpty(statusFilter) ? "is-active" : null)" @onclick="FilterAll">@L["Catalog:AllStatuses"]</button>
                        @foreach (var status in Enum.GetValues<WorkflowInstanceStatus>())
                        {
                            <button type="button" class="@(statusFilter == status.ToString() ? "is-active" : null)" @onclick="() => SetStatusFilter(status.ToString())">
                                @L[$"Work:WorkflowStatus.{status}"]
                            </button>
                        }
                    </div>
                </HcsDismissible>
            </div>
        </div>

        <section class="docs-main">
            <form class="docs-toolbar list-search" id="wf-instance-search" hidden="@(!showSearch)" @onsubmit="ApplySearch" @onsubmit:preventDefault>
                <label class="sr-only" for="wf-instance-q">@L["Catalog:SearchPlaceholder"]</label>
                <input class="input docs-search" id="wf-instance-q" type="search" @bind="filter" @bind:event="oninput"
                       placeholder="@L["Catalog:SearchPlaceholder"]" autocomplete="off" />
                <button class="btn btn-primary" type="submit">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                    @L["Catalog:SearchButton"]
                </button>
            </form>

            <div class="docs-table-wrap">
                @if (isLoading && !loaded)
                {
                    <DocsEmpty Loading="true" />
                }
                else if (pageItems.Count == 0)
                {
                    <DocsEmpty Hint="@L["Catalog:EmptyDescription"]" />
                }
                else
                {
                    <table class="docs-table">
                        <thead>
                            <tr>
                                <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                                <th scope="col">@L["Menu:Documents"]</th>
                                <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                                <th class="col-steps" scope="col">@L["Work:CurrentStep"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in pageItems)
                        {
                            <tr @key="item.Id">
                                <td>
                                    <div class="doc-actions">
                                        <a class="doc-action" href="@($"/document-workflow-instances/{item.Id}")" title="@L["Work:View"]" aria-label="@L["Work:View"]">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="8" r="0.9" fill="currentColor" stroke="none"/></svg>
                                        </a>
                                        <button class="doc-action" type="button" title="@L["Work:PdfPreview"]" aria-label="@L["Work:PdfPreview"]" @onclick="() => PreviewAsync(item)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <div class="doc-title" title="@DocumentTitle(item.DocumentId)">
                                        <a class="wf-name" href="@($"/document-detail/{item.DocumentId}")">@DocumentTitle(item.DocumentId)</a>
                                        <span class="doc-code">#@DocumentNumber(item.DocumentId)</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @InstanceBadgeClass(item.Status)">@L[$"Work:WorkflowStatus.{item.Status}"]</span>
                                </td>
                                <td class="wf-steps">@item.CurrentStep / @Math.Max(item.Tasks.Count, 1)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                <div class="pager" aria-label="@L["Catalog:PageSize"]">
                    <button type="button" disabled="@(!CanPrev)" @onclick="GoFirst">@L["Catalog:PagerFirst"]</button>
                    <button type="button" disabled="@(!CanPrev)" @onclick="GoPrev">@L["Catalog:PagerPrev"]</button>
                    <button type="button" disabled="@(!CanNext)" @onclick="GoNext">@L["Catalog:PagerNext"]</button>
                    <button type="button" disabled="@(!CanNext)" @onclick="GoLast">@L["Catalog:PagerLast"]</button>
                    <label class="sr-only" for="wf-instance-page-size">@L["Catalog:PageSize"]</label>
                    <select id="wf-instance-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                        @foreach (var size in pageSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="vb-card">
            <header class="vb-chrome">
                <div class="vb-chrome-id">
                    <button class="icon-btn" type="button" @onclick="GoBackToList" aria-label="@L["Feature:BackToList"]">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 18 9 12l6-6"/></svg>
                    </button>
                    <div class="vb-editor-head">
                        <h1 title="@DocumentTitle(selected.DocumentId)">@DocumentTitle(selected.DocumentId)</h1>
                        <p class="vb-editor-sub">
                            <span>#@DocumentNumber(selected.DocumentId)</span>
                            <span class="badge @InstanceBadgeClass(selected.Status)">@L[$"Work:WorkflowStatus.{selected.Status}"]</span>
                        </p>
                    </div>
                </div>
                <div class="vb-chrome-actions">
                    <div class="vb-foot">
                        <button class="btn btn-outline" type="button" @onclick="() => PreviewAsync(selected)">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                            @L["Work:PdfPreview"]
                        </button>
                        @if (selected.Status == WorkflowInstanceStatus.Returned)
                        {
                            <AuthorizeView Policy="Documents.Workflow.Start">
                                <Authorized>
                                    <button class="btn btn-primary" type="button" @onclick="ResubmitAsync">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                                        @L["Work:Resubmit"]
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        }
                    </div>
                </div>
            </header>

            <div class="process-hero">
                <div>
                    <p class="process-hero-title">@DefinitionName(selected.DefinitionId)</p>
                    <p class="process-hero-code">@selected.Id.ToString("N")[..8]</p>
                </div>
                <div class="process-hero-meta">
                    <span class="badge @InstanceBadgeClass(selected.Status)">@L[$"Work:WorkflowStatus.{selected.Status}"]</span>
                    <span>@L["Work:CurrentStep"]: @selected.CurrentStep</span>
                </div>
            </div>

            <section class="process-flow" aria-label="@L["Work:CreateSteps"]">
                <h3>@DefinitionName(selected.DefinitionId)</h3>
                <ol class="flow-steps">
                    @foreach (var task in selected.Tasks)
                    {
                        <li class="flow-step @(task.Status == ApprovalTaskStatus.Pending ? "is-current" : null)">
                            <span class="flow-dot" aria-hidden="true"></span>
                            <div class="flow-body">
                                <div class="flow-title-row">
                                    <strong>@StepName(task.StepCode)</strong>
                                    <span class="badge @TaskBadgeClass(task.Status)">@L[$"Work:ApprovalStatus.{task.Status}"]</span>
                                </div>
                                @if (task.DueAt is { } due)
                                {
                                    <p class="flow-wait">@due.ToLocalTime().ToString("dd/MM/yyyy")</p>
                                }
                                @if (task.Status == ApprovalTaskStatus.Pending)
                                {
                                    <textarea class="input flow-comment" rows="2" @bind="decisionComment" placeholder="@L["Feature:DecisionComment"]"></textarea>
                                    <AuthorizeView Policy="Documents.Workflow.Decide">
                                        <Authorized>
                                            <div class="flow-actions">
                                                <button class="btn btn-primary" type="button" @onclick="() => DecideAsync(task.Id, true)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                                                    @L["Feature:Approve"]
                                                </button>
                                                <button class="btn btn-danger" type="button" @onclick="() => DecideAsync(task.Id, false)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                                                    @L["Feature:Reject"]
                                                </button>
                                                @if (StepAllowsReturn(task.StepCode))
                                                {
                                                    <button class="btn btn-outline" type="button" @onclick="() => ReturnAsync(task.Id)">
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-1"/></svg>
                                                        @L["Work:Return"]
                                                    </button>
                                                }
                                            </div>
                                        </Authorized>
                                    </AuthorizeView>
                                }
                            </div>
                        </li>
                    }
                </ol>
            </section>
        </div>
    }
</section>

<SubmitWorkflowModal @ref="submitModal" OnSubmitted="LoadAsync" />
<DocumentPdfPreviewModal @ref="previewModal" />
@code {
    [Parameter] public Guid? InstanceId { get; set; }

    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<DocumentDto> documents = [];
    private readonly List<WorkflowDefinitionDto> definitions = [];
    private readonly List<WorkflowInstanceDto> instances = [];
    private readonly List<WorkflowInstanceDto> pageItems = [];
    private SubmitWorkflowModal? submitModal;
    private DocumentPdfPreviewModal? previewModal;
    private WorkflowInstanceDto? selected;
    private Guid? loadedInstanceId;
    private string filter = "", search = "", statusFilter = "";
    private string decisionComment = "";
    private bool isLoading, showFilters, showSearch, loaded;
    private int totalCount, pageSize = 20, currentPage = 1;

    private bool IsSearchFiltered => !string.IsNullOrWhiteSpace(search);
    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < PageCount;

    private List<WorkflowInstanceDto> FilteredInstances
    {
        get
        {
            IEnumerable<WorkflowInstanceDto> query = instances;
            if (!string.IsNullOrWhiteSpace(search))
                query = query.Where(x => DocumentName(x.DocumentId).Contains(search, StringComparison.OrdinalIgnoreCase));
            if (Enum.TryParse<WorkflowInstanceStatus>(statusFilter, out var status))
                query = query.Where(x => x.Status == status);
            return query.ToList();
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (!loaded || loadedInstanceId == InstanceId) return;
        try { await LoadSelectedAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
    }

    private void ToggleSearch()
    {
        showSearch = !showSearch;
        if (showSearch) showFilters = false;
    }
    private void ToggleFilters()
    {
        showFilters = !showFilters;
        if (showFilters) showSearch = false;
    }
    private void FilterAll() => SetStatusFilter(string.Empty);
    private void ApplySearch() { search = SearchText.Normalize(filter); currentPage = 1; ApplyPage(); }
    private void SetStatusFilter(string value)
    {
        statusFilter = value;
        showFilters = false;
        currentPage = 1;
        ApplyPage();
    }
    private void ApplyPage()
    {
        var filtered = FilteredInstances;
        totalCount = filtered.Count;
        currentPage = Math.Clamp(currentPage, 1, PageCount);
        pageItems.Clear();
        pageItems.AddRange(filtered.Skip((currentPage - 1) * pageSize).Take(pageSize));
    }
    private void GoFirst() { currentPage = 1; ApplyPage(); }
    private void GoPrev() { if (CanPrev) { currentPage--; ApplyPage(); } }
    private void GoNext() { if (CanNext) { currentPage++; ApplyPage(); } }
    private void GoLast() { currentPage = PageCount; ApplyPage(); }
    private void OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        ApplyPage();
    }
    private void GoBackToList() => Navigation.NavigateTo("/document-workflow-instances");
    private Task PreviewAsync(WorkflowInstanceDto instance)
    {
        var document = documents.FirstOrDefault(x => x.Id == instance.DocumentId);
        return document is null
            ? Task.CompletedTask
            : previewModal?.ShowAsync(document.Id, document.Files, document.Title) ?? Task.CompletedTask;
    }
    private Task OpenStart() => submitModal?.ShowAsync() ?? Task.CompletedTask;
    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var page = await Documents.GetDocumentsAsync(new DocumentListQuery(null, null, false, 0, 100, 3));
            documents.Clear(); documents.AddRange(page.Items);
            definitions.Clear(); definitions.AddRange(await Documents.GetDefinitionsAsync());
            instances.Clear(); instances.AddRange(await Documents.GetInstancesAsync());
            loaded = true;
            await LoadSelectedAsync();
            ApplyPage();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }
    private async Task LoadSelectedAsync()
    {
        loadedInstanceId = InstanceId;
        selected = InstanceId is { } id
            ? await Documents.GetInstanceAsync(id)
            : null;
        decisionComment = "";
    }
    private Task DecideAsync(Guid taskId, bool approve) =>
        SubmitDecisionAsync(taskId, approve, returnStep: false, approve ? L["Feature:Approve"] : L["Feature:Reject"]);
    private Task ReturnAsync(Guid taskId) =>
        SubmitDecisionAsync(taskId, approve: false, returnStep: true, L["Work:Return"]);
    private async Task SubmitDecisionAsync(Guid taskId, bool approve, bool returnStep, string successMessage)
    {
        try
        {
            var comment = string.IsNullOrWhiteSpace(decisionComment) ? null : decisionComment;
            selected = await Documents.DecideAsync(taskId, new DecideApprovalTaskRequest(approve, comment, Guid.NewGuid().ToString("N"), Return: returnStep));
            decisionComment = "";
            await NotifySuccessAsync(successMessage);
            await RefreshInstancesAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task ResubmitAsync()
    {
        if (selected is null) return;
        try
        {
            selected = await Documents.ResubmitWorkflowAsync(selected.Id, Guid.NewGuid().ToString("N"));
            await NotifySuccessAsync(L["Work:Resubmit"]);
            await RefreshInstancesAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task RefreshInstancesAsync()
    {
        instances.Clear();
        instances.AddRange(await Documents.GetInstancesAsync());
        ApplyPage();
    }
    private bool StepAllowsReturn(string stepCode)
    {
        if (selected is null) return false;
        var definition = definitions.FirstOrDefault(x => x.Id == selected.DefinitionId);
        return definition?.Steps.FirstOrDefault(x => string.Equals(x.Code, stepCode, StringComparison.OrdinalIgnoreCase))?.AllowReturn == true;
    }
    private string DocumentName(Guid id) => documents.FirstOrDefault(x => x.Id == id) is { } d ? $"{d.Number} · {d.Title}" : id.ToString("N")[..8];
    private string DocumentTitle(Guid id) => documents.FirstOrDefault(x => x.Id == id)?.Title ?? id.ToString("N")[..8];
    private string DocumentNumber(Guid id) => documents.FirstOrDefault(x => x.Id == id)?.Number ?? id.ToString("N")[..8];
    private string DefinitionName(Guid id) => definitions.FirstOrDefault(x => x.Id == id)?.Name ?? id.ToString("N")[..8];
    private string StepName(string stepCode)
    {
        if (selected is null) return stepCode;
        return definitions.FirstOrDefault(x => x.Id == selected.DefinitionId)?
            .Steps.FirstOrDefault(x => string.Equals(x.Code, stepCode, StringComparison.OrdinalIgnoreCase))?.Name
            ?? stepCode;
    }
    private static string InstanceBadgeClass(WorkflowInstanceStatus status) => status switch
    {
        WorkflowInstanceStatus.Running => "badge-info",
        WorkflowInstanceStatus.Completed => "badge-muted",
        WorkflowInstanceStatus.Returned => "badge-warn",
        _ => "badge-overdue"
    };
    private static string TaskBadgeClass(ApprovalTaskStatus status) => status switch
    {
        ApprovalTaskStatus.Pending => "badge-info",
        ApprovalTaskStatus.Approved => "badge-muted",
        ApprovalTaskStatus.Returned => "badge-warn",
        _ => "badge-overdue"
    };
}
