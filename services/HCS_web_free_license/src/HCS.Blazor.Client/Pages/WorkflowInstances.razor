@page "/workflow-instances"
@page "/document-workflow-instances"
@page "/document-workflow-instances/{InstanceId:guid}"
@attribute [Authorize(Policy = "Documents.Workflow.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents

<PageTitle>@L["Menu:WorkflowInstances"] · HCS</PageTitle>
<section class="hcs-catalog-page">
    <header class="hcs-catalog-titlebar">
        <div class="min-w-0"><h1>@L["Menu:WorkflowInstances"]</h1></div>
        <div class="hcs-catalog-page__actions">
            <Button Color="Color.Primary" Outline="true" Class="hcs-catalog-export" Clicked="LoadAsync" Disabled="@isLoading">@L["Catalog:Refresh"]</Button>
            <AuthorizeView Policy="Documents.Workflow.Start">
                <Authorized>
                    <Button Color="Color.Primary" Class="hcs-catalog-create" Clicked="OpenStart"><Icon Name="@IconName.Add" /> @L["Work:SubmitWorkflow"]</Button>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <Card Class="mb-3 hcs-catalog-filter-card"><CardBody>
        <div class="hcs-catalog-filter-row">
            <Addons Class="hcs-catalog-search">
                <Addon AddonType="AddonType.Body"><TextInput @bind-Value="filter" Placeholder="@L["Catalog:SearchPlaceholder"]" /></Addon>
                <Addon AddonType="AddonType.End"><Button Color="Color.Primary" Clicked="ApplyFilter"><i class="fa fa-search me-1"></i> @L["Catalog:SearchButton"]</Button></Addon>
            </Addons>
        </div>
    </CardBody></Card>
    <Card Class="hcs-catalog-grid-card"><CardBody>
        @if (isLoading) { <div class="hcs-loading py-5"><i class="fa fa-spinner fa-spin"></i><span>@L["Catalog:Loading"]</span></div> }
        else if (VisibleInstances.Count == 0) { <div class="hcs-empty py-5"><i class="fa fa-inbox"></i><h2>@L["Catalog:EmptyTitle"]</h2><p>@L["Catalog:EmptyDescription"]</p></div> }
        else
        {
            <div class="table-responsive"><table class="table table-hover align-middle mb-0 hcs-catalog-grid">
                <thead><tr><th></th><th>@L["Menu:Documents"]</th><th>@L["Catalog:Status"]</th><th>@L["Feature:AddStep"]</th><th>@L["Catalog:Actions"]</th></tr></thead>
                <tbody>
                @foreach (var instance in VisibleInstances)
                {
                    <tr class="@(instance.Id == InstanceId ? "table-active" : null)">
                        <td><input class="hcs-row-check" type="checkbox" disabled tabindex="-1" /></td>
                        <td><a href="@($"/document-detail/{instance.DocumentId}")"><strong>@DocumentName(instance.DocumentId)</strong></a></td>
                        <td><span class="hcs-status-badge hcs-status-badge--planning">@instance.Status</span></td>
                        <td>@instance.CurrentStep / @instance.Tasks.Count</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary hcs-action-button" href="@($"/document-workflow-instances/{instance.Id}")">@L["Work:View"]</a>
                            <Button Size="Size.Small" Color="Color.Light" Outline="true" Class="hcs-action-button" Clicked="() => PreviewAsync(instance)">@L["Work:PdfPreview"]</Button>
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </CardBody></Card>

    @if (selected is not null)
    {
        <Card Class="hcs-catalog-grid-card mt-4">
            <CardHeader>@L["Work:View"] · @selected.Id</CardHeader>
            <CardBody>
                <p class="mb-3"><span class="hcs-status-badge hcs-status-badge--info">@selected.Status</span> · @L["Feature:AddStep"] @selected.CurrentStep</p>
                @if (selected.Status == WorkflowInstanceStatus.Returned)
                {
                    <AuthorizeView Policy="Documents.Workflow.Start">
                        <Authorized>
                            <Button Color="Color.Primary" Class="mb-3" Clicked="ResubmitAsync">@L["Work:Resubmit"]</Button>
                        </Authorized>
                    </AuthorizeView>
                }
                @foreach (var task in selected.Tasks)
                {
                    <div class="border rounded p-3 mb-2">
                        <strong>@task.StepCode</strong> · @task.Status
                        @if (task.DueAt is { } due)
                        {
                            <small class="text-muted ms-2">@due.ToLocalTime().ToString("dd/MM/yyyy")</small>
                        }
                        @if (task.Status == ApprovalTaskStatus.Pending)
                        {
                            <textarea class="form-control mt-2" rows="2" @bind="decisionComment" placeholder="@L["Feature:DecisionComment"]"></textarea>
                            <AuthorizeView Policy="Documents.Workflow.Decide">
                                <Authorized>
                                    <div class="mt-2 d-flex gap-2 flex-wrap">
                                        <Button Color="Color.Success" Clicked="() => DecideAsync(task.Id, true)">@L["Feature:Approve"]</Button>
                                        <Button Color="Color.Danger" Clicked="() => DecideAsync(task.Id, false)">@L["Feature:Reject"]</Button>
                                        @if (StepAllowsReturn(task.StepCode))
                                        {
                                            <Button Color="Color.Warning" Clicked="() => ReturnAsync(task.Id)">@L["Work:Return"]</Button>
                                        }
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        }
                    </div>
                }
            </CardBody>
        </Card>
    }
</section>

<SubmitWorkflowModal @ref="submitModal" OnSubmitted="LoadAsync" />
<DocumentPdfPreviewModal @ref="previewModal" />
@code {
    [Parameter] public Guid? InstanceId { get; set; }
    private readonly List<DocumentDto> documents = [];
    private readonly List<WorkflowDefinitionDto> definitions = [];
    private readonly List<WorkflowInstanceDto> instances = [];
    private SubmitWorkflowModal? submitModal;
    private DocumentPdfPreviewModal? previewModal;
    private WorkflowInstanceDto? selected;
    private string filter = "", search = "";
    private string decisionComment = "";
    private bool isLoading;

    private List<WorkflowInstanceDto> VisibleInstances => string.IsNullOrWhiteSpace(search)
        ? instances
        : instances.Where(x => DocumentName(x.DocumentId).Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override Task OnParametersSetAsync() => LoadAsync();
    private Task OpenStart() => submitModal?.ShowAsync() ?? Task.CompletedTask;
    private Task PreviewAsync(WorkflowInstanceDto instance)
    {
        var document = documents.FirstOrDefault(x => x.Id == instance.DocumentId);
        return document is null
            ? Task.CompletedTask
            : previewModal?.ShowAsync(document.Id, document.Files, document.Title) ?? Task.CompletedTask;
    }
    private void ApplyFilter() => search = filter;
    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var page = await Documents.GetDocumentsAsync(new DocumentListQuery(null, null, false, 0, 100, 3));
            documents.Clear(); documents.AddRange(page.Items);
            definitions.Clear(); definitions.AddRange(await Documents.GetDefinitionsAsync());
            instances.Clear(); instances.AddRange(await Documents.GetInstancesAsync());
            selected = InstanceId is { } id
                ? await Documents.GetInstanceAsync(id)
                : null;
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }
    private async Task DecideAsync(Guid taskId, bool approve)
    {
        try
        {
            selected = await Documents.DecideAsync(taskId, new DecideApprovalTaskRequest(approve, string.IsNullOrWhiteSpace(decisionComment) ? null : decisionComment, Guid.NewGuid().ToString("N")));
            decisionComment = "";
            await NotifySuccessAsync(approve ? L["Feature:Approve"] : L["Feature:Reject"]);
            instances.Clear(); instances.AddRange(await Documents.GetInstancesAsync());
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task ReturnAsync(Guid taskId)
    {
        try
        {
            selected = await Documents.DecideAsync(taskId, new DecideApprovalTaskRequest(false, string.IsNullOrWhiteSpace(decisionComment) ? null : decisionComment, Guid.NewGuid().ToString("N"), Return: true));
            decisionComment = "";
            await NotifySuccessAsync(L["Work:Return"]);
            instances.Clear(); instances.AddRange(await Documents.GetInstancesAsync());
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task ResubmitAsync()
    {
        if (selected is null) return;
        try
        {
            selected = await Documents.ResubmitWorkflowAsync(selected.Id, Guid.NewGuid().ToString("N"));
            await NotifySuccessAsync(L["Work:Resubmit"]);
            instances.Clear(); instances.AddRange(await Documents.GetInstancesAsync());
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private bool StepAllowsReturn(string stepCode)
    {
        if (selected is null) return false;
        var definition = definitions.FirstOrDefault(x => x.Id == selected.DefinitionId);
        return definition?.Steps.FirstOrDefault(x => string.Equals(x.Code, stepCode, StringComparison.OrdinalIgnoreCase))?.AllowReturn == true;
    }
    private string DocumentName(Guid id) => documents.FirstOrDefault(x => x.Id == id) is { } d ? $"{d.Number} · {d.Title}" : id.ToString("N")[..8];
}
