@page "/notifications"
@attribute [Authorize(Policy = CollaborationPermissions.Notifications)]
@inherits HCSComponentBase
@inject CollaborationClient Chat
@inject NavigationManager Navigation
@using HCS.Blazor.Client.Collaboration
@using HCS.CollaborationService.Contracts

<PageTitle>@L["Notifications:Title"] · HCS</PageTitle>
<section class="page page-wf page-dm" aria-labelledby="notifications-title">
    <div class="page-head">
        <h1 id="notifications-title">@L["Notifications:Title"]</h1>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="MarkAllReadAsync" disabled="@(!allItems.Any(x => !x.IsRead) || isLoading)">
                @L["Notifications:MarkAllAsRead"]
            </button>
            <button class="btn btn-outline" type="button" @onclick="LoadAsync" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                @L["Catalog:Refresh"]
            </button>
        </div>
    </div>

    <section class="docs-main">
        <form class="docs-toolbar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <label class="sr-only" for="notif-q">@L["Catalog:SearchPlaceholder"]</label>
            <input class="input docs-search" id="notif-q" type="search" @bind="filter" @bind:event="oninput"
                   placeholder="@L["Catalog:SearchPlaceholder"]" autocomplete="off" />
            <HcsDismissible Class="filter-pop" @bind-IsOpen="showFilters">
                <button class="btn btn-outline @(string.IsNullOrEmpty(statusFilter) ? null : "is-filtered")" type="button"
                        aria-expanded="@showFilters.ToString().ToLowerInvariant()"
                        @onclick="() => showFilters = !showFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                    @L["Catalog:Filter"]
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="filter-menu @(showFilters ? "is-open" : null)" role="menu">
                    <button type="button" class="@(string.IsNullOrEmpty(statusFilter) ? "is-active" : null)" @onclick="FilterAll">@L["Catalog:AllStatuses"]</button>
                    <button type="button" class="@(statusFilter == "unread" ? "is-active" : null)" @onclick='() => SetStatus("unread")'>@L["Work:Unread"]</button>
                    <button type="button" class="@(statusFilter == "read" ? "is-active" : null)" @onclick='() => SetStatus("read")'>@L["Notifications:Read"]</button>
                </div>
            </HcsDismissible>
            <button class="btn btn-primary" type="submit" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:SearchButton"]
            </button>
            <button class="btn btn-outline" type="button" @onclick="ResetSearchAsync" disabled="@isLoading">@L["Catalog:Reset"]</button>
        </form>

        <div class="docs-table-wrap">
            @if (isLoading && pageItems.Count == 0)
            {
                <DocsEmpty Loading="true" />
            }
            else if (pageItems.Count == 0)
            {
                <DocsEmpty Hint="@L["Work:NoRecentNotifications"]" />
            }
            else
            {
                <table class="docs-table">
                    <thead>
                        <tr>
                            <th scope="col">@L["Notifications:TitleColumn"]</th>
                            <th scope="col">@L["Notifications:Body"]</th>
                            <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                            <th scope="col">@L["Notifications:CreatedAt"]</th>
                            <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in pageItems)
                    {
                        <tr @key="item.Id">
                            <td>
                                <strong class="@(item.IsRead ? null : "fw-semibold")">@NotificationText.Localize(L, item.Title)</strong>
                            </td>
                            <td><span class="text-muted">@NotificationText.Localize(L, item.Body)</span></td>
                            <td>
                                @if (item.IsRead)
                                {
                                    <span class="hcs-status-badge hcs-status-badge--success">@L["Notifications:Read"]</span>
                                }
                                else
                                {
                                    <span class="hcs-status-badge hcs-status-badge--warning">@L["Work:Unread"]</span>
                                }
                            </td>
                            <td>@NotificationText.FormatLocal(item.CreatedAt, "dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="doc-actions">
                                    <button class="doc-action" type="button" title="@L["Work:ViewDetail"]" aria-label="@L["Work:ViewDetail"]" @onclick="() => OpenAsync(item)">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                    @if (!item.IsRead)
                                    {
                                        <button class="doc-action" type="button" title="@L["Notifications:MarkAsRead"]" aria-label="@L["Notifications:MarkAsRead"]" @onclick="() => MarkReadAsync(item)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            <div class="pager" aria-label="@L["Catalog:PageSize"]">
                <button type="button" disabled="@(!CanPrev || isLoading)" @onclick="GoFirst">@L["Catalog:PagerFirst"]</button>
                <button type="button" disabled="@(!CanPrev || isLoading)" @onclick="GoPrev">@L["Catalog:PagerPrev"]</button>
                <button type="button" disabled="@(!CanNext || isLoading)" @onclick="GoNext">@L["Catalog:PagerNext"]</button>
                <button type="button" disabled="@(!CanNext || isLoading)" @onclick="GoLast">@L["Catalog:PagerLast"]</button>
                <label class="sr-only" for="notif-page-size">@L["Catalog:PageSize"]</label>
                <select id="notif-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>
    </section>
</section>

@code {
    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<NotificationDto> allItems = [];
    private readonly List<NotificationDto> pageItems = [];
    private string filter = "", statusFilter = "";
    private bool isLoading, showFilters;
    private int totalCount, pageSize = 20, currentPage = 1;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < PageCount;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            allItems.Clear();
            const int batch = 100;
            for (var skip = 0; ; skip += batch)
            {
                var items = await Chat.GetNotificationsAsync(unreadOnly: false, skip: skip, take: batch);
                if (items.Count == 0) break;
                allItems.AddRange(items);
                if (items.Count < batch) break;
            }

            ApplyPage();
        }
        catch (Exception ex)
        {
            allItems.Clear();
            pageItems.Clear();
            totalCount = 0;
            await NotifyErrorAsync(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyPage()
    {
        var filtered = allItems
            .Where(Matches)
            .OrderByDescending(x => x.CreatedAt)
            .ThenByDescending(x => x.Id)
            .ToList();
        totalCount = filtered.Count;
        if (currentPage > PageCount) currentPage = PageCount;
        pageItems.Clear();
        pageItems.AddRange(filtered.Skip((currentPage - 1) * pageSize).Take(pageSize));
    }

    private bool Matches(NotificationDto item)
    {
        if (statusFilter == "unread" && item.IsRead) return false;
        if (statusFilter == "read" && !item.IsRead) return false;
        if (string.IsNullOrWhiteSpace(filter)) return true;

        var term = SearchText.Normalize(filter);
        var title = NotificationText.Localize(L, item.Title);
        var body = NotificationText.Localize(L, item.Body);
        return title.Contains(term, StringComparison.OrdinalIgnoreCase)
            || body.Contains(term, StringComparison.OrdinalIgnoreCase)
            || item.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
            || item.Body.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private Task SearchAsync()
    {
        currentPage = 1;
        ApplyPage();
        return Task.CompletedTask;
    }

    private Task ResetSearchAsync()
    {
        filter = statusFilter = "";
        showFilters = false;
        currentPage = 1;
        ApplyPage();
        return Task.CompletedTask;
    }

    private Task FilterAll()
    {
        statusFilter = "";
        showFilters = false;
        currentPage = 1;
        ApplyPage();
        return Task.CompletedTask;
    }

    private Task SetStatus(string value)
    {
        statusFilter = value;
        showFilters = false;
        currentPage = 1;
        ApplyPage();
        return Task.CompletedTask;
    }

    private Task GoFirst() { currentPage = 1; ApplyPage(); return Task.CompletedTask; }
    private Task GoPrev() { currentPage = Math.Max(1, currentPage - 1); ApplyPage(); return Task.CompletedTask; }
    private Task GoNext() { currentPage = Math.Min(PageCount, currentPage + 1); ApplyPage(); return Task.CompletedTask; }
    private Task GoLast() { currentPage = PageCount; ApplyPage(); return Task.CompletedTask; }
    private Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return Task.CompletedTask;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        ApplyPage();
        return Task.CompletedTask;
    }

    private async Task OpenAsync(NotificationDto item)
    {
        if (!item.IsRead)
        {
            try { await Chat.MarkNotificationReadAsync(item.Id); } catch { /* navigate anyway */ }
        }

        Navigation.NavigateTo(NotificationText.ResolveLink(item));
    }

    private async Task MarkReadAsync(NotificationDto item)
    {
        try
        {
            await Chat.MarkNotificationReadAsync(item.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await NotifyErrorAsync(ex);
        }
    }

    private async Task MarkAllReadAsync()
    {
        try
        {
            await Chat.MarkAllNotificationsReadAsync();
            await NotifySuccessAsync(L["Notifications:MarkedAllAsRead"]);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await NotifyErrorAsync(ex);
        }
    }
}
