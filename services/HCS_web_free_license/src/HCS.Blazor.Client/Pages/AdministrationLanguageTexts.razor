@page "/administration/language-texts"
@attribute [Authorize(Policy = HCSPermissions.Languages.Default)]
@using HCS.Permissions
@using Microsoft.AspNetCore.Authorization
@inherits HCSComponentBase
@inject LanguageManagementClient LanguageClient
@inject LanguageCatalogState LanguageState

<PageTitle>@L["LanguageTexts:Title"] · HCS</PageTitle>

<AuthorizeView Policy="@HCSPermissions.Languages.Default">
    <Authorized>
        <section class="page page-wf page-admin-language-texts" aria-labelledby="language-texts-title">
            <div class="page-head">
                <h1 id="language-texts-title">@L["LanguageTexts:Title"]</h1>
                <div class="page-actions">
                    <button class="btn btn-outline" type="button" @onclick="RefreshAsync" disabled="@isLoading">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                        @L["LanguageTexts:Refresh"]
                    </button>
                    @if (canManageTexts)
                    {
                        <button class="btn btn-primary" type="button" @onclick="OpenCreateModalAsync" disabled="@isSaving">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                            @L["LanguageTexts:Create"]
                        </button>
                    }
                </div>
            </div>

            <p class="page-admin-language-texts__note">@L["LanguageTexts:RuntimeNotice"]</p>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="hcs-admin-alert" role="alert">
                    <span>@errorMessage</span>
                    <button class="btn btn-outline" type="button" @onclick="RefreshAsync" disabled="@isLoading">@L["LanguageTexts:Retry"]</button>
                </div>
            }

            <form class="docs-toolbar list-search" id="language-texts-search-form" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <label class="sr-only" for="language-text-culture">@L["LanguageTexts:Culture"]</label>
                <select class="select input page-admin-language-texts__culture" id="language-text-culture" value="@selectedCultureName" @onchange="OnCultureChangedAsync">
                    @foreach (var language in LanguageState.Languages)
                    {
                        <option value="@language.CultureName">@language.DisplayName (@language.CultureName)</option>
                    }
                </select>
                <label class="sr-only" for="language-text-search">@L["LanguageTexts:SearchPlaceholder"]</label>
                <input class="input docs-search" id="language-text-search" type="search" @bind="filterText" @bind:event="oninput"
                       placeholder="@L["LanguageTexts:SearchPlaceholder"]" autocomplete="off" />
                <button class="btn btn-primary" type="submit" disabled="@(isLoading || string.IsNullOrWhiteSpace(selectedCultureName))">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                    @L["LanguageTexts:SearchButton"]
                </button>
                <button class="btn btn-outline" type="button" @onclick="ResetSearchAsync" disabled="@isLoading">
                    @L["LanguageTexts:Reset"]
                </button>
            </form>

            <div class="docs-table-wrap">
                <div class="docs-table-scroll">
                    @if (isLoading && rows.Count == 0)
                    {
                        <DocsEmpty Loading="true" Title="@L["LanguageTexts:Loading"]" />
                    }
                    else if (rows.Count == 0)
                    {
                        <DocsEmpty Title="@L["LanguageTexts:EmptyTitle"]" Hint="@L["LanguageTexts:EmptyDescription"]" />
                    }
                    else
                    {
                        <table class="docs-table">
                            <thead>
                                <tr>
                                    <th class="col-actions" scope="col">@L["LanguageTexts:Actions"]</th>
                                    <th scope="col">@L["LanguageTexts:Key"]</th>
                                    <th scope="col">@L["LanguageTexts:Value"]</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var text in rows)
                            {
                                <tr @key="text.Id">
                                    <td class="col-actions">
                                        @if (canManageTexts)
                                        {
                                            <div class="doc-actions">
                                                <button class="doc-action" type="button" title="@L["LanguageTexts:Edit"]" aria-label="@L["LanguageTexts:Edit"]" @onclick="() => OpenEditModalAsync(text)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                                </button>
                                                <button class="doc-action is-danger" type="button" title="@L["LanguageTexts:Delete"]" aria-label="@L["LanguageTexts:Delete"]" @onclick="() => DeleteAsync(text)">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                                </button>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (canManageTexts)
                                        {
                                            <button type="button" class="doc-title-open" @onclick="() => OpenEditModalAsync(text)">@text.Name</button>
                                        }
                                        else
                                        {
                                            @text.Name
                                        }
                                    </td>
                                    <td><span class="page-admin-language-texts__value" title="@text.Value">@text.Value</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
                <HcsPager TotalCount="totalCount" PageSize="pageSize" PageSizeId="language-texts-page-size" PageSizes="PageSizeOptions"
                          CanPrev="CanPrevPage" CanNext="CanNextPage" Disabled="@isLoading"
                          FirstClicked="GoFirstPage" PrevClicked="GoPrevPage" NextClicked="GoNextPage" LastClicked="GoLastPage"
                          PageSizeChanged="OnPageSizeChanged" />
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        <section class="page page-wf"><div class="hcs-admin-alert" role="alert">@L["Users:NoAdminPermission"]</div></section>
    </NotAuthorized>
</AuthorizeView>

<Modal @ref="editModal" Size="ModalSize.Large">
    <ModalContent Centered="true" Class="hcs-catalog-modal">
        <ModalHeader Class="hcs-catalog-modal__header">
            <ModalTitle>@(editingId.HasValue ? L["LanguageTexts:EditTitle"] : L["LanguageTexts:CreateTitle"])</ModalTitle>
            <CloseButton Clicked="CloseModalAsync" Disabled="@isSaving" />
        </ModalHeader>
        <ModalBody Class="hcs-catalog-modal__body">
            @if (!string.IsNullOrWhiteSpace(formErrorMessage))
            {
                <div class="hcs-admin-alert" role="alert">@formErrorMessage</div>
            }
            <p class="page-admin-language-texts__meta">
                <span><strong>@L["LanguageTexts:Resource"]:</strong> HCS</span>
                <span><strong>@L["LanguageTexts:Culture"]:</strong> @selectedCultureName</span>
            </p>
            <Field>
                <FieldLabel for="language-text-key">@L["LanguageTexts:Key"]</FieldLabel>
                <TextInput id="language-text-key" @bind-Value="form.Name" ReadOnly="@editingId.HasValue" MaxLength="256" />
                @if (!string.IsNullOrWhiteSpace(keyError)) { <div class="hcs-field-error">@keyError</div> }
                @if (editingId.HasValue) { <div class="hcs-field-hint">@L["LanguageTexts:KeyReadonly"]</div> }
            </Field>
            <Field>
                <FieldLabel for="language-text-value">@L["LanguageTexts:Value"]</FieldLabel>
                <textarea id="language-text-value" class="form-control" rows="6" maxlength="4096" @bind="form.Value"></textarea>
                @if (!string.IsNullOrWhiteSpace(valueError)) { <div class="hcs-field-error">@valueError</div> }
            </Field>
        </ModalBody>
        <ModalFooter Class="hcs-catalog-modal__footer">
            <button class="btn btn-outline" type="button" @onclick="CloseModalAsync" disabled="@isSaving">@L["LanguageTexts:Cancel"]</button>
            <button class="btn btn-primary" type="button" @onclick="SaveAsync" disabled="@isSaving">
                @(editingId.HasValue ? L["LanguageTexts:Save"] : L["LanguageTexts:Create"])
            </button>
        </ModalFooter>
    </ModalContent>
</Modal>
