    private async Task LoadMemberNamesAsync(IEnumerable<Guid> userIds)
    {
        try
        {
            var contacts = await Chat.GetContactsAsync(null, 100);
            foreach (var contact in contacts.Where(x => userIds.Contains(x.Id)))
                memberNames[contact.Id] = UserDisplayNames.FirstReal(contact.DisplayName, contact.UserName);
        }
        catch { }
    }

    private string MemberName(Guid userId) => memberNames.GetValueOrDefault(userId, userId.ToString("N")[..8]);
    private string DepartmentSelectText(Guid? id) => CatalogSelect2Cache.TextFor(departments, id, x => x.Id, x => CatalogSelect2Text.CodeName(x.Code, x.Name));

    private async Task<CatalogSelect2SearchResponse> SearchDepartmentsAsync(string term, int page)
    {
        var skip = Math.Max(page - 1, 0) * 20;
        var result = await Catalog.SearchDepartmentsAsync(term, skip, 20);
        return CatalogSelect2Cache.Merge(departments, result.Items, x => x.Id,
            x => CatalogSelect2Text.CodeName(x.Code, x.Name), more: skip + result.Items.Count < result.TotalCount);
    }

    private Task OnRangeChanged(IReadOnlyList<DateTime?> dates)
    {
        selectedDates = dates;
        if (dates.Count >= 2 && dates[0] is { } start && dates[1] is { } end)
        {
            fromDate = (start <= end ? start : end).Date;
            toDate = (start <= end ? end : start).Date;
            if (selectedDay.Date < fromDate || selectedDay.Date > toDate) selectedDay = fromDate;
            return LoadAsync();
        }
        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var from = fromDate.Date;
            var to = toDate.Date.AddDays(1).AddTicks(-1);
            events.Clear(); events.AddRange((await Work.GetCalendarAsync(from, to)).Where(x => x.StartTime.ToLocalTime() >= from && x.StartTime.ToLocalTime() <= to));
            projects.Clear(); projects.AddRange((await Work.GetProjectsAsync(new WorkListQuery(null, null, 0, 100))).Items
                .Where(x => x.EndDate >= from && x.StartDate <= to));
            tasks.Clear(); tasks.AddRange((await Work.GetTasksAsync(null, new WorkListQuery(null, null, 0, 100))).Items
                .Where(x => x.DueDate >= from && x.StartDate <= to));
            try { documents.Clear(); documents.AddRange((await Documents.GetDocumentsAsync(new DocumentListQuery(null, null, false, 0, 20))).Items); } catch { documents.Clear(); }
            try { workflows.Clear(); workflows.AddRange(await Documents.GetInstancesAsync()); } catch { workflows.Clear(); }
            try
            {
                notifications.Clear();
                notifications.AddRange((await Chat.GetNotificationsAsync())
                    .OrderByDescending(x => x.CreatedAt)
                    .ThenByDescending(x => x.Id));
            }
            catch { notifications.Clear(); }
            if (!visibleDays.Contains(selectedDay.Date))
                selectedDay = visibleDays.Contains(DateTime.Today) ? DateTime.Today : fromDate.Date;
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }

    private string ProjectLabel(CalendarEventDto item)
    {
        if (item.RelatedType == "PROJECT" && Guid.TryParse(item.RelatedId, out var id))
        {
            var project = projects.FirstOrDefault(x => x.Id == id);
            if (project is not null) return $" · {project.Name}";
        }
        return string.IsNullOrWhiteSpace(item.Description) ? "" : $" · {item.Description}";
    }

    private RenderFragment Kpi(string icon, string background, string color, int value, string label) => __builder =>
    {
        <div class="hcs-ws-kpi">
            <div class="hcs-ws-kpi-top">
                <div class="hcs-ws-kpi-icon" style="@($"background:{background};color:{color}")"><i class="fa @icon"></i></div>
            </div>
            <div class="hcs-ws-kpi-num">@value</div>
            <div class="hcs-ws-kpi-lbl">@label</div>
        </div>
    };

    private sealed class ProjectForm
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddMonths(1);
        public string Status { get; set; } = "Draft";
        public Guid? OwnerDepartmentId { get; set; }

        public void Reset()
        {
            Code = Name = Description = "";
            StartDate = DateTime.Today;
            EndDate = DateTime.Today.AddMonths(1);
            Status = "Draft";
            OwnerDepartmentId = null;
        }
    }
