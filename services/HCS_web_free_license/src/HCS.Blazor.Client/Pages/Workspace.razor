@page "/workspace"
@using System.Globalization
@using System.Net
@attribute [Authorize(Policy = "WorkManagement.Dashboard")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject DocumentClient Documents
@inject CollaborationClient Chat
@inject OrganizationUnitCatalogClient OrganizationUnits
@inject SystemFeatureState Features

<PageTitle>@L["Feature:WorkspaceTitle"] · HCS</PageTitle>
<section class="hcs-workspace">
    <div class="hcs-ws-filter">
        <span class="hcs-ws-filter-label">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
            @L["Work:FilterByDateRange"]
        </span>
        <div class="hcs-ws-filter-dates">
            <HcsDatePicker TValue="IReadOnlyList<DateTime?>"
                           Value="selectedDates"
                           ValueChanged="OnRangeChanged"
                           InputMode="DateInputMode.Date"
                           SelectionMode="DateInputSelectionMode.Range"
                           DisplayFormat="dd/MM/yyyy"
                           Placeholder="@L["Work:SelectDateRange"]" />
        </div>
        <button type="button" class="btn btn-primary" @onclick="LoadAsync" disabled="@isLoading">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
            @L["Catalog:SearchButton"]
        </button>
    </div>

    <div class="hcs-ws-kpis">
        <div class="hcs-ws-kpi hcs-ws-kpi--static">
            <span class="hcs-ws-kpi-icon pink" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg></span>
            <div class="hcs-ws-kpi-num">@events.Count</div>
            <div class="hcs-ws-kpi-lbl">@L["Work:Events"]</div>
        </div>
        <a class="hcs-ws-kpi" href="/document-signing">
            <span class="hcs-ws-kpi-icon teal" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 12h8m-8 4 2 2 5-5"/></svg></span>
            <div class="hcs-ws-kpi-num">@myDocumentCount</div>
            <div class="hcs-ws-kpi-lbl">@L["Work:SigningDocuments"]</div>
        </a>
        <a class="hcs-ws-kpi" href="/projects">
            <span class="hcs-ws-kpi-icon blue" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h7l2 2h9v10H3z"/></svg></span>
            <div class="hcs-ws-kpi-num">@projects.Count</div>
            <div class="hcs-ws-kpi-lbl">@L["Menu:Projects"]</div>
        </a>
        <a class="hcs-ws-kpi" href="/tasks">
            <span class="hcs-ws-kpi-icon green" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 7h12M8 12h12M8 17h12"/><path d="M4 7h.01M4 12h.01M4 17h.01"/></svg></span>
            <div class="hcs-ws-kpi-num">@myTasks.Count</div>
            <div class="hcs-ws-kpi-lbl">@L["Work:MyTasks"]</div>
        </a>
    </div>

    <div class="hcs-ws-grid-73">
        <article class="hcs-ws-card">
            <header class="hcs-ws-card-hd">
                <div class="hcs-ws-card-title-wrap">
                    <div class="hcs-ws-card-icon pink" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg></div>
                    <div>
                        <div class="hcs-ws-card-title">@L["Work:Calendar"]</div>
                        <div class="hcs-ws-card-sub">@L["Work:Total"] @visibleDaysEvents.Count @L["Work:Events"]</div>
                    </div>
                </div>
            </header>
            <div class="hcs-ws-card-body">
                <div class="hcs-ws-week">
                    @foreach (var day in visibleDays)
                    {
                        var hasEvents = events.Any(x => x.StartTime.ToLocalTime().Date == day.Date);
                        <div class="hcs-ws-day">
                            <span class="hcs-ws-wd">@day.ToString("ddd")</span>
                            <button type="button" class="hcs-ws-dn @(day.Date == selectedDay.Date ? "is-today" : null)" @onclick="() => selectedDay = day">@day.Day</button>
                            <span class="hcs-ws-dot @(hasEvents ? null : "is-empty")"></span>
                        </div>
                    }
                </div>
                @if (visibleDaysEvents.Count == 0) { <div class="hcs-ws-empty">@L["Work:NoUpcomingEvents"]</div> }
                else
                {
                    <div class="hcs-ws-ev">
                        @foreach (var group in visibleDaysEvents.GroupBy(x => x.StartTime.ToLocalTime().Date).OrderBy(g => g.Key))
                        {
                            <div class="hcs-ws-ev-day @(group.Key == selectedDay.Date ? "is-selected" : null)">
                                <div class="hcs-ws-ev-day-label">@group.Key.ToString("ddd dd/MM")</div>
                                @foreach (var item in group.OrderBy(x => x.StartTime))
                                {
                                    <div class="hcs-ws-ev-row">
                                        <span class="hcs-ws-ev-accent"></span>
                                        <div class="hcs-ws-ev-body">
                                            <button type="button" class="hcs-ws-ev-name" @onclick="() => OpenCalendarEventAsync(item)">@item.Title</button>
                                            <div class="hcs-ws-ev-meta">@item.StartTime.ToLocalTime().ToString("HH:mm") – @item.EndTime.ToLocalTime().ToString("HH:mm")@ProjectLabel(item)</div>
                                        </div>
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenCalendarEventAsync(item)">@L["Work:View"]</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </article>
        <article class="hcs-ws-card hcs-ws-card--notifications">
            <header class="hcs-ws-card-hd">
                <div class="hcs-ws-card-title-wrap">
                    <div class="hcs-ws-card-icon teal" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 7 3 9H3c0-2 3-2 3-9"/><path d="M10 19a2 2 0 0 0 4 0"/></svg></div>
                    <div>
                        <div class="hcs-ws-card-title">@L["Work:Notifications"]</div>
                        <div class="hcs-ws-card-sub">@notifications.Count(x => !x.IsRead) @L["Work:Unread"]</div>
                    </div>
                </div>
                <button type="button" class="hcs-ws-notif-mark-all" @onclick="MarkAllWorkspaceNotificationsAsync" disabled="@(!notifications.Any(x => !x.IsRead))">
                    @L["Notifications:MarkAllAsRead"]
                </button>
            </header>
            <div class="hcs-ws-card-body">
                @if (notifications.Count == 0) { <div class="hcs-ws-empty">@L["Work:NoRecentNotifications"]</div> }
                else
                {
                    <div class="hcs-ws-notif">
                        @foreach (var item in notifications)
                        {
                            var kind = NotificationText.ResolveKind(item);
                            <a class="hcs-ws-notif-item text-decoration-none @(item.IsRead ? null : "is-unread")"
                               href="@NotificationText.ResolveLink(item)"
                               @onclick="() => OpenWorkspaceNotificationAsync(item)"
                               @onclick:preventDefault>
                                <span class="hcs-ws-notif-ico is-@kind" aria-hidden="true">
                                    <i class="fa @NotificationText.IconClass(kind)"></i>
                                </span>
                                <span class="hcs-ws-notif-copy">
                                    <strong>@NotificationText.Localize(L, item.Title)</strong>
                                    <p>@NotificationText.Localize(L, item.Body)</p>
                                    <time datetime="@item.CreatedAt.ToUniversalTime().ToString("O")">@NotificationText.FormatLocal(item.CreatedAt, "dd/MM HH:mm")</time>
                                </span>
                            </a>
                        }
                    </div>
                }
                <a class="hcs-ws-notif-all" href="/notifications">@L["Notifications:ViewAll"]</a>
            </div>
        </article>
    </div>

    <div class="hcs-ws-grid-37">
        <article class="hcs-ws-card">
            <header class="hcs-ws-card-hd">
                <div class="hcs-ws-card-title-wrap">
                    <div class="hcs-ws-card-icon purple" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="12" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M8.2 7.2 15.5 11M8.2 16.8 15.5 13"/></svg></div>
                    <div>
                        <div class="hcs-ws-card-title">@L["Menu:Workflows"]</div>
                        <div class="hcs-ws-card-sub">@workflows.Count @L["Menu:Documents"]</div>
                    </div>
                </div>
            </header>
            <div class="hcs-ws-card-body">
                @if (isLoading) { <HcsLoading CssClass="py-4" /> }
                else if (workflows.Count == 0) { <div class="hcs-ws-empty">@L["Work:NoRecentDocuments"]</div> }
                else { @StatusDonut(workflows.Count, L["Menu:Documents"], workflowGroups) }
            </div>
        </article>
        <article class="hcs-ws-card">
            <header class="hcs-ws-card-hd">
                <div class="hcs-ws-card-title-wrap">
                    <div class="hcs-ws-card-icon teal" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 12h8m-8 4 2 2 5-5"/></svg></div>
                    <div>
                        <div class="hcs-ws-card-title">@L["Work:SigningDocuments"]</div>
                        <div class="hcs-ws-card-sub">@workflows.Count @L["Menu:Documents"]</div>
                    </div>
                </div>
            </header>
            <div class="hcs-ws-card-body">
                @if (isLoading) { <HcsLoading CssClass="py-4" /> }
                else
                {
                    <div class="hcs-ws-signing-tabs" aria-label="@L["Work:SigningDocuments"]">
                        @foreach (var tab in SigningTabs)
                        {
                            <button type="button" class="hcs-ws-signing-tab @(signingTab == tab.Key ? "is-active" : null)"
                                    aria-pressed="@((signingTab == tab.Key).ToString().ToLowerInvariant())"
                                    @onclick="() => SelectSigningTab(tab.Key)">
                                @L[tab.Label] <span>@tab.Count</span>
                            </button>
                        }
                    </div>
                    <div class="hcs-ws-doc-groups" @key="signingTab" aria-live="polite">
                        @if (FilteredSigningWorkflows.Count == 0)
                        {
                            <div class="hcs-ws-empty">@L["Work:NoRecentDocuments"]</div>
                        }
                        else
                        {
                            @WorkflowDocRows(FilteredSigningWorkflows.Take(signingVisibleCount).ToList())
                        }
                        @if (signingVisibleCount < FilteredSigningWorkflows.Count)
                        {
                            <div class="hcs-ws-signing-more">
                                <button type="button" class="btn btn-outline btn-sm" @onclick="LoadMoreSigningDocuments">@L["Work:LoadMoreDocuments"]</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </article>
    </div>

    <div class="hcs-ws-grid-37">
        <article class="hcs-ws-card">
            <header class="hcs-ws-card-hd">
                <div class="hcs-ws-card-title-wrap">
                    <div class="hcs-ws-card-icon blue" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19V5"/><path d="M4 19h16"/><path d="M8 16l3-5 3 3 4-7"/></svg></div>
                    <div>
                        <div class="hcs-ws-card-title">@L["Menu:Projects"]</div>
                        <div class="hcs-ws-card-sub">@projects.Count @L["Menu:Projects"]</div>
                    </div>
                </div>
            </header>
            <div class="hcs-ws-card-body">
                @if (projects.Count == 0) { <div class="hcs-ws-empty">@L["Work:NoProjectsFound"]</div> }
                else { @StatusDonut(projects.Count, L["Menu:Projects"], projectGroups) }
            </div>
        </article>
        <article class="hcs-ws-card">
            <header class="hcs-ws-card-hd">
                <div class="hcs-ws-card-title-wrap">
                    <div class="hcs-ws-card-icon teal" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h7l2 2h9v10H3z"/></svg></div>
                    <div>
                        <div class="hcs-ws-card-title">@L["Menu:Projects"]</div>
                        <div class="hcs-ws-card-sub">@projects.Count(x => x.Status == "Completed") @L["Work:Of"] @projects.Count @L["Menu:Projects"]</div>
                    </div>
                </div>
                <AuthorizeView Policy="WorkManagement.Projects">
                    <Authorized><button type="button" class="btn btn-primary btn-sm hcs-ws-add" title="@L["Work:NewProject"]" aria-label="@L["Work:NewProject"]" @onclick="OpenCreateProjectModalAsync"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></Authorized>
                </AuthorizeView>
            </header>
            <div class="hcs-ws-card-body">
                @if (projects.Count == 0) { <div class="hcs-ws-empty">@L["Work:NoProjectsFound"]</div> }
                else
                {
                    <div class="hcs-ws-proj hcs-ws-list-expandable">
                        @foreach (var project in projects.Take(projectVisibleCount))
                        {
                            var progress = WorkUi.ProjectProgress(project.Status);
                            <div class="hcs-ws-proj-row">
                                <div class="hcs-ws-proj-top">
                                    <button type="button" class="hcs-ws-proj-name" @onclick="() => OpenProjectDetailModalAsync(project.Id)">@project.Name</button>
                                    <div class="hcs-ws-proj-actions">
                                        <span class="@WorkUi.ProjectBadgeClass(project.Status)">@L[WorkUi.ProjectStatusKey(project.Status)]</span>
                                        <button type="button" class="icon-btn eye" title="@L["Work:ViewDetail"]" aria-label="@L["Work:ViewDetail"]" @onclick="() => OpenProjectDetailModalAsync(project.Id)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </button>
                                    </div>
                                </div>
                                <div class="hcs-ws-pbar"><div class="hcs-ws-pbf" style="width:@progress%"></div></div>
                                <div class="hcs-ws-proj-foot">
                                    <span class="hcs-ws-people">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M16 11a3 3 0 1 0-4-5 3 3 0 0 0 4 5z"/><path d="M8 14a3 3 0 1 0-4-5 3 3 0 0 0 4 5z"/><path d="M20 20a5 5 0 0 0-8 0"/><path d="M12 20a5 5 0 0 0-8 0"/></svg>
                                        @project.MemberCount @L["Work:Members"]
                                    </span>
                                    <span>@project.EndDate.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                    @if (projectVisibleCount < projects.Count)
                    {
                        <div class="hcs-ws-signing-more">
                            <button type="button" class="btn btn-outline btn-sm" @onclick="() => projectVisibleCount += 6">@L["Work:LoadMoreDocuments"]</button>
                        </div>
                    }
                }
            </div>
        </article>
    </div>

    <div class="hcs-ws-grid-37">
        <article class="hcs-ws-card">
            <header class="hcs-ws-card-hd">
                <div class="hcs-ws-card-title-wrap">
                    <div class="hcs-ws-card-icon green" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 7h12M8 12h12M8 17h12"/><path d="M4 7h.01M4 12h.01M4 17h.01"/></svg></div>
                    <div>
                        <div class="hcs-ws-card-title">@L["Menu:Tasks"]</div>
                        <div class="hcs-ws-card-sub">@tasks.Count @L["Menu:Tasks"]</div>
                    </div>
                </div>
            </header>
            <div class="hcs-ws-card-body">
                @if (tasks.Count == 0) { <div class="hcs-ws-empty">@L["Feature:NoTasks"]</div> }
                else { @StatusDonut(tasks.Count, L["Menu:Tasks"], taskGroups) }
            </div>
        </article>
        <article class="hcs-ws-card">
            <header class="hcs-ws-card-hd">
                <div class="hcs-ws-card-title-wrap">
                    <div class="hcs-ws-card-icon green" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 7h12M8 12h12M8 17h12"/><path d="M4 7h.01M4 12h.01M4 17h.01"/></svg></div>
                    <div>
                        <div class="hcs-ws-card-title">@L["Work:MyTasks"]</div>
                        <div class="hcs-ws-card-sub">@myTasks.Count @L["Menu:Tasks"]</div>
                    </div>
                </div>
                <AuthorizeView Policy="WorkManagement.ProjectTasks">
                    <Authorized><button type="button" class="btn btn-primary btn-sm hcs-ws-add" title="@L["Work:NewTask"]" aria-label="@L["Work:NewTask"]" @onclick="OpenCreateTaskModalAsync"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></Authorized>
                </AuthorizeView>
            </header>
            <div class="hcs-ws-card-body">
                @if (myTasks.Count == 0) { <div class="hcs-ws-empty">@L["Feature:NoTasks"]</div> }
                else
                {
                    <div class="hcs-ws-task hcs-ws-list-expandable">
                        @foreach (var task in myTasks.Take(taskVisibleCount))
                        {
                            <div class="hcs-ws-task-row">
                                <button type="button" class="hcs-ws-task-name" @onclick="() => OpenTaskDetailModalAsync(task.Id)">@task.Title</button>
                                <span class="@WorkUi.ProgressBadgeClass(task.ProgressPercent)">@task.ProgressPercent%</span>
                                <button type="button" class="icon-btn eye" title="@L["Work:ViewDetail"]" aria-label="@L["Work:ViewDetail"]" @onclick="() => OpenTaskDetailModalAsync(task.Id)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                            </div>
                        }
                    </div>
                    @if (taskVisibleCount < myTasks.Count)
                    {
                        <div class="hcs-ws-signing-more">
                            <button type="button" class="btn btn-outline btn-sm" @onclick="() => taskVisibleCount += 6">@L["Work:LoadMoreDocuments"]</button>
                        </div>
                    }
                }
            </div>
        </article>
    </div>
</section>

<ProjectTaskCreateModal @ref="createTaskModal" OnCreated="LoadAsync" />
<ProjectTaskViewModal @ref="taskViewModal" OnChanged="LoadAsync" OnViewDocument="PreviewTaskDocumentAsync" />
<CalendarEventViewModal @ref="calendarEventModal" OnOpenProject="OpenProjectFromCalendarEventAsync" OnOpenTask="OpenTaskFromCalendarEventAsync" />
<DocumentPdfPreviewModal @ref="documentPreviewModal" ShowAssignTask="true" OnAssignTask="AssignPreviewDocumentAsync">
    <FooterActions>
        @if (previewingMyDocument?.IsSigning == true)
        {
            <a class="btn btn-primary" href="@($"/document-signing/{previewingMyDocument.Id}")">
                <i class="fa fa-signature me-1" aria-hidden="true"></i>@L["Menu:DocumentSigning"]
            </a>
        }
    </FooterActions>
</DocumentPdfPreviewModal>

<Modal @ref="createProjectModal" Size="ModalSize.Large">
    <ModalContent Centered Class="hcs-catalog-modal">
        <ModalHeader Class="hcs-catalog-modal__header">
            <ModalTitle>@L["Work:NewProject"]</ModalTitle>
            <CloseButton Clicked="CloseCreateProjectModalAsync" />
        </ModalHeader>
        <ModalBody Class="hcs-catalog-modal__body">
            <div class="hcs-catalog-form">
                <div class="hcs-form-row">
                    <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="projectForm.Code" Name="hcsWorkspaceProjectCode" MaxLength="64" Placeholder="@ProjectCodePlaceholder" /></Field>
                    <Field><FieldLabel>@L["Feature:ProjectName"] *</FieldLabel><HcsIsolatedTextInput @bind-Value="projectForm.Name" Name="hcsWorkspaceProjectName" /></Field>
                </div>
                <Field><FieldLabel>@L["Feature:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="projectForm.Description"></textarea></Field>
                <div class="hcs-form-row hcs-form-row--equal">
                    <Field><FieldLabel>@L["Feature:StartDate"]</FieldLabel><HcsDatePicker TValue="DateTime" @bind-Value="projectForm.StartDate" InputMode="DateInputMode.DateTime" ShowTodayButton ShowClearButton /></Field>
                    <Field><FieldLabel>@L["Feature:EndDate"]</FieldLabel><HcsDatePicker TValue="DateTime" @bind-Value="projectForm.EndDate" InputMode="DateInputMode.DateTime" ShowTodayButton ShowClearButton /></Field>
                </div>
                <div class="hcs-form-row hcs-form-row--equal">
                    <Field><FieldLabel>@L["Catalog:Status"]</FieldLabel>
                        <Select TValue="string" @bind-Value="projectForm.Status">
                            @foreach (var value in WorkUi.ProjectStatuses) { <SelectItem Value="@value">@L[WorkUi.ProjectStatusKey(value)]</SelectItem> }
                        </Select>
                    </Field>
                    <Field><FieldLabel>@L["Catalog:Department"]</FieldLabel>
                        <CatalogSelect2 Value="projectForm.OwnerDepartmentId"
                                        ValueChanged="value => projectForm.OwnerDepartmentId = value"
                                        Placeholder="@L["Catalog:SearchPlaceholder"]"
                                        SelectedText="@DepartmentSelectText(projectForm.OwnerDepartmentId)"
                                        Search="SearchDepartmentsAsync" />
                    </Field>
                </div>
            </div>
        </ModalBody>
        <ModalFooter Class="hcs-catalog-modal__footer">
            <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="CloseCreateProjectModalAsync">@L["Catalog:Cancel"]</Button>
            <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="CreateProjectAsync" Disabled="@isSavingProject">@L["Catalog:SaveChanges"]</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="projectDetailModal" Size="ModalSize.ExtraLarge">
    <ModalContent Centered Class="hcs-catalog-modal hcs-ws-project-modal">
        <ModalHeader Class="hcs-catalog-modal__header">
            <ModalTitle title="@(projectDetail?.Project.Name ?? L["Feature:ProjectDetail"].Value)">@(projectDetail?.Project.Name ?? L["Feature:ProjectDetail"])</ModalTitle>
            <CloseButton Clicked="CloseProjectDetailModalAsync" />
        </ModalHeader>
        <ModalBody Class="hcs-catalog-modal__body">
            @if (projectDetail is null)
            {
                <HcsLoading CssClass="py-5" />
            }
            else
            {
                <div class="hcs-ws-project">
                    <div class="hcs-ws-project__summary">
                        <span class="hcs-ws-project__code">#@projectDetail.Project.Code</span>
                        <span class="@WorkUi.ProjectBadgeClass(projectDetail.Project.Status)">@L[WorkUi.ProjectStatusKey(projectDetail.Project.Status)]</span>
                        <span class="hcs-ws-project__dates">
                            @projectDetail.Project.StartDate.ToLocalTime().ToString("dd/MM/yyyy")
                            –
                            @projectDetail.Project.EndDate.ToLocalTime().ToString("dd/MM/yyyy")
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(projectDetail.Project.Description))
                    {
                        <p class="hcs-ws-project__desc">@projectDetail.Project.Description</p>
                    }
                    <div class="hcs-ws-project__grid">
                        <section class="hcs-ws-project__panel" aria-labelledby="ws-project-members">
                            <header class="hcs-ws-project__panel-hd">
                                <h3 id="ws-project-members">@L["Feature:Members"]</h3>
                                <span class="hcs-ws-project__count">@projectDetail.Members.Count</span>
                            </header>
                            @if (projectDetail.Members.Count == 0)
                            {
                                <p class="hcs-ws-project__empty">@L["Feature:NoMembers"]</p>
                            }
                            else
                            {
                                <ul class="hcs-ws-project__members">
                                    @foreach (var member in projectDetail.Members)
                                    {
                                        var name = MemberName(member.UserId);
                                        <li>
                                            <span class="hcs-ws-project__avatar" aria-hidden="true">@Initials(name)</span>
                                            <span class="hcs-ws-project__member">
                                                <strong>@name</strong>
                                                <small>@ProjectRoleLabel(member.Role)</small>
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                        <section class="hcs-ws-project__panel" aria-labelledby="ws-project-tasks">
                            <header class="hcs-ws-project__panel-hd">
                                <h3 id="ws-project-tasks">@L["Menu:Tasks"]</h3>
                                <span class="hcs-ws-project__count">@projectDetail.Tasks.Count</span>
                            </header>
                            @if (projectDetail.Tasks.Count == 0)
                            {
                                <p class="hcs-ws-project__empty">@L["Feature:NoTasks"]</p>
                            }
                            else
                            {
                                <ul class="hcs-ws-project__tasks">
                                    @foreach (var task in projectDetail.Tasks.Take(12))
                                    {
                                        <li>
                                            <button type="button" class="hcs-ws-project__task-name" @onclick="() => OpenTaskFromProjectModalAsync(task.Id)">@task.Title</button>
                                            <span class="@WorkUi.TaskBadgeClass(task.Status)">@L[WorkUi.TaskStatusKey(task.Status)]</span>
                                            <button type="button" class="icon-btn eye" title="@L["Work:ViewDetail"]" aria-label="@L["Work:ViewDetail"]" @onclick="() => OpenTaskFromProjectModalAsync(task.Id)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    </div>
                </div>
            }
        </ModalBody>
        <ModalFooter Class="hcs-catalog-modal__footer">
            <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="CloseProjectDetailModalAsync">@L["Catalog:Cancel"]</Button>
            @if (projectDetail is not null)
            {
                <a class="btn btn-primary hcs-catalog-save" href="@($"/project-detail/{projectDetail.Project.Id}")"><i class="fa fa-arrow-up-right-from-square me-1" aria-hidden="true"></i>@L["Work:ViewDetail"]</a>
            }
        </ModalFooter>
    </ModalContent>
</Modal>
@code {
    private readonly List<CalendarEventDto> events = [];
    private readonly List<ProjectDto> projects = [];
    private readonly List<ProjectTaskDto> tasks = [];
    private readonly Dictionary<Guid, SigningQueueItemDto> signingQueue = [];
    private readonly List<WorkflowInstanceDto> workflows = [];
    private readonly Dictionary<Guid, SigningQueueDocumentDto> workflowDocuments = [];
    private readonly List<NotificationDto> notifications = [];
    private readonly List<DepartmentCatalogDto> departments = [];
    private readonly Dictionary<Guid, string> memberNames = [];
    private readonly ProjectForm projectForm = new();
    private ProjectTaskCreateModal? createTaskModal;
    private ProjectTaskViewModal? taskViewModal;
    private CalendarEventViewModal? calendarEventModal;
    private DocumentPdfPreviewModal? documentPreviewModal;
    private MyDocumentRow? previewingMyDocument;
    private Modal? createProjectModal;
    private string? nextProjectCode;
    private string ProjectCodePlaceholder => nextProjectCode ?? Features.Prefix(AutoCodeKind.Project);
    private Modal? projectDetailModal;
    private ProjectDetailDto? projectDetail;
    private bool isSavingProject;
    private DateTime fromDate = DateTime.Today.AddMonths(-1);
    private DateTime toDate = DateTime.Today.AddMonths(1);
    private IReadOnlyList<DateTime?> selectedDates = [DateTime.Today.AddMonths(-1), DateTime.Today.AddMonths(1)];
    private DateTime selectedDay = DateTime.Today;
    private bool isLoading;
    private int loadGeneration;
    private long myDocumentCount;

    private IReadOnlyList<DateTime> visibleDays
    {
        get
        {
            var from = fromDate.Date;
            var to = toDate.Date;
            if (to < from) to = from;
            var start = DateTime.Today;
            if (start < from || start > to) start = from;
            var count = Math.Max(1, Math.Min(10, (int)(to - start).TotalDays + 1));
            return Enumerable.Range(0, count).Select(offset => start.AddDays(offset)).ToList();
        }
    }
    private List<CalendarEventDto> visibleDaysEvents => events
        .Where(x =>
        {
            var date = x.StartTime.ToLocalTime().Date;
            return date >= visibleDays[0] && date <= visibleDays[^1];
        })
        .OrderBy(x => x.StartTime)
        .ToList();
    private List<ProjectTaskDto> myTasks => tasks.Where(x => x.Status is not "Completed" and not "Cancelled").ToList();
    private List<WorkflowInstanceDto> createdWorkflows => workflows.Where(IsCreatedByMe).ToList();
    private List<WorkflowInstanceDto> receivedWorkflows => workflows.Where(IsReceivedByMe).ToList();
    private string signingTab = "all";
    private int signingVisibleCount = 6;
    private int projectVisibleCount = 6;
    private int taskVisibleCount = 6;
    private IReadOnlyList<(string Key, string Label, int Count)> SigningTabs =>
    [
        ("all", "All", workflows.Count),
        ("created", "Work:CreatedByMe", createdWorkflows.Count),
        ("received", "Feature:SigningSentToMe", receivedWorkflows.Count)
    ];
    private List<WorkflowInstanceDto> FilteredSigningWorkflows => (signingTab switch
    {
        "created" => createdWorkflows,
        "received" => receivedWorkflows,
        _ => workflows
    }).OrderByDescending(item => item.CreationTime).ThenByDescending(item => item.Id).ToList();
    private void SelectSigningTab(string tab)
    {
        signingTab = tab;
        signingVisibleCount = 6;
    }
    private void LoadMoreSigningDocuments() => signingVisibleCount += 6;
    private IReadOnlyList<(string Label, int Count, int Percent, string Color)> workflowGroups =>
        SigningStatusDisplay.Styles.Where(style => style.Key != "Completed")
            .Select(style =>
            {
                var count = workflows.Count(item => SigningStatusDisplay.ForWorkflow(item).Key == style.Key);
                return (L[style.TextKey].Value, count,
                    (int)Math.Round(100d * count / Math.Max(workflows.Count, 1)), style.Color);
            }).ToList();
    private IReadOnlyList<(string Label, int Count, int Percent, string Color)> projectGroups => StatusGroups(projects,
        (L["Work:Status.Planning"], "var(--color-gray-600, #64748B)", x => x.Status is "Draft" or "Planning"),
        (L["Work:Status.InProgress"], "#2563EB", x => x.Status == "Active"),
        (L["Work:Status.Completed"], "#1d9e75", x => x.Status == "Completed"),
        (L["Work:Status.Cancelled"], "#DB2777", x => x.Status == "Cancelled"));
    private IReadOnlyList<(string Label, int Count, int Percent, string Color)> taskGroups => StatusGroups(tasks,
        (L["Work:Status.Todo"], WorkUi.TaskStatusColor("New"), x => x.Status == "New"),
        (L["Work:Status.Doing"], WorkUi.TaskStatusColor("InProgress"), x => x.Status == "InProgress"),
        (L["Work:Status.Waiting"], WorkUi.TaskStatusColor("Waiting"), x => x.Status == "Waiting"),
        (L["Work:Status.Done"], WorkUi.TaskStatusColor("Completed"), x => x.Status == "Completed"),
        (L["Work:Status.Cancelled"], WorkUi.TaskStatusColor("Cancelled"), x => x.Status == "Cancelled"));

    private static IReadOnlyList<(string Label, int Count, int Percent, string Color)> StatusGroups<T>(
        IReadOnlyCollection<T> items, params (string Label, string Color, Func<T, bool> Match)[] defs)
    {
        var total = Math.Max(items.Count, 1);
        return defs.Select(def => (def.Label, items.Count(def.Match), (int)Math.Round(100d * items.Count(def.Match) / total), def.Color)).ToList();
    }

    private static List<(string Color, double Percent, double Offset)> DonutSlices(
        IReadOnlyList<(string Label, int Count, int Percent, string Color)> groups, int total)
    {
        var slices = new List<(string Color, double Percent, double Offset)>();
        if (total <= 0)
        {
            return slices;
        }

        var offset = 0d;
        foreach (var group in groups)
        {
            if (group.Count <= 0)
            {
                continue;
            }

            var percent = 100d * group.Count / total;
            slices.Add((group.Color, percent, offset));
            offset += percent;
        }

        return slices;
    }

    private static string DonutNumber(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private RenderFragment StatusDonut(int total, string unit, IReadOnlyList<(string Label, int Count, int Percent, string Color)> groups)
    {
        var slices = DonutSlices(groups, total);
        var summary = string.Join(", ", groups.Select(group => $"{group.Label}: {group.Count} ({group.Percent}%)"));
        return @<div class="hcs-ws-donut-chart" aria-label="@summary">
            <div class="hcs-ws-donut" role="img" aria-label="@summary">
                <svg viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                    <circle class="hcs-ws-donut-track" cx="18" cy="18" r="15.9155" fill="none" pathLength="100"></circle>
                    @foreach (var slice in slices)
                    {
                        <circle @key="slice.Offset" cx="18" cy="18" r="15.9155" fill="none" pathLength="100"
                                stroke="@slice.Color"
                                stroke-dasharray="@(DonutNumber(slice.Percent) + " " + DonutNumber(100 - slice.Percent))"
                                stroke-dashoffset="@DonutNumber(-slice.Offset)"></circle>
                    }
                </svg>
                <div class="hcs-ws-donut-hole">
                    <span class="hcs-ws-donut-total">@total</span>
                    <span class="hcs-ws-donut-label">@unit</span>
                </div>
            </div>
            <ul class="hcs-ws-legend" aria-label="@L["Catalog:Status"]">
                @foreach (var group in groups)
                {
                    <li>
                        <span class="hcs-ws-wf-dot" style="background:@group.Color" aria-hidden="true"></span>
                        <span>@group.Label</span>
                        <span class="hcs-ws-wf-val" style="color:@group.Color">@group.Count</span>
                        <span class="hcs-ws-card-sub">@group.Percent%</span>
                    </li>
                }
            </ul>
        </div>;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task OpenCreateProjectModalAsync()
    {
        projectForm.Reset();
        nextProjectCode = null;
        try { nextProjectCode = (await Work.GetNextProjectCodeAsync()).Code; } catch { }
        if (departments.Count == 0)
        {
            try { departments.AddRange(await OrganizationUnits.GetDepartmentCatalogAsync()); } catch { }
        }
        if (createProjectModal is not null) await createProjectModal.Show();
    }

    private async Task CloseCreateProjectModalAsync()
    {
        if (createProjectModal is not null) await createProjectModal.Hide();
        projectForm.Reset();
    }

    private async Task CreateProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(projectForm.Name))
        {
            await NotifyErrorAsync(L["Catalog:NameRequired"]);
            return;
        }
        if (projectForm.EndDate < projectForm.StartDate)
        {
            await NotifyErrorAsync(L["Catalog:ValidationError"]);
            return;
        }
        isSavingProject = true;
        try
        {
            await Work.CreateProjectAsync(new CreateProjectRequest(string.IsNullOrWhiteSpace(projectForm.Code) ? null : projectForm.Code.Trim(), projectForm.Name.Trim(),
                string.IsNullOrWhiteSpace(projectForm.Description) ? null : projectForm.Description.Trim(),
                projectForm.StartDate, projectForm.EndDate, projectForm.Status, projectForm.OwnerDepartmentId));
            await NotifySuccessAsync(L["Catalog:Created"]);
            await CloseCreateProjectModalAsync();
            await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSavingProject = false; }
    }

    private async Task OpenProjectDetailModalAsync(Guid projectId)
    {
        projectDetail = null;
        memberNames.Clear();
        if (projectDetailModal is not null) await projectDetailModal.Show();
        try
        {
            projectDetail = await Work.GetProjectAsync(projectId);
            await LoadMemberNamesAsync(projectDetail.Members.Select(x => x.UserId));
        }
        catch (Exception ex)
        {
            await NotifyErrorAsync(ex);
            await CloseProjectDetailModalAsync();
        }
    }

    private async Task CloseProjectDetailModalAsync()
    {
        if (projectDetailModal is not null) await projectDetailModal.Hide();
        projectDetail = null;
        memberNames.Clear();
    }

    private async Task OpenTaskFromProjectModalAsync(Guid taskId)
    {
        await CloseProjectDetailModalAsync();
        await OpenTaskDetailModalAsync(taskId);
    }

    private async Task OpenCreateTaskModalAsync()
    {
        if (createTaskModal is not null) await createTaskModal.ShowAsync();
    }

    private async Task OpenTaskDetailModalAsync(Guid taskId)
    {
        if (taskViewModal is not null) await taskViewModal.ShowAsync(taskId);
    }

    private Task OpenCalendarEventAsync(CalendarEventDto item)
    {
        if (WorkUi.TryRelatedTaskId(item.RelatedType, item.RelatedId, out var taskId))
            return OpenTaskDetailModalAsync(taskId);
        return calendarEventModal?.ShowAsync(item) ?? Task.CompletedTask;
    }

    private Task OpenProjectFromCalendarEventAsync(Guid projectId) => OpenProjectDetailModalAsync(projectId);

    private Task OpenTaskFromCalendarEventAsync(Guid taskId) => OpenTaskDetailModalAsync(taskId);

    private async Task PreviewDocumentAsync(Guid documentId)
    {
        try
        {
            var document = await Documents.GetDocumentAsync(documentId);
            previewingMyDocument = new MyDocumentRow(
                document.Id,
                document.Title,
                document.Status,
                document.CreationTime,
                workflows.Any(item => item.DocumentId == document.Id));
            if (documentPreviewModal is not null)
                await documentPreviewModal.ShowAsync(document.Id, document.Files, document.Title, showHistory: true);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
    }

    private Task PreviewTaskDocumentAsync(Guid documentId) => PreviewDocumentAsync(documentId);

    private async Task AssignPreviewDocumentAsync()
    {
        var documentId = documentPreviewModal?.DocumentId;
        if (documentId is null) return;
        await documentPreviewModal!.HideAsync();
        if (createTaskModal is not null) await createTaskModal.ShowAsync(linkedDocumentId: documentId);
    }

    private async Task LoadMemberNamesAsync(IEnumerable<Guid> userIds)
    {
        memberNames.Clear();
        var ids = userIds.Where(id => id != Guid.Empty).Distinct().ToArray();
        if (ids.Length == 0) return;

        var contacts = new List<ChatContactDto>();
        await ChatContactDirectory.EnsureAsync(Chat, contacts, ids, CurrentUser);
        foreach (var id in ids)
        {
            var name = ChatContactDirectory.Name(contacts, id);
            if (!string.IsNullOrWhiteSpace(name))
                memberNames[id] = name;
        }
    }

    private string MemberName(Guid userId) => memberNames.GetValueOrDefault(userId, "");
    private string ProjectRoleLabel(string role) => role switch
    {
        "Manager" => L["Work:ProjectRole.Manager"],
        "Supervisor" => L["Work:ProjectRole.Supervisor"],
        "Member" => L["Work:ProjectRole.Member"],
        _ => role
    };
    private string DepartmentSelectText(Guid? id) => CatalogSelect2Cache.TextFor(departments, id, x => x.Id, OrganizationUnitCatalogMapper.DisplayText);

    private async Task<CatalogSelect2SearchResponse> SearchDepartmentsAsync(string term, int page)
    {
        if (departments.Count == 0)
        {
            try { departments.AddRange(await OrganizationUnits.GetDepartmentCatalogAsync()); } catch { }
        }

        var found = OrganizationUnitCatalogMapper.FilterTree(departments, term);
        return CatalogSelect2Cache.Merge(departments, found, x => x.Id,
            OrganizationUnitCatalogMapper.OptionText(departments), more: false);
    }

    private Task OnRangeChanged(IReadOnlyList<DateTime?> dates)
    {
        selectedDates = dates;
        if (dates.Count < 2 || dates[0] is not { } start || dates[1] is not { } end)
            return Task.CompletedTask;

        var from = LocalDate(start <= end ? start : end);
        var to = LocalDate(start <= end ? end : start);
        if (from == fromDate.Date && to == toDate.Date)
            return Task.CompletedTask;

        fromDate = from;
        toDate = to;
        if (selectedDay.Date < fromDate || selectedDay.Date > toDate)
            selectedDay = fromDate;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        var generation = ++loadGeneration;
        isLoading = true;
        try
        {
            var from = fromDate.Date;
            var to = toDate.Date.AddDays(1).AddTicks(-1);
            events.Clear();
            projects.Clear();
            tasks.Clear();
            signingQueue.Clear();
            myDocumentCount = 0;
            workflowDocuments.Clear();
            workflows.Clear();
            notifications.Clear();
            signingVisibleCount = 6;
            projectVisibleCount = 6;
            taskVisibleCount = 6;
            await Task.WhenAll(
                LoadWorkspaceWidgetAsync(async () =>
                {
                    events.AddRange((await Work.GetCalendarAsync(from, to)).Where(x => x.StartTime.ToLocalTime() >= from && x.StartTime.ToLocalTime() <= to));
                    await NotifyWidgetRenderedAsync(generation);
                }, generation),
                LoadWorkspaceWidgetAsync(async () =>
                {
                    projects.AddRange((await Work.GetProjectsAsync(new WorkListQuery(null, null, 0, 100))).Items
                        .Where(x => x.EndDate >= from && x.StartDate <= to));
                    await NotifyWidgetRenderedAsync(generation);
                }, generation),
                LoadWorkspaceWidgetAsync(async () =>
                {
                    tasks.AddRange((await Work.GetTasksAsync(null, new WorkListQuery(null, null, 0, 100))).Items
                        .Where(x => x.DueDate >= from && x.StartDate <= to));
                    await NotifyWidgetRenderedAsync(generation);
                }, generation),
                LoadWorkspaceWidgetAsync(async () =>
                {
                    var page = await Documents.GetSigningQueuePageAsync(new SigningQueueQuery(
                        Skip: 0,
                        Take: 50,
                        From: from,
                        ToExclusive: toDate.Date.AddDays(1)));
                    foreach (var item in page.Items)
                    {
                        signingQueue[item.Instance.Id] = item;
                        workflowDocuments[item.Document.Id] = item.Document;
                    }
                    workflows.AddRange(signingQueue.Values.Select(item => item.Instance));
                    myDocumentCount = workflows.Count;
                    await NotifyWidgetRenderedAsync(generation);
                }, generation),
                LoadWorkspaceWidgetAsync(async () =>
                {
                    notifications.AddRange(ChatNotificationGrouping.CollapseUnread(
                        (await Chat.GetNotificationsAsync(
                            from: from, toExclusive: toDate.Date.AddDays(1)))
                        .OrderByDescending(x => x.CreatedAt)
                        .ThenByDescending(x => x.Id)));
                    await NotifyWidgetRenderedAsync(generation);
                }, generation));
            if (generation != loadGeneration)
                return;
            if (!visibleDays.Contains(selectedDay.Date))
                selectedDay = visibleDays.Contains(DateTime.Today) ? DateTime.Today : fromDate.Date;
        }
        catch (Exception ex)
        {
            if (generation == loadGeneration)
                await NotifyWorkspaceErrorAsync(ex);
        }
        finally
        {
            if (generation == loadGeneration)
                isLoading = false;
        }
    }

    private async Task OpenWorkspaceNotificationAsync(NotificationDto item)
    {
        var link = NotificationText.ResolveLink(item);
        try { await Chat.MarkNotificationReadAsync(item.Id); }
        catch { /* still open the destination */ }
        MarkWorkspaceNotificationRead(item);
        LoginNavigation.NavigateTo(link);
    }

    private async Task MarkAllWorkspaceNotificationsAsync()
    {
        try { await Chat.MarkAllNotificationsReadAsync(); }
        catch (Exception ex)
        {
            await NotifyErrorAsync(ex);
            return;
        }

        for (var i = 0; i < notifications.Count; i++)
            notifications[i] = notifications[i] with { IsRead = true };
    }

    private void MarkWorkspaceNotificationRead(NotificationDto item)
    {
        var conversation = ChatNotificationRules.ConversationKey(item.Link);
        for (var i = 0; i < notifications.Count; i++)
        {
            var current = notifications[i];
            if (current.Id == item.Id
                || (ChatNotificationRules.IsChatLink(item.Link)
                    && ChatNotificationRules.ConversationKey(current.Link) == conversation))
            {
                notifications[i] = current with { IsRead = true };
            }
        }
    }

    private async Task LoadWorkspaceWidgetAsync(Func<Task> load, int generation)
    {
        try { await load(); }
        catch (Exception ex) when (generation != loadGeneration) { }
        catch (Exception ex) when (BffErrorMapper.GetStatusCode(ex) == HttpStatusCode.Forbidden)
        {
            // Keep other workspace widgets visible when a sibling API is not granted.
        }
        catch (Exception ex) when (BffErrorMapper.GetStatusCode(ex) == HttpStatusCode.Unauthorized)
        {
            if (generation != loadGeneration)
                return;
            if (!await IsBrowserSessionActiveAsync())
            {
                await NotifyErrorAsync(ex);
                return;
            }

            try { await load(); }
            catch (Exception retry) when (generation != loadGeneration) { }
            catch (Exception retry) when (BffErrorMapper.GetStatusCode(retry) is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
            {
                // Cookie session is still valid; this widget's API is unavailable.
            }
            catch (Exception retry) { await NotifyErrorAsync(retry); }
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
    }

    private Task NotifyWidgetRenderedAsync(int generation) =>
        generation == loadGeneration ? InvokeAsync(StateHasChanged) : Task.CompletedTask;

    private async Task NotifyWorkspaceErrorAsync(Exception ex)
    {
        if (BffErrorMapper.GetStatusCode(ex) == HttpStatusCode.Unauthorized && await IsBrowserSessionActiveAsync())
            return;
        await NotifyErrorAsync(ex);
    }

    private static DateTime LocalDate(DateTime value) =>
        (value.Kind == DateTimeKind.Utc ? value.ToLocalTime() : value).Date;

    private string ProjectLabel(CalendarEventDto item)
    {
        if (item.RelatedType == "PROJECT" && Guid.TryParse(item.RelatedId, out var id))
        {
            var project = projects.FirstOrDefault(x => x.Id == id);
            if (project is not null) return $" · {project.Name}";
        }
        return string.IsNullOrWhiteSpace(item.Description) ? "" : $" · {item.Description}";
    }

    private static bool InRange(DateTime value, DateTime from, DateTime to)
    {
        var local = value.Kind == DateTimeKind.Utc ? value.ToLocalTime() : value;
        return local >= from && local <= to;
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1)
        {
            var token = parts[0];
            return token[..Math.Min(2, token.Length)].ToUpperInvariant();
        }
        return string.Concat(char.ToUpperInvariant(parts[0][0]), char.ToUpperInvariant(parts[^1][0]));
    }

    private bool IsCreatedByMe(WorkflowInstanceDto instance) =>
        CurrentUser.Id is { } userId &&
        workflowDocuments.TryGetValue(instance.DocumentId, out var document) &&
        document.FromUserId == userId;

    private bool IsReceivedByMe(WorkflowInstanceDto instance) =>
        CurrentUser.Id is { } userId &&
        signingQueue.TryGetValue(instance.Id, out var item) &&
        instance.Tasks.Any(task => (task.AssigneeUserId == userId || task.DecidedBy == userId)
            && item.Definition.Steps.Any(step =>
                string.Equals(step.Code, task.StepCode, StringComparison.OrdinalIgnoreCase)
                && step.Type is "PROCESS" or "SIGN"));

    private string WorkflowDocTitle(WorkflowInstanceDto instance) =>
        workflowDocuments.TryGetValue(instance.DocumentId, out var document) && !string.IsNullOrWhiteSpace(document.Title)
            ? document.Title
            : instance.DocumentId.ToString("N")[..8];

    private RenderFragment WorkflowDocRows(IReadOnlyList<WorkflowInstanceDto> items) => items.Count == 0
        ? @<text></text>
        : @<div class="hcs-ws-doc">
            @foreach (var item in items)
            {
                <div class="hcs-ws-doc-row" @key="item.Id">
                    <svg class="hcs-ws-file-icon hcs-ws-signing-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 12h8m-8 4 2 2 5-5"/></svg>
                    <button type="button" class="hcs-ws-doc-name" @onclick="() => PreviewDocumentAsync(item.DocumentId)">@WorkflowDocTitle(item)</button>
                    <span class="@SigningStatusDisplay.ForWorkflow(item).Css">@L[SigningStatusDisplay.ForWorkflow(item).TextKey]</span>
                    <button type="button" class="icon-btn eye" title="@L["Work:PdfPreview"]" aria-label="@L["Work:PdfPreview"]" @onclick="() => PreviewDocumentAsync(item.DocumentId)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
            }
        </div>;

    private sealed record MyDocumentRow(Guid Id, string Title, DocumentStatus Status, DateTime When, bool IsSigning);

    private sealed class ProjectForm
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddMonths(1);
        public string Status { get; set; } = "Draft";
        public Guid? OwnerDepartmentId { get; set; }

        public void Reset()
        {
            Code = Name = Description = "";
            StartDate = DateTime.Today;
            EndDate = DateTime.Today.AddMonths(1);
            Status = "Draft";
            OwnerDepartmentId = null;
        }
    }
}
