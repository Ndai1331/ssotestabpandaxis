@page "/survey-collections/{SurveyLocationId:guid}"
@attribute [Authorize(Policy = "WorkManagement.Surveys")]
@inherits HCSComponentBase
@inject WorkManagementClient Work

<PageTitle>@L["Feature:Collect"] · HCS</PageTitle>
<section class="hcs-document-page">
    <header class="hcs-document-page__header"><div><h1>@L["Feature:Collect"]</h1></div><a class="btn btn-outline-primary" href="/survey-sessions">@L["Feature:BackToList"]</a></header>
    @foreach (var session in sessions.Where(x => x.Status == "Active"))
    {
        <Card Class="mb-3"><CardHeader>@session.Name</CardHeader>
            <CardBody>
                @foreach (var item in criteria.Where(x => x.IsActive))
                {
                    <Field>
                        <FieldLabel>@item.Name</FieldLabel>
                        <div class="hcs-star-rating" role="radiogroup" aria-label="@L["Feature:StarRating"]">
                            @foreach (var star in Enumerable.Range(1, WorkUi.MaxStars))
                            {
                                <button type="button"
                                        class="@(WorkUi.ScoreToStars(scores.GetValueOrDefault(item.Id)) >= star ? "is-active" : null)"
                                        aria-label="@($"{star}★")"
                                        @onclick="() => scores[item.Id] = WorkUi.StarsToScore(star)">★</button>
                            }
                        </div>
                    </Field>
                }
                <Button Color="Color.Primary" Clicked="() => SubmitAsync(session.Id)">@L["Catalog:SaveChanges"]</Button>
            </CardBody>
        </Card>
    }
</section>
@code {
    [Parameter] public Guid SurveyLocationId { get; set; }
    private readonly List<SurveySessionDto> sessions = [];
    private readonly List<SurveyCriteriaDto> criteria = [];
    private readonly Dictionary<Guid, decimal> scores = [];

    protected override async Task OnParametersSetAsync()
    {
        try { sessions.Clear(); sessions.AddRange(await Work.GetSessionsAsync(SurveyLocationId)); criteria.Clear(); criteria.AddRange(await Work.GetCriteriaAsync()); }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
    }
    private async Task SubmitAsync(Guid sessionId)
    {
        try
        {
            foreach (var pair in scores)
            {
                await Work.SubmitResultAsync(sessionId, new SubmitSurveyResultRequest(pair.Key, null, pair.Value, null));
            }
            await NotifySuccessAsync(L["Catalog:Created"]);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
}
