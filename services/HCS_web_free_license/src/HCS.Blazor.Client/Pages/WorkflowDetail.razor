@page "/workflow-detail"
@page "/workflow-detail/{Id:guid}"
@attribute [Authorize(Policy = "Documents.Workflow.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject CollaborationClient Chat
@inject OrganizationCatalogClient Catalog
@inject IdentityAdminClient Identity
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@L["Feature:WorkflowDetail"] · HCS</PageTitle>
<section class="hcs-document-page">
    <header class="hcs-document-page__header">
        <div>
            <p class="hcs-document-page__eyebrow">@L["Menu:Workflows"]</p>
            <h1>@(string.IsNullOrWhiteSpace(form.Name) ? L["Feature:WorkflowDetail"] : form.Name)</h1>
        </div>
        <a class="btn btn-outline-primary" href="/workflow-lists">@L["Feature:BackToList"]</a>
    </header>

    <Steps SelectedStep="@selectedStep" SelectedStepChanged="OnStepChanged">
        <Items>
            <Step Name="step1" Completed="Id.HasValue"><Marker><Icon Name="IconName.FileAlt" /></Marker><Caption>@L["Work:CreateWorkflow"]</Caption></Step>
            <Step Name="step2" Completed="template is not null"><Marker><Icon Name="IconName.File" /></Marker><Caption>@L["Work:CreateTemplate"]</Caption></Step>
            <Step Name="step3" Completed="form.Steps.Count > 0"><Marker><Icon Name="IconName.List" /></Marker><Caption>@L["Work:CreateSteps"]</Caption></Step>
            <Step Name="step4" Completed="form.Steps.Any(x => x.HasAssignment)"><Marker><Icon Name="IconName.UserFriends" /></Marker><Caption>@L["Work:AssignUsers"]</Caption></Step>
        </Items>
        <Content>
            <StepPanel Name="step1">
                <Card><CardBody>
                    <div class="hcs-catalog-form">
                        <Field><FieldLabel>@L["Work:Kind"]</FieldLabel>
                            <CatalogSelect2 Value="form.KindId"
                                            ValueChanged="value => form.KindId = value"
                                            Placeholder="@L["Work:Kind"]"
                                            SelectedText="@KindName(form.KindId)"
                                            Search="SearchKindsAsync" />
                        </Field>
                        <div class="hcs-form-row">
                            <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Code" Name="hcsWorkflowCode" MaxLength="64" Disabled="@(Id.HasValue)" /></Field>
                            <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Name" Name="hcsWorkflowName" /></Field>
                        </div>
                        <Field><FieldLabel>@L["Work:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="form.Description"></textarea></Field>
                        <Field><FieldLabel>@L["Work:SignMode"]</FieldLabel>
                            <Select TValue="string" @bind-Value="form.SignMode">
                                <SelectItem Value="@("SEQUENTIAL")">@L["Work:SignMode.SEQUENTIAL"]</SelectItem>
                                <SelectItem Value="@("PARALLEL")">@L["Work:SignMode.PARALLEL"]</SelectItem>
                            </Select>
                        </Field>
                        <Field><Check TValue="bool" @bind-Checked="form.IsActive">@L["Work:IsActive"]</Check></Field>
                        <AuthorizeView Policy="Documents.Workflow.Manage">
                            <Authorized>
                                <Button Color="Color.Primary" Clicked="SaveWorkflowAsync" Disabled="@isSaving">@L["Catalog:SaveChanges"]</Button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </CardBody></Card>
            </StepPanel>
            <StepPanel Name="step2">
                @if (Id is null)
                {
                    <p class="text-muted mb-0">@L["Work:SaveWorkflowFirst"]</p>
                }
                else
                {
                    <div class="row g-3 hcs-template-split">
                        <div class="col-lg-6">
                            <Card><CardBody>
                                <div class="hcs-catalog-form">
                                    <div class="hcs-form-row">
                                        <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="templateForm.Code" Name="hcsTemplateCode" MaxLength="64" /></Field>
                                        <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><HcsIsolatedTextInput @bind-Value="templateForm.Name" Name="hcsTemplateName" /></Field>
                                    </div>
                                    <div class="hcs-form-row hcs-form-row--equal">
                                        <Field><FieldLabel>@L["Work:OutputFormat"]</FieldLabel>
                                            <Select TValue="string" @bind-Value="templateForm.OutputFormat">
                                                <SelectItem Value="@("PDF")">PDF</SelectItem>
                                            </Select>
                                        </Field>
                                        <Field><FieldLabel>@L["Work:SignMode"]</FieldLabel>
                                            <Select TValue="string" @bind-Value="form.SignMode">
                                                <SelectItem Value="@("SEQUENTIAL")">@L["Work:SignMode.SEQUENTIAL"]</SelectItem>
                                                <SelectItem Value="@("PARALLEL")">@L["Work:SignMode.PARALLEL"]</SelectItem>
                                            </Select>
                                        </Field>
                                    </div>
                                    <Field><FieldLabel>@L["Work:ContentSchema"]</FieldLabel>
                                        <textarea class="form-control" rows="6" @bind="templateForm.TemplateJson"></textarea>
                                    </Field>
                                    <Field><FieldLabel>@L["Work:UploadWord"]</FieldLabel>
                                        <div class="hcs-dropzone">
                                            <InputFile class="form-control" OnChange="UploadWordAsync" accept=".docx" />
                                            <p class="hcs-dropzone__hint mb-0">@L["Work:DropFileHere"]</p>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(template?.WordFileName))
                                        {
                                            <p class="text-muted small mt-2 mb-0">workflow-templates/@template.WordFileName</p>
                                        }
                                    </Field>
                                    <AuthorizeView Policy="Documents.Workflow.Manage">
                                        <Authorized>
                                            <Button Color="Color.Success" Clicked="SaveTemplateAsync" Disabled="@isSaving">@L["Catalog:SaveChanges"]</Button>
                                            @if (template is not null)
                                            {
                                                <Button Color="Color.Light" Class="ms-2" Clicked="SetActiveAsync" Disabled="@(template.IsActive)">@L["Work:SetTemplateActive"]</Button>
                                            }
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </CardBody></Card>
                        </div>
                        <div class="col-lg-6">
                            @if (!string.IsNullOrWhiteSpace(pdfUrl))
                            {
                                <iframe src="@pdfUrl" title="@L["Work:PdfPreview"]" class="hcs-pdf-frame"></iframe>
                            }
                            else
                            {
                                <Card><CardBody><p class="text-muted mb-0">@L["Work:PreviewPdfOnly"]</p></CardBody></Card>
                            }
                        </div>
                    </div>
                    <WizardFooter SelectedStep="@selectedStep" SelectedStepChanged="OnStepChanged" OnSave="SaveTemplateAsync" />
                }
            </StepPanel>
            <StepPanel Name="step3">
                @if (Id is null)
                {
                    <p class="text-muted mb-0">@L["Work:SaveWorkflowFirst"]</p>
                }
                else
                {
                    <Card><CardBody>
                        <Button Color="Color.Primary" Class="mb-3" Clicked="AddStep"><Icon Name="@IconName.Add" /> @L["Work:AddStep"]</Button>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 hcs-catalog-grid"><thead><tr>
                                <th>@L["Work:Order"]</th>
                                <th>@L["Catalog:Name"]</th>
                                <th>@L["Work:StepType"]</th>
                                <th>@L["Work:SlaDays"]</th>
                                <th>@L["Work:AllowReturn"]</th>
                                <th>@L["Work:IsActive"]</th>
                                <th>@L["Catalog:Actions"]</th>
                            </tr></thead>
                            <tbody>
                            @foreach (var (step, index) in form.Steps.Select((s, i) => (s, i)))
                            {
                                <tr @key="step.Key">
                                    <td>@(index + 1)</td>
                                    <td>@step.Name</td>
                                    <td>@L[$"Work:StepType.{step.Type}"]</td>
                                    <td>@(step.SlaDays?.ToString() ?? "—")</td>
                                    <td>@BoolIcon(step.AllowReturn)</td>
                                    <td>@BoolIcon(true)</td>
                                    <td>
                                        <Button Size="Size.Small" Color="Color.Primary" Outline="true" Clicked="() => EditStep(step)"><i class="fa fa-pen"></i></Button>
                                        <Button Size="Size.Small" Color="Color.Danger" Outline="true" Clicked="() => RemoveStep(step)" Disabled="@(form.Steps.Count <= 1)"><i class="fa fa-trash"></i></Button>
                                    </td>
                                </tr>
                            }
                            </tbody></table>
                        </div>
                    </CardBody></Card>
                    <WizardFooter SelectedStep="@selectedStep" SelectedStepChanged="OnStepChanged" OnSave="SaveStepsAsync" SaveDisabled="@isSaving" />
                }
            </StepPanel>
            <StepPanel Name="step4">
                @if (Id is null || form.Steps.Count == 0)
                {
                    <p class="text-muted mb-0">@L["Work:PleaseCreateStep"]</p>
                }
                else
                {
                    <Card><CardBody>
                        <Button Color="Color.Primary" Class="mb-3" Clicked="AddAssignmentRow"><Icon Name="@IconName.Add" /> @L["Work:AddAssignment"]</Button>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 hcs-catalog-grid"><thead><tr>
                                <th>@L["Work:CreateSteps"]</th>
                                <th>@L["Work:Assignee"]</th>
                                <th>@L["Work:IsPrimary"]</th>
                                <th>@L["Work:IsActive"]</th>
                                <th>@L["Catalog:Actions"]</th>
                            </tr></thead>
                            <tbody>
                            @foreach (var step in form.Steps)
                            {
                                <tr @key="step.Key">
                                    <td>@step.Name</td>
                                    <td>@AssigneePills(step)</td>
                                    <td>@BoolIcon(IsPrimary(step))</td>
                                    <td>@BoolIcon(true)</td>
                                    <td>
                                        <Button Size="Size.Small" Color="Color.Primary" Outline="true" Clicked="() => EditAssignment(step)"><i class="fa fa-pen"></i></Button>
                                    </td>
                                </tr>
                            }
                            </tbody></table>
                        </div>
                    </CardBody></Card>
                    <WizardFooter SelectedStep="@selectedStep" SelectedStepChanged="OnStepChanged" OnSave="SaveStepsAsync" SaveDisabled="@isSaving" />
                }
            </StepPanel>
        </Content>
    </Steps>
</section>

<Modal @ref="stepModal"><ModalContent Centered Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@L["Work:AddStep"]</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        @if (editingStep is not null)
        {
            <div class="hcs-catalog-form">
                <div class="hcs-form-row">
                    <Field><FieldLabel>@L["Feature:StepCode"]</FieldLabel><HcsIsolatedTextInput @bind-Value="editingStep.Code" Name="hcsStepCode" MaxLength="64" /></Field>
                    <Field><FieldLabel>@L["Feature:StepName"]</FieldLabel><HcsIsolatedTextInput @bind-Value="editingStep.Name" Name="hcsStepName" /></Field>
                </div>
                <div class="hcs-form-row hcs-form-row--equal">
                    <Field><FieldLabel>@L["Work:StepType"]</FieldLabel>
                        <Select TValue="string" @bind-Value="editingStep.Type">
                            <SelectItem Value="@("PROCESS")">@L["Work:StepType.PROCESS"]</SelectItem>
                            <SelectItem Value="@("SIGN")">@L["Work:StepType.SIGN"]</SelectItem>
                            <SelectItem Value="@("VIEW")">@L["Work:StepType.VIEW"]</SelectItem>
                        </Select>
                    </Field>
                    <Field><FieldLabel>@L["Feature:RequiredPermission"]</FieldLabel><HcsIsolatedTextInput @bind-Value="editingStep.RequiredPermission" Name="hcsStepPermission" /></Field>
                </div>
                <div class="hcs-form-row hcs-form-row--equal">
                    <Field><FieldLabel>@L["Work:SlaDays"]</FieldLabel><NumericPicker TValue="int?" @bind-Value="editingStep.SlaDays" /></Field>
                    <Field><Check TValue="bool" @bind-Checked="editingStep.AllowReturn">@L["Work:AllowReturn"]</Check></Field>
                </div>
            </div>
        }
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Clicked="() => stepModal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Clicked="CloseStepModal">@L["Catalog:SaveChanges"]</Button>
    </ModalFooter>
</ModalContent></Modal>

<Modal @ref="assignmentModal"><ModalContent Centered Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@L["Work:AddAssignment"]</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        @if (editingAssignment is not null)
        {
            <p class="mb-3"><strong>@editingAssignment.Name</strong> · @L[$"Work:StepType.{editingAssignment.Type}"]</p>
            @if (editingAssignment.Type == "VIEW")
            {
                <Field><FieldLabel>@L["Work:FilterDepartment"]</FieldLabel>
                    <DepartmentTreeSelect Items="departmentTree" SelectedIds="editingAssignment.DepartmentIds"
                                          SelectedIdsChanged="ids => editingAssignment.DepartmentIds = ids.ToList()"
                                          EmptyMessage="@L["Catalog:EmptyTitle"]" />
                </Field>
                <Field><FieldLabel>@L["Work:Assignee"]</FieldLabel>
                    <UserSelect2 Multiple="true" Values="editingAssignment.UserIds"
                                 ValuesChanged="ids => editingAssignment.UserIds = ids.ToList()"
                                 SelectedTexts="@UserNames(editingAssignment.UserIds)"
                                 Placeholder="@L["Chat:SelectContacts"]"
                                 Search="SearchContactsAsync" />
                </Field>
                <Field><FieldLabel>@L["Feature:Role"]</FieldLabel>
                    <Select TValue="Guid?" @bind-Value="editingAssignment.RoleId">
                        <SelectItem TValue="Guid?" Value="null">—</SelectItem>
                        @foreach (var role in roles) { <SelectItem TValue="Guid?" Value="@role.Id">@role.Name</SelectItem> }
                    </Select>
                </Field>
            }
            else
            {
                <Field>
                    <RadioGroup TValue="string" @bind-CheckedValue="editingAssignment.AssigneeType">
                        <Radio TValue="string" Value="@("SpecificUser")">@L["Work:AssigneeType.SpecificUser"]</Radio>
                        <Radio TValue="string" Value="@("RoleInSubmitterOu")">@L["Work:AssigneeType.RoleInSubmitterOu"]</Radio>
                    </RadioGroup>
                </Field>
                @if (editingAssignment.AssigneeType == "RoleInSubmitterOu")
                {
                    <Field><FieldLabel>@L["Feature:Role"]</FieldLabel>
                        <Select TValue="Guid?" @bind-Value="editingAssignment.RoleId">
                            <SelectItem TValue="Guid?" Value="null">—</SelectItem>
                            @foreach (var role in roles) { <SelectItem TValue="Guid?" Value="@role.Id">@role.Name</SelectItem> }
                        </Select>
                    </Field>
                }
                else
                {
                    <Field><FieldLabel>@L["Work:Assignee"]</FieldLabel>
                        <UserSelect2 Value="editingAssignment.AssigneeUserId"
                                     ValueChanged="value => editingAssignment.AssigneeUserId = value"
                                     Placeholder="@L["Chat:SelectContacts"]"
                                     SelectedText="@ContactName(editingAssignment.AssigneeUserId)"
                                     Search="SearchContactsAsync" />
                    </Field>
                }
            }
        }
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Clicked="() => assignmentModal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Clicked="CloseAssignmentModal">@L["Catalog:SaveChanges"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    [Parameter] public Guid? Id { get; set; }
    private readonly WorkflowForm form = new();
    private readonly List<ChatContactDto> contacts = [];
    private readonly List<WorkflowKindDto> kinds = [];
    private readonly List<IdentityAdminRoleDto> roles = [];
    private List<DepartmentTreeNode> departmentTree = [];
    private WorkflowTemplateDto? template;
    private readonly TemplateForm templateForm = new();
    private StepDraft? editingStep;
    private StepDraft? editingAssignment;
    private Modal? stepModal;
    private Modal? assignmentModal;
    private string selectedStep = "step1";
    private string? pdfUrl;
    private bool isSaving, loaded;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (contacts.Count == 0) contacts.AddRange(await Chat.GetContactsAsync(null, 50));
            if (kinds.Count == 0) kinds.AddRange(await Documents.GetKindsAsync());
            if (roles.Count == 0)
            {
                try { roles.AddRange((await Identity.GetRolesAsync(maxResultCount: 100)).Items); } catch { }
            }
            if (departmentTree.Count == 0)
            {
                var departments = await Catalog.GetDepartmentLookupAsync();
                departmentTree = DepartmentTreeSelectHelper.Build(departments);
            }
            if (Id is { } id)
            {
                var definition = await Documents.GetDefinitionAsync(id);
                form.Code = definition.Code; form.Name = definition.Name;
                form.KindId = definition.KindId; form.Description = definition.Description ?? ""; form.IsActive = definition.IsActive;
                form.SignMode = string.IsNullOrWhiteSpace(definition.SignMode) ? "SEQUENTIAL" : definition.SignMode;
                form.Steps.Clear();
                foreach (var step in definition.Steps.OrderBy(x => x.Order))
                    form.Steps.Add(StepDraft.From(step));
                var templates = await Documents.GetTemplatesAsync();
                template = templates.Where(x => x.DefinitionId == id).OrderByDescending(x => x.IsActive).ThenByDescending(x => x.Version).FirstOrDefault();
                BindTemplateForm();
                await LoadPdfAsync();
            }
            else if (loaded)
            {
                form.Reset();
                template = null;
                templateForm.Reset();
                await RevokePdfAsync();
                pdfUrl = null;
            }
            loaded = true;
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
    }

    private void OnStepChanged(string name) => selectedStep = name;
    private async Task SaveWorkflowAsync()
    {
        isSaving = true;
        try
        {
            var steps = MapSteps();
            if (Id is { } id)
            {
                await Documents.UpdateDefinitionAsync(id, new UpdateWorkflowDefinitionRequest(form.Name.Trim(), steps, form.KindId, form.Description, form.IsActive, form.SignMode));
                await NotifySuccessAsync(L["Catalog:Updated"]);
            }
            else
            {
                var created = await Documents.CreateDefinitionAsync(new CreateWorkflowDefinitionRequest(form.Code.Trim(), form.Name.Trim(), steps, form.KindId, form.Description, form.IsActive, form.SignMode));
                Navigation.NavigateTo($"/workflow-detail/{created}", forceLoad: true);
            }
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSaving = false; }
    }
    private async Task SaveStepsAsync()
    {
        if (Id is not { } id) return;
        isSaving = true;
        try
        {
            await Documents.UpdateDefinitionAsync(id, new UpdateWorkflowDefinitionRequest(form.Name.Trim(), MapSteps(), form.KindId, form.Description, form.IsActive, form.SignMode));
            await NotifySuccessAsync(L["Catalog:Updated"]);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSaving = false; }
    }
    private void BindTemplateForm()
    {
        if (template is null)
        {
            templateForm.Code = string.IsNullOrWhiteSpace(form.Code) ? "" : $"{form.Code}-tpl";
            templateForm.Name = form.Name;
            templateForm.TemplateJson = "{}";
            templateForm.OutputFormat = "PDF";
            return;
        }
        templateForm.Code = template.Code;
        templateForm.Name = template.Name;
        templateForm.TemplateJson = string.IsNullOrWhiteSpace(template.TemplateJson) ? "{}" : template.TemplateJson;
        templateForm.OutputFormat = string.IsNullOrWhiteSpace(template.OutputFormat) ? "PDF" : template.OutputFormat;
    }
    private async Task SaveTemplateAsync()
    {
        if (Id is not { } id) return;
        isSaving = true;
        try
        {
            await EnsureTemplateAsync();
            if (template is null) return;
            template = await Documents.UpdateTemplateAsync(template.Id,
                new UpdateWorkflowTemplateRequest(templateForm.Name.Trim(), templateForm.TemplateJson, templateForm.OutputFormat));
            await Documents.UpdateDefinitionAsync(id, new UpdateWorkflowDefinitionRequest(
                form.Name.Trim(), MapSteps(), form.KindId, form.Description, form.IsActive, form.SignMode));
            BindTemplateForm();
            await LoadPdfAsync();
            await NotifySuccessAsync(L["Catalog:Updated"]);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSaving = false; }
    }
    private async Task EnsureTemplateAsync()
    {
        if (Id is not { } id) return;
        if (template is not null) return;
        var code = string.IsNullOrWhiteSpace(templateForm.Code) ? $"{form.Code}-tpl" : templateForm.Code.Trim();
        var name = string.IsNullOrWhiteSpace(templateForm.Name) ? form.Name : templateForm.Name.Trim();
        var json = string.IsNullOrWhiteSpace(templateForm.TemplateJson) ? "{}" : templateForm.TemplateJson;
        template = await Documents.CreateTemplateAsync(new CreateWorkflowTemplateRequest(code, name, id, 1, json, templateForm.OutputFormat));
        BindTemplateForm();
    }
    private Task UploadWordAsync(InputFileChangeEventArgs args) => UploadTemplateFileAsync("word", args.File, refreshPreview: true);
    private Task UploadPdfAsync(InputFileChangeEventArgs args) => UploadTemplateFileAsync("pdf", args.File, refreshPreview: true);
    private async Task UploadTemplateFileAsync(string kind, IBrowserFile file, bool refreshPreview = false)
    {
        if (Id is null) return;
        try
        {
            await EnsureTemplateAsync();
            template = await Documents.UploadTemplateFileAsync(template!.Id, kind, file);
            if (refreshPreview) await LoadPdfAsync();
            await NotifySuccessAsync(L["Catalog:Updated"]);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task SetActiveAsync()
    {
        if (template is null) return;
        try { template = await Documents.SetTemplateActiveAsync(template.Id, true); await NotifySuccessAsync(L["Catalog:Updated"]); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task LoadPdfAsync()
    {
        if (template?.PdfFileId is null) return;
        try
        {
            var bytes = await Documents.GetTemplateFileAsync(template.Id, "pdf");
            await RevokePdfAsync();
            pdfUrl = await Js.InvokeAsync<string>("hcsCreateObjectUrl", "application/pdf", bytes);
        }
        catch { pdfUrl = null; }
    }
    private async Task RevokePdfAsync()
    {
        if (string.IsNullOrWhiteSpace(pdfUrl)) return;
        await Js.InvokeVoidAsync("hcsRevokeObjectUrl", pdfUrl);
    }
    private async Task AddStep()
    {
        editingStep = new StepDraft($"step{form.Steps.Count + 1}", L["Feature:StepName"], "PROCESS", "Documents.Workflow.Decide");
        form.Steps.Add(editingStep);
        if (stepModal is not null) await stepModal.Show();
    }
    private async Task EditStep(StepDraft step)
    {
        editingStep = step;
        if (stepModal is not null) await stepModal.Show();
    }
    private void RemoveStep(StepDraft step) { if (form.Steps.Count > 1) form.Steps.Remove(step); }
    private async Task CloseStepModal() { if (stepModal is not null) await stepModal.Hide(); }
    private async Task EditAssignment(StepDraft step)
    {
        editingAssignment = step;
        if (step.Type == "VIEW") step.AssigneeType = "ScopedAssignee";
        if (assignmentModal is not null) await assignmentModal.Show();
    }
    private async Task CloseAssignmentModal() { if (assignmentModal is not null) await assignmentModal.Hide(); }
    private Task AddAssignmentRow()
    {
        var step = form.Steps.FirstOrDefault(x => !x.HasAssignment) ?? form.Steps.LastOrDefault();
        return step is null ? Task.CompletedTask : EditAssignment(step);
    }
    private static bool IsPrimary(StepDraft step) =>
        step.AssigneeUserId.HasValue || step.UserIds.Count == 1;
    private RenderFragment BoolIcon(bool value) => builder =>
    {
        builder.OpenElement(0, "i");
        builder.AddAttribute(1, "class", value
            ? "fa fa-check hcs-status-icon hcs-status-icon--active"
            : "fa fa-times hcs-status-icon hcs-status-icon--inactive");
        builder.CloseElement();
    };
    private RenderFragment AssigneePills(StepDraft step) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "hcs-assignee-pills");
        if (step.RoleId is { } roleId)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "hcs-pill hcs-pill--role");
            builder.AddContent(seq++, roles.FirstOrDefault(x => x.Id == roleId)?.Name ?? L["Feature:Role"]);
            builder.CloseElement();
        }
        if (step.AssigneeUserId is { } userId)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "hcs-pill hcs-pill--user");
            builder.AddContent(seq++, string.IsNullOrWhiteSpace(ContactName(userId)) ? L["Work:Assignee"] : ContactName(userId));
            builder.CloseElement();
        }
        else if (step.UserIds.Count > 0)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "hcs-pill hcs-pill--user");
            builder.AddContent(seq++, $"{step.UserIds.Count} {L["Work:Members"]}");
            builder.CloseElement();
        }
        if (step.RoleId is null && step.AssigneeUserId is null && step.UserIds.Count == 0)
            builder.AddContent(seq++, "—");
        builder.CloseElement();
    };
    private string AssigneeSummary(StepDraft step)
    {
        if (step.Type == "VIEW")
        {
            var parts = new List<string>();
            if (step.UserIds.Count > 0) parts.Add(string.Join(", ", UserNames(step.UserIds)));
            if (step.DepartmentIds.Count > 0) parts.Add($"{step.DepartmentIds.Count}");
            return parts.Count == 0 ? "—" : string.Join(" · ", parts);
        }
        if (step.AssigneeType == "RoleInSubmitterOu")
            return roles.FirstOrDefault(x => x.Id == step.RoleId)?.Name ?? L["Work:AssigneeType.RoleInSubmitterOu"];
        return string.IsNullOrWhiteSpace(ContactName(step.AssigneeUserId)) ? "—" : ContactName(step.AssigneeUserId);
    }
    private List<WorkflowStepInput> MapSteps() => form.Steps.Select((step, index) =>
        new WorkflowStepInput(step.Code.Trim(), step.Name.Trim(), index + 1, step.RequiredPermission.Trim(), step.Type,
            step.AssigneeUserId, step.Type == "VIEW" ? "ScopedAssignee" : step.AssigneeType, step.RoleId, step.UserIds, step.DepartmentIds, step.SlaDays, step.AllowReturn)).ToList();
    private string KindName(Guid? id) => id is null ? "" : kinds.FirstOrDefault(x => x.Id == id)?.Name ?? "";
    private string ContactName(Guid? id) => id is null ? "" : contacts.FirstOrDefault(x => x.Id == id)?.DisplayName ?? "";
    private IReadOnlyList<string> UserNames(IEnumerable<Guid> ids) => CatalogSelect2Cache.TextsFor(contacts, ids, x => x.Id, x => x.DisplayName);
    private Task<CatalogSelect2SearchResponse> SearchKindsAsync(string term, int page)
    {
        var found = kinds.Where(x => string.IsNullOrWhiteSpace(term) || x.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || x.Code.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult(CatalogSelect2Cache.Merge(kinds, found, x => x.Id, x => CatalogSelect2Text.CodeName(x.Code, x.Name), false));
    }
    private async Task<CatalogSelect2SearchResponse> SearchContactsAsync(string term, int page)
    {
        var found = await Chat.GetContactsAsync(term, 50);
        return CatalogSelect2Cache.Merge(contacts, found, x => x.Id, x => x.DisplayName, more: false);
    }
    public async ValueTask DisposeAsync()
    {
        try { await RevokePdfAsync(); } catch { }
    }

    private sealed class StepDraft(string code, string name, string type, string permission)
    {
        public Guid Key { get; } = Guid.NewGuid();
        public string Code { get; set; } = code;
        public string Name { get; set; } = name;
        public string Type { get; set; } = type;
        public string RequiredPermission { get; set; } = permission;
        public Guid? AssigneeUserId { get; set; }
        public string AssigneeType { get; set; } = "SpecificUser";
        public Guid? RoleId { get; set; }
        public List<Guid> UserIds { get; set; } = [];
        public List<Guid> DepartmentIds { get; set; } = [];
        public int? SlaDays { get; set; }
        public bool AllowReturn { get; set; }
        public bool HasAssignment => AssigneeUserId.HasValue || UserIds.Count > 0 || DepartmentIds.Count > 0 || RoleId.HasValue;
        public static StepDraft From(WorkflowStepDto step)
        {
            var draft = new StepDraft(step.Code, step.Name, step.Type, step.RequiredPermission)
            {
                AssigneeUserId = step.AssigneeUserId,
                AssigneeType = string.IsNullOrWhiteSpace(step.AssigneeType) ? "SpecificUser" : step.AssigneeType,
                RoleId = step.RoleId,
                UserIds = step.UserIds?.ToList() ?? [],
                DepartmentIds = step.DepartmentIds?.ToList() ?? [],
                SlaDays = step.SlaDays,
                AllowReturn = step.AllowReturn
            };
            return draft;
        }
    }
    private sealed class WorkflowForm
    {
        public Guid? KindId { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string SignMode { get; set; } = "SEQUENTIAL";
        public bool IsActive { get; set; } = true;
        public List<StepDraft> Steps { get; } = [new("review", "Review", "PROCESS", "Documents.Workflow.Decide")];
        public void Reset()
        {
            KindId = null; Code = Name = Description = ""; SignMode = "SEQUENTIAL"; IsActive = true;
            Steps.Clear();
            Steps.Add(new("review", "Review", "PROCESS", "Documents.Workflow.Decide"));
        }
    }
