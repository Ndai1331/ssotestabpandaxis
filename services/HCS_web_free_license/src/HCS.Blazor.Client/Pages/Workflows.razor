@page "/workflow-lists"
@attribute [Authorize(Policy = "Documents.Workflow.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation

<PageTitle>@L["Menu:WorkflowList"] · HCS</PageTitle>
<section class="page page-wf wf-list">
    <div class="page-head">
        <h1>@L["Menu:WorkflowList"]</h1>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="LoadAsync" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                @L["Catalog:Refresh"]
            </button>
            <AuthorizeView Policy="Documents.Workflow.Manage">
                <Authorized>
                    <button class="btn btn-primary" type="button" @onclick="OpenCreate">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        @L["Catalog:New"]
                    </button>
                </Authorized>
            </AuthorizeView>
            <button class="btn btn-outline @(showSearch ? "is-open" : null) @(IsSearchFiltered ? "is-filtered" : null)"
                    type="button" aria-expanded="@showSearch.ToString().ToLowerInvariant()"
                    aria-controls="wf-search-form" @onclick="ToggleSearch">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:Search"]
            </button>
            <HcsDismissible Class="filter-pop" @bind-IsOpen="showFilters">
                <button class="btn btn-outline" type="button" aria-expanded="@showFilters.ToString().ToLowerInvariant()"
                        aria-controls="wf-filter-menu" @onclick="ToggleFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                    @L["Catalog:Filter"]
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="filter-menu @(showFilters ? "is-open" : null)" id="wf-filter-menu" role="menu">
                    <button type="button" class="@(string.IsNullOrEmpty(activeFilter) ? "is-active" : null)" @onclick="FilterAll">@L["Catalog:AllStatuses"]</button>
                    <button type="button" class="@(activeFilter == "true" ? "is-active" : null)" @onclick="FilterActive">@L["Catalog:Active"]</button>
                    <button type="button" class="@(activeFilter == "false" ? "is-active" : null)" @onclick="FilterInactive">@L["Catalog:Inactive"]</button>
                </div>
            </HcsDismissible>
        </div>
    </div>

    <section class="docs-main">
        <form class="docs-toolbar list-search" id="wf-search-form" hidden="@(!showSearch)" @onsubmit="ApplySearch" @onsubmit:preventDefault>
            <label class="sr-only" for="wf-q">@L["Catalog:SearchPlaceholder"]</label>
            <input class="input docs-search" id="wf-q" type="search" @bind="filter" @bind:event="oninput"
                   placeholder="@L["Catalog:SearchPlaceholder"]" autocomplete="off" />
            <button class="btn btn-primary" type="submit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:SearchButton"]
            </button>
        </form>

        <div class="docs-table-wrap">
            @if (isLoading && !loaded)
            {
                <DocsEmpty Loading="true" />
            }
            else if (pageItems.Count == 0)
            {
                <DocsEmpty Hint="@L["Catalog:EmptyDescription"]" />
            }
            else
            {
                <table class="docs-table">
                    <thead>
                        <tr>
                            <th scope="col">@L["Catalog:Name"]</th>
                            <th scope="col">@L["Work:Kind"]</th>
                            <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                            <th class="col-steps" scope="col">@L["Feature:AddStep"]</th>
                            <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in pageItems)
                    {
                        <tr @key="item.Id">
                            <td>
                                <a class="wf-name" href="@($"/workflow-detail/{item.Id:D}")" title="@($"{item.Code} - {item.Name}")">@item.Code - @item.Name</a>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(KindName(item.KindId)) ? "—" : KindName(item.KindId))</td>
                            <td>
                                <span class="badge @(item.IsActive ? "badge-info" : "badge-muted")">
                                    @(item.IsActive ? L["Catalog:Active"] : L["Catalog:Inactive"])
                                </span>
                            </td>
                            <td class="wf-steps">@item.Steps.Count / @Math.Max(item.Steps.Count, 1)</td>
                            <td>
                                <div class="doc-actions">
                                    <a class="doc-action" href="@($"/workflow-detail/{item.Id:D}")" title="@($"{L["Catalog:Edit"]} {item.Name}")" aria-label="@($"{L["Catalog:Edit"]} {item.Name}")">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </a>
                                    <AuthorizeView Policy="Documents.Workflow.Manage">
                                        <Authorized>
                                            <button class="doc-action is-danger" type="button" title="@($"{L["Catalog:Delete"]} {item.Name}")" aria-label="@($"{L["Catalog:Delete"]} {item.Name}")" @onclick="() => DeleteAsync(item)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            <div class="pager" aria-label="@L["Catalog:PageSize"]">
                <button type="button" disabled="@(!CanPrev)" @onclick="GoFirst">@L["Catalog:PagerFirst"]</button>
                <button type="button" disabled="@(!CanPrev)" @onclick="GoPrev">@L["Catalog:PagerPrev"]</button>
                <button type="button" disabled="@(!CanNext)" @onclick="GoNext">@L["Catalog:PagerNext"]</button>
                <button type="button" disabled="@(!CanNext)" @onclick="GoLast">@L["Catalog:PagerLast"]</button>
                <label class="sr-only" for="wf-page-size">@L["Catalog:PageSize"]</label>
                <select id="wf-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>
    </section>
</section>

<Modal @ref="modal"><ModalContent Centered Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@L["Work:CreateWorkflow"]</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        <div class="hcs-catalog-form">
            <Field><FieldLabel>@L["Work:Kind"]</FieldLabel>
                <CatalogSelect2 Value="form.KindId"
                                ValueChanged="value => form.KindId = value"
                                Placeholder="@L["Work:Kind"]"
                                SelectedText="@KindName(form.KindId)"
                                Search="SearchKindsAsync" />
            </Field>
            <div class="hcs-form-row">
                <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Code" Name="hcsWorkflowListCode" MaxLength="64" /></Field>
                <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Name" Name="hcsWorkflowListName" /></Field>
            </div>
            <Field><FieldLabel>@L["Work:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="form.Description"></textarea></Field>
            <Field><FieldLabel>@L["Work:SignMode"]</FieldLabel>
                <Select TValue="string" @bind-Value="form.SignMode">
                    <SelectItem Value="@("SEQUENTIAL")">@L["Work:SignMode.SEQUENTIAL"]</SelectItem>
                    <SelectItem Value="@("PARALLEL")">@L["Work:SignMode.PARALLEL"]</SelectItem>
                </Select>
            </Field>
            <Field><Check TValue="bool" @bind-Value="form.IsActive">@L["Work:IsActive"]</Check></Field>
        </div>
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => modal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveCreateAsync" Disabled="@isSaving">@L["Catalog:SaveChanges"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<WorkflowDefinitionDto> definitions = [];
    private readonly List<WorkflowDefinitionDto> pageItems = [];
    private readonly List<WorkflowTemplateDto> templates = [];
    private readonly List<WorkflowKindDto> kinds = [];
    private readonly WorkflowCreateForm form = new();
    private Modal? modal;
    private string filter = "", search = "", activeFilter = "";
    private bool isLoading, isSaving, showFilters, showSearch, loaded;
    private int totalCount, pageSize = 20, currentPage = 1;

    private bool IsSearchFiltered => !string.IsNullOrWhiteSpace(search);
    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < PageCount;

    private List<WorkflowDefinitionDto> FilteredDefinitions
    {
        get
        {
            IEnumerable<WorkflowDefinitionDto> query = definitions;
            if (!string.IsNullOrWhiteSpace(search))
                query = query.Where(x => x.Code.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            if (activeFilter == "true") query = query.Where(x => x.IsActive);
            if (activeFilter == "false") query = query.Where(x => !x.IsActive);
            return query.ToList();
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private void ToggleSearch()
    {
        showSearch = !showSearch;
        if (showSearch) showFilters = false;
    }
    private void ToggleFilters()
    {
        showFilters = !showFilters;
        if (showFilters) showSearch = false;
    }
    private void FilterAll() => SetActiveFilter(string.Empty);
    private void FilterActive() => SetActiveFilter("true");
    private void FilterInactive() => SetActiveFilter("false");
    private void ApplySearch() { search = SearchText.Normalize(filter); currentPage = 1; ApplyPage(); }
    private void SetActiveFilter(string value)
    {
        activeFilter = value;
        showFilters = false;
        currentPage = 1;
        ApplyPage();
    }
    private void ApplyPage()
    {
        var filtered = FilteredDefinitions;
        totalCount = filtered.Count;
        currentPage = Math.Clamp(currentPage, 1, PageCount);
        pageItems.Clear();
        pageItems.AddRange(filtered.Skip((currentPage - 1) * pageSize).Take(pageSize));
    }
    private void GoFirst() { currentPage = 1; ApplyPage(); }
    private void GoPrev() { if (CanPrev) { currentPage--; ApplyPage(); } }
    private void GoNext() { if (CanNext) { currentPage++; ApplyPage(); } }
    private void GoLast() { currentPage = PageCount; ApplyPage(); }
    private void OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        ApplyPage();
    }
    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            definitions.Clear(); definitions.AddRange(await Documents.GetDefinitionsAsync());
            templates.Clear(); templates.AddRange(await Documents.GetTemplatesAsync());
            kinds.Clear(); kinds.AddRange(await Documents.GetKindsAsync());
            loaded = true;
            ApplyPage();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }
    private async Task OpenCreate()
    {
        form.Reset();
        if (modal is not null) await modal.Show();
    }
    private async Task SaveCreateAsync()
    {
        if (string.IsNullOrWhiteSpace(form.Code) || string.IsNullOrWhiteSpace(form.Name))
        {
            await NotifyErrorAsync(L["Catalog:TypeRequired"]);
            return;
        }
        isSaving = true;
        try
        {
            var steps = new List<WorkflowStepInput> { new("review", L["Feature:StepName"], 1, "Documents.Workflow.Decide", "PROCESS") };
            var id = await Documents.CreateDefinitionAsync(new CreateWorkflowDefinitionRequest(
                form.Code.Trim(), form.Name.Trim(), steps, form.KindId, form.Description, form.IsActive, form.SignMode));
            if (modal is not null) await modal.Hide();
            await NotifySuccessAsync(L["Catalog:Created"]);
            await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSaving = false; }
    }
    private async Task DeleteAsync(WorkflowDefinitionDto item)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], item.Name))) return;
        try { await Documents.DeleteDefinitionAsync(item.Id); await NotifySuccessAsync(L["Catalog:Deleted"]); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private string KindName(Guid? id) => id is null ? "" : kinds.FirstOrDefault(x => x.Id == id)?.Name ?? "";
    private Task<CatalogSelect2SearchResponse> SearchKindsAsync(string term, int page)
    {
        term = SearchText.Normalize(term);
        var found = kinds.Where(x => string.IsNullOrWhiteSpace(term)
            || x.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || x.Code.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult(CatalogSelect2Cache.Merge(kinds, found, x => x.Id, x => CatalogSelect2Text.CodeName(x.Code, x.Name), false));
    }

    private sealed class WorkflowCreateForm
    {
        public Guid? KindId { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string SignMode { get; set; } = "SEQUENTIAL";
        public bool IsActive { get; set; } = true;
        public void Reset()
        {
            KindId = null; Code = Name = Description = ""; SignMode = "SEQUENTIAL"; IsActive = true;
        }
    }
}
