@page "/administration/roles"
@page "/roles"
@attribute [Authorize(Roles = "admin")]
@using HCS.Localization
@using System.Net
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Components.Messages
@inject IdentityAdminClient IdentityClient
@inject IUiMessageService UiMessageService
@inject IStringLocalizer<HCSResource> L
@inject NavigationManager Navigation

<PageTitle>@L["Roles:Title"] · HCS</PageTitle>

<AuthorizeView Roles="admin">
    <Authorized>
        <section class="page page-wf page-admin-roles" aria-labelledby="roles-title">
            <div class="page-head">
                <h1 id="roles-title">@L["Roles:Title"]</h1>
                <div class="page-actions">
                    <button class="btn btn-outline" type="button" @onclick="LoadRolesAsync" disabled="@isLoading">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                        @L["Catalog:Refresh"]
                    </button>
                    <button class="btn btn-primary" type="button" @onclick="OpenCreateRoleAsync" disabled="@isSavingRole">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        @L["Roles:Create"]
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="hcs-admin-alert" role="alert">
                    <span>@errorMessage</span>
                    @if (sessionExpired)
                    {
                        <button class="btn btn-primary" type="button" @onclick="NavigateToLogin">@L["Roles:LoginAgain"]</button>
                    }
                    else
                    {
                        <button class="btn btn-outline" type="button" @onclick="LoadRolesAsync">@L["Roles:Retry"]</button>
                    }
                </div>
            }

            @if (isLoading && roles.Count == 0)
            {
                <DocsEmpty Loading="true" Title="@L["Roles:LoadingRoles"]" />
            }
            else if (roles.Count == 0)
            {
                <DocsEmpty Title="@L["Roles:EmptyTitle"]" Hint="@L["Roles:EmptyDescription"]" />
            }
            else
            {
                <div class="admin-roles-layout">
                    <aside class="admin-roles-pane" aria-label='@L["Roles:ListTitle"]'>
                        <h2>@L["Roles:ListTitle"]</h2>
                        <div class="admin-roles-list">
                            @foreach (var role in roles)
                            {
                                <div class="admin-role-option @(selectedRoleName == role.Name ? "is-active" : null)">
                                    <button type="button" class="admin-role-option__select" @onclick="@(() => LoadPermissionsAsync(role.Name))">
                                        <span class="admin-role-option__name">@role.Name</span>
                                        @if (role.IsStatic || role.IsDefault || role.IsPublic)
                                        {
                                            <span class="admin-role-option__tags">
                                                @if (role.IsStatic)
                                                {
                                                    <span class="badge">@L["Roles:Static"]</span>
                                                }
                                                @if (role.IsDefault)
                                                {
                                                    <span class="badge badge-info">@L["Roles:Default"]</span>
                                                }
                                                @if (role.IsPublic)
                                                {
                                                    <span class="badge badge-muted">@L["Roles:Public"]</span>
                                                }
                                            </span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                    </aside>

                    <section class="admin-roles-pane admin-roles-perms">
                        <header class="admin-roles-perms__head">
                            <div>
                                <h2>@L["Roles:PermissionsTitle"]</h2>
                                <p>@selectedRoleName</p>
                            </div>
                            @if (SelectedRole is { } selectedRole)
                            {
                                <div class="admin-roles-perms__actions">
                                    @if (CanEdit(selectedRole))
                                    {
                                        <button class="btn btn-outline" type="button" @onclick="() => OpenEditRoleAsync(selectedRole)" disabled="@(isSavingRole || isDeleting)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                            @L["Roles:Edit"]
                                        </button>
                                    }
                                    @if (CanDelete(selectedRole))
                                    {
                                        <button class="btn btn-danger" type="button" @onclick="() => DeleteRoleAsync(selectedRole)" disabled="@(isDeleting || isSaving || isLoadingPermissions || isSavingRole)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                            @L["Roles:Delete"]
                                        </button>
                                    }
                                </div>
                            }
                        </header>
                        <div class="admin-roles-perms__body">
                            @if (isLoadingPermissions)
                            {
                                <DocsEmpty Loading="true" Compact="true" Title="@L["Roles:LoadingPermissions"]" />
                            }
                            else if (!string.IsNullOrWhiteSpace(permissionErrorMessage) && permissionGroups.Count == 0)
                            {
                                <div class="hcs-admin-alert" role="alert">
                                    <span>@permissionErrorMessage</span>
                                    @if (permissionSessionExpired)
                                    {
                                        <button class="btn btn-primary" type="button" @onclick="NavigateToLogin">@L["Roles:LoginAgain"]</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline" type="button" @onclick="@(() => LoadPermissionsAsync(selectedRoleName!))">@L["Roles:Retry"]</button>
                                    }
                                </div>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(permissionErrorMessage))
                                {
                                    <div class="hcs-admin-alert" role="alert">
                                        <span>@permissionErrorMessage</span>
                                    </div>
                                }
                                <div class="admin-permission-toolbar">
                                    <label class="sr-only" for="roles-permission-filter">@L["Roles:SearchPermissions"]</label>
                                    <input class="input" id="roles-permission-filter" type="search" autocomplete="off"
                                           placeholder="@L["Roles:SearchPermissions"]" @bind="permissionFilter" @bind:event="oninput" />
                                    <label class="form-check">
                                        <input class="form-check-input" type="checkbox" checked="@AllPermissionsGranted" disabled="@(!HasAnyEditablePermissions)" @onchange="OnToggleAllPermissions" />
                                        <span class="form-check-label">@L["Roles:GrantAll"]</span>
                                    </label>
                                </div>
                                <div class="admin-permission-layout">
                                    <fieldset class="admin-permission-groups">
                                        <legend>@L["Roles:PermissionGroups"]</legend>
                                        @foreach (var group in permissionGroups)
                                        {
                                            <button type="button" class="@(selectedPermissionGroup == group.Name ? "is-active" : null)" @onclick="@(() => selectedPermissionGroup = group.Name)">
                                                <span>@PermissionLabel(group.Name, group.DisplayName)</span>
                                                <small>@group.Permissions.Count(permission => permission.IsGranted)</small>
                                            </button>
                                        }
                                    </fieldset>
                                    <div class="admin-permission-items" aria-label='@L["Roles:PermissionList"]'>
                                        @if (SelectedPermissionGroup is null)
                                        {
                                            <p class="admin-permission-empty">@L["Roles:SelectGroup"]</p>
                                        }
                                        else
                                        {
                                            <label class="form-check admin-permission-select-all">
                                                <input class="form-check-input" type="checkbox" checked="@SelectedGroupAllGranted" disabled="@(!HasEditablePermissions(SelectedPermissionGroup))" @onchange="OnToggleSelectedGroup" />
                                                <span class="form-check-label">@L["Roles:SelectAll"]</span>
                                            </label>
                                            @if (VisibleFeatures.Count == 0)
                                            {
                                                <p class="admin-permission-empty">@L["Roles:NoMatchingPermissions"]</p>
                                            }
                                            else
                                            {
                                            <div class="admin-permission-table-wrap">
                                            <table class="admin-permission-table">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">@L["Roles:Feature"]</th>
                                                        <th class="col-action" scope="col">@L["Roles:FeatureAccess"]</th>
                                                        @if (ShowCrudColumns)
                                                        {
                                                            <th class="col-action" scope="col">@L["Roles:ActionCreate"]</th>
                                                            <th class="col-action" scope="col">@L["Roles:ActionUpdate"]</th>
                                                            <th class="col-action" scope="col">@L["Roles:ActionDelete"]</th>
                                                        }
                                                        @if (ShowExtraColumn)
                                                        {
                                                            <th scope="col">@L["Roles:OtherActions"]</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                @foreach (var feature in VisibleFeatures)
                                                {
                                                    <tr @key="feature.Key">
                                                        <td>
                                                            <div class="admin-permission-feature">@feature.DisplayName</div>
                                                            <span class="admin-permission-code">@feature.Name</span>
                                                        </td>
                                                        <td class="col-action">
                                                            @if (feature.Access is null)
                                                            {
                                                                <span class="admin-permission-none">—</span>
                                                            }
                                                            else
                                                            {
                                                                <input class="form-check-input" type="checkbox" checked="@feature.Access.IsGranted" disabled="@(!CanEdit(feature.Access))" title="@L["Roles:FeatureAccess"]" aria-label="@($"{feature.DisplayName} · {L["Roles:FeatureAccess"]}")" @onchange="@(e => OnFeatureAccessChanged(feature, e))" />
                                                            }
                                                        </td>
                                                        @if (ShowCrudColumns)
                                                        {
                                                            <td class="col-action">
                                                                @if (feature.Create is null)
                                                                {
                                                                    <span class="admin-permission-none">—</span>
                                                                }
                                                                else
                                                                {
                                                                    <input class="form-check-input" type="checkbox" checked="@feature.Create.IsGranted" disabled="@(!CanEdit(feature.Create))" title="@L["Roles:ActionCreate"]" aria-label="@($"{feature.DisplayName} · {L["Roles:ActionCreate"]}")" @onchange="@(e => OnFeatureActionChanged(feature, feature.Create, e))" />
                                                                }
                                                            </td>
                                                            <td class="col-action">
                                                                @if (feature.Update is null)
                                                                {
                                                                    <span class="admin-permission-none">—</span>
                                                                }
                                                                else
                                                                {
                                                                    <input class="form-check-input" type="checkbox" checked="@feature.Update.IsGranted" disabled="@(!CanEdit(feature.Update))" title="@L["Roles:ActionUpdate"]" aria-label="@($"{feature.DisplayName} · {L["Roles:ActionUpdate"]}")" @onchange="@(e => OnFeatureActionChanged(feature, feature.Update, e))" />
                                                                }
                                                            </td>
                                                            <td class="col-action">
                                                                @if (feature.Delete is null)
                                                                {
                                                                    <span class="admin-permission-none">—</span>
                                                                }
                                                                else
                                                                {
                                                                    <input class="form-check-input" type="checkbox" checked="@feature.Delete.IsGranted" disabled="@(!CanEdit(feature.Delete))" title="@L["Roles:ActionDelete"]" aria-label="@($"{feature.DisplayName} · {L["Roles:ActionDelete"]}")" @onchange="@(e => OnFeatureActionChanged(feature, feature.Delete, e))" />
                                                                }
                                                            </td>
                                                        }
                                                        @if (ShowExtraColumn)
                                                        {
                                                            <td>
                                                                @if (feature.Extra.Count == 0)
                                                                {
                                                                    <span class="admin-permission-none">—</span>
                                                                }
                                                                else
                                                                {
                                                                    <div class="admin-permission-extras">
                                                                        @foreach (var extra in feature.Extra)
                                                                        {
                                                                            <label class="form-check">
                                                                                <input class="form-check-input" type="checkbox" checked="@extra.Permission.IsGranted" disabled="@(!CanEdit(extra.Permission))" @onchange="@(e => OnFeatureActionChanged(feature, extra.Permission, e))" />
                                                                                <span class="form-check-label">@extra.Label</span>
                                                                            </label>
                                                                        }
                                                                    </div>
                                                                }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                                </tbody>
                                            </table>
                                            </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <footer class="admin-roles-perms__footer">
                            @if (SelectedRole is { } lockedRole && !CanDelete(lockedRole))
                            {
                                <p class="admin-roles-hint">@L["Roles:StaticLocked"]</p>
                            }
                            <button class="btn btn-primary" type="button" @onclick="SavePermissionsAsync" disabled="@(isSaving || isDeleting || isLoadingPermissions || string.IsNullOrWhiteSpace(selectedRoleName))">@L["Roles:SavePermissions"]</button>
                        </footer>
                    </section>
                </div>
            }
        </section>
    </Authorized>
    <NotAuthorized>
        <section class="page page-wf"><div class="hcs-admin-alert" role="alert">@L["Roles:NoAdminPermission"]</div></section>
    </NotAuthorized>
</AuthorizeView>

<Modal @ref="roleModal">
    <ModalContent Centered Class="hcs-catalog-modal">
        <ModalHeader Class="hcs-catalog-modal__header">
            <ModalTitle>@(editingRole is null ? L["Roles:CreateTitle"] : L["Roles:EditTitle"])</ModalTitle>
            <CloseButton Clicked="CloseRoleModalAsync" />
        </ModalHeader>
        <ModalBody Class="hcs-catalog-modal__body">
            @if (!string.IsNullOrWhiteSpace(roleFormErrorMessage))
            {
                <div class="hcs-admin-alert" role="alert">@roleFormErrorMessage</div>
            }
            <Field>
                <FieldLabel>@L["Roles:Name"] *</FieldLabel>
                <HcsIsolatedTextInput @bind-Value="roleForm.Name" Name="hcsRoleName" Autofocus="true" Disabled="@(!CanRenameForm)" Placeholder='@L["Roles:NamePlaceholder"].Value' />
            </Field>
            @if (!CanRenameForm && editingRole is not null)
            {
                <p class="admin-roles-hint">@L["Roles:StaticLocked"]</p>
            }
            <div class="admin-role-create-flags">
                <Check TValue="bool" @bind-Value="roleForm.IsDefault">@L["Roles:Default"]</Check>
                <Check TValue="bool" @bind-Value="roleForm.IsPublic">@L["Roles:Public"]</Check>
            </div>
        </ModalBody>
        <ModalFooter Class="hcs-catalog-modal__footer">
            <button class="btn btn-outline" type="button" @onclick="CloseRoleModalAsync">@L["Roles:Cancel"]</button>
            <button class="btn btn-primary" type="button" @onclick="SaveRoleAsync" disabled="@isSavingRole">@(editingRole is null ? L["Roles:CreateSubmit"] : L["Roles:Save"])</button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    private readonly List<IdentityAdminRoleDto> roles = [];
    private readonly List<IdentityAdminPermissionGroup> permissionGroups = [];
    private Modal? roleModal;
    private IdentityAdminRoleCreateForm roleForm = new();
    private IdentityAdminRoleDto? editingRole;
    private string? selectedRoleName;
    private string? selectedPermissionGroup;
    private string? permissionFilter;
    private string? errorMessage;
    private string? permissionErrorMessage;
    private string? roleFormErrorMessage;
    private bool sessionExpired;
    private bool permissionSessionExpired;
    private bool isLoading;
    private bool isLoadingPermissions;
    private bool isSavingRole;
    private bool isSaving;
    private bool isDeleting;

    private IdentityAdminRoleDto? SelectedRole =>
        roles.FirstOrDefault(role => string.Equals(role.Name, selectedRoleName, StringComparison.OrdinalIgnoreCase));

    private bool CanRenameForm => editingRole is null || CanRename(editingRole);

    private IReadOnlyList<PermissionFeatureRow> VisibleFeatures => GetVisibleFeatures();

    private bool ShowCrudColumns =>
        VisibleFeatures.Any(feature => feature.Create is not null || feature.Update is not null || feature.Delete is not null);

    private bool ShowExtraColumn =>
        VisibleFeatures.Any(feature => feature.Extra.Count > 0);

    private IdentityAdminPermissionGroup? SelectedPermissionGroup =>
        permissionGroups.FirstOrDefault(group => group.Name == selectedPermissionGroup);

    private static bool IsProtectedAdmin(IdentityAdminRoleDto role) =>
        string.Equals(role.Name, "admin", StringComparison.OrdinalIgnoreCase);

    private static bool CanEdit(IdentityAdminRoleDto role) => !IsProtectedAdmin(role);

    private static bool CanRename(IdentityAdminRoleDto role) => CanEdit(role);

    private static bool CanDelete(IdentityAdminRoleDto role) => CanEdit(role) && !role.IsStatic;

    private bool AllPermissionsGranted
    {
        get
        {
            var editablePermissions = EditablePermissions().ToList();
            return editablePermissions.Count > 0 && editablePermissions.All(permission => permission.IsGranted);
        }
    }

    private bool HasAnyEditablePermissions => EditablePermissions().Any();

    private bool SelectedGroupAllGranted
    {
        get
        {
            var editablePermissions = EditablePermissions(SelectedPermissionGroup).ToList();
            return editablePermissions.Count > 0 && editablePermissions.All(permission => permission.IsGranted);
        }
    }

    protected override async Task OnInitializedAsync() => await LoadRolesAsync();

    private async Task LoadRolesAsync()
    {
        isLoading = true;
        errorMessage = null;
        sessionExpired = false;
        try
        {
            var result = await IdentityClient.GetRolesAsync(maxResultCount: 100);
            roles.Clear();
            roles.AddRange(result.Items);
            var nextRole = roles.FirstOrDefault(role => role.Name == selectedRoleName) ?? roles.FirstOrDefault();
            if (nextRole is null)
            {
                selectedRoleName = null;
                permissionGroups.Clear();
            }
            else
            {
                await LoadPermissionsAsync(nextRole.Name);
            }
        }
        catch (IdentityAdminApiException exception)
        {
            sessionExpired = exception.StatusCode == HttpStatusCode.Unauthorized;
            errorMessage = FriendlyApiError(exception, "Roles:LoadError");
        }
        catch (Exception)
        {
            errorMessage = L["Roles:LoadError"].Value;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPermissionsAsync(string roleName)
    {
        if (string.IsNullOrWhiteSpace(roleName)) return;
        selectedRoleName = roleName;
        var previousGroup = selectedPermissionGroup;
        selectedPermissionGroup = null;
        permissionFilter = null;
        permissionErrorMessage = null;
        permissionSessionExpired = false;
        isLoadingPermissions = true;
        permissionGroups.Clear();
        try
        {
            var result = await IdentityClient.GetRolePermissionsAsync(roleName);
            permissionGroups.AddRange(PermissionMenuAligner.Align(result.Groups, key => L[key].Value));
            selectedPermissionGroup = permissionGroups.FirstOrDefault(group => group.Name == previousGroup)?.Name
                ?? permissionGroups.FirstOrDefault()?.Name;
        }
        catch (IdentityAdminApiException exception)
        {
            permissionSessionExpired = exception.StatusCode == HttpStatusCode.Unauthorized;
            permissionErrorMessage = FriendlyApiError(exception, "Roles:PermissionsLoadError");
        }
        catch (Exception)
        {
            permissionErrorMessage = L["Roles:PermissionsLoadError"].Value;
        }
        finally
        {
            isLoadingPermissions = false;
        }
    }

    private Task OnToggleAllPermissions(ChangeEventArgs args)
    {
        SetGranted(EditablePermissions(), CheckboxValue(args));

        return InvokeAsync(StateHasChanged);
    }

    private Task OnToggleSelectedGroup(ChangeEventArgs args)
    {
        SetGranted(EditablePermissions(SelectedPermissionGroup), CheckboxValue(args));

        return InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<PermissionFeatureRow> GetVisibleFeatures()
    {
        var features = PermissionFeatureGrouper.Group(
            SelectedPermissionGroup?.Permissions ?? [],
            PermissionLabel);

        if (string.IsNullOrWhiteSpace(permissionFilter))
        {
            return features;
        }

        return features.Where(FeatureMatchesFilter).ToList();
    }

    private bool FeatureMatchesFilter(PermissionFeatureRow feature) =>
        MatchesFilter(feature.DisplayName) ||
        MatchesFilter(feature.Name) ||
        MatchesPermission(feature.Access) ||
        MatchesPermission(feature.Create) ||
        MatchesPermission(feature.Update) ||
        MatchesPermission(feature.Delete) ||
        feature.Extra.Any(extra => MatchesFilter(extra.Label) || MatchesPermission(extra.Permission));

    private bool MatchesPermission(IdentityAdminPermission? permission) =>
        permission is not null &&
        (MatchesFilter(permission.DisplayName) || MatchesFilter(permission.Name));

    private bool MatchesFilter(string? value) =>
        !string.IsNullOrWhiteSpace(value) &&
        !string.IsNullOrWhiteSpace(permissionFilter) &&
        value.Contains(permissionFilter, StringComparison.OrdinalIgnoreCase);

    private static bool CanEdit(IdentityAdminPermission permission) => permission.IsEditable;

    private Task OnFeatureAccessChanged(PermissionFeatureRow feature, ChangeEventArgs args)
    {
        if (feature.Access is null || !CanEdit(feature.Access))
        {
            return InvokeAsync(StateHasChanged);
        }

        var isGranted = CheckboxValue(args);
        feature.Access.IsGranted = isGranted;
        if (!isGranted)
        {
            foreach (var permission in feature.AllPermissions())
            {
                if (CanEdit(permission))
                {
                    permission.IsGranted = false;
                }
            }
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task OnFeatureActionChanged(PermissionFeatureRow feature, IdentityAdminPermission permission, ChangeEventArgs args)
    {
        if (!CanEdit(permission))
        {
            return InvokeAsync(StateHasChanged);
        }

        permission.IsGranted = CheckboxValue(args);
        if (permission.IsGranted && feature.Access is { } access && CanEdit(access))
        {
            access.IsGranted = true;
        }

        return InvokeAsync(StateHasChanged);
    }

    private static bool HasEditablePermissions(IdentityAdminPermissionGroup? group) =>
        EditablePermissions(group).Any();

    private IEnumerable<IdentityAdminPermission> EditablePermissions() =>
        permissionGroups.SelectMany(group => EditablePermissions(group));

    private static IEnumerable<IdentityAdminPermission> EditablePermissions(IdentityAdminPermissionGroup? group) =>
        group?.Permissions.Where(permission => permission.IsEditable) ?? [];

    private static void SetGranted(IEnumerable<IdentityAdminPermission> permissions, bool isGranted)
    {
        foreach (var permission in permissions)
        {
            permission.IsGranted = isGranted;
        }
    }

    private static bool CheckboxValue(ChangeEventArgs args) =>
        args.Value is bool value ? value : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;

    private async Task SavePermissionsAsync()
    {
        if (isSaving || string.IsNullOrWhiteSpace(selectedRoleName))
        {
            return;
        }

        isSaving = true;
        permissionErrorMessage = null;
        try
        {
            await IdentityClient.UpdateRolePermissionsAsync(selectedRoleName, permissionGroups.SelectMany(group => group.Permissions));
            await LoadPermissionsAsync(selectedRoleName);
            if (string.IsNullOrWhiteSpace(permissionErrorMessage))
            {
                await UiMessageService.Success(L["Roles:Saved"].Value);
            }
        }
        catch (IdentityAdminApiException exception)
        {
            permissionErrorMessage = FriendlyApiError(exception, "Roles:SaveError");
            await UiMessageService.Error(permissionErrorMessage);
        }
        catch (Exception)
        {
            permissionErrorMessage = L["Roles:SaveError"].Value;
            await UiMessageService.Error(permissionErrorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task OpenCreateRoleAsync()
    {
        editingRole = null;
        roleForm = new IdentityAdminRoleCreateForm();
        roleFormErrorMessage = null;
        if (roleModal is not null)
        {
            await roleModal.Show();
        }
    }

    private async Task OpenEditRoleAsync(IdentityAdminRoleDto role)
    {
        if (!CanEdit(role))
        {
            return;
        }

        editingRole = role;
        roleForm = new IdentityAdminRoleCreateForm
        {
            Name = role.Name,
            IsDefault = role.IsDefault,
            IsPublic = role.IsPublic
        };
        roleFormErrorMessage = null;
        if (roleModal is not null)
        {
            await roleModal.Show();
        }
    }

    private async Task CloseRoleModalAsync()
    {
        if (roleModal is not null)
        {
            await roleModal.Hide();
        }

        editingRole = null;
        roleForm = new IdentityAdminRoleCreateForm();
        roleFormErrorMessage = null;
    }

    private async Task SaveRoleAsync()
    {
        if (editingRole is null)
        {
            await CreateRoleAsync();
            return;
        }

        await UpdateRoleAsync(editingRole);
    }

    private async Task CreateRoleAsync()
    {
        if (isSavingRole)
        {
            return;
        }

        var roleName = roleForm.Name.Trim();
        if (string.IsNullOrWhiteSpace(roleName))
        {
            roleFormErrorMessage = L["Roles:NameRequired"].Value;
            return;
        }

        isSavingRole = true;
        roleFormErrorMessage = null;
        try
        {
            var created = await IdentityClient.CreateRoleAsync(roleName, roleForm.IsDefault, roleForm.IsPublic);
            await CloseRoleModalAsync();
            await UiMessageService.Success(L["Roles:Created"].Value);
            await LoadRolesAsync();
            if (roles.FirstOrDefault(role => role.Name == created.Name) is { } createdRole)
            {
                await LoadPermissionsAsync(createdRole.Name);
            }
        }
        catch (IdentityAdminApiException exception)
        {
            roleFormErrorMessage = FriendlyApiError(exception, "Roles:CreateError");
            await UiMessageService.Error(roleFormErrorMessage);
        }
        catch (Exception)
        {
            roleFormErrorMessage = L["Roles:CreateError"].Value;
            await UiMessageService.Error(roleFormErrorMessage);
        }
        finally
        {
            isSavingRole = false;
        }
    }

    private async Task UpdateRoleAsync(IdentityAdminRoleDto role)
    {
        if (isSavingRole || !CanEdit(role))
        {
            return;
        }

        var roleName = CanRename(role) ? roleForm.Name.Trim() : role.Name;
        if (string.IsNullOrWhiteSpace(roleName))
        {
            roleFormErrorMessage = L["Roles:NameRequired"].Value;
            return;
        }

        isSavingRole = true;
        roleFormErrorMessage = null;
        try
        {
            var updated = await IdentityClient.UpdateRoleAsync(
                role.Id,
                roleName,
                roleForm.IsDefault,
                roleForm.IsPublic,
                role.ConcurrencyStamp);
            await CloseRoleModalAsync();
            await UiMessageService.Success(L["Roles:Updated"].Value);
            selectedRoleName = updated.Name;
            await LoadRolesAsync();
        }
        catch (IdentityAdminApiException exception)
        {
            roleFormErrorMessage = FriendlyApiError(exception, "Roles:UpdateError");
            await UiMessageService.Error(roleFormErrorMessage);
        }
        catch (Exception)
        {
            roleFormErrorMessage = L["Roles:UpdateError"].Value;
            await UiMessageService.Error(roleFormErrorMessage);
        }
        finally
        {
            isSavingRole = false;
        }
    }

    private async Task DeleteRoleAsync(IdentityAdminRoleDto role)
    {
        if (!CanDelete(role) || isDeleting)
        {
            return;
        }

        if (!await UiMessageService.Confirm(string.Format(L["Roles:DeleteConfirmation"].Value, role.Name)))
        {
            return;
        }

        isDeleting = true;
        errorMessage = null;
        try
        {
            await IdentityClient.DeleteRoleAsync(role.Id);
            if (string.Equals(selectedRoleName, role.Name, StringComparison.OrdinalIgnoreCase))
            {
                selectedRoleName = null;
            }

            await LoadRolesAsync();
            await UiMessageService.Success(L["Roles:Deleted"].Value);
        }
        catch (IdentityAdminApiException exception)
        {
            sessionExpired = exception.StatusCode == HttpStatusCode.Unauthorized;
            errorMessage = FriendlyApiError(exception, "Roles:DeleteError", "Roles:DeleteConflict");
            await UiMessageService.Error(errorMessage);
        }
        catch (Exception)
        {
            errorMessage = L["Roles:DeleteError"].Value;
            await UiMessageService.Error(errorMessage);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private string PermissionLabel(string name, string fallback)
    {
        foreach (var candidate in PermissionLabelCandidates(name, fallback))
        {
            var localized = L[$"Permission:{candidate}"];
            if (!localized.ResourceNotFound)
            {
                return localized.Value;
            }
        }

        return string.IsNullOrWhiteSpace(fallback) ? name : fallback;
    }

    private static IEnumerable<string> PermissionLabelCandidates(string name, string fallback)
    {
        foreach (var raw in new[] { name, fallback })
        {
            if (string.IsNullOrWhiteSpace(raw))
            {
                continue;
            }

            var normalized = NormalizePermissionName(raw);
            yield return normalized;

            if (normalized.StartsWith("Abp", StringComparison.Ordinal) && normalized.Length > 3)
            {
                yield return normalized[3..];
            }

            if (!normalized.StartsWith("Abp", StringComparison.Ordinal) &&
                (normalized.StartsWith("FeatureManagement", StringComparison.Ordinal) ||
                 normalized.StartsWith("SettingManagement", StringComparison.Ordinal) ||
                 normalized.StartsWith("PermissionManagement", StringComparison.Ordinal) ||
                 normalized.StartsWith("Identity", StringComparison.Ordinal)))
            {
                yield return "Abp" + normalized;
            }
        }
    }

    private static string NormalizePermissionName(string value)
    {
        var normalized = value.Trim();
        if (normalized.StartsWith("HCS.", StringComparison.OrdinalIgnoreCase))
        {
            normalized = normalized[4..];
        }

        return normalized.StartsWith("Permission:", StringComparison.OrdinalIgnoreCase)
            ? normalized["Permission:".Length..]
            : normalized;
    }

    private void NavigateToLogin() => Navigation.NavigateTo("/login", forceLoad: true);

    private string FriendlyApiError(IdentityAdminApiException exception, string fallbackKey, string? conflictKey = null)
    {
        if (string.Equals(exception.ErrorCode, "HCS:RoleAssignedToUsers", StringComparison.Ordinal))
        {
            return L["Roles:DeleteConflict"].Value;
        }

        return exception.StatusCode switch
        {
            HttpStatusCode.Unauthorized => L["Roles:SessionExpired"].Value,
            HttpStatusCode.Forbidden => L["Roles:Forbidden"].Value,
            HttpStatusCode.NotFound => L["Roles:NotFound"].Value,
            HttpStatusCode.BadRequest => L["Roles:BadRequest"].Value,
            HttpStatusCode.Conflict => L[conflictKey ?? "Roles:Conflict"].Value,
            _ => L[fallbackKey].Value
        };
    }
