@page "/administration/audit-logs"
@attribute [Authorize(Policy = "HCS.AuditViewer")]
@inherits HCSComponentBase
@using HCS.Auditing
@using HCS.Blazor.Client.Auditing
@using HCS.Blazor.Client.Services

<PageTitle>@L["Menu:AuditLogs"] · HCS</PageTitle>

<section class="page page-wf page-audit" aria-labelledby="audit-title" aria-hidden="@(selected is not null || isLoadingDetail || detailError is not null ? "true" : null)" inert="@(selected is not null || isLoadingDetail || detailError is not null ? "true" : null)">
    <div class="page-head">
        <h1 id="audit-title">@L["Menu:AuditLogs"]</h1>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="ExportAsync" disabled="@(isLoading || rows.Count == 0)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v12"/><path d="m8 11 4 4 4-4"/><path d="M5 21h14"/></svg>
                @L["Audit:ExportCsv"]
            </button>
            <button class="btn btn-outline" type="button" @onclick="LoadAsync" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                @L["Catalog:Refresh"]
            </button>
        </div>
    </div>

    <form class="docs-toolbar list-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label class="sr-only" for="audit-filter">@L["Audit:Keyword"]</label>
        <input id="audit-filter" class="input docs-search" @bind="filter" @bind:event="oninput" @onkeydown="OnKeywordKeyDown" placeholder="@L["Audit:KeywordPlaceholder"]" autocomplete="off" />
        <button class="btn btn-primary" type="submit" disabled="@isLoading">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
            @L["Catalog:SearchButton"]
        </button>
        <button class="btn btn-outline @(showFilters ? "is-open" : null) @(IsAdvancedFiltered ? "is-filtered" : null)"
                type="button" @onclick="ToggleFilters" aria-expanded="@showFilters" aria-controls="audit-advanced-filters">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
            @L["Audit:AdvancedFilters"]
        </button>
        @if (showFilters)
        {
            <button class="btn btn-outline" type="button" @onclick="ResetAsync" disabled="@isLoading">@L["Catalog:Reset"]</button>
        }
    </form>

    @if (showFilters)
    {
        <div id="audit-advanced-filters" class="hcs-audit-filter-grid">
            <div class="hcs-audit-field"><label for="audit-user">@L["Audit:User"]</label><input id="audit-user" class="input" @bind="userName" /></div>
            <div class="hcs-audit-field"><label for="audit-user-id">@L["Audit:UserId"]</label><input id="audit-user-id" class="input" @bind="userId" /></div>
            <div class="hcs-audit-field"><label for="audit-ip">@L["Audit:IpAddress"]</label><input id="audit-ip" class="input" @bind="clientIpAddress" /></div>
            <div class="hcs-audit-field"><label for="audit-method">@L["Audit:HttpMethod"]</label><select id="audit-method" class="select input" @bind="httpMethod"><option value="">@L["Catalog:AllStatuses"]</option><option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option><option>DELETE</option></select></div>
            <div class="hcs-audit-field"><label for="audit-status">@L["Audit:Status"]</label><select id="audit-status" class="select input" @bind="status"><option value="">@L["Catalog:AllStatuses"]</option><option value="200">200</option><option value="201">201</option><option value="400">400</option><option value="401">401</option><option value="403">403</option><option value="404">404</option><option value="500">500</option></select></div>
            <div class="hcs-audit-field"><label for="audit-service">@L["Audit:Service"]</label><input id="audit-service" class="input" @bind="sourceService" /></div>
            <div class="hcs-audit-field"><label for="audit-application">@L["Audit:Application"]</label><input id="audit-application" class="input" @bind="applicationName" /></div>
            <div class="hcs-audit-field"><label for="audit-action">@L["Audit:Action"]</label><input id="audit-action" class="input" @bind="action" /></div>
            <div class="hcs-audit-field"><label for="audit-api">@L["Audit:Api"]</label><input id="audit-api" class="input" @bind="url" /></div>
            <div class="hcs-audit-field"><label for="audit-browser">@L["Audit:Browser"]</label><input id="audit-browser" class="input" @bind="browserInfo" /></div>
            <div class="hcs-audit-field"><label for="audit-correlation">@L["Audit:CorrelationId"]</label><input id="audit-correlation" class="input" @bind="correlationId" /></div>
            <div class="hcs-audit-field"><label for="audit-start">@L["Audit:From"]</label><input id="audit-start" type="datetime-local" class="input" value="@startTime" @onchange="OnStartTimeChanged" /></div>
            <div class="hcs-audit-field"><label for="audit-end">@L["Audit:ToExclusive"]</label><input id="audit-end" type="datetime-local" class="input" value="@endTime" @onchange="OnEndTimeChanged" /></div>
            <div class="hcs-audit-field"><label for="audit-exception">@L["Audit:Result"]</label><select id="audit-exception" class="select input" @bind="exceptionState"><option value="">@L["Catalog:AllStatuses"]</option><option value="true">@L["Audit:HasException"]</option><option value="false">@L["Audit:NoException"]</option></select></div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="hcs-admin-alert" role="alert"><span>@errorMessage</span><button class="btn btn-outline" type="button" @onclick="LoadAsync">@L["Catalog:Retry"]</button></div>
    }

    <div class="docs-table-wrap">
        <div class="hcs-audit-table-meta"><span>@(lastUpdated.HasValue ? $"{L["Audit:UpdatedAt"]}: {lastUpdated.Value:dd/MM/yyyy HH:mm:ss}" : L["Audit:NotLoaded"])</span><span>@L["Audit:ProjectionNote"]</span></div>
        <div class="docs-table-scroll hcs-audit-table-scroll">
            @if (isLoading)
            {
                <DocsEmpty Loading="true" />
            }
            else if (rows.Count == 0)
            {
                <DocsEmpty Title="@L["Audit:EmptyTitle"]" Hint="@L["Audit:EmptyDescription"]" />
            }
            else
            {
                <table class="docs-table hcs-audit-table">
                    <caption class="visually-hidden">@L["Audit:TableCaption"]</caption>
                    <thead><tr>
                        <th class="col-actions" scope="col">@L["Audit:ActionColumn"]</th>
                        <th scope="col" aria-sort="@SortAria("HttpStatusCode")"><button type="button" class="hcs-audit-sort" @onclick="SortStatusAsync">@L["Audit:HttpRequest"] @SortMarker("HttpStatusCode")</button></th>
                        <th scope="col" aria-sort="@SortAria("UserName")"><button type="button" class="hcs-audit-sort" @onclick="SortUserAsync">@L["Audit:User"] @SortMarker("UserName")</button></th>
                        <th scope="col">@L["Audit:IpAddress"]</th>
                        <th scope="col" aria-sort="@SortAria("ExecutionTime")"><button type="button" class="hcs-audit-sort" @onclick="SortTimeAsync">@L["Audit:Time"] @SortMarker("ExecutionTime")</button></th>
                        <th scope="col" aria-sort="@SortAria("ExecutionDuration")"><button type="button" class="hcs-audit-sort" @onclick="SortDurationAsync">@L["Audit:Duration"] @SortMarker("ExecutionDuration")</button></th>
                        <th scope="col">@L["Audit:Service"]</th><th scope="col">@L["Audit:Application"]</th><th scope="col">@L["Audit:CorrelationId"]</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td class="col-actions">
                                <div class="doc-actions">
                                    <button class="doc-action" type="button" @onclick="() => OpenDetailAsync(row)" aria-label="@L["Audit:OpenDetail"]" title="@L["Audit:OpenDetail"]">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
                                    </button>
                                </div>
                            </td>
                            <td>
                                <div class="hcs-audit-request">
                                    <span class="hcs-audit-status @StatusClass(row.HttpStatusCode)">@row.HttpStatusCode</span>
                                    <span class="hcs-audit-method">@FirstValue(row.HttpMethod)</span>
                                    <span class="hcs-audit-url" title="@row.Url">@FirstValue(row.Url)</span>
                                </div>
                            </td>
                            <td><span title="@row.UserId">@DisplayUser(row)</span></td>
                            <td class="hcs-audit-mono">@FirstValue(row.ClientIpAddress)</td>
                            <td><time datetime="@IsoDate(row.ExecutionTime)">@FormatDate(row.ExecutionTime)</time></td>
                            <td class="hcs-audit-duration">@row.ExecutionDuration</td>
                            <td title="@row.SourceService">@ShortService(row.SourceService)</td>
                            <td title="@row.ApplicationName">@FirstValue(row.ApplicationName)</td>
                            <td>
                                <span class="hcs-audit-correlation" title="@row.CorrelationId">@FirstValue(row.CorrelationId)</span>
                                @if (row.HasException)
                                {
                                    <span class="hcs-audit-exception" title="@L["Audit:HasException"]">!</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
        <HcsPager TotalCount="totalCount" PageSize="pageSize" PageSizeId="audit-page-size" PageSizes="PageSizeOptions"
                  CanPrev="CanPrevPage" CanNext="CanNextPage" Disabled="@isLoading"
                  FirstClicked="GoFirstPage" PrevClicked="GoPrevPage" NextClicked="GoNextPage" LastClicked="GoLastPage"
                  PageSizeChanged="OnPageSizeChanged" />
    </div>
</section>

@if (selected is not null || isLoadingDetail || detailError is not null)
{
    <div class="hcs-audit-modal-backdrop" @onclick="CloseDetail">
            <section @ref="detailModal" class="hcs-audit-modal" role="dialog" aria-modal="true" aria-labelledby="audit-detail-title" tabindex="-1" @onclick:stopPropagation @onkeydown="HandleDialogKeyDown">
            <header class="hcs-audit-modal-header">
                <h2 id="audit-detail-title">@L["Audit:DetailTitle"]</h2>
                <button class="hcs-audit-close" type="button" @onclick="CloseDetail" aria-label="@L["Catalog:Close"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                </button>
            </header>
            @if (isLoadingDetail)
            { <div class="hcs-audit-state"><HcsLoadingIcon /> @L["Catalog:Loading"]</div> }
            else if (!string.IsNullOrWhiteSpace(detailError))
            { <div class="hcs-admin-alert" role="alert">@detailError</div> }
            else if (selected is not null)
            {
                <div class="hcs-audit-modal-body">
                    <dl class="hcs-audit-detail-grid">
                        <div><dt>@L["Audit:Status"]</dt><dd><span class="hcs-audit-status @StatusClass(selected.HttpStatusCode)">@selected.HttpStatusCode @StatusText(selected.HttpStatusCode)</span></dd></div>
                        <div><dt>@L["Audit:HttpMethod"]</dt><dd><span class="hcs-audit-method">@FirstValue(selected.HttpMethod)</span></dd></div>
                        <div class="hcs-audit-detail-grid__wide"><dt>@L["Audit:Api"]</dt><dd class="hcs-audit-break">@FirstValue(selected.Url)</dd></div>
                        <div class="hcs-audit-detail-grid__wide"><dt>@L["Audit:Action"]</dt><dd class="hcs-audit-break">@FirstValue(selected.ActionName)</dd></div>
                        <div><dt>@L["Audit:User"]</dt><dd>@DisplayUser(selected)</dd></div>
                        <div><dt>@L["Audit:UserId"]</dt><dd class="hcs-audit-mono hcs-audit-id">@FirstValue(selected.UserId?.ToString("D"))</dd></div>
                        <div><dt>@L["Audit:IpAddress"]</dt><dd>@FirstValue(selected.ClientIpAddress)</dd></div>
                        <div><dt>@L["Audit:Time"]</dt><dd>@FormatDate(selected.ExecutionTime)</dd></div>
                        <div><dt>@L["Audit:Duration"]</dt><dd>@selected.ExecutionDuration ms</dd></div>
                        <div><dt>@L["Audit:Service"]</dt><dd class="hcs-audit-break" title="@selected.SourceService">@ShortService(selected.SourceService)</dd></div>
                        <div><dt>@L["Audit:Application"]</dt><dd>@FirstValue(selected.ApplicationName)</dd></div>
                        <div class="hcs-audit-detail-grid__wide"><dt>@L["Audit:Browser"]</dt><dd class="hcs-audit-browser" title="@selected.BrowserInfo">@FirstValue(selected.BrowserInfo)</dd></div>
                        <div class="hcs-audit-detail-grid__wide"><dt>@L["Audit:CorrelationId"]</dt><dd class="hcs-audit-mono hcs-audit-break">@FirstValue(selected.CorrelationId)</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(selected.Exceptions)) { <div class="hcs-audit-detail-block hcs-audit-detail-block--danger"><h3>@L["Audit:Exception"]</h3><p>@selected.Exceptions</p></div> }
                    @if (!string.IsNullOrWhiteSpace(selected.Comments)) { <div class="hcs-audit-detail-block"><h3>@L["Audit:Comments"]</h3><p>@selected.Comments</p></div> }
                    <div class="hcs-audit-detail-block"><h3>@L["Audit:Actions"]</h3>@if (selected.Actions.Count == 0) { <p class="hcs-audit-muted">@L["Audit:NoActions"]</p> } else { <ul class="hcs-audit-detail-list">@foreach (var item in selected.Actions) { <li><strong>@ShortService(item.ServiceName)</strong> · @FirstValue(item.MethodName) <span>@FormatDate(item.ExecutionTime) · @item.ExecutionDuration ms</span></li> }</ul> }</div>
                    <div class="hcs-audit-detail-block"><h3>@L["Audit:EntityChanges"]</h3>@if (selected.EntityChanges.Count == 0) { <p class="hcs-audit-muted">@L["Audit:NoEntityChanges"]</p> } else { <ul class="hcs-audit-detail-list">@foreach (var item in selected.EntityChanges) { <li><strong>@FirstValue(item.ChangeType)</strong> · @FirstValue(item.EntityTypeFullName) · @FirstValue(item.EntityId) <span>@FormatDate(item.ChangeTime)</span></li> }</ul> }</div>
                </div>
            }
        </section>
    </div>
}
