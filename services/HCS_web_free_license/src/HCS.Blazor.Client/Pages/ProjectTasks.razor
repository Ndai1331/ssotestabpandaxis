@page "/tasks"
@attribute [Authorize(Policy = "WorkManagement.ProjectTasks")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject IUiMessageService UiMessage
@inject IJSRuntime JsRuntime

<PageTitle>@L["Menu:Tasks"] · HCS</PageTitle>
<section class="page page-wf page-cv" aria-labelledby="tasks-title" @onclick="CloseTaskMenu">
    <div class="page-head">
        <h1 id="tasks-title">@L["Menu:Tasks"]</h1>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="ToggleViewAsync">
                @if (isKanban)
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12"/><path d="M4 6h.01M4 12h.01M4 18h.01"/></svg>
                    @L["Work:ListView"]
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h6v14H4zM14 5h6v8h-6z"/></svg>
                    @L["Work:KanbanView"]
                }
            </button>
            <button class="btn btn-outline" type="button" @onclick="ExportAsync" disabled="@(tasks.Count == 0 || isLoading)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/></svg>
                @L["Catalog:Export"]
            </button>
            <button class="btn btn-primary" type="button" @onclick="OpenCreate">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                @L["Work:NewTask"]
            </button>
            <button class="btn btn-outline @(showSearch ? "is-open" : null) @(IsSearchFiltered ? "is-filtered" : null)"
                    type="button" aria-expanded="@showSearch.ToString().ToLowerInvariant()"
                    aria-controls="cv-search-form" @onclick="ToggleSearch">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:Search"]
            </button>
            <HcsDismissible Class="filter-pop" @bind-IsOpen="showFilters">
                <button class="btn btn-outline @(IsStatusFiltered ? "is-filtered" : null)" type="button"
                        aria-expanded="@showFilters.ToString().ToLowerInvariant()"
                        aria-controls="cv-filter-menu" @onclick="ToggleFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                    @L["Catalog:Filter"]
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="filter-menu @(showFilters ? "is-open" : null)" id="cv-filter-menu" role="menu">
                    <button type="button" class="@(string.IsNullOrEmpty(statusFilter) ? "is-active" : null)" @onclick="FilterAll">@L["Catalog:AllStatuses"]</button>
                    @foreach (var value in WorkUi.TaskStatuses)
                    {
                        <button type="button" class="@(statusFilter == value ? "is-active" : null)" @onclick="() => SetStatus(value)">
                            @L[WorkUi.TaskStatusKey(value)]
                        </button>
                    }
                    <button type="button" @onclick="ResetSearchAsync">@L["Catalog:Reset"]</button>
                </div>
            </HcsDismissible>
        </div>
    </div>

    <section class="docs-main">
        <form class="docs-toolbar list-search" id="cv-search-form" hidden="@(!showSearch)" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <label class="sr-only" for="cv-q">@L["Catalog:SearchPlaceholder"]</label>
            <input class="input docs-search" id="cv-q" type="search" @bind="filter" @bind:event="oninput"
                   placeholder="@L["Catalog:SearchPlaceholder"]" autocomplete="off" />
            <div class="list-search-select">
                <label class="sr-only">@L["Feature:Project"]</label>
                <CatalogSelect2 Value="projectFilter"
                                ValueChanged="OnProjectFilterChangedAsync"
                                Placeholder="@L["Feature:Project"]"
                                SelectedText="@ProjectSelectText(projectFilter)"
                                Search="SearchProjectsAsync" />
            </div>
            <button class="btn btn-primary" type="submit" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:SearchButton"]
            </button>
        </form>

        @if (isKanban)
        {
            <div class="kb-board">
                @foreach (var column in WorkUi.TaskStatuses)
                {
                    var columnTasks = tasks.Where(x => string.Equals(x.Status, column, StringComparison.Ordinal)).ToList();
                    <section class="kb-col kb-col--@WorkUi.TaskStatusTone(column) @(dragOver == column ? "is-drop" : null)"
                             @ondragover:preventDefault
                             @ondragenter="() => dragOver = column"
                             @ondragleave="() => dragOver = dragOver == column ? null : dragOver"
                             @ondrop="() => DropAsync(column)">
                        <header class="kb-col-head">
                            <span class="kb-col-title">
                                <span class="kb-col-icon" aria-hidden="true">@((MarkupString)TaskStatusIcon(column))</span>
                                <span>@L[WorkUi.TaskStatusKey(column)]</span>
                            </span>
                            <span class="kb-count">@columnTasks.Count</span>
                        </header>
                        <div class="kb-col-body">
                            @if (columnTasks.Count == 0)
                            {
                                <p class="kb-empty">@L["Work:KanbanEmpty"]</p>
                            }
                            @foreach (var task in columnTasks)
                            {
                                <article class="kb-card" draggable="true" @key="task.Id" @ondragstart="() => dragging = task" @ondragend="() => dragging = null">
                                    <h3 class="kb-title" title="@task.Title"><a href="@($"/project-task-detail/{task.Id}")">@task.Title</a></h3>
                                    <p class="kb-code">@task.Code</p>
                                    <p class="kb-desc">@ProjectName(task.ProjectId)</p>
                                    @if (task.ParentTaskId is { } parentId)
                                    {
                                        <p class="kb-desc">@L["Feature:ParentTask"]: @ParentTitle(parentId)</p>
                                    }
                                    <p class="kb-prio">@L[WorkUi.PriorityKey(task.Priority)] · @task.ProgressPercent%</p>
                                    <div class="kb-progress" style="@($"--kb-progress:{task.ProgressPercent}%")" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@task.ProgressPercent">
                                        <span></span>
                                    </div>
                                    <div class="kb-dates">
                                        <time class="kb-date is-start">@WorkUi.FormatDay(task.StartDate)</time>
                                        <time class="kb-date is-end">@WorkUi.FormatDay(task.DueDate)</time>
                                    </div>
                                    <footer class="kb-foot">
                                        <span class="kb-assignee">
                                            <span class="kb-avatar">@(string.IsNullOrWhiteSpace(task.Title) ? "?" : task.Title[..1])</span>
                                            @task.ProgressPercent%
                                        </span>
                                        <HcsDismissible Class="@($"hcs-more-pop kb-menu {(openMenuId == task.Id ? "is-open" : null)}")"
                                                        IsOpen="openMenuId == task.Id"
                                                        OnClose="CloseTaskMenu"
                                                        @onclick:stopPropagation="true"
                                                        @ondragstart:preventDefault>
                                            <button class="msg-more" type="button" data-task-more="@task.Id" aria-haspopup="menu"
                                                    aria-expanded="@(openMenuId == task.Id ? "true" : "false")"
                                                    aria-label="@L["Catalog:Actions"]" @onclick="() => ToggleTaskMenu(task.Id)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="5" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="12" cy="19" r="1.3"/></svg>
                                            </button>
                                        </HcsDismissible>
                                    </footer>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        }
        else if (isLoading && tasks.Count == 0)
        {
            <DocsEmpty Loading="true" />
        }
        else
        {
            <div class="docs-table-wrap">
                <TaskTree Tasks="tasks" ViewClicked="OpenView" CreateClicked="OpenCreateChild" ProjectNameOf="ProjectName" />
            </div>
        }
    </section>
    @if (openMenuId is { } menuTaskId && tasks.FirstOrDefault(x => x.Id == menuTaskId) is { } menuTask)
    {
        <div class="msg-menu" id="task-card-menu" role="menu" aria-label="@L["Catalog:Actions"]" @onclick:stopPropagation="true">
            <button type="button" role="menuitem" @onclick="() => OpenViewFromMenuAsync(menuTask)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                @L["Work:ViewDetail"]
            </button>
            @if (menuTask.CanDelete)
            {
                <button class="is-danger" type="button" role="menuitem" @onclick="() => DeleteFromMenuAsync(menuTask)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M6 7l1 13h10l1-13"/></svg>
                    @L["Catalog:Delete"]
                </button>
            }
        </div>
    }
</section>
<ProjectTaskCreateModal @ref="createModal" OnCreated="LoadAsync" />
<ProjectTaskViewModal @ref="viewModal" OnChanged="LoadAsync" />
@code {
    private readonly List<ProjectDto> projects = [];
    private readonly List<ProjectTaskDto> tasks = [];
    private ProjectTaskCreateModal? createModal;
    private ProjectTaskViewModal? viewModal;
    private Guid? projectFilter;
    private ProjectTaskDto? dragging;
    private string? dragOver, filter, statusFilter;
    private Guid? openMenuId;
    private bool isLoading, showFilters, showSearch, isKanban = true;

    private bool IsSearchFiltered => !string.IsNullOrWhiteSpace(filter) || projectFilter is not null;
    private bool IsStatusFiltered => !string.IsNullOrWhiteSpace(statusFilter);

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (openMenuId is { } menuId)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("hcsChat.positionMenu", "task-card-menu", $"[data-task-more='{menuId:D}']");
            }
            catch
            {
            }
        }
    }

    private void ToggleSearch()
    {
        showSearch = !showSearch;
        if (showSearch) showFilters = false;
    }
    private void ToggleFilters()
    {
        showFilters = !showFilters;
        if (showFilters) showSearch = false;
    }
    private Task FilterAll() => SetStatus(null);
    private Task SetStatus(string? value)
    {
        statusFilter = value;
        showFilters = false;
        return LoadAsync();
    }
    private Task OnProjectFilterChangedAsync(Guid? value)
    {
        projectFilter = value;
        return SearchAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var projectPage = await Work.GetProjectsAsync(new WorkListQuery(null, null, 0, 100));
            projects.Clear(); projects.AddRange(projectPage.Items);
            var taskPage = await Work.GetTasksAsync(projectFilter, new WorkListQuery(filter, string.IsNullOrWhiteSpace(statusFilter) ? null : statusFilter, 0, 100));
            tasks.Clear(); tasks.AddRange(taskPage.Items);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }

    private Task SearchAsync() => LoadAsync();
    private Task ResetSearchAsync()
    {
        filter = statusFilter = null;
        projectFilter = null;
        showFilters = false;
        return LoadAsync();
    }
    private Task ToggleViewAsync() { isKanban = !isKanban; return LoadAsync(); }
    private Task OpenCreate() => createModal?.ShowAsync(projectFilter) ?? Task.CompletedTask;
    private Task OpenCreateChild(ProjectTaskDto? parent) =>
        createModal?.ShowAsync(parent?.ProjectId ?? projectFilter, parent?.Id) ?? Task.CompletedTask;
    private void CloseTaskMenu() => openMenuId = null;
    private void ToggleTaskMenu(Guid id) => openMenuId = openMenuId == id ? null : id;
    private Task OpenView(ProjectTaskDto task) => viewModal?.ShowAsync(task.Id) ?? Task.CompletedTask;
    private Task OpenViewFromMenuAsync(ProjectTaskDto task)
    {
        CloseTaskMenu();
        return OpenView(task);
    }
    private Task DeleteFromMenuAsync(ProjectTaskDto task)
    {
        CloseTaskMenu();
        return DeleteAsync(task);
    }
    private async Task DeleteAsync(ProjectTaskDto task)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], task.Title))) return;
        try { await Work.DeleteTaskAsync(task.Id); await NotifySuccessAsync(L["Catalog:Deleted"]); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private async Task DropAsync(string status)
    {
        if (dragging is null || string.Equals(dragging.Status, status, StringComparison.Ordinal)) { dragOver = null; return; }
        try
        {
            await Work.UpdateTaskAsync(dragging.Id, new UpdateProjectTaskRequest(dragging.Title, dragging.Description, dragging.StartDate, dragging.DueDate, dragging.Priority, status, dragging.ProgressPercent));
            dragging = null; dragOver = null; await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); dragOver = null; }
    }
    private async Task ExportAsync()
    {
        try
        {
            await CsvDownload.DownloadAsync(JsRuntime, $"tasks-{DateTime.Now:yyyyMMdd-HHmm}.csv",
                [L["Catalog:Code"], L["Feature:TaskTitle"], L["Feature:Project"], L["Catalog:Status"], L["Feature:Priority"]],
                tasks.Select(item => (IReadOnlyList<string>)[item.Code, item.Title, ProjectName(item.ProjectId), L[WorkUi.TaskStatusKey(item.Status)], L[WorkUi.PriorityKey(item.Priority)]]));
            await UiMessage.Success(L["Catalog:Exported"]);
        }
        catch { await UiMessage.Error(L["Catalog:ExportError"]); }
    }
    private string ProjectName(Guid projectId) => projects.FirstOrDefault(x => x.Id == projectId)?.Name ?? "—";
    private string ProjectSelectText(Guid? id) =>
        CatalogSelect2Cache.TextFor(projects, id, x => x.Id, x => CatalogSelect2Text.CodeName(x.Code, x.Name));
    private async Task<CatalogSelect2SearchResponse> SearchProjectsAsync(string term, int page)
    {
        var skip = Math.Max(page - 1, 0) * 20;
        var result = await Work.GetProjectsAsync(new WorkListQuery(term, null, skip, 20));
        return CatalogSelect2Cache.Merge(projects, result.Items, x => x.Id,
            x => CatalogSelect2Text.CodeName(x.Code, x.Name), more: skip + result.Items.Count < result.TotalCount);
    }
    private string ParentTitle(Guid parentId) => tasks.FirstOrDefault(x => x.Id == parentId)?.Title ?? "—";

    private static string TaskStatusIcon(string status) => status switch
    {
        "InProgress" => """<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M10 8l6 4-6 4z"/></svg>""",
        "Waiting" => """<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>""",
        "Completed" => """<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>""",
        "Cancelled" => """<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6M15 9l-6 6"/></svg>""",
        _ => """<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/></svg>"""
    };
}
