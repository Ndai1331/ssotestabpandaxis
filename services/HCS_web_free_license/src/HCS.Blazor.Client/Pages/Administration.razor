@page "/administration"
@page "/users"
@page "/identity/users-management"
@attribute [Authorize(Roles = "admin")]
@using System.Globalization
@using System.Net
@using System.Threading
@using HCS.Blazor.Client.Pages.Organization
@using HCS.Localization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Components.Messages
@inject IdentityAdminClient IdentityClient
@inject OrganizationCatalogClient OrganizationClient
@inject IUiMessageService UiMessageService
@inject IStringLocalizer<HCSResource> L

<PageTitle>@L["Menu:Users"] · HCS</PageTitle>

<AuthorizeView Roles="admin">
    <Authorized>
        <section class="page page-wf page-admin-users" aria-labelledby="users-title">
            <div class="page-head">
                <h1 id="users-title">@L["Menu:Users"]</h1>
                <div class="page-actions">
                    <button class="btn btn-outline" type="button" @onclick="RefreshUsersAsync" disabled="@isLoadingUsers">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                        @L["Catalog:Refresh"]
                    </button>
                    <button class="btn btn-primary" type="button" @onclick="OpenCreateUserAsync" disabled="@isSaving">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        @L["Users:CreateTitle"]
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="hcs-admin-alert" role="alert">
                    <span>@errorMessage</span>
                    @if (canRetry)
                    {
                        <button class="btn btn-outline" type="button" @onclick="RefreshUsersAsync">@L["Roles:Retry"]</button>
                    }
                </div>
            }

            <form class="docs-toolbar list-search" id="users-search-form" @onsubmit="SearchUsersAsync" @onsubmit:preventDefault>
                <label class="sr-only" for="users-q">@L["Users:SearchPlaceholder"]</label>
                <input class="input docs-search" id="users-q" type="search" @bind="filterText" @bind:event="oninput"
                       placeholder="@L["Users:SearchPlaceholder"]" autocomplete="off" />
                <button class="btn btn-primary" type="submit" disabled="@isLoadingUsers">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                    @L["Catalog:SearchButton"]
                </button>
                <label class="filter-label" for="users-status-filter">@L["Catalog:Status"]</label>
                <select class="select input" id="users-status-filter" value="@statusFilter" @onchange="OnStatusFilterChanged">
                    <option value="">@L["Catalog:AllStatuses"]</option>
                    <option value="active">@L["Catalog:Active"]</option>
                    <option value="inactive">@L["Catalog:Inactive"]</option>
                </select>
            </form>

            <div class="docs-table-wrap">
                @if (isLoadingUsers)
                {
                    <DocsEmpty Loading="true" />
                }
                else if (users.Count == 0)
                {
                    <DocsEmpty Title="@L["Users:EmptyTitle"]" Hint="@L["Catalog:EmptyDescription"]" />
                }
                else
                {
                    <table class="docs-table">
                        <thead>
                            <tr>
                                <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                                <th scope="col">@L["Account:UserName"]</th>
                                <th scope="col">@L["FullName"]</th>
                                <th scope="col">@L["Account:Email"]</th>
                                <th scope="col">@L["Menu:Roles"]</th>
                                <th scope="col">@L["Catalog:Department"]</th>
                                <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                                <th scope="col">@L["Users:CreatedAt"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var user in users)
                        {
                            <tr @key="user.Id">
                                <td class="col-actions">
                                    <div class="doc-actions">
                                        <button class="doc-action" type="button" title="@L["Catalog:Edit"]" aria-label="@L["Catalog:Edit"]" @onclick="() => OpenEditUserAsync(user)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                        </button>
                                        <button class="doc-action is-danger" type="button" title="@L["Catalog:Delete"]" aria-label="@L["Catalog:Delete"]" @onclick="() => DeleteUserAsync(user)">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <button type="button" class="doc-title-open" @onclick="() => OpenEditUserAsync(user)">@user.UserName</button>
                                </td>
                                <td>@FullName(user)</td>
                                <td>@user.Email</td>
                                <td>@RoleSummary(user.Id)</td>
                                <td>
                                    <div>@DepartmentSummary(user.Id)</div>
                                    <span class="doc-code">@PositionSummary(user.Id)</span>
                                </td>
                                <td>
                                    <div class="admin-user-status">
                                        <span class="@(user.IsActive ? "badge hcs-status-badge--success" : "badge badge-muted")">@(user.IsActive ? L["Catalog:Active"] : L["Catalog:Inactive"])</span>
                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge badge-warn">@L["Users:Locked"]</span>
                                        }
                                    </div>
                                </td>
                                <td>@FormatDate(user.CreationTime)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                <div class="pager" aria-label="@L["Catalog:PageSize"]">
                    <button type="button" disabled="@(!CanPrevPage || isLoadingUsers)" @onclick="GoFirstPage">@L["Catalog:PagerFirst"]</button>
                    <button type="button" disabled="@(!CanPrevPage || isLoadingUsers)" @onclick="GoPrevPage">@L["Catalog:PagerPrev"]</button>
                    <button type="button" disabled="@(!CanNextPage || isLoadingUsers)" @onclick="GoNextPage">@L["Catalog:PagerNext"]</button>
                    <button type="button" disabled="@(!CanNextPage || isLoadingUsers)" @onclick="GoLastPage">@L["Catalog:PagerLast"]</button>
                    <label class="sr-only" for="users-page-size">@L["Catalog:PageSize"]</label>
                    <select id="users-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>
            </div>
        </section>

        <Modal @ref="userModal" Size="ModalSize.ExtraLarge">
            <ModalContent Centered Class="hcs-catalog-modal">
                <ModalHeader Class="hcs-catalog-modal__header">
                    <ModalTitle>@(editingUserId.HasValue ? L["Users:EditTitle"] : L["Users:CreateTitle"])</ModalTitle>
                    <CloseButton Clicked="CloseUserModalAsync" />
                </ModalHeader>
                <ModalBody Class="hcs-catalog-modal__body">
                    @if (!string.IsNullOrWhiteSpace(formErrorMessage))
                    {
                        <div class="hcs-admin-alert" role="alert">@formErrorMessage</div>
                    }
                    <div class="process-side-tabs" role="tablist">
                        <button class="process-side-tab @(activeUserTab == "info" ? "is-active" : null)" type="button" role="tab" @onclick="@(() => activeUserTab = "info")">Thông tin người dùng</button>
                        <button class="process-side-tab @(activeUserTab == "roles" ? "is-active" : null)" type="button" role="tab" @onclick="@(() => activeUserTab = "roles")">Vai trò (@userForm.RoleNames.Count)</button>
                        <button class="process-side-tab @(activeUserTab == "departments" ? "is-active" : null)" type="button" role="tab" @onclick="@(() => activeUserTab = "departments")">Cây phòng ban (@(string.IsNullOrWhiteSpace(userForm.DepartmentId) ? 0 : 1))</button>
                        @if (editingUserId.HasValue)
                        {
                            <button class="process-side-tab @(activeUserTab == "signatures" ? "is-active" : null)" type="button" role="tab" @onclick="@(() => activeUserTab = "signatures")">@L["Admin:SignaturesTab"]</button>
                        }
                    </div>

                    <div class="hcs-user-tab-panel" hidden="@(activeUserTab != "info")" role="tabpanel">
                        <div class="hcs-user-form-grid">
                            <Field>
                                <FieldLabel>Tên người dùng *</FieldLabel>
                                <HcsIsolatedTextInput @bind-Value="userForm.UserName" Name="hcsUserUserName" ReadOnly="@editingUserId.HasValue" />
                            </Field>
                            <Field>
                                <FieldLabel>Mật khẩu @(editingUserId.HasValue ? string.Empty : "*")</FieldLabel>
                                <HcsIsolatedTextInput @bind-Value="userForm.Password" Name="hcsUserPassword" InputType="password" Placeholder="@(editingUserId.HasValue ? "Để trống nếu không đổi" : null)" />
                            </Field>
                            <Field>
                                <FieldLabel>Họ</FieldLabel>
                                <HcsIsolatedTextInput @bind-Value="userForm.Surname" Name="hcsUserSurname" />
                            </Field>
                            <Field>
                                <FieldLabel>Tên</FieldLabel>
                                <HcsIsolatedTextInput @bind-Value="userForm.Name" Name="hcsUserGivenName" />
                            </Field>
                            <Field Class="hcs-user-form-grid__full">
                                <FieldLabel>Địa chỉ email *</FieldLabel>
                                <HcsIsolatedTextInput @bind-Value="userForm.Email" Name="hcsUserEmail" InputType="email" />
                            </Field>
                            <Field>
                                <FieldLabel>Số điện thoại</FieldLabel>
                                <HcsIsolatedTextInput @bind-Value="userForm.PhoneNumber" Name="hcsUserPhone" InputType="tel" />
                            </Field>
                            <Field>
                                <FieldLabel>Chức vụ</FieldLabel>
                                <Select TValue="string" @bind-Value="userForm.PositionId">
                                    <SelectItem Value="@string.Empty">Chọn giá trị</SelectItem>
                                    @foreach (var position in positions)
                                    {
                                        <SelectItem Value="@position.Id.ToString()">@position.Code — @position.Name</SelectItem>
                                    }
                                </Select>
                            </Field>
                        </div>
                        <div class="hcs-user-flags">
                            <Check TValue="bool" @bind-Value="userForm.IsActive">Kích hoạt</Check>
                            <Check TValue="bool" @bind-Value="userForm.LockoutEnabled">Khóa tài khoản</Check>
                            <Check TValue="bool" Value="@userForm.EmailConfirmed" Disabled="true">Email đã xác nhận</Check>
                            <Check TValue="bool" Value="@userForm.ShouldChangePasswordOnNextLogin" Disabled="true">Bắt đổi mật khẩu</Check>
                        </div>
                        <p class="hcs-form-note">Các cờ “Email đã xác nhận” và “Bắt đổi mật khẩu” chưa có trong hợp đồng Identity Community hiện tại nên chỉ hiển thị trạng thái.</p>
                    </div>
                    <div class="hcs-user-tab-panel" hidden="@(activeUserTab != "roles")" role="tabpanel">
                        <div class="hcs-user-role-list">
                            @if (roles.Count == 0)
                            {
                                <p class="hcs-empty-state">Không có vai trò có thể gán.</p>
                            }
                            else
                            {
                                @foreach (var role in roles)
                                {
                                    <label class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               checked="@userForm.RoleNames.Contains(role.Name)"
                                               @onchange="args => ToggleUserRole(role.Name, args)" />
                                        <span class="form-check-label">@role.Name</span>
                                    </label>
                                }
                            }
                        </div>
                    </div>
                    <div class="hcs-user-tab-panel" hidden="@(activeUserTab != "departments")" role="tabpanel">
                        <Field>
                            <FieldLabel>Phòng ban</FieldLabel>
                            <Select TValue="string" @bind-Value="userForm.DepartmentId">
                                <SelectItem Value="@string.Empty">Chọn phòng ban</SelectItem>
                                @foreach (var department in departments)
                                {
                                    <SelectItem Value="@department.Id.ToString()">@department.Code — @department.Name</SelectItem>
                                }
                            </Select>
                        </Field>
                        <p class="hcs-form-note">Mỗi người dùng có thể có một phòng ban chính. Lựa chọn này được lưu qua Organization user-mapping.</p>
                    </div>
                    @if (editingUserId.HasValue)
                    {
                        <div class="hcs-user-tab-panel" hidden="@(activeUserTab != "signatures")" role="tabpanel">
                            <div class="hcs-user-signing">
                                <h2 class="hcs-user-signing__title">@L["Feature:UserSignatures"]</h2>
                                <UserSignaturesPanel UserId="editingUserId" />
                                <div class="alert alert-info mt-3 mb-0">
                                    Danh mục cấu hình chữ ký dùng chung toàn hệ thống. Mở
                                    <a href="/signature-settings">Danh mục cấu hình chữ ký</a>
                                    để xem hoặc cập nhật; chữ ký cá nhân của user này vẫn được quản lý ở phần trên.
                                </div>
                            </div>
                        </div>
                    }
                </ModalBody>
                <ModalFooter Class="hcs-catalog-modal__footer">
                    <button class="btn btn-outline" type="button" @onclick="CloseUserModalAsync">@L["Catalog:Cancel"]</button>
                    <button class="btn btn-primary" type="button" @onclick="SaveUserAsync" disabled="@isSaving">@L["Catalog:SaveChanges"]</button>
                </ModalFooter>
            </ModalContent>
        </Modal>

    </Authorized>
    <NotAuthorized>
        <section class="page page-wf"><div class="hcs-admin-alert" role="alert">@L["Users:NoAdminPermission"]</div></section>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly int[] PageSizeOptions = [10, 20, 50, 100];

    private readonly List<IdentityAdminUserDto> users = [];
    private readonly List<IdentityAdminRoleDto> roles = [];
    private readonly List<DepartmentCatalogDto> departments = [];
    private readonly List<PositionCatalogDto> positions = [];
    private readonly Dictionary<Guid, string> userRoleNames = [];
    private readonly Dictionary<Guid, string> userDepartmentNames = [];
    private readonly Dictionary<Guid, string> userPositionNames = [];

    private Modal? userModal;
    private IdentityAdminUserForm userForm = new();
    private Guid? editingUserId;
    private string editingConcurrencyStamp = string.Empty;
    private string? filterText;
    private string statusFilter = string.Empty;
    private string? errorMessage;
    private string? formErrorMessage;
    private string activeUserTab = "info";
    private bool isLoadingUsers;
    private bool isSaving;
    private bool canRetry;
    private int totalUsers;
    private int pageSize = 20;
    private int currentPage = 1;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalUsers / (double)Math.Max(pageSize, 1)));
    private bool CanPrevPage => currentPage > 1;
    private bool CanNextPage => currentPage < PageCount;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadRolesAsync(), LoadOrganizationLookupsAsync());
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        isLoadingUsers = true;
        errorMessage = null;
        canRetry = false;
        try
        {
            var skip = (Math.Max(1, currentPage) - 1) * pageSize;
            var result = await IdentityClient.GetUsersAsync(filterText, skip, pageSize);
            var loadedUsers = result.Items.AsEnumerable();
            if (statusFilter == "active") loadedUsers = loadedUsers.Where(user => user.IsActive);
            if (statusFilter == "inactive") loadedUsers = loadedUsers.Where(user => !user.IsActive);
            users.Clear();
            users.AddRange(loadedUsers);
            totalUsers = Math.Min(int.MaxValue, (int)result.TotalCount);
            currentPage = Math.Clamp(currentPage, 1, PageCount);
            await LoadUserRoleSummariesAsync(users, CancellationToken.None);
            await LoadUserOrganizationSummariesAsync(users, CancellationToken.None);
        }
        catch (IdentityAdminApiException exception)
        {
            errorMessage = FriendlyApiError(exception, "Users:LoadError");
            canRetry = true;
        }
        catch (Exception)
        {
            errorMessage = L["Users:LoadError"].Value;
            canRetry = true;
        }
        finally
        {
            isLoadingUsers = false;
        }
    }

    private async Task LoadRolesAsync()
    {
        try
        {
            var result = await IdentityClient.GetRolesAsync(maxResultCount: 100);
            roles.Clear();
            roles.AddRange(result.Items);
        }
        catch (Exception)
        {
            roles.Clear();
        }
    }

    private async Task LoadOrganizationLookupsAsync()
    {
        try
        {
            departments.Clear();
            var query = new OrganizationCatalogQuery(null, true, 0, 100);
            var departmentsResult = await OrganizationClient.GetDepartmentsAsync(query);
            departments.AddRange(departmentsResult.Items);
        }
        catch (Exception)
        {
            departments.Clear();
        }

        try
        {
            positions.Clear();
            var positionsResult = await OrganizationClient.GetPositionsAsync(new OrganizationCatalogQuery(null, true, 0, 100));
            positions.AddRange(positionsResult.Items);
        }
        catch (Exception)
        {
            positions.Clear();
        }
    }

    private async Task LoadUserOrganizationSummariesAsync(IEnumerable<IdentityAdminUserDto> loadedUsers, CancellationToken cancellationToken)
    {
        foreach (var user in loadedUsers)
        {
            try
            {
                var mappings = await IdentityClient.GetUserMappingsAsync(user.Id, cancellationToken);
                var mapping = mappings.FirstOrDefault(item => item.IsPrimary) ?? mappings.FirstOrDefault();
                userDepartmentNames[user.Id] = mapping is null ? "—" : DepartmentName(mapping.DepartmentId);
                userPositionNames[user.Id] = mapping?.PositionId is { } positionId ? PositionName(positionId) : "—";
            }
            catch (IdentityAdminApiException exception) when (exception.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.NotFound)
            {
                userDepartmentNames[user.Id] = "—";
                userPositionNames[user.Id] = "—";
            }
        }
    }

    private async Task LoadUserRoleSummariesAsync(IEnumerable<IdentityAdminUserDto> loadedUsers, CancellationToken cancellationToken)
    {
        foreach (var user in loadedUsers)
        {
            try
            {
                var userRoles = await IdentityClient.GetUserRolesAsync(user.Id, cancellationToken);
                userRoleNames[user.Id] = string.Join(", ", userRoles.Select(role => role.Name));
            }
            catch (IdentityAdminApiException exception) when (exception.StatusCode is HttpStatusCode.Forbidden or HttpStatusCode.NotFound)
            {
                userRoleNames[user.Id] = "—";
            }
        }
    }

    private async Task OpenCreateUserAsync()
    {
        editingUserId = null;
        editingConcurrencyStamp = string.Empty;
        userForm = new IdentityAdminUserForm();
        activeUserTab = "info";
        formErrorMessage = null;
        if (userModal is not null) await userModal.Show();
    }

    private async Task OpenEditUserAsync(IdentityAdminUserDto user)
    {
        var latest = user;
        try
        {
            latest = await IdentityClient.GetUserAsync(user.Id);
        }
        catch (IdentityAdminApiException)
        {
        }

        editingUserId = latest.Id;
        editingConcurrencyStamp = latest.ConcurrencyStamp;
        userForm = new IdentityAdminUserForm
        {
            UserName = latest.UserName,
            Surname = latest.Surname,
            Name = latest.Name,
            Email = latest.Email,
            PhoneNumber = latest.PhoneNumber,
            IsActive = latest.IsActive,
            LockoutEnabled = latest.LockoutEnabled,
            EmailConfirmed = latest.EmailConfirmed
        };
        formErrorMessage = null;
        activeUserTab = "info";
        try
        {
            foreach (var role in await IdentityClient.GetUserRolesAsync(latest.Id)) userForm.RoleNames.Add(role.Name);
            var mappings = await IdentityClient.GetUserMappingsAsync(latest.Id);
            var mapping = mappings.FirstOrDefault(item => item.IsPrimary) ?? mappings.FirstOrDefault();
            if (mapping is not null)
            {
                userForm.DepartmentId = mapping.DepartmentId.ToString();
                userForm.PositionId = mapping.PositionId?.ToString() ?? string.Empty;
            }
        }
        catch (IdentityAdminApiException exception)
        {
            formErrorMessage = FriendlyApiError(exception, "Users:LoadError");
        }

        if (userModal is not null) await userModal.Show();
    }

    private async Task CloseUserModalAsync()
    {
        if (userModal is not null) await userModal.Hide();
        editingUserId = null;
        formErrorMessage = null;
    }

    private async Task SaveUserAsync()
    {
        if (isSaving) return;
        var validationMessage = ValidateUserForm();
        if (validationMessage is not null)
        {
            formErrorMessage = validationMessage;
            await UiMessageService.Warn(validationMessage);
            return;
        }

        isSaving = true;
        formErrorMessage = null;
        try
        {
            var wasEditing = editingUserId.HasValue;
            IdentityAdminUserDto savedUser;
            if (editingUserId.HasValue)
            {
                savedUser = await IdentityClient.UpdateUserAsync(editingUserId.Value, userForm, editingConcurrencyStamp);
            }
            else
            {
                savedUser = await IdentityClient.CreateUserAsync(userForm);
            }

            string? secondaryError = null;
            try
            {
                await IdentityClient.UpdateUserRolesAsync(savedUser.Id, userForm.RoleNames);
            }
            catch (IdentityAdminApiException exception)
            {
                secondaryError = FriendlyApiError(exception, "Users:SaveError");
            }

            try
            {
                await SyncOrganizationMappingAsync(savedUser.Id);
            }
            catch (IdentityAdminApiException exception)
            {
                secondaryError ??= FriendlyApiError(exception, "Users:SaveError");
            }

            await CloseUserModalAsync();
            if (secondaryError is null)
            {
                await UiMessageService.Success(wasEditing ? L["Users:Updated"].Value : L["Users:Created"].Value);
            }
            else
            {
                await UiMessageService.Warn(secondaryError);
            }

            await RefreshUsersAsync();
        }
        catch (IdentityAdminApiException exception)
        {
            formErrorMessage = FriendlyApiError(exception, "Users:SaveError");
            await UiMessageService.Error(formErrorMessage);
        }
        catch (Exception)
        {
            formErrorMessage = L["Users:SaveError"].Value;
            await UiMessageService.Error(formErrorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SyncOrganizationMappingAsync(Guid userId)
    {
        Guid? positionId = Guid.TryParse(userForm.PositionId, out var parsedPositionId) ? parsedPositionId : null;
        var mappings = await IdentityClient.GetUserMappingsAsync(userId);
        var primary = mappings.FirstOrDefault(item => item.IsPrimary) ?? mappings.FirstOrDefault();
        if (!Guid.TryParse(userForm.DepartmentId, out var departmentId))
        {
            if (primary is not null)
            {
                await IdentityClient.DeleteUserMappingAsync(primary.Id);
            }

            return;
        }

        if (primary is null)
        {
            await IdentityClient.CreateUserMappingAsync(userId, departmentId, positionId);
            return;
        }

        if (primary.DepartmentId == departmentId && primary.PositionId == positionId)
        {
            return;
        }

        await IdentityClient.UpdateUserMappingAsync(primary.Id, userId, departmentId, positionId, primary.UnitId);
    }

    private async Task DeleteUserAsync(IdentityAdminUserDto user)
    {
        if (!await UiMessageService.Confirm(string.Format(L["Users:DeleteConfirmation"].Value, user.UserName))) return;
        try
        {
            await IdentityClient.DeleteUserAsync(user.Id);
            await UiMessageService.Success(L["Users:Deleted"].Value);
            if (users.Count == 1 && currentPage > 1) currentPage--;
            await LoadUsersAsync();
        }
        catch (IdentityAdminApiException exception)
        {
            errorMessage = FriendlyApiError(exception, "Users:DeleteError");
            await UiMessageService.Error(errorMessage);
        }
        catch (Exception)
        {
            errorMessage = L["Users:DeleteError"].Value;
            await UiMessageService.Error(errorMessage);
        }
    }

    private void ToggleUserRole(string roleName, ChangeEventArgs args)
    {
        var isSelected = args.Value is bool flag && flag
            || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (isSelected)
        {
            userForm.RoleNames.Add(roleName);
        }
        else
        {
            userForm.RoleNames.Remove(roleName);
        }
    }

    private string? ValidateUserForm()
    {
        if (string.IsNullOrWhiteSpace(userForm.UserName)) return "Tên người dùng là bắt buộc.";
        if (!editingUserId.HasValue && string.IsNullOrWhiteSpace(userForm.Password)) return "Mật khẩu là bắt buộc khi tạo người dùng.";
        if (string.IsNullOrWhiteSpace(userForm.Email) || !userForm.Email.Contains('@')) return "Địa chỉ email không hợp lệ.";
        return null;
    }

    private Task SearchUsersAsync()
    {
        currentPage = 1;
        return LoadUsersAsync();
    }

    private Task RefreshUsersAsync()
    {
        errorMessage = null;
        return LoadUsersAsync();
    }

    private Task OnStatusFilterChanged(ChangeEventArgs args)
    {
        statusFilter = args.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        return LoadUsersAsync();
    }

    private Task GoFirstPage() { currentPage = 1; return LoadUsersAsync(); }
    private Task GoPrevPage() { currentPage = Math.Max(1, currentPage - 1); return LoadUsersAsync(); }
    private Task GoNextPage() { currentPage = Math.Min(PageCount, currentPage + 1); return LoadUsersAsync(); }
    private Task GoLastPage() { currentPage = PageCount; return LoadUsersAsync(); }

    private Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return Task.CompletedTask;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        return LoadUsersAsync();
    }

    private string RoleSummary(Guid userId) => userRoleNames.TryGetValue(userId, out var names) && !string.IsNullOrWhiteSpace(names) ? names : "—";
    private string DepartmentSummary(Guid userId) => userDepartmentNames.TryGetValue(userId, out var name) && !string.IsNullOrWhiteSpace(name) ? name : "—";
    private string PositionSummary(Guid userId) => userPositionNames.TryGetValue(userId, out var name) && !string.IsNullOrWhiteSpace(name) ? name : "—";
    private string DepartmentName(Guid departmentId) => departments.FirstOrDefault(item => item.Id == departmentId) is { } department
        ? $"{department.Code} — {department.Name}"
        : departmentId.ToString("D");
    private string PositionName(Guid positionId) => positions.FirstOrDefault(item => item.Id == positionId) is { } position
        ? $"{position.Code} — {position.Name}"
        : positionId.ToString("D");
    private static string FullName(IdentityAdminUserDto user) => string.Join(' ', new[] { user.Surname, user.Name }.Where(value => !string.IsNullOrWhiteSpace(value))).Trim() is { Length: > 0 } fullName ? fullName : "—";
    private static string FormatDate(DateTimeOffset? value) => value?.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture) ?? "—";

    private string FriendlyApiError(IdentityAdminApiException exception, string fallbackKey) =>
        exception.UserMessage
        ?? exception.StatusCode switch
    {
        HttpStatusCode.BadRequest => L["Users:BadRequest"].Value,
        HttpStatusCode.Unauthorized => L["Users:SessionExpired"].Value,
        HttpStatusCode.Forbidden => L["Users:Forbidden"].Value,
        HttpStatusCode.NotFound => L["Users:NotFound"].Value,
        HttpStatusCode.Conflict => L["Users:Conflict"].Value,
        _ => L[fallbackKey].Value
    };
}
