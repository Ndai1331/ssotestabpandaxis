@page "/survey-results"
@attribute [Authorize(Policy = "WorkManagement.Surveys")]
@inherits HCSComponentBase
@inject WorkManagementClient Work

<PageTitle>@L["Feature:SurveyResults"] · HCS</PageTitle>

<section class="page page-wf">
    <div class="page-head">
        <div>
            <h1>@L["Feature:SurveyResults"]</h1>
            <p class="event-panel-kicker">@L["SurveyResults:Subtitle"]</p>
        </div>
    </div>
    <form class="docs-toolbar" @onsubmit:preventDefault>
        <span class="filter-label" id="survey-location-label">@L["SurveyLocation"]</span>
        <ProviderSelect2 Value="selectedLocationId"
                         ValueChanged="OnLocationChanged"
                         Items="LocationItems"
                         Placeholder="@L["All"]"
                         AriaLabel="@L["SurveyLocation"]"
                         Search="SearchLocationsAsync" />
        <button class="btn btn-outline" type="button" @onclick="ResetAsync">@L["Catalog:Reset"]</button>
    </form>
    <div class="event-panel">
        @if (isLoading)
        {
            <DocsEmpty Loading="true" />
        }
        else
        {
            <div class="hcs-survey-tabs" role="tablist">
                <button type="button" class="@(activeTab == "chart" ? "is-active" : null)" @onclick='() => activeTab = "chart"'>@L["Feature:ChartStatistics"]</button>
                <button type="button" class="@(activeTab == "detail" ? "is-active" : null)" @onclick='() => activeTab = "detail"'>@L["Feature:DetailData"]</button>
            </div>
            @if (activeTab == "chart")
            {
                <div class="hcs-survey-results__headline"><span>@L["RatingDistributionTotal"]</span><strong>@(statistics?.TotalReviews ?? 0)</strong></div>
                <div class="hcs-survey-results__section">
                    <h2>@L["RatingDistribution"]</h2>
                    @foreach (var star in Enumerable.Range(0, WorkUi.MaxStars + 1).Reverse())
                    {
                        var count = statistics?.ScoreDistribution.GetValueOrDefault(star) ?? 0;
                        var total = statistics?.TotalReviews ?? 0;
                        var width = total == 0 ? 0 : (double)count * 100 / total;
                        <div class="hcs-survey-bar"><span class="hcs-survey-bar__label">@($"{star}★")</span><div class="hcs-survey-bar__track"><div class="hcs-survey-bar__fill" style="@($"width:{width:0}%")"></div></div><span class="hcs-survey-bar__value">@count</span></div>
                    }
                </div>
                <div class="hcs-survey-results__section">
                    <h2>@L["CriteriaAverageRating"]</h2>
                    @if (statistics?.CriteriaAverageScores.Count > 0)
                    {
                        @foreach (var item in statistics.CriteriaAverageScores.OrderBy(x => x.Key))
                        {
                            var averagePercent = item.Value;
                            <div class="hcs-survey-bar"><span class="hcs-survey-bar__label">@item.Key</span><div class="hcs-survey-bar__track"><div class="hcs-survey-bar__fill" style="@($"width:{averagePercent:0}%")"></div></div><span class="hcs-survey-bar__value">@($"{averagePercent / 20m:0.#}/5")</span></div>
                        }
                    }
                    else
                    {
                        <DocsEmpty Compact="true" Title="@L["NoSurveyData"]" />
                    }
                </div>
            }
            else if (summaries.Items.Count == 0)
            {
                <DocsEmpty Title="@L["Catalog:EmptyTitle"]" Hint="@L["NoSurveyData"]" />
            }
            else
            {
                <div class="docs-table-wrap">
                    <table class="docs-table">
                        <thead><tr><th scope="col">@L["Feature:StarRating"]</th><th scope="col">@L["Menu:SurveyCriterias"]</th><th scope="col">@L["FullName"]</th><th scope="col">@L["PhoneNumber"]</th><th scope="col">@L["SurveyTime"]</th><th class="col-actions" scope="col"></th></tr></thead>
                        <tbody>
                            @foreach (var item in summaries.Items)
                            {
                                <tr>
                                    <td><span class="hcs-status-badge hcs-status-badge--info">@($"{WorkUi.ScoreToStars(item.Score)}★")</span></td>
                                    <td>@item.SurveyCriteriaName</td>
                                    <td>@(item.FullName ?? "—")</td>
                                    <td>@(item.PhoneNumber ?? "—")</td>
                                    <td>@item.SurveyTime.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <button type="button" class="doc-action" @onclick="() => OpenDetailAsync(item)" title="@L["ViewDetail"]" aria-label="@L["ViewDetail"]">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/></svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="pager">
                        <span>@($"{summaries.TotalCount} {L["SurveyResults:Records"]}")</span>
                        <button type="button" disabled="@(page == 0)" @onclick="PreviousPageAsync">@L["Previous"]</button>
                        <button type="button" disabled="@(!HasNextPage)" @onclick="NextPageAsync">@L["Next"]</button>
                    </div>
                </div>
            }
        }
    </div>
</section>

@if (showDetail)
{
    <div class="hcs-public-survey__backdrop" role="presentation">
        <div class="hcs-public-survey__dialog" role="dialog" aria-modal="true" aria-labelledby="survey-detail-title">
            <div class="hcs-public-survey__dialog-header">
                <h2 id="survey-detail-title">@L["SurveyDetails"]</h2>
                <button type="button" class="btn-close" aria-label="@L["Close"]" @onclick="CloseDetail"></button>
            </div>
            <div class="hcs-public-survey__dialog-body">
                @if (selectedSummary is not null)
                {
                    <dl class="row mb-4">
                        <dt class="col-sm-4">@L["FullName"]</dt><dd class="col-sm-8">@(selectedSummary.FullName ?? "—")</dd>
                        <dt class="col-sm-4">@L["PhoneNumber"]</dt><dd class="col-sm-8">@(selectedSummary.PhoneNumber ?? "—")</dd>
                        <dt class="col-sm-4">@L["PatientCode"]</dt><dd class="col-sm-8">@(selectedSummary.PatientCode ?? "—")</dd>
                        <dt class="col-sm-4">@L["Note"]</dt><dd class="col-sm-8">@(selectedSummary.Note ?? "—")</dd>
                        <dt class="col-sm-4">@L["SurveyTime"]</dt><dd class="col-sm-8">@selectedSummary.SurveyTime.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                }
                @if (isDetailLoading)
                {
                    <DocsEmpty Loading="true" Compact="true" />
                }
                else if (details.Count == 0)
                {
                    <DocsEmpty Compact="true" Title="@L["NoSurveyData"]" />
                }
                else
                {
                    <div class="table-responsive"><table class="table align-middle">
                        <thead><tr><th>@L["Menu:SurveyCriterias"]</th><th>@L["Feature:Score"]</th><th>@L["Feature:Comment"]</th></tr></thead>
                        <tbody>
                            @foreach (var item in details)
                            {
                                <tr><td>@item.SurveyCriteriaName</td><td>@($"{WorkUi.ScoreToStars(item.Score)}★")</td><td>@(item.Comment ?? "—")</td></tr>
                            }
                        </tbody>
                    </table></div>
                }
            </div>
            <div class="hcs-public-survey__dialog-footer"><button type="button" class="btn btn-secondary" @onclick="CloseDetail">@L["Close"]</button></div>
        </div>
    </div>
}

@code {
    private const int PageSize = 20;
    private readonly List<SurveyLocationDto> locations = [];
    private SurveyResultStatisticsDto? statistics;
    private PagedWorkResponse<SurveyResultSessionSummaryDto> summaries = new(0, []);
    private readonly List<SurveyResultSessionDetailDto> details = [];
    private SurveyResultSessionSummaryDto? selectedSummary;
    private string selectedLocationId = string.Empty;
    private string activeTab = "chart";
    private int page;
    private bool isLoading = true;
    private bool isDetailLoading;
    private bool showDetail;

    private Guid? SelectedLocation => Guid.TryParse(selectedLocationId, out var id) ? id : null;
    private bool HasNextPage => (page + 1) * PageSize < summaries.TotalCount;
    private IReadOnlyList<CatalogSelect2Item> LocationItems => locations
        .Select(item => new CatalogSelect2Item(item.Id.ToString("D"), item.Name, item.Code))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            locations.AddRange(await Work.GetLocationsAsync());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await NotifyErrorAsync(ex);
            isLoading = false;
        }
    }

    private async Task OnLocationChanged(string? value)
    {
        selectedLocationId = value ?? string.Empty;
        page = 0;
        await LoadAsync();
    }

    private Task<CatalogSelect2SearchResponse> SearchLocationsAsync(string term, int page)
    {
        var query = CatalogSelect2Text.NormalizeSearch(term);
        var results = locations
            .Where(item => string.IsNullOrEmpty(query)
                || CatalogSelect2Text.NormalizeSearch(item.Name).Contains(query, StringComparison.Ordinal)
                || CatalogSelect2Text.NormalizeSearch(item.Code).Contains(query, StringComparison.Ordinal))
            .Select(item => new CatalogSelect2Item(item.Id.ToString("D"), item.Name, item.Code))
            .ToList();

        return Task.FromResult(new CatalogSelect2SearchResponse(results, false));
    }

    private async Task ResetAsync()
    {
        selectedLocationId = string.Empty;
        page = 0;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            statistics = await Work.GetSurveyStatisticsAsync(SelectedLocation);
            summaries = await Work.GetSurveyResultSummariesAsync(SelectedLocation, page * PageSize, PageSize);
        }
        catch (Exception ex)
        {
            await NotifyErrorAsync(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (page == 0) return;
        page--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!HasNextPage) return;
        page++;
        await LoadAsync();
    }

    private async Task OpenDetailAsync(SurveyResultSessionSummaryDto item)
    {
        selectedSummary = item;
        details.Clear();
        showDetail = true;
        isDetailLoading = true;
        try
        {
            details.AddRange(await Work.GetSurveyResultDetailsAsync(item.SurveySessionId, SelectedLocation));
        }
        catch (Exception ex)
        {
            await NotifyErrorAsync(ex);
        }
        finally
        {
            isDetailLoading = false;
        }
    }

    private void CloseDetail() => showDetail = false;
}
