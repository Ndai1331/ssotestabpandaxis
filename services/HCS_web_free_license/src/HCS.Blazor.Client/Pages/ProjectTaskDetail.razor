@page "/project-task-detail/{TaskId:guid}"
@attribute [Authorize(Policy = "WorkManagement.ProjectTasks")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject CollaborationClient Chat
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation

<PageTitle>@L["Feature:TaskDetail"] · HCS</PageTitle>
<section class="page page-wf page-cv cv-detail" aria-labelledby="task-detail-title">
    @if (isLoading)
    {
        <DocsEmpty Loading="true" />
    }
    else if (detail is not null)
    {
        <form class="vb-card" @onsubmit="SaveTaskAsync" @onsubmit:preventDefault>
            <header class="vb-chrome">
                <div class="vb-chrome-id">
                    <button class="icon-btn" type="button" @onclick="GoBackToList" aria-label="@L["Feature:BackToList"]">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 18 9 12l6-6"/></svg>
                    </button>
                    <div class="vb-editor-head">
                        <h1 id="task-detail-title" title="@(form.Title.Length > 0 ? form.Title : L["Feature:TaskDetail"].Value)">@(form.Title.Length > 0 ? form.Title : L["Feature:TaskDetail"])</h1>
                        <p class="vb-editor-sub">
                            <span>@(string.IsNullOrWhiteSpace(form.Code) ? "—" : form.Code)</span>
                            <span class="@WorkUi.TaskBadgeDs(form.Status)">@L[WorkUi.TaskStatusKey(form.Status)]</span>
                            @if (!string.IsNullOrWhiteSpace(projectName))
                            {
                                <a href="@($"/project-detail/{detail.Task.ProjectId}")">@projectName</a>
                            }
                        </p>
                    </div>
                </div>
                <div class="vb-chrome-actions">
                    <div class="vb-foot">
                        <button class="btn btn-outline" type="button" @onclick="GoBackToList">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 18 9 12l6-6"/></svg>
                            @L["Feature:BackToList"]
                        </button>
                        <button class="btn btn-primary" type="submit" disabled="@isSaving">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                            @L["Catalog:SaveChanges"]
                        </button>
                    </div>
                </div>
            </header>

            <div class="vb-shell">
                <div class="vb-main">
                    <div class="vb-tabs" role="tablist" aria-label="@L["Feature:TaskDetail"]">
                        <button class="vb-tab @(activeTab == "info" ? "is-active" : null)" type="button" role="tab"
                                aria-selected="@(activeTab == "info")" @onclick="ShowInfoTab">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
                            @L["Feature:GeneralInformation"]
                        </button>
                        <button class="vb-tab @(activeTab == "assignments" ? "is-active" : null)" type="button" role="tab"
                                aria-selected="@(activeTab == "assignments")" @onclick="ShowAssignmentsTab">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M16 11a4 4 0 1 0-8 0"/><path d="M4 20a8 8 0 0 1 16 0"/><circle cx="18" cy="8" r="2.2"/><path d="M22 20a6 6 0 0 0-4-5.6"/></svg>
                            @L["Feature:Assignments"]
                            @if (detail.Assignments.Count > 0)
                            {
                                <span class="vb-tab-count">@detail.Assignments.Count</span>
                            }
                        </button>
                        <button class="vb-tab @(activeTab == "documents" ? "is-active" : null)" type="button" role="tab"
                                aria-selected="@(activeTab == "documents")" @onclick="ShowDocumentsTab">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/></svg>
                            @L["Menu:Documents"]
                            @if (detail.Documents.Count > 0)
                            {
                                <span class="vb-tab-count">@detail.Documents.Count</span>
                            }
                        </button>
                    </div>

                    <div class="vb-pane @(activeTab == "info" ? "is-active" : null)" role="tabpanel">
                        <div class="hcs-catalog-form">
                            <div class="hcs-form-row">
                                <Field>
                                    <FieldLabel>@L["Feature:Project"]</FieldLabel>
                                    <HcsIsolatedTextInput Value="@projectName" Name="hcsTaskProjectName" Disabled="true" />
                                </Field>
                                <Field>
                                    <FieldLabel>@L["Feature:ParentTask"]</FieldLabel>
                                    <HcsIsolatedTextInput Value="@ParentTaskLabel" Name="hcsTaskParentLabel" Disabled="true" />
                                </Field>
                            </div>
                            <div class="hcs-form-row">
                                <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput Value="@form.Code" Name="hcsTaskDetailCode" Disabled="true" /></Field>
                                <Field><FieldLabel>@L["Feature:TaskTitle"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Title" Name="hcsTaskDetailTitle" /></Field>
                            </div>
                            <div class="hcs-form-row hcs-form-row--equal">
                                <Field><FieldLabel>@L["Feature:StartDate"]</FieldLabel><HcsDatePicker TValue="DateTime" @bind-Value="form.StartDate" InputMode="DateInputMode.DateTime" ShowTodayButton ShowClearButton /></Field>
                                <Field><FieldLabel>@L["Feature:DueDate"]</FieldLabel><HcsDatePicker TValue="DateTime" @bind-Value="form.DueDate" InputMode="DateInputMode.DateTime" ShowTodayButton ShowClearButton /></Field>
                            </div>
                            <div class="hcs-form-row hcs-form-row--equal">
                                <Field>
                                    <FieldLabel>@L["Feature:Priority"]</FieldLabel>
                                    <Select TValue="string" @bind-Value="form.Priority">
                                        @foreach (var value in WorkUi.TaskPriorities)
                                        {
                                            <SelectItem Value="@value">@L[WorkUi.PriorityKey(value)]</SelectItem>
                                        }
                                    </Select>
                                </Field>
                                <Field>
                                    <FieldLabel>@L["Catalog:Status"]</FieldLabel>
                                    <Select TValue="string" Value="@form.Status" ValueChanged="OnStatusChanged">
                                        @foreach (var value in WorkUi.TaskStatuses)
                                        {
                                            <SelectItem Value="@value">@L[WorkUi.TaskStatusKey(value)]</SelectItem>
                                        }
                                    </Select>
                                </Field>
                                <Field>
                                    <FieldLabel>@L["Work:ProgressPercent"] · @form.ProgressPercent%</FieldLabel>
                                    <div class="hcs-progress-slider">
                                        <input type="range" class="hcs-progress-range" min="0" max="100" step="5"
                                               value="@form.ProgressPercent"
                                               style="@($"--hcs-progress:{form.ProgressPercent}%")"
                                               aria-valuemin="0" aria-valuemax="100" aria-valuenow="@form.ProgressPercent"
                                               aria-label="@L["Work:ProgressPercent"]"
                                               @oninput="OnProgressInput"
                                               @onchange="OnProgressInput" />
                                        <span class="hcs-progress-slider__value">@form.ProgressPercent%</span>
                                    </div>
                                </Field>
                            </div>
                            <Field>
                                <FieldLabel>@L["Feature:Description"]</FieldLabel>
                                <textarea class="form-control" rows="4" @bind="form.Description" autocomplete="off"></textarea>
                            </Field>
                        </div>
                    </div>

                    <div class="vb-pane @(activeTab == "assignments" ? "is-active" : null)" role="tabpanel">
                        @if (detail.Task.CanManageAssignments)
                        {
                            <div class="docs-toolbar list-search">
                                <div class="list-search-select">
                                    <label class="sr-only">@L["Feature:Member"]</label>
                                    <UserSelect2 Value="assigneeId"
                                                 ValueChanged="value => assigneeId = value"
                                                 Placeholder="@L["Chat:SelectContacts"]"
                                                 SelectedText="@Name(assigneeId)"
                                                 Search="SearchContactsAsync" />
                                </div>
                                <div class="pj-role-pick">
                                    <label class="sr-only" for="hcs-task-detail-role">@L["Feature:Role"]</label>
                                    <select id="hcs-task-detail-role" class="select" @bind="assignmentType">
                                        <option value="Member">@L["Work:ProjectRole.Member"]</option>
                                        <option value="Supervisor">@L["Work:ProjectRole.Supervisor"]</option>
                                        <option value="Manager">@L["Work:ProjectRole.Manager"]</option>
                                    </select>
                                </div>
                                <button class="btn btn-primary" type="button" @onclick="AddAssignmentAsync">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M16 11h6"/></svg>
                                    @L["Feature:AddMember"]
                                </button>
                            </div>
                        }
                        @if (detail.Assignments.Count == 0)
                        {
                            <DocsEmpty Compact="true" Title="@L["Feature:NoMembers"]" />
                        }
                        else
                        {
                            <ul class="hcs-member-list">
                                @foreach (var assignment in detail.Assignments)
                                {
                                    <li class="hcs-member-list__item">
                                        <span class="kb-avatar" aria-hidden="true">@Initial(Name(assignment.UserId))</span>
                                        <span class="hcs-member-list__meta">
                                            <strong class="hcs-member-list__name">@Name(assignment.UserId)</strong>
                                            <span class="hcs-member-list__role">@AssignmentTypeLabel(assignment.AssignmentType)</span>
                                        </span>
                                        @if (detail.Task.CanManageAssignments && CurrentUser.Id != assignment.UserId)
                                        {
                                            <button class="doc-action is-danger" type="button" title="@L["Catalog:Delete"]" aria-label="@L["Catalog:Delete"]" @onclick="() => RemoveAssignmentAsync(assignment)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M6 7l1 13h10l1-13"/></svg>
                                            </button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="vb-pane @(activeTab == "documents" ? "is-active" : null)" role="tabpanel">
                        <TaskDocumentsPane TaskId="TaskId"
                                           References="detail.Documents"
                                           CanManage="true"
                                           ShowUpload="true"
                                           OnChanged="ReloadTaskDocumentsAsync" />
                    </div>
                </div>
            </div>
        </form>
    }
</section>
@code {
    [Parameter] public Guid TaskId { get; set; }
    private ProjectTaskDetailDto? detail;
    private readonly List<HCS.CollaborationService.Contracts.ChatContactDto> contacts = [];
    private readonly List<ProjectTaskDto> siblingTasks = [];
    private readonly TaskEditForm form = new();
    private string projectName = "";
    private string activeTab = "info";
    private Guid? assigneeId;
    private string assignmentType = "Member";
    private bool isLoading, isSaving;
    private string ParentTaskLabel =>
        form.ParentTaskId is { } parentId
            ? siblingTasks.FirstOrDefault(x => x.Id == parentId)?.Title ?? parentId.ToString("N")[..8]
            : L["Catalog:NoParent"];

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        try
        {
            detail = await Work.GetTaskAsync(TaskId);
            BindForm(detail.Task);
            async Task LoadContactsSafeAsync()
            {
                try
                {
                    if (contacts.Count == 0)
                        contacts.AddRange(await Chat.GetContactsAsync(null, 50));
                }
                catch { }
            }

            await Task.WhenAll(
                LoadProjectContextAsync(detail.Task.ProjectId),
                LoadContactsSafeAsync());
            await ChatContactDirectory.EnsureAsync(Chat, contacts, detail.Assignments.Select(x => x.UserId), CurrentUser);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }

    private void GoBackToList() => Navigation.NavigateTo("/tasks");
    private void ShowInfoTab() => activeTab = "info";
    private void ShowAssignmentsTab() => activeTab = "assignments";
    private void ShowDocumentsTab() => activeTab = "documents";

    private void BindForm(ProjectTaskDto task)
    {
        form.ParentTaskId = task.ParentTaskId;
        form.Code = task.Code;
        form.Title = task.Title;
        form.Description = task.Description ?? "";
        form.StartDate = task.StartDate;
        form.DueDate = task.DueDate;
        form.Priority = task.Priority;
        form.Status = task.Status;
        form.ProgressPercent = task.ProgressPercent;
    }

    private async Task LoadProjectContextAsync(Guid projectId)
    {
        siblingTasks.Clear();
        try
        {
            var project = await Work.GetProjectAsync(projectId);
            projectName = project.Project.Name;
            siblingTasks.AddRange(project.Tasks.Where(x => x.Id != TaskId));
        }
        catch { /* fall back to chat contacts */ }
    }

    private async Task SaveTaskAsync()
    {
        isSaving = true;
        try
        {
            await Work.UpdateTaskAsync(TaskId, new UpdateProjectTaskRequest(
                form.Title.Trim(), Blank(form.Description), form.StartDate, form.DueDate, form.Priority, form.Status, form.ProgressPercent));
            await NotifySuccessAsync(L["Catalog:Updated"]);
            GoBackToList();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSaving = false; }
    }

    private Task OnStatusChanged(string value)
    {
        form.Status = value;
        if (string.Equals(value, "Completed", StringComparison.OrdinalIgnoreCase)) form.ProgressPercent = 100;
        return Task.CompletedTask;
    }

    private Task OnProgressInput(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value))
        {
            return Task.CompletedTask;
        }

        form.ProgressPercent = Math.Clamp(value, 0, 100);
        if (form.ProgressPercent == 100)
        {
            form.Status = "Completed";
        }
        else if (string.Equals(form.Status, "Completed", StringComparison.OrdinalIgnoreCase))
        {
            form.Status = "InProgress";
        }

        return Task.CompletedTask;
    }

    private async Task AddAssignmentAsync()
    {
        if (detail?.Task.CanManageAssignments != true || assigneeId is not { } userId) return;
        try
        {
            await Work.AddAssignmentAsync(TaskId, new AddTaskAssignmentRequest(userId, assignmentType));
            detail = await Work.GetTaskAsync(TaskId);
            await ChatContactDirectory.EnsureAsync(Chat, contacts, detail.Assignments.Select(x => x.UserId), CurrentUser);
            await NotifySuccessAsync(L["Catalog:Updated"]);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task RemoveAssignmentAsync(TaskAssignmentDto assignment)
    {
        if (detail?.Task.CanManageAssignments != true || CurrentUser.Id == assignment.UserId) return;
        if (!await UiMessage.Confirm(L["Catalog:DeleteConfirmation", Name(assignment.UserId)].Value)) return;
        try
        {
            await Work.RemoveAssignmentAsync(TaskId, assignment.Id);
            detail = await Work.GetTaskAsync(TaskId);
            await NotifySuccessAsync(L["Catalog:Deleted"]);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private async Task ReloadTaskDocumentsAsync()
    {
        detail = await Work.GetTaskAsync(TaskId);
    }

    private string Name(Guid? id) => ChatContactDirectory.Name(contacts, id);
    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1];
    private string AssignmentTypeLabel(string type) => type switch
    {
        "Manager" => L["Work:ProjectRole.Manager"],
        "Supervisor" => L["Work:ProjectRole.Supervisor"],
        "Member" => L["Work:ProjectRole.Member"],
        "Assignee" => L["Work:Assignee"],
        _ => type
    };
    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private async Task<CatalogSelect2SearchResponse> SearchContactsAsync(string term, int page)
    {
        var found = ChatContactDirectory.WithCurrentUser(await Chat.GetContactsAsync(term, 50), contacts, CurrentUser, term);
        return CatalogSelect2Cache.Merge(contacts, found, x => x.Id, x => x.DisplayName, false, CatalogSelect2Cache.UserItem);
    }

    private sealed class TaskEditForm
    {
        public Guid? ParentTaskId { get; set; }
        public string Code { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime DueDate { get; set; } = DateTime.Today.AddDays(7);
        public string Priority { get; set; } = "Normal";
        public string Status { get; set; } = "New";
        public int ProgressPercent { get; set; }
    }
}
