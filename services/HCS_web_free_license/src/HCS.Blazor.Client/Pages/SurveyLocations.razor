@page "/survey-locations"
@attribute [Authorize(Policy = "WorkManagement.SurveyManagement")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject IJSRuntime JsRuntime
@inject SurveyCatalogCache Cache
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation

<PageTitle>@L["Menu:SurveyLocations"] · HCS</PageTitle>
<section class="page page-wf page-dm" aria-labelledby="survey-locations-title">
    <div class="page-head">
        <h1 id="survey-locations-title">@L["Menu:SurveyLocations"]</h1>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="ExportAsync" disabled="@(pageItems.Count == 0 || isLoading)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/></svg>
                @L["Catalog:Export"]
            </button>
            <button class="btn btn-primary" type="button" @onclick="OpenCreate">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                @L["Catalog:New"]
            </button>
        </div>
    </div>
    <section class="docs-main">
        <form class="docs-toolbar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <label class="sr-only" for="sl-q">@L["Catalog:SearchPlaceholder"]</label>
            <input class="input docs-search" id="sl-q" type="search" @bind="filter" @bind:event="oninput"
                   placeholder="@L["Catalog:SearchPlaceholder"]" autocomplete="off" />
            <button class="btn btn-primary" type="submit" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:SearchButton"]
            </button>
            <HcsDismissible Class="filter-pop" @bind-IsOpen="showFilters">
                <button class="btn btn-outline @(string.IsNullOrEmpty(statusFilter) ? null : "is-filtered")" type="button"
                        aria-expanded="@showFilters.ToString().ToLowerInvariant()"
                        @onclick="() => showFilters = !showFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                    @L["Catalog:Filter"]
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="filter-menu @(showFilters ? "is-open" : null)" role="menu">
                    <button type="button" class="@(string.IsNullOrEmpty(statusFilter) ? "is-active" : null)" @onclick="FilterAll">@L["Catalog:AllStatuses"]</button>
                    <button type="button" class="@(statusFilter == "true" ? "is-active" : null)" @onclick="FilterActive">@L["Catalog:Active"]</button>
                    <button type="button" class="@(statusFilter == "false" ? "is-active" : null)" @onclick="FilterInactive">@L["Catalog:Inactive"]</button>
                </div>
            </HcsDismissible>
        </form>
        <div class="docs-table-wrap">
            @if (isLoading && pageItems.Count == 0)
            {
                <DocsEmpty Loading="true" />
            }
            else if (pageItems.Count == 0)
            {
                <DocsEmpty Hint="@L["Catalog:EmptyDescription"]" />
            }
            else
            {
                <table class="docs-table">
                    <thead>
                        <tr>
                            <th scope="col">@L["Catalog:Code"]</th>
                            <th scope="col">@L["Catalog:Name"]</th>
                            <th scope="col">@L["Feature:Description"]</th>
                            <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                            <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in pageItems)
                    {
                        <tr @key="item.Id">
                            <td class="doc-code">@item.Code</td>
                            <td>@item.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                            <td>
                                <span class="dm-status @(item.IsActive ? "is-on" : "is-off")" title="@(item.IsActive ? L["Catalog:Active"] : L["Catalog:Inactive"])">
                                    @if (item.IsActive)
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                                    }
                                    else
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                                    }
                                </span>
                            </td>
                            <td>
                                <div class="doc-actions">
                                    <button class="doc-action" type="button" title="@L["Catalog:Edit"]" aria-label="@L["Catalog:Edit"]" @onclick="() => OpenEdit(item)">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                    </button>
                                    <button class="doc-action" type="button" title="@L["Feature:CopyLink"]" aria-label="@L["Feature:CopyLink"]" @onclick="() => CopyCollectionLinkAsync(item.Id)">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l1-1a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-1 1a5 5 0 0 0 7 7l1-1"/></svg>
                                    </button>
                                    <button class="doc-action is-danger" type="button" title="@L["Catalog:Delete"]" aria-label="@L["Catalog:Delete"]" @onclick="() => DeleteAsync(item)">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            <div class="pager" aria-label="@L["Catalog:PageSize"]">
                <button type="button" disabled="@(!CanPrev)" @onclick="GoFirst">@L["Catalog:PagerFirst"]</button>
                <button type="button" disabled="@(!CanPrev)" @onclick="GoPrev">@L["Catalog:PagerPrev"]</button>
                <button type="button" disabled="@(!CanNext)" @onclick="GoNext">@L["Catalog:PagerNext"]</button>
                <button type="button" disabled="@(!CanNext)" @onclick="GoLast">@L["Catalog:PagerLast"]</button>
                <label class="sr-only" for="sl-page-size">@L["Catalog:PageSize"]</label>
                <select id="sl-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>
    </section>
</section>

<Modal @ref="modal"><ModalContent Centered Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header">
        <ModalTitle>@(editingId is null ? L["Catalog:Create"] : L["Catalog:Edit"])</ModalTitle>
        <CloseButton />
    </ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        <div class="hcs-catalog-form">
            <div class="hcs-form-row">
                <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Code" Name="hcsSurveyLocationCode" MaxLength="64" Disabled="@(editingId is not null)" /></Field>
                <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Name" Name="hcsSurveyLocationName" /></Field>
            </div>
            <Field><FieldLabel>@L["Feature:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="form.Description"></textarea></Field>
            @if (editingId is not null)
            {
                <Field><Check TValue="bool" @bind-Value="form.IsActive">@L["Catalog:Active"]</Check></Field>
            }
        </div>
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => modal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveAsync" Disabled="@isSaving">@L["Catalog:SaveChanges"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<SurveyLocationDto> allItems = [];
    private readonly List<SurveyLocationDto> pageItems = [];
    private readonly LocationForm form = new();
    private Modal? modal;
    private Guid? editingId;
    private string filter = "";
    private string statusFilter = "";
    private bool isLoading, isSaving, showFilters;
    private int totalCount, pageSize = 20, currentPage = 1;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)Math.Max(pageSize, 1)));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < PageCount;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task GoFirst() { currentPage = 1; ApplyPage(); return Task.CompletedTask; }
    private Task GoPrev() { if (!CanPrev) return Task.CompletedTask; currentPage--; ApplyPage(); return Task.CompletedTask; }
    private Task GoNext() { if (!CanNext) return Task.CompletedTask; currentPage++; ApplyPage(); return Task.CompletedTask; }
    private Task GoLast() { currentPage = PageCount; ApplyPage(); return Task.CompletedTask; }
    private Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return Task.CompletedTask;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        ApplyPage();
        return Task.CompletedTask;
    }
    private Task FilterAll() => SetStatusFilter(string.Empty);
    private Task FilterActive() => SetStatusFilter("true");
    private Task FilterInactive() => SetStatusFilter("false");
    private Task SetStatusFilter(string value)
    {
        statusFilter = value;
        showFilters = false;
        currentPage = 1;
        ApplyPage();
        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            allItems.Clear();
            allItems.AddRange(await Work.GetLocationsAsync());
            Cache.Set(false, allItems.Select(x => new SurveyCatalogItem(x.Id, x.Code, x.Name, 0, x.IsActive)).ToList());
            ApplyPage();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }

    private void ApplyPage()
    {
        var filtered = allItems.Where(Matches).ToList();
        totalCount = filtered.Count;
        pageItems.Clear();
        pageItems.AddRange(filtered.Skip((currentPage - 1) * pageSize).Take(pageSize));
    }

    private bool Matches(SurveyLocationDto item)
    {
        if (!string.IsNullOrWhiteSpace(filter))
        {
            var term = SearchText.Normalize(filter);
            if (item.Code.IndexOf(term, StringComparison.OrdinalIgnoreCase) < 0 &&
                item.Name.IndexOf(term, StringComparison.OrdinalIgnoreCase) < 0)
                return false;
        }
        if (statusFilter == "true") return item.IsActive;
        if (statusFilter == "false") return !item.IsActive;
        return true;
    }

    private Task SearchAsync() { currentPage = 1; ApplyPage(); return Task.CompletedTask; }
    private Task ResetSearchAsync() { filter = statusFilter = ""; showFilters = false; currentPage = 1; ApplyPage(); return Task.CompletedTask; }

    private async Task OpenCreate()
    {
        editingId = null;
        form.Reset();
        if (modal is not null) await modal.Show();
    }

    private async Task OpenEdit(SurveyLocationDto item)
    {
        editingId = item.Id;
        form.Code = item.Code;
        form.Name = item.Name;
        form.Description = item.Description ?? "";
        form.IsActive = item.IsActive;
        if (modal is not null) await modal.Show();
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        try
        {
            if (editingId is { } id)
                await Work.UpdateLocationAsync(id, new UpdateSurveyLocationRequest(form.Name.Trim(), null, form.IsActive, Blank(form.Description)));
            else
                await Work.CreateLocationAsync(new CreateSurveyLocationRequest(form.Code.Trim(), form.Name.Trim(), null, Blank(form.Description), form.IsActive));
            await NotifySuccessAsync(editingId is null ? L["Catalog:Created"] : L["Catalog:Updated"]);
            if (modal is not null) await modal.Hide();
            await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
        finally { isSaving = false; }
    }

    private async Task CopyCollectionLinkAsync(Guid locationId)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.ToAbsoluteUri($"/survey-collections/{locationId}").ToString());
            await NotifySuccessAsync(L["Feature:LinkCopied"]);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }

    private async Task DeleteAsync(SurveyLocationDto item)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], item.Name))) return;
        try
        {
            await Work.DeleteLocationAsync(item.Id);
            await NotifySuccessAsync(L["Catalog:Deleted"]);
            await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }

    private async Task ExportAsync()
    {
        try
        {
            await CsvDownload.DownloadAsync(JsRuntime, $"survey-locations-{DateTime.Now:yyyyMMdd-HHmm}.csv",
                [L["Catalog:Code"], L["Catalog:Name"], L["Catalog:Status"]],
                pageItems.Select(item => (IReadOnlyList<string>)[item.Code, item.Name, item.IsActive ? L["Catalog:Active"] : L["Catalog:Inactive"]]));
            await UiMessage.Success(L["Catalog:Exported"]);
        }
        catch { await UiMessage.Error(L["Catalog:ExportError"]); }
    }

    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class LocationForm
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsActive { get; set; } = true;
        public void Reset() { Code = Name = Description = ""; IsActive = true; }
    }
}
