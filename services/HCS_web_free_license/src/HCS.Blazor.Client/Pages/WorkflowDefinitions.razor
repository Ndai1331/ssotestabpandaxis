@page "/workflow-definitions"
@attribute [Authorize(Policy = "Documents.Workflow.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject IUiMessageService UiMessage

<PageTitle>@L["Menu:WorkflowDefinitions"] · HCS</PageTitle>
<section class="hcs-catalog-page">
    <header class="hcs-catalog-titlebar">
        <div class="min-w-0"><h1>@L["Menu:WorkflowDefinitions"]</h1></div>
        <div class="hcs-catalog-page__actions">
            <Button Color="Color.Primary" Outline="true" Class="hcs-catalog-export" Clicked="LoadAsync" Disabled="@isLoading">@L["Catalog:Refresh"]</Button>
            <AuthorizeView Policy="Documents.Workflow.Manage">
                <Authorized>
                    <Button Color="Color.Primary" Class="hcs-catalog-create" Clicked="OpenCreate"><Icon Name="@IconName.Add" /> @L["Catalog:New"]</Button>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <Card Class="mb-3 hcs-catalog-filter-card"><CardBody>
        <div class="hcs-catalog-filter-row">
            <Addons Class="hcs-catalog-search">
                <Addon AddonType="AddonType.Body"><TextInput @bind-Value="filter" Placeholder="@L["Catalog:SearchPlaceholder"]" /></Addon>
                <Addon AddonType="AddonType.End"><Button Color="Color.Primary" Clicked="() => search = filter"><i class="fa fa-search me-1"></i> @L["Catalog:SearchButton"]</Button></Addon>
            </Addons>
        </div>
    </CardBody></Card>
    <Card Class="hcs-catalog-grid-card"><CardBody>
        @if (isLoading) { <div class="hcs-loading py-5"><i class="fa fa-spinner fa-spin"></i><span>@L["Catalog:Loading"]</span></div> }
        else if (Visible.Count == 0) { <div class="hcs-empty py-5"><i class="fa fa-inbox"></i><h2>@L["Catalog:EmptyTitle"]</h2><p>@L["Catalog:EmptyDescription"]</p></div> }
        else
        {
            <div class="table-responsive"><table class="table table-hover align-middle mb-0 hcs-catalog-grid">
                <thead><tr><th>@L["Catalog:Code"]</th><th>@L["Catalog:Name"]</th><th>@L["Work:Description"]</th><th>@L["Work:IsActive"]</th><th>@L["Catalog:Actions"]</th></tr></thead>
                <tbody>
                @foreach (var item in Visible)
                {
                    <tr>
                        <td><span class="hcs-catalog-code">#@item.Code</span></td>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Description</td>
                        <td>@(item.IsActive ? L["Catalog:Active"] : L["Catalog:Inactive"])</td>
                        <td>
                            <AuthorizeView Policy="Documents.Workflow.Manage">
                                <Authorized>
                                    <div class="hcs-row-actions">
                                        <Button Size="Size.Small" Color="Color.Primary" Outline="true" Class="hcs-action-button hcs-action-button--edit" Clicked="() => Edit(item)"><Icon Name="@IconName.Edit" /></Button>
                                        <Button Size="Size.Small" Color="Color.Danger" Outline="true" Class="hcs-action-button hcs-action-button--delete" Clicked="() => DeleteAsync(item)"><Icon Name="@IconName.Delete" /></Button>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </CardBody></Card>
</section>

<Modal @ref="modal"><ModalContent Centered Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@(editing is null ? L["Catalog:Create"] : L["Catalog:Edit"])</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        <div class="hcs-catalog-form">
            <div class="hcs-form-row">
                <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Code" Name="hcsKindCode" MaxLength="64" Disabled="@(editing is not null)" /></Field>
                <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Name" Name="hcsKindName" /></Field>
            </div>
            <Field><FieldLabel>@L["Work:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="form.Description"></textarea></Field>
            <Field><Check TValue="bool" @bind-Checked="form.IsActive">@L["Work:IsActive"]</Check></Field>
        </div>
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => modal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveAsync">@L["Catalog:SaveChanges"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    private readonly List<WorkflowKindDto> kinds = [];
    private readonly KindForm form = new();
    private WorkflowKindDto? editing;
    private Modal? modal;
    private string filter = "", search = "";
    private bool isLoading;

    private List<WorkflowKindDto> Visible => string.IsNullOrWhiteSpace(search)
        ? kinds
        : kinds.Where(x => x.Code.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Name.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        isLoading = true;
        try { kinds.Clear(); kinds.AddRange(await Documents.GetKindsAsync()); }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }
    private async Task OpenCreate() { editing = null; form.Reset(); if (modal is not null) await modal.Show(); }
    private async Task Edit(WorkflowKindDto item)
    {
        editing = item;
        form.Code = item.Code; form.Name = item.Name; form.Description = item.Description ?? ""; form.IsActive = item.IsActive;
        if (modal is not null) await modal.Show();
    }
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(form.Code) || string.IsNullOrWhiteSpace(form.Name))
        {
            await NotifyErrorAsync(L["Catalog:CodeNameRequired"]);
            return;
        }
        try
        {
            if (editing is null)
                await Documents.CreateKindAsync(new CreateWorkflowKindRequest(form.Code.Trim(), form.Name.Trim(), form.Description, form.IsActive));
            else
                await Documents.UpdateKindAsync(editing.Id, new UpdateWorkflowKindRequest(form.Name.Trim(), form.Description, form.IsActive));
            if (modal is not null) await modal.Hide();
            await NotifySuccessAsync(editing is null ? L["Catalog:Created"] : L["Catalog:Updated"]);
            await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task DeleteAsync(WorkflowKindDto item)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], item.Name))) return;
        try { await Documents.DeleteKindAsync(item.Id); await NotifySuccessAsync(L["Catalog:Deleted"]); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private sealed class KindForm
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsActive { get; set; } = true;
        public void Reset() { Code = Name = Description = ""; IsActive = true; }
    }
}
