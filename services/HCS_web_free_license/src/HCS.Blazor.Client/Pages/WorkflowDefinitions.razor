@page "/workflow-definitions"
@attribute [Authorize(Policy = "Documents.Workflow.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject IUiMessageService UiMessage

<PageTitle>@L["Menu:WorkflowDefinitions"] · HCS</PageTitle>
<section class="hcs-catalog-page">
    <header class="hcs-catalog-titlebar">
        <div class="min-w-0"><h1>@L["Menu:WorkflowDefinitions"]</h1></div>
        <div class="hcs-catalog-page__actions">
            <Button Color="Color.Primary" Outline="true" Class="hcs-catalog-export" Clicked="LoadAsync" Disabled="@isLoading">@L["Catalog:Refresh"]</Button>
            <Button Color="Color.Primary" Class="hcs-catalog-create" Clicked="OpenCreate"><Icon Name="@IconName.Add" /> @L["Catalog:New"]</Button>
        </div>
    </header>
    @if (error is not null) { <div class="alert alert-warning">@error</div> }
    @if (success is not null) { <div class="alert alert-success">@success</div> }
    <Card Class="mb-4 hcs-catalog-filter-card"><CardBody>
        <div class="hcs-catalog-filter-row">
            <Addons Class="hcs-catalog-search">
                <Addon AddonType="AddonType.Body"><TextInput @bind-Value="filter" Placeholder="@L["Catalog:SearchPlaceholder"]" /></Addon>
                <Addon AddonType="AddonType.End"><Button Color="Color.Primary" Clicked="() => { }"><i class="fa fa-search me-1"></i> @L["Catalog:SearchButton"]</Button></Addon>
            </Addons>
        </div>
    </CardBody></Card>
    <Card Class="hcs-catalog-grid-card mb-4"><CardBody>
        @if (isLoading) { <div class="hcs-loading py-5"><i class="fa fa-spinner fa-spin"></i><span>@L["Catalog:Loading"]</span></div> }
        else if (VisibleDefinitions.Count == 0) { <div class="hcs-empty py-5"><i class="fa fa-inbox"></i><h2>@L["Catalog:EmptyTitle"]</h2><p>@L["Catalog:EmptyDescription"]</p></div> }
        else
        {
            <div class="table-responsive"><table class="table table-hover align-middle mb-0 hcs-catalog-grid">
                <thead><tr><th></th><th>@L["Catalog:Code"]</th><th>@L["Feature:AddStep"]</th><th>@L["Catalog:Actions"]</th></tr></thead>
                <tbody>
                @foreach (var item in VisibleDefinitions)
                {
                    <tr>
                        <td><input class="hcs-row-check" type="checkbox" disabled tabindex="-1" /></td>
                        <td><strong>@item.Name</strong><span class="hcs-catalog-code">#@item.Code</span></td>
                        <td>@item.Steps.Count</td>
                        <td>
                            <div class="hcs-row-actions">
                                <Button Size="Size.Small" Color="Color.Primary" Outline="true" Class="hcs-action-button hcs-action-button--edit" Clicked="() => Edit(item)"><Icon Name="@IconName.Edit" /></Button>
                                <Button Size="Size.Small" Color="Color.Danger" Outline="true" Class="hcs-action-button hcs-action-button--delete" Clicked="() => DeleteAsync(item)"><Icon Name="@IconName.Delete" /></Button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </CardBody></Card>

    <header class="hcs-catalog-titlebar">
        <div class="min-w-0"><h2 class="h4 mb-0">@L["Feature:Templates"]</h2></div>
        <div class="hcs-catalog-page__actions">
            <Button Color="Color.Primary" Class="hcs-catalog-create" Clicked="OpenTemplateCreate"><Icon Name="@IconName.Add" /> @L["Catalog:New"]</Button>
        </div>
    </header>
    <Card Class="hcs-catalog-grid-card"><CardBody>
        @if (templates.Count == 0) { <div class="hcs-empty py-5"><i class="fa fa-inbox"></i><h2>@L["Catalog:EmptyTitle"]</h2></div> }
        else
        {
            <div class="table-responsive"><table class="table table-hover align-middle mb-0 hcs-catalog-grid">
                <thead><tr><th></th><th>@L["Catalog:Code"]</th><th>@L["Feature:Version"]</th><th>@L["Catalog:Status"]</th><th>@L["Catalog:Actions"]</th></tr></thead>
                <tbody>
                @foreach (var template in templates)
                {
                    <tr>
                        <td><input class="hcs-row-check" type="checkbox" disabled tabindex="-1" /></td>
                        <td><strong>@template.Name</strong><span class="hcs-catalog-code">#@template.Code</span></td>
                        <td>@template.Version</td>
                        <td><span class="@(template.IsActive ? "hcs-status-badge hcs-status-badge--success" : "hcs-status-badge hcs-status-badge--planning")">@(template.IsActive ? L["Catalog:Active"] : L["Catalog:Inactive"])</span></td>
                        <td>
                            <Button Size="Size.Small" Color="Color.Light" Clicked="() => SetActiveAsync(template, !template.IsActive)">
                                @(template.IsActive ? L["Feature:Deactivate"] : L["Feature:Activate"])
                            </Button>
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </CardBody></Card>
</section>

<Modal @ref="definitionModal"><ModalContent Centered Size="ModalSize.Large" Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@(editingId is null ? L["Feature:WorkflowDesigner"] : L["Catalog:Edit"])</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        <div class="hcs-catalog-form">
            <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><TextInput @bind-Value="form.Code" Disabled="@(editingId is not null)" /></Field>
            <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><TextInput @bind-Value="form.Name" /></Field>
            <h3 class="h6">@L["Feature:AddStep"]</h3>
            @for (var i = 0; i < form.Steps.Count; i++)
            {
                var index = i;
                var step = form.Steps[index];
                <div class="border rounded p-2 mb-2">
                    <Field><FieldLabel>@L["Feature:StepCode"]</FieldLabel><TextInput @bind-Value="step.Code" /></Field>
                    <Field><FieldLabel>@L["Feature:StepName"]</FieldLabel><TextInput @bind-Value="step.Name" /></Field>
                    <Field><FieldLabel>@L["Feature:RequiredPermission"]</FieldLabel><TextInput @bind-Value="step.RequiredPermission" /></Field>
                    <Button Size="Size.Small" Color="Color.Danger" Outline="true" Clicked="() => RemoveStep(index)" Disabled="@(form.Steps.Count <= 1)">@L["Catalog:Delete"]</Button>
                </div>
            }
            <Button Color="Color.Light" Clicked="AddStep">@L["Feature:AddStep"]</Button>
        </div>
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => definitionModal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveDefinitionAsync">@L["Catalog:SaveChanges"]</Button>
    </ModalFooter>
</ModalContent></Modal>

<Modal @ref="templateModal"><ModalContent Centered Size="ModalSize.Large" Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@L["Feature:Templates"]</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        <div class="hcs-catalog-form">
            <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><TextInput @bind-Value="templateForm.Code" /></Field>
            <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><TextInput @bind-Value="templateForm.Name" /></Field>
            <Field><FieldLabel>@L["Feature:Version"]</FieldLabel><NumericPicker TValue="int" @bind-Value="templateForm.Version" Min="1" /></Field>
            <Field><FieldLabel>@L["Menu:WorkflowDefinitions"]</FieldLabel>
                <Select TValue="string" @bind-Value="templateForm.DefinitionId">
                    <SelectItem Value="@string.Empty">@L["Catalog:ChooseType"]</SelectItem>
                    @foreach (var item in definitions) { <SelectItem Value="@item.Id.ToString()">@($"{item.Code} · {item.Name}")</SelectItem> }
                </Select>
            </Field>
            <Field><FieldLabel>@L["Feature:TemplateJson"]</FieldLabel><textarea class="form-control" rows="4" @bind="templateForm.Json"></textarea></Field>
        </div>
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => templateModal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="CreateTemplateAsync">@L["Catalog:Create"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    private readonly List<WorkflowDefinitionDto> definitions = [];
    private readonly List<WorkflowTemplateDto> templates = [];
    private readonly DefinitionForm form = new();
    private readonly TemplateForm templateForm = new();
    private Modal? definitionModal, templateModal;
    private Guid? editingId;
    private string filter = "";
    private bool isLoading;
    private string? error, success;

    private List<WorkflowDefinitionDto> VisibleDefinitions => string.IsNullOrWhiteSpace(filter)
        ? definitions
        : definitions.Where(x => x.Code.Contains(filter, StringComparison.OrdinalIgnoreCase) || x.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        isLoading = true; error = null;
        try { definitions.Clear(); definitions.AddRange(await Documents.GetDefinitionsAsync()); templates.Clear(); templates.AddRange(await Documents.GetTemplatesAsync()); }
        catch { error = L["Catalog:LoadError"]; }
        finally { isLoading = false; }
    }
    private async Task OpenCreate() { editingId = null; form.Reset(); if (definitionModal is not null) await definitionModal.Show(); }
    private async Task OpenTemplateCreate() { templateForm.Reset(); if (templateModal is not null) await templateModal.Show(); }
    private void AddStep() => form.Steps.Add(new StepDraft($"step{form.Steps.Count + 1}", L["Feature:StepName"], form.Steps.Count + 1, "Documents.Workflow.Decide"));
    private void RemoveStep(int index) { if (form.Steps.Count > 1) form.Steps.RemoveAt(index); }
    private async Task Edit(WorkflowDefinitionDto item)
    {
        editingId = item.Id; form.Code = item.Code; form.Name = item.Name;
        form.Steps.Clear();
        foreach (var step in item.Steps.OrderBy(x => x.Order))
            form.Steps.Add(new StepDraft(step.Code, step.Name, step.Order, step.RequiredPermission));
        if (definitionModal is not null) await definitionModal.Show();
    }
    private async Task SaveDefinitionAsync()
    {
        try
        {
            var steps = form.Steps.Select((step, index) => new WorkflowStepInput(step.Code.Trim(), step.Name.Trim(), index + 1, step.RequiredPermission.Trim())).ToList();
            if (editingId is { } id) await Documents.UpdateDefinitionAsync(id, new UpdateWorkflowDefinitionRequest(form.Name.Trim(), steps));
            else await Documents.CreateDefinitionAsync(new CreateWorkflowDefinitionRequest(form.Code.Trim(), form.Name.Trim(), steps));
            success = L["Catalog:Updated"];
            if (definitionModal is not null) await definitionModal.Hide();
            form.Reset(); await LoadAsync();
        }
        catch { error = L["Catalog:SaveError"]; }
    }
    private async Task DeleteAsync(WorkflowDefinitionDto item)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], item.Name))) return;
        try { await Documents.DeleteDefinitionAsync(item.Id); success = L["Catalog:Deleted"]; await LoadAsync(); }
        catch { error = L["Catalog:DeleteError"]; }
    }
    private async Task CreateTemplateAsync()
    {
        if (!Guid.TryParse(templateForm.DefinitionId, out var definitionId)) { error = L["Catalog:TypeRequired"]; return; }
        try
        {
            await Documents.CreateTemplateAsync(new CreateWorkflowTemplateRequest(templateForm.Code.Trim(), templateForm.Name.Trim(), definitionId, templateForm.Version, string.IsNullOrWhiteSpace(templateForm.Json) ? "{}" : templateForm.Json));
            if (templateModal is not null) await templateModal.Hide();
            templateForm.Reset(); success = L["Catalog:Created"]; await LoadAsync();
        }
        catch { error = L["Catalog:SaveError"]; }
    }
    private async Task SetActiveAsync(WorkflowTemplateDto template, bool isActive)
    {
        try { await Documents.SetTemplateActiveAsync(template.Id, isActive); await LoadAsync(); }
        catch { error = L["Catalog:SaveError"]; }
    }
    private sealed class StepDraft(string code, string name, int order, string permission)
    {
        public string Code { get; set; } = code; public string Name { get; set; } = name; public int Order { get; set; } = order; public string RequiredPermission { get; set; } = permission;
    }
    private sealed class DefinitionForm
    {
        public string Code { get; set; } = ""; public string Name { get; set; } = "";
        public List<StepDraft> Steps { get; } = [new("review", "Review", 1, "Documents.Workflow.Decide")];
        public void Reset() { Code = Name = ""; Steps.Clear(); Steps.Add(new("review", "Review", 1, "Documents.Workflow.Decide")); }
    }
    private sealed class TemplateForm
    {
        public string Code { get; set; } = ""; public string Name { get; set; } = ""; public string DefinitionId { get; set; } = ""; public int Version { get; set; } = 1; public string Json { get; set; } = "{}";
        public void Reset() { Code = Name = DefinitionId = ""; Version = 1; Json = "{}"; }
    }
}
