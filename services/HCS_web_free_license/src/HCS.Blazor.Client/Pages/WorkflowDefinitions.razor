@page "/workflow-definitions"
@attribute [Authorize(Policy = "Documents.Workflow.View")]
@inherits HCSComponentBase
@inject DocumentClient Documents
@inject IUiMessageService UiMessage

<PageTitle>@L["Menu:WorkflowDefinitions"] · HCS</PageTitle>
<section class="page page-wf wf-kinds">
    <div class="page-head">
        <h1>@L["Menu:WorkflowDefinitions"]</h1>
        <div class="page-actions">
            <button class="btn btn-outline" type="button" @onclick="LoadAsync" disabled="@isLoading">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                @L["Catalog:Refresh"]
            </button>
            <AuthorizeView Policy="Documents.Workflow.Manage">
                <Authorized>
                    <button class="btn btn-primary" type="button" @onclick="OpenCreate">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        @L["Catalog:New"]
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <section class="docs-main">
        <form class="docs-toolbar" @onsubmit="ApplySearch" @onsubmit:preventDefault>
            <label class="sr-only" for="wf-kind-q">@L["Catalog:SearchPlaceholder"]</label>
            <input class="input docs-search" id="wf-kind-q" type="search" @bind="filter" @bind:event="oninput"
                   placeholder="@L["Catalog:SearchPlaceholder"]" autocomplete="off" />
            <button class="btn btn-primary" type="submit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                @L["Catalog:SearchButton"]
            </button>
            <HcsDismissible Class="filter-pop" @bind-IsOpen="showFilters">
                <button class="btn btn-outline" type="button" aria-expanded="@showFilters.ToString().ToLowerInvariant()"
                        @onclick="() => showFilters = !showFilters">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16l-6 8v5l-4 1v-6z"/></svg>
                    @L["Catalog:Filter"]
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="filter-menu @(showFilters ? "is-open" : null)" role="menu">
                    <button type="button" class="@(string.IsNullOrEmpty(activeFilter) ? "is-active" : null)" @onclick="FilterAll">@L["Catalog:AllStatuses"]</button>
                    <button type="button" class="@(activeFilter == "true" ? "is-active" : null)" @onclick="FilterActive">@L["Catalog:Active"]</button>
                    <button type="button" class="@(activeFilter == "false" ? "is-active" : null)" @onclick="FilterInactive">@L["Catalog:Inactive"]</button>
                </div>
            </HcsDismissible>
        </form>

        <div class="docs-table-wrap">
            @if (isLoading && !loaded)
            {
                <DocsEmpty Loading="true" />
            }
            else if (pageItems.Count == 0)
            {
                <DocsEmpty Hint="@L["Catalog:EmptyDescription"]" />
            }
            else
            {
                <table class="docs-table">
                    <thead>
                        <tr>
                            <th scope="col">@L["Catalog:Code"]</th>
                            <th scope="col">@L["Catalog:Name"]</th>
                            <th scope="col">@L["Work:Description"]</th>
                            <th class="col-status" scope="col">@L["Catalog:Status"]</th>
                            <th class="col-actions" scope="col">@L["Catalog:Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in pageItems)
                    {
                        <tr @key="item.Id">
                            <td class="doc-code">@item.Code</td>
                            <td>@item.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                            <td>
                                <span class="dm-status @(item.IsActive ? "is-on" : "is-off")" title="@(item.IsActive ? L["Catalog:Active"] : L["Catalog:Inactive"])">
                                    @if (item.IsActive)
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                                    }
                                    else
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                                    }
                                </span>
                            </td>
                            <td>
                                <AuthorizeView Policy="Documents.Workflow.Manage">
                                    <Authorized>
                                        <div class="doc-actions">
                                            <button class="doc-action" type="button" title="@($"{L["Catalog:Edit"]} {item.Name}")" aria-label="@($"{L["Catalog:Edit"]} {item.Name}")" @onclick="() => Edit(item)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                            </button>
                                            <button class="doc-action is-danger" type="button" title="@($"{L["Catalog:Delete"]} {item.Name}")" aria-label="@($"{L["Catalog:Delete"]} {item.Name}")" @onclick="() => DeleteAsync(item)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                            </button>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            <div class="pager" aria-label="@L["Catalog:PageSize"]">
                <button type="button" disabled="@(!CanPrev)" @onclick="GoFirst">@L["Catalog:PagerFirst"]</button>
                <button type="button" disabled="@(!CanPrev)" @onclick="GoPrev">@L["Catalog:PagerPrev"]</button>
                <button type="button" disabled="@(!CanNext)" @onclick="GoNext">@L["Catalog:PagerNext"]</button>
                <button type="button" disabled="@(!CanNext)" @onclick="GoLast">@L["Catalog:PagerLast"]</button>
                <label class="sr-only" for="wf-kind-page-size">@L["Catalog:PageSize"]</label>
                <select id="wf-kind-page-size" aria-label="@L["Catalog:PageSize"]" value="@pageSize" @onchange="OnPageSizeChanged">
                    @foreach (var size in pageSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>
    </section>
</section>

<Modal @ref="modal"><ModalContent Centered Class="hcs-catalog-modal">
    <ModalHeader Class="hcs-catalog-modal__header"><ModalTitle>@(editing is null ? L["Catalog:Create"] : L["Catalog:Edit"])</ModalTitle><CloseButton /></ModalHeader>
    <ModalBody Class="hcs-catalog-modal__body">
        <div class="hcs-catalog-form">
            <div class="hcs-form-row">
                <Field><FieldLabel>@L["Catalog:Code"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Code" Name="hcsKindCode" MaxLength="64" Disabled="@(editing is not null)" /></Field>
                <Field><FieldLabel>@L["Catalog:Name"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Name" Name="hcsKindName" /></Field>
            </div>
            <Field><FieldLabel>@L["Work:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="form.Description"></textarea></Field>
            <Field><Check TValue="bool" @bind-Value="form.IsActive">@L["Work:IsActive"]</Check></Field>
        </div>
    </ModalBody>
    <ModalFooter Class="hcs-catalog-modal__footer">
        <Button Color="Color.Secondary" Class="hcs-catalog-cancel" Clicked="() => modal!.Hide()">@L["Catalog:Cancel"]</Button>
        <Button Color="Color.Primary" Class="hcs-catalog-save" Clicked="SaveAsync">@L["Catalog:SaveChanges"]</Button>
    </ModalFooter>
</ModalContent></Modal>
@code {
    private static readonly int[] pageSizes = [10, 20, 50, 100];
    private readonly List<WorkflowKindDto> kinds = [];
    private List<WorkflowKindDto> pageItems = [];
    private readonly KindForm form = new();
    private WorkflowKindDto? editing;
    private Modal? modal;
    private string filter = "", search = "", activeFilter = "";
    private bool isLoading, showFilters, loaded;
    private int totalCount, pageSize = 20, currentPage = 1;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < PageCount;

    private List<WorkflowKindDto> Filtered
    {
        get
        {
            IEnumerable<WorkflowKindDto> query = kinds;
            if (!string.IsNullOrWhiteSpace(search))
                query = query.Where(x => x.Code.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            if (activeFilter == "true") query = query.Where(x => x.IsActive);
            if (activeFilter == "false") query = query.Where(x => !x.IsActive);
            return query.ToList();
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private void FilterAll() => SetActiveFilter(string.Empty);
    private void FilterActive() => SetActiveFilter("true");
    private void FilterInactive() => SetActiveFilter("false");
    private void ApplySearch() { search = SearchText.Normalize(filter); currentPage = 1; ApplyPage(); }
    private void SetActiveFilter(string value)
    {
        activeFilter = value;
        showFilters = false;
        currentPage = 1;
        ApplyPage();
    }
    private void ApplyPage()
    {
        var filtered = Filtered;
        totalCount = filtered.Count;
        currentPage = Math.Clamp(currentPage, 1, PageCount);
        pageItems = filtered.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }
    private void GoFirst() { currentPage = 1; ApplyPage(); }
    private void GoPrev() { if (CanPrev) { currentPage--; ApplyPage(); } }
    private void GoNext() { if (CanNext) { currentPage++; ApplyPage(); } }
    private void GoLast() { currentPage = PageCount; ApplyPage(); }
    private void OnPageSizeChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var size)) return;
        pageSize = Math.Clamp(size, 10, 100);
        currentPage = 1;
        ApplyPage();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var latestKinds = await Documents.GetKindsAsync();
            kinds.Clear();
            kinds.AddRange(latestKinds);
            loaded = true;
            ApplyPage();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }
    private async Task OpenCreate() { editing = null; form.Reset(); if (modal is not null) await modal.Show(); }
    private async Task Edit(WorkflowKindDto item)
    {
        editing = item;
        form.Code = item.Code; form.Name = item.Name; form.Description = item.Description ?? ""; form.IsActive = item.IsActive;
        if (modal is not null) await modal.Show();
    }
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(form.Code) || string.IsNullOrWhiteSpace(form.Name))
        {
            await NotifyErrorAsync(L["Catalog:CodeNameRequired"]);
            return;
        }
        try
        {
            if (editing is null)
                await Documents.CreateKindAsync(new CreateWorkflowKindRequest(form.Code.Trim(), form.Name.Trim(), form.Description, form.IsActive));
            else
                await Documents.UpdateKindAsync(editing.Id, new UpdateWorkflowKindRequest(form.Name.Trim(), form.Description, form.IsActive));
            if (modal is not null) await modal.Hide();
            await NotifySuccessAsync(editing is null ? L["Catalog:Created"] : L["Catalog:Updated"]);
            await LoadAsync();
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task DeleteAsync(WorkflowKindDto item)
    {
        if (!await UiMessage.Confirm(string.Format(L["Catalog:DeleteConfirmation"], item.Name))) return;
        try { await Documents.DeleteKindAsync(item.Id); await NotifySuccessAsync(L["Catalog:Deleted"]); await LoadAsync(); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private sealed class KindForm
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool IsActive { get; set; } = true;
        public void Reset() { Code = Name = Description = ""; IsActive = true; }
    }
}
