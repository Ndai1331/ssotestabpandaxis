@page "/calendar-event-detail/{EventId:guid}"
@attribute [Authorize(Policy = "WorkManagement.Calendar")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject CollaborationClient Chat
@inject IUiMessageService UiMessage
@inject NavigationManager Navigation

<PageTitle>@L["Feature:EventDetail"] · HCS</PageTitle>
<section class="page page-wf page-vb">
    <form class="vb-card" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <header class="vb-chrome">
            <div class="vb-chrome-id">
                <a class="icon-btn" href="/calendar-events" aria-label="@L["Feature:BackToList"]">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 18 9 12l6-6"/></svg>
                </a>
                <div class="vb-editor-head">
                    <h1 title="@(item?.Title ?? L["Feature:EventDetail"].Value)">@(item?.Title ?? L["Feature:EventDetail"])</h1>
                    @if (item is not null)
                    {
                        <p class="vb-editor-sub">
                            <span>@item.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm") – @item.EndTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            <span class="badge badge-info">@item.Visibility</span>
                        </p>
                    }
                </div>
            </div>
            <div class="vb-chrome-actions">
                <div class="vb-foot">
                    @if (RelatedHref() is { } relatedHref)
                    {
                        <a class="btn btn-outline" href="@relatedHref">@L["Work:OpenRelated"]</a>
                    }
                    <a class="btn btn-outline" href="/calendar-events">@L["Feature:BackToList"]</a>
                </div>
            </div>
        </header>
        <div class="vb-shell">
            <div class="vb-main">
                @if (item is null)
                {
                    <DocsEmpty Loading="true" />
                }
                else
                {
                    <div class="hcs-catalog-form">
                        <Field><FieldLabel>@L["Feature:Event"]</FieldLabel><HcsIsolatedTextInput @bind-Value="form.Title" Name="hcsEventDetailTitle" Disabled="@(!item.CanManage)" /></Field>
                        <Field><FieldLabel>@L["Feature:Description"]</FieldLabel><textarea class="form-control" rows="3" @bind="form.Description" autocomplete="off" disabled="@(!item.CanManage)"></textarea></Field>
                        <Field><FieldLabel>@L["Feature:Visibility"]</FieldLabel>
                            <Select TValue="string" @bind-Value="form.Visibility" Disabled="@(!item.CanManage)">
                                <SelectItem Value="@("Private")">Private</SelectItem>
                                <SelectItem Value="@("Participants")">Participants</SelectItem>
                                <SelectItem Value="@("Public")">Public</SelectItem>
                            </Select>
                        </Field>
                        <Field><FieldLabel>@L["Chat:SelectContacts"]</FieldLabel>
                            @if (contacts.Count == 0)
                            {
                                <DocsEmpty Compact="true" Title="@L["Catalog:EmptyTitle"]" />
                            }
                            else
                            {
                                @foreach (var contact in contacts)
                                {
                                    <Check TValue="bool" Value="form.Participants.Contains(contact.Id)" ValueChanged="@((bool value) => Toggle(contact.Id, value))" Disabled="@(!item.CanManage)">@contact.DisplayName</Check>
                                }
                            }
                        </Field>
                        @if (item.CanManage)
                        {
                        <div class="vb-foot">
                            <button class="btn btn-outline" type="button" @onclick="DeleteAsync">@L["Catalog:Delete"]</button>
                            <button class="btn btn-primary" type="submit">@L["Catalog:SaveChanges"]</button>
                        </div>
                        }
                    </div>
                }
            </div>
        </div>
    </form>
</section>
@code {
    [Parameter] public Guid EventId { get; set; }
    private CalendarEventDto? item;
    private readonly EventForm form = new();
    private readonly List<HCS.CollaborationService.Contracts.ChatContactDto> contacts = [];

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            item = await Work.GetCalendarEventAsync(EventId);
            form.Title = item.Title; form.Description = item.Description ?? ""; form.Visibility = item.Visibility;
            form.Participants.Clear(); foreach (var id in item.ParticipantUserIds) form.Participants.Add(id);
            if (contacts.Count == 0) contacts.AddRange(await Chat.GetContactsAsync(null, 50));
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
    }

    private string? RelatedHref() => item is null ? null : WorkUi.RelatedEntityHref(item.RelatedType, item.RelatedId);
    private void Toggle(Guid id, bool selected)
    {
        if (item is null || !item.CanManage) return;
        if (selected) form.Participants.Add(id); else form.Participants.Remove(id);
    }
    private async Task SaveAsync()
    {
        if (item is null || !item.CanManage) return;
        try
        {
            item = await Work.UpdateCalendarEventAsync(EventId, new UpsertCalendarEventRequest(form.Title.Trim(), string.IsNullOrWhiteSpace(form.Description) ? null : form.Description, item.StartTime, item.EndTime, item.AllDay, item.EventType, item.Location, item.RelatedType, item.RelatedId, form.Visibility, form.Participants.ToList()));
            await NotifySuccessAsync(L["Catalog:Updated"]);
            Navigation.NavigateTo("/calendar-events");
        }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Save); }
    }
    private async Task DeleteAsync()
    {
        if (item is null || !item.CanManage) return;
        if (!await UiMessage.Confirm(L["Catalog:DeleteConfirmation"].Value)) return;
        try { await Work.DeleteCalendarEventAsync(EventId); Navigation.NavigateTo("/calendar-events"); }
        catch (Exception ex) { await NotifyErrorAsync(ex, BffErrorKind.Delete); }
    }
    private sealed class EventForm
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Visibility { get; set; } = "Private";
        public HashSet<Guid> Participants { get; } = [];
    }
}
