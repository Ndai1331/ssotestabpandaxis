@page "/employee-ratings/results/dashboard"
@page "/administration/employee-ratings-dashboard"
@attribute [Authorize(Policy = "WorkManagement.EmployeeRatings.Dashboard")]
@using HCS.Blazor.Client.Components.Charts
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject EmployeeRatingDirectoryService Directory

<PageTitle>@L["Menu:EmployeeRatingResults"] · HCS</PageTitle>

<section class="hcs-rating-page" aria-labelledby="employee-rating-dashboard-title">
    <header class="hcs-rating-page__header">
        <div>
            <p class="hcs-rating-page__kicker">@L["Menu:Social"]</p>
            <h1 id="employee-rating-dashboard-title">@L["Menu:EmployeeRatingResults"]</h1>
            <p class="hcs-rating-page__lede">@L["EmployeeRatings:DashboardSubtitle"]</p>
        </div>
    </header>

    <EmployeeRatingNav />

    @if (isLoading)
    {
        <HcsLoading CssClass="py-5" />
    }
    else if (hasError || dashboard is null)
    {
        <div class="hcs-empty py-5" role="alert"><i class="fa fa-circle-exclamation" aria-hidden="true"></i><h2>@L["EmployeeRatings:LoadErrorTitle"]</h2><p>@L["EmployeeRatings:LoadError"]</p><button class="btn btn-primary" type="button" @onclick="LoadAsync">@L["Catalog:Retry"]</button></div>
    }
    else
    {
        <div class="hcs-rating-kpi-grid mb-4">
            <div class="card hcs-rating-kpi"><div class="card-body"><span>@L["EmployeeRatings:EvaluatedEmployees"]</span><strong>@dashboard.EvaluatedEmployeeCount</strong></div></div>
            <div class="card hcs-rating-kpi"><div class="card-body"><span>@L["EmployeeRatings:CompanyAverage"]</span><strong><i class="fa fa-star" aria-hidden="true"></i> @dashboard.CompanyAverageScore.ToString("0.0")/5</strong></div></div>
            <div class="card hcs-rating-kpi"><div class="card-body"><span>@L["EmployeeRatings:CompletionRate"]</span><strong>@CompletionRate.ToString("0.#")%</strong><small>@dashboard.DistinctVoterCount / @directoryTotal @L["EmployeeRatings:Voters"]</small></div></div>
        </div>

        <div class="hcs-rating-dashboard-grid">
            <section class="card hcs-rating-panel hcs-rating-panel--wide" aria-labelledby="top-rated-title">
                <div class="card-body">
                    <h2 id="top-rated-title">@L["EmployeeRatings:TopFive"]</h2>
                    @if (TopRated.Count == 0)
                    {
                        <DocsEmpty Compact="true" Title="@L["EmployeeRatings:NoData"]" />
                    }
                    else
                    {
                        <BarChart ChartId="employee-rating-top-five" Labels="TopRatedLabels" Data="TopRatedData" Horizontal="true" MaxValue="5" YAxisLabel="@L["EmployeeRatings:Average"]" />
                        <div class="hcs-chart-data-table">
                            <table class="table table-sm mb-0"><caption>@L["EmployeeRatings:TopFive"]</caption><thead><tr><th>@L["EmployeeRatings:Employee"]</th><th>@L["EmployeeRatings:Average"]</th></tr></thead><tbody>@foreach (var item in TopRated) { <tr><td>@item.Name</td><td>@item.Score.ToString("0.0")/5</td></tr> }</tbody></table>
                        </div>
                    }
                </div>
            </section>
            <section class="card hcs-rating-panel" aria-labelledby="distribution-title">
                <div class="card-body">
                    <h2 id="distribution-title">@L["EmployeeRatings:Distribution"]</h2>
                    <PieChart ChartId="employee-rating-distribution" Labels="DistributionLabels" Data="DistributionData" IsDoughnut="true" Title="@L["EmployeeRatings:Distribution"]" />
                    <div class="hcs-chart-data-table">
                        <table class="table table-sm mb-0"><caption>@L["EmployeeRatings:Distribution"]</caption><thead><tr><th>@L["EmployeeRatings:Score"]</th><th>@L["EmployeeRatings:Reviews"]</th></tr></thead><tbody>@foreach (var item in DistributionRows) { <tr><td>@item.Label</td><td>@item.Count</td></tr> }</tbody></table>
                    </div>
                </div>
            </section>
            <section class="card hcs-rating-panel hcs-rating-panel--wide" aria-labelledby="department-title">
                <div class="card-body">
                    <h2 id="department-title">@L["EmployeeRatings:DepartmentComparison"]</h2>
                    @if (DepartmentRows.Count == 0)
                    {
                        <DocsEmpty Compact="true" Title="@L["EmployeeRatings:NoData"]" />
                    }
                    else
                    {
                        <LineChart ChartId="employee-rating-departments" Labels="DepartmentLabels" Data="DepartmentData" MaxValue="5" YAxisLabel="@L["EmployeeRatings:Average"]" />
                        <div class="hcs-chart-data-table">
                            <table class="table table-sm mb-0"><caption>@L["EmployeeRatings:DepartmentComparison"]</caption><thead><tr><th>@L["EmployeeRatings:Department"]</th><th>@L["EmployeeRatings:Average"]</th></tr></thead><tbody>@foreach (var item in DepartmentRows) { <tr><td>@item.Name</td><td>@item.Score.ToString("0.0")/5</td></tr> }</tbody></table>
                        </div>
                    }
                </div>
            </section>
        </div>
    }
</section>

@code {
    [Parameter] public string? Unused { get; set; }

    private readonly List<EmployeeRatingPerson> people = [];
    private EmployeeRatingDashboardDto? dashboard;
    private bool isLoading = true;
    private bool hasError;
    private long directoryTotal;

    private List<(string Name, decimal Score)> TopRated { get; set; } = [];
    private List<(string Name, decimal Score)> DepartmentRows { get; set; } = [];
    private List<(string Label, int Count)> DistributionRows { get; set; } = [];
    private List<string> TopRatedLabels => TopRated.Select(x => x.Name).ToList();
    private List<double> TopRatedData => TopRated.Select(x => (double)x.Score).ToList();
    private List<string> DepartmentLabels => DepartmentRows.Select(x => x.Name).ToList();
    private List<double> DepartmentData => DepartmentRows.Select(x => (double)x.Score).ToList();
    private List<string> DistributionLabels => DistributionRows.Select(x => x.Label).ToList();
    private List<double> DistributionData => DistributionRows.Select(x => (double)x.Count).ToList();
    private double CompletionRate => directoryTotal == 0 ? 0 : dashboard!.DistinctVoterCount * 100d / directoryTotal;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        hasError = false;
        try
        {
            var countTask = Directory.GetPeoplePageAsync(null, 0, 1);
            var dashboardTask = Work.GetEmployeeRatingDashboardAsync();
            await Task.WhenAll(countTask, dashboardTask);
            dashboard = await dashboardTask;
            directoryTotal = (await countTask).TotalCount;
            var ids = dashboard.EmployeeSummaries.Select(item => item.TargetUserId);
            people.Clear();
            people.AddRange(await Directory.GetPeopleByIdsAsync(ids));
            BuildCharts();
        }
        catch (Exception exception)
        {
            hasError = true;
            await NotifyErrorAsync(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BuildCharts()
    {
        var names = people.ToDictionary(x => x.User.UserId, x => x.User.DisplayName);
        TopRated = dashboard!.EmployeeSummaries
            .Where(x => names.ContainsKey(x.TargetUserId))
            .OrderByDescending(x => x.AverageScore).ThenByDescending(x => x.ReviewCount)
            .Take(5).Select(x => (names[x.TargetUserId], x.AverageScore)).ToList();

        DepartmentRows = dashboard.EmployeeSummaries
            .Where(x => names.ContainsKey(x.TargetUserId))
            .GroupBy(x =>
            {
                var department = people.First(person => person.User.UserId == x.TargetUserId).DepartmentName;
                return string.IsNullOrWhiteSpace(department) ? L["EmployeeRatings:NoDepartment"].Value : department;
            })
            .Select(group =>
            {
                var reviews = group.Sum(x => x.ReviewCount);
                return (Name: group.Key, Score: reviews == 0 ? 0 : group.Sum(x => x.AverageScore * x.ReviewCount) / reviews);
            })
            .OrderByDescending(x => x.Score).ToList();

        DistributionRows = Enumerable.Range(1, 5)
            .Select(score => (Label: $"{score} {L["EmployeeRatings:Stars"]}", Count: dashboard.ScoreDistribution.GetValueOrDefault(score)))
            .ToList();
    }
}
