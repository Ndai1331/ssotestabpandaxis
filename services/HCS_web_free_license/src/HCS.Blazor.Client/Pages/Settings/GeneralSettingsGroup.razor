@using HCS.Blazor.Client.Collaboration
@using HCS.Blazor.Client.Settings
@using HCS.Settings
@inherits HCSComponentBase
@inject SystemFeatureSettingsClient SettingsClient
@inject SystemFeatureState Features
@inject CollaborationClient Collaboration

<section class="hcs-general-settings" aria-labelledby="hcs-general-settings-title" aria-busy="@(isLoading || isSaving ? "true" : "false")">
    <h2 id="hcs-general-settings-title" class="sr-only">@L["Settings:GeneralGroup"]</h2>

    @if (isLoading)
    {
        <DocsEmpty Loading="true" Compact="true" Title="@L["Settings:GeneralLoading"]" />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="hcs-settings-alert" role="alert">
                <span>@errorMessage</span>
                <button class="btn btn-outline btn-sm" type="button" @onclick="LoadAsync" disabled="@isSaving">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                    @L["Settings:BrandingRetry"]
                </button>
            </div>
        }

        <div class="hcs-settings-section">
            <h3>@L["Settings:GeneralGroup"]</h3>
            <p>@L["Settings:GeneralDescription"]</p>
            <div class="hcs-settings-option">
                <div>
                    <h4>@L["Settings:AllowSigningFromDocuments"]</h4>
                    <p id="hcs-allow-signing-from-documents-description">@L["Settings:AllowSigningFromDocumentsDescription"]</p>
                </div>
                <button type="button"
                        class="hcs-settings-switch @(allowSigningFromDocuments ? "is-enabled" : null)"
                        aria-pressed="@(allowSigningFromDocuments ? "true" : "false")"
                        aria-describedby="hcs-allow-signing-from-documents-description"
                        @onclick="ToggleAllowSigningFromDocuments"
                        disabled="@isSaving">
                    <span class="hcs-settings-switch__track" aria-hidden="true">
                        <span class="hcs-settings-switch__thumb"></span>
                    </span>
                    <span>@(allowSigningFromDocuments ? L["Settings:AllowSigningFromDocumentsEnabled"] : L["Settings:AllowSigningFromDocumentsDisabled"])</span>
                </button>
            </div>
            <div class="hcs-settings-option">
                <div>
                    <h4>@L["Settings:ChatAttachmentMaxMegabytes"]</h4>
                    <p id="hcs-chat-attachment-max-description">@L["Settings:ChatAttachmentMaxMegabytesDescription"]</p>
                </div>
                <label class="hcs-settings-number" for="hcs-chat-attachment-max">
                    <span class="sr-only">@L["Settings:ChatAttachmentMaxMegabytes"]</span>
                    <input class="input"
                           id="hcs-chat-attachment-max"
                           type="number"
                           min="@HCSSettings.ChatAttachmentMaxMegabytesMin"
                           max="@HCSSettings.ChatAttachmentMaxMegabytesMax"
                           step="1"
                           value="@chatAttachmentMaxMegabytes"
                           aria-describedby="hcs-chat-attachment-max-description"
                           disabled="@isSaving"
                           @onchange="OnChatAttachmentMaxChanged" />
                    <span>@L["Settings:ChatAttachmentMaxMegabytesUnit"]</span>
                </label>
            </div>
        </div>

        @if (ShowActions)
        {
            <footer class="hcs-settings-footer">
                <p class="hcs-settings-hint" role="status">
                    @(allowSigningFromDocuments ? L["Settings:AllowSigningFromDocumentsStatusEnabled"] : L["Settings:AllowSigningFromDocumentsStatusDisabled"])
                </p>
                <div class="page-actions">
                    <button class="btn btn-primary" type="button" @onclick="SaveAsync" disabled="@(isSaving || !isDirty)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 3h11l5 5v13H5z"/><path d="M16 3v6H8V3M8 21v-7h8v7"/></svg>
                        @L["Settings:GeneralSave"]
                    </button>
                </div>
            </footer>
        }
    }
</section>

@code {
    [Parameter]
    public bool ShowActions { get; set; } = true;

    private bool isLoading = true;
    private bool isSaving;
    private bool isDirty;
    private bool allowSigningFromDocuments = true;
    private int chatAttachmentMaxMegabytes = HCSSettings.ChatAttachmentMaxMegabytesDefault;
    private string? errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var settings = await SettingsClient.GetAsync();
            allowSigningFromDocuments = settings.AllowSigningFromDocuments;
            chatAttachmentMaxMegabytes = HCSSettings.ClampChatAttachmentMaxMegabytes(settings.ChatAttachmentMaxMegabytes);
            Features.Apply(settings);
            isDirty = false;
        }
        catch (Exception exception)
        {
            errorMessage = MapBffError(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnChatAttachmentMaxChanged(ChangeEventArgs args)
    {
        if (isSaving)
        {
            return;
        }

        if (int.TryParse(Convert.ToString(args.Value), out var value))
        {
            chatAttachmentMaxMegabytes = value;
        }

        isDirty = true;
        errorMessage = null;
    }

    private void ToggleAllowSigningFromDocuments()
    {
        if (!isSaving)
        {
            allowSigningFromDocuments = !allowSigningFromDocuments;
            isDirty = true;
            errorMessage = null;
        }
    }

    internal async Task<bool> TrySaveAsync()
    {
        if (isSaving)
        {
            return false;
        }

        if (!isDirty)
        {
            return true;
        }

        isSaving = true;
        errorMessage = null;
        try
        {
            var megabytes = HCSSettings.ClampChatAttachmentMaxMegabytes(chatAttachmentMaxMegabytes);
            chatAttachmentMaxMegabytes = megabytes;
            await SettingsClient.UpdateGeneralAsync(new UpdateGeneralSettingsDto
            {
                AllowSigningFromDocuments = allowSigningFromDocuments,
                ChatAttachmentMaxMegabytes = megabytes
            });
            await Collaboration.UpdateAttachmentPolicyAsync(megabytes);
            await Features.RefreshAsync();
            isDirty = false;
            return true;
        }
        catch (Exception exception)
        {
            errorMessage = MapBffError(exception, BffErrorKind.Save);
            return false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveAsync()
    {
        if (await TrySaveAsync() && ShowActions)
        {
            await NotifySuccessAsync(L["Settings:GeneralSaved"]);
        }
    }
}
