@using HCS.Blazor.Client.Pages
@using HCS.Blazor.Client.Settings
@using HCS.Settings
@inherits HCSComponentBase
@inject AuthenticationSettingsClient SettingsClient
@inject IdentityAdminClient IdentityClient

<section class="hcs-auth-settings" aria-labelledby="hcs-sso-login-settings-title" aria-busy="@(isLoading || isBusy ? "true" : "false")">
    <h2 id="hcs-sso-login-settings-title" class="sr-only">@L["Settings:SsoLoginGroup"]</h2>

    @if (isLoading)
    {
        <DocsEmpty Loading="true" Compact="true" Title="@L["Settings:SsoLoginLoading"]" />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="hcs-settings-alert" role="alert">
                <span>@errorMessage</span>
                <button class="btn btn-outline btn-sm" type="button" @onclick="LoadAsync" disabled="@isBusy">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.3"/><path d="M21 3v6h-6"/></svg>
                    @L["Settings:SsoLoginRetry"]
                </button>
            </div>
        }

        <div class="hcs-settings-section">
            <h3>@L["Settings:SsoSectionSignIn"]</h3>
            <p>@L["Settings:SsoSectionSignInDescription"]</p>
            @OptionRow(
                L["Settings:SsoEnabled"],
                L["Settings:SsoEnabledDescription"],
                "hcs-sso-enabled-description",
                enabled,
                L["Settings:SsoEnabledOn"],
                L["Settings:SsoEnabledOff"],
                EventCallback.Factory.Create(this, ToggleEnabled))
            @OptionRow(
                L["Settings:SsoLoginButton"],
                L["Settings:SsoLoginButtonDescription"],
                "hcs-sso-login-settings-description",
                showSsoLoginButton,
                L["Settings:SsoLoginButtonEnabled"],
                L["Settings:SsoLoginButtonDisabled"],
                EventCallback.Factory.Create(this, ToggleSsoLoginButton))
        </div>

        <div class="hcs-settings-section">
            <h3>@L["Settings:SsoSectionConnection"]</h3>
            <div class="hcs-settings-grid">
                <div class="field field--wide">
                    <label class="field-label" for="sso-base-url">@L["Settings:SsoBaseUrl"]</label>
                    <input id="sso-base-url" class="input" @bind="baseUrl" placeholder="https://sso-hcs.htltech.vn" autocomplete="off" spellcheck="false" disabled="@isBusy" />
                    <p class="hcs-settings-hint">@L["Settings:SsoBaseUrlHint"]</p>
                </div>
                <div class="field">
                    <label class="field-label" for="sso-realm">@L["Settings:SsoRealm"]</label>
                    <input id="sso-realm" class="input" @bind="realm" placeholder="@KeycloakSettingDefaults.Realm" autocomplete="off" disabled="@isBusy" />
                    <p class="hcs-settings-hint">@L["Settings:SsoRealmHint"]</p>
                </div>
                <div class="field">
                    <label class="field-label" for="sso-client-id">@L["Settings:SsoClientId"]</label>
                    <input id="sso-client-id" class="input" @bind="clientId" placeholder="@KeycloakSettingDefaults.ClientId" autocomplete="off" disabled="@isBusy" />
                    <p class="hcs-settings-hint">@L["Settings:SsoClientIdHint"]</p>
                </div>
                <div class="field">
                    <label class="field-label" for="sso-client-secret">@L["Settings:SsoClientSecret"]</label>
                    <input id="sso-client-secret"
                           class="input"
                           type="password"
                           @bind="clientSecret"
                           autocomplete="new-password"
                           placeholder="@(hasClientSecret ? L["Settings:SsoSecretConfigured"].Value : null)"
                           disabled="@isBusy" />
                    <p class="hcs-settings-hint">@L["Settings:SsoSecretHint"]</p>
                </div>
                <div class="field">
                    <label class="field-label" for="sso-admin-user">@L["Settings:SsoAdminUser"]</label>
                    <input id="sso-admin-user" class="input" @bind="adminUser" autocomplete="off" disabled="@isBusy" />
                    <p class="hcs-settings-hint">@L["Settings:SsoAdminUserHint"]</p>
                </div>
                <div class="field">
                    <label class="field-label" for="sso-admin-secret">@L["Settings:SsoAdminSecret"]</label>
                    <input id="sso-admin-secret"
                           class="input"
                           type="password"
                           @bind="adminSecret"
                           autocomplete="new-password"
                           placeholder="@(hasAdminSecret ? L["Settings:SsoSecretConfigured"].Value : null)"
                           disabled="@isBusy" />
                    <p class="hcs-settings-hint">@L["Settings:SsoAdminSecretHint"]</p>
                </div>
            </div>
        </div>

        <div class="hcs-settings-section">
            <h3>@L["Settings:SsoSectionSecurity"]</h3>
            @OptionRow(
                L["Settings:SsoRequireHttps"],
                L["Settings:SsoRequireHttpsDescription"],
                "hcs-sso-https-description",
                requireHttpsMetadata,
                L["Settings:SsoRequireHttpsOn"],
                L["Settings:SsoRequireHttpsOff"],
                EventCallback.Factory.Create(this, ToggleRequireHttps))
        </div>

        <div class="hcs-settings-section">
            <h3>@L["Settings:SsoRoleMappings"]</h3>
            <p>@L["Settings:SsoRoleMappingsDescription"]</p>
            <div class="field">
                <label class="field-label" for="sso-app-access-group">@L["Settings:SsoAppAccessGroup"]</label>
                <input id="sso-app-access-group" class="input" @bind="appAccessGroup" placeholder="@KeycloakSettingDefaults.AppAccessGroup" autocomplete="off" disabled="@isBusy" />
                <p class="hcs-settings-hint">@L["Settings:SsoAppAccessGroupHint"]</p>
            </div>
            <div class="hcs-auth-settings__table-wrap">
                <table class="hcs-auth-settings__table">
                    <thead>
                        <tr>
                            <th scope="col">@L["Settings:SsoMappingGroup"]</th>
                            <th scope="col">@L["Settings:SsoMappingRole"]</th>
                            <th scope="col"><span class="sr-only">@L["Settings:SsoMappingRemove"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var index = 0; index < mappings.Count; index++)
                        {
                            var row = index;
                            <tr @key="@row">
                                <td>
                                    <input class="input"
                                           value="@mappings[row].Group"
                                           @oninput="e => SetMappingGroup(row, e.Value?.ToString() ?? string.Empty)"
                                           placeholder="@L["Settings:SsoMappingGroupPlaceholder"]"
                                           autocomplete="off"
                                           disabled="@isBusy" />
                                </td>
                                <td>
                                    <select class="select"
                                            value="@RoleValue(row)"
                                            @onchange="e => SetMappingRole(row, e.Value?.ToString())"
                                            disabled="@isBusy"
                                            aria-label="@L["Settings:SsoMappingRole"]">
                                        <option value="">@L["Settings:SsoMappingRolePlaceholder"]</option>
                                        @foreach (var role in roleOptions)
                                        {
                                            <option value="@role">@RoleLabel(role)</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <div class="doc-actions">
                                        <button class="doc-action is-danger"
                                                type="button"
                                                title="@L["Settings:SsoMappingRemove"]"
                                                aria-label="@L["Settings:SsoMappingRemove"]"
                                                @onclick="() => RemoveMapping(row)"
                                                disabled="@isBusy">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="page-actions hcs-auth-settings__add">
                <button class="btn btn-outline btn-sm" type="button" @onclick="AddMapping" disabled="@isBusy">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    @L["Settings:SsoMappingAdd"]
                </button>
            </div>
        </div>

        <footer class="hcs-settings-footer">
            <p class="hcs-settings-hint" role="status" aria-live="polite">
                @(enabled
                    ? (showSsoLoginButton ? L["Settings:SsoLoginStatusEnabled"] : L["Settings:SsoLoginStatusDisabled"])
                    : L["Settings:SsoEnabledStatusOff"])
            </p>
            <div class="page-actions">
                <button class="btn btn-outline" type="button" @onclick="TestAsync" disabled="@isBusy">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 12A10 10 0 1 1 12 2"/><path d="M22 2v6h-6"/><path d="m8 12 2.5 2.5L16 9"/></svg>
                    @L["Settings:SsoTest"]
                </button>
                <button class="btn btn-primary" type="button" @onclick="SaveAsync" disabled="@isBusy">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 3h11l5 5v13H5z"/><path d="M16 3v6H8V3M8 21v-7h8v7"/></svg>
                    @L["Settings:SsoLoginSave"]
                </button>
            </div>
        </footer>
    }
</section>

@code {
    private bool isLoading = true;
    private bool isBusy;
    private bool enabled;
    private bool showSsoLoginButton = true;
    private bool requireHttpsMetadata = true;
    private bool hasClientSecret;
    private bool hasAdminSecret;
    private string baseUrl = string.Empty;
    private string realm = KeycloakSettingDefaults.Realm;
    private string clientId = KeycloakSettingDefaults.ClientId;
    private string clientSecret = string.Empty;
    private string adminUser = string.Empty;
    private string adminSecret = string.Empty;
    private string appAccessGroup = KeycloakSettingDefaults.AppAccessGroup;
    private List<KeycloakRoleMapping> mappings = [.. KeycloakSettingDefaults.RoleMappings];
    private List<string> roleOptions = [.. DefaultRoleNames];
    private string? errorMessage;

    private static readonly string[] DefaultRoleNames =
        KeycloakSettingDefaults.RoleMappings
            .Select(mapping => mapping.Role)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    protected override Task OnInitializedAsync() => LoadAsync();

    private RenderFragment OptionRow(
        string title,
        string description,
        string describedBy,
        bool isOn,
        string onLabel,
        string offLabel,
        EventCallback clicked) => __builder =>
    {
        <div class="hcs-settings-option">
            <div>
                <h4>@title</h4>
                <p id="@describedBy">@description</p>
            </div>
            <button type="button"
                    class="hcs-settings-switch @(isOn ? "is-enabled" : null)"
                    aria-pressed="@(isOn ? "true" : "false")"
                    aria-describedby="@describedBy"
                    disabled="@isBusy"
                    @onclick="clicked">
                <span class="hcs-settings-switch__track" aria-hidden="true">
                    <span class="hcs-settings-switch__thumb"></span>
                </span>
                <span>@(isOn ? onLabel : offLabel)</span>
            </button>
        </div>
    };

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var settings = await SettingsClient.GetAsync();
            Apply(settings);
            await LoadRoleOptionsAsync();
        }
        catch (Exception exception)
        {
            errorMessage = MapBffError(exception);
            ApplyRoleOptions(DefaultRoleNames);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadRoleOptionsAsync()
    {
        var names = new HashSet<string>(DefaultRoleNames, StringComparer.OrdinalIgnoreCase);
        try
        {
            var result = await IdentityClient.GetRolesAsync(maxResultCount: 200);
            foreach (var role in result.Items ?? [])
            {
                if (!string.IsNullOrWhiteSpace(role.Name))
                {
                    names.Add(role.Name.Trim());
                }
            }
        }
        catch
        {
            // Keep default HCS roles if identity lookup is unavailable.
        }

        ApplyRoleOptions(names);
    }

    private void ApplyRoleOptions(IEnumerable<string> names)
    {
        var options = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var name in names)
        {
            if (!string.IsNullOrWhiteSpace(name))
            {
                options.Add(name.Trim());
            }
        }

        foreach (var mapping in mappings)
        {
            if (!string.IsNullOrWhiteSpace(mapping.Role))
            {
                options.Add(mapping.Role.Trim());
            }
        }

        roleOptions = options
            .OrderBy(name =>
            {
                var index = Array.FindIndex(
                    DefaultRoleNames,
                    role => string.Equals(role, name, StringComparison.OrdinalIgnoreCase));
                return index >= 0 ? index : int.MaxValue;
            })
            .ThenBy(name => name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string RoleValue(int index) =>
        index >= 0 && index < mappings.Count ? mappings[index].Role ?? string.Empty : string.Empty;

    private string RoleLabel(string role)
    {
        if (string.IsNullOrWhiteSpace(role))
        {
            return L["Settings:SsoMappingRolePlaceholder"];
        }

        var key = $"Settings:SsoRole.{role}";
        var localized = L[key];
        return localized.ResourceNotFound || string.Equals(localized.Value, key, StringComparison.Ordinal)
            ? role
            : localized.Value;
    }

    private void Apply(AuthenticationSettingsDto settings)
    {
        enabled = settings.Enabled;
        showSsoLoginButton = settings.ShowSsoLoginButton;
        requireHttpsMetadata = settings.RequireHttpsMetadata;
        hasClientSecret = settings.HasClientSecret;
        hasAdminSecret = settings.HasAdminSecret;
        baseUrl = settings.BaseUrl ?? string.Empty;
        realm = string.IsNullOrWhiteSpace(settings.Realm) ? KeycloakSettingDefaults.Realm : settings.Realm;
        clientId = string.IsNullOrWhiteSpace(settings.ClientId) ? KeycloakSettingDefaults.ClientId : settings.ClientId;
        clientSecret = string.Empty;
        adminUser = settings.AdminUser ?? string.Empty;
        adminSecret = string.Empty;
        appAccessGroup = string.IsNullOrWhiteSpace(settings.AppAccessGroup)
            ? KeycloakSettingDefaults.AppAccessGroup
            : settings.AppAccessGroup;
        mappings = settings.RoleMappings is { Count: > 0 }
            ? settings.RoleMappings.Select(mapping => new KeycloakRoleMapping { Group = mapping.Group, Role = mapping.Role }).ToList()
            : [.. KeycloakSettingDefaults.RoleMappings];
    }

    private void ToggleEnabled()
    {
        if (!isBusy)
        {
            enabled = !enabled;
            errorMessage = null;
        }
    }

    private void ToggleSsoLoginButton()
    {
        if (!isBusy)
        {
            showSsoLoginButton = !showSsoLoginButton;
            errorMessage = null;
        }
    }

    private void ToggleRequireHttps()
    {
        if (!isBusy)
        {
            requireHttpsMetadata = !requireHttpsMetadata;
            errorMessage = null;
        }
    }

    private void AddMapping()
    {
        mappings.Add(new KeycloakRoleMapping());
    }

    private void RemoveMapping(int index)
    {
        if (index >= 0 && index < mappings.Count)
        {
            mappings.RemoveAt(index);
        }
    }

    private void SetMappingGroup(int index, string value)
    {
        if (index >= 0 && index < mappings.Count)
        {
            mappings[index].Group = value;
        }
    }

    private void SetMappingRole(int index, string? value)
    {
        if (index >= 0 && index < mappings.Count)
        {
            mappings[index].Role = value ?? string.Empty;
        }
    }

    private UpdateAuthenticationSettingsDto CreateInput() => new()
    {
        ShowSsoLoginButton = showSsoLoginButton,
        Enabled = enabled,
        BaseUrl = baseUrl,
        Realm = realm,
        ClientId = clientId,
        ClientSecret = clientSecret,
        RequireHttpsMetadata = requireHttpsMetadata,
        AdminUser = adminUser,
        AdminSecret = adminSecret,
        AppAccessGroup = appAccessGroup,
        RoleMappings = mappings.Select(mapping => new KeycloakRoleMapping { Group = mapping.Group, Role = mapping.Role }).ToList()
    };

    private async Task TestAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            var result = await SettingsClient.TestAsync(CreateInput());
            if (result.Success)
            {
                await NotifySuccessAsync(result.Message ?? L["Settings:SsoTestDiscoveryOk"]);
            }
            else
            {
                errorMessage = result.Message ?? L["Settings:SsoTestDiscoveryFailed"];
            }
        }
        catch (Exception exception)
        {
            errorMessage = MapBffError(exception);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            await SettingsClient.UpdateAsync(CreateInput());
            hasClientSecret = hasClientSecret || !string.IsNullOrWhiteSpace(clientSecret);
            hasAdminSecret = hasAdminSecret || !string.IsNullOrWhiteSpace(adminSecret);
            clientSecret = string.Empty;
            adminSecret = string.Empty;
            await NotifySuccessAsync(L["Settings:SsoLoginSaved"]);
        }
        catch (Exception exception)
        {
            errorMessage = MapBffError(exception, BffErrorKind.Save);
        }
        finally
        {
            isBusy = false;
        }
    }
}
