@page "/social"
@page "/social/profile"
@using Microsoft.AspNetCore.Components.Routing
@using HCS.Blazor.Client.Account
@using System.Threading
@using System.IO
@using System.Text.RegularExpressions
@attribute [Authorize(Policy = CollaborationPermissions.Social)]
@inherits HCSComponentBase
@inject SocialClient Social
@inject AccountProfileClient Account
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>@(isProfile ? L["Social:ProfileTitle"] : L["Social:Title"]) · HCS</PageTitle>

<section class="hcs-social-page page-social" aria-label='@(isProfile ? L["Social:ProfileTitle"] : L["Social:Title"])'>
    <div class="social-wrap" @onclick="ClosePostMenu">
    @if (!isProfile)
    {
        <div class="page-head social-feed-head">
            <div>
                <p class="social-kicker">@L["Social:Subtitle"]</p>
                <h1 id="social-title">@L["Social:Title"]</h1>
            </div>
            <div class="page-actions">
                <a class="btn btn-primary" href="/social/profile">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
                    @L["Social:OpenProfile"]
                </a>
            </div>
        </div>
    }

    @if (isProfile && myProfile is { } profile)
    {
        <section class="social-cover hcs-social-profile-card hcs-social-profile-card--top" aria-labelledby="social-my-profile-title">
            <div class="social-cover-bar hcs-social-profile-card__cover">
                <a class="btn btn-cover hcs-social-profile-card__back" href="/social">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 11 12 4l8 7"/><path d="M6 10v9h12v-9"/></svg>
                    @L["Social:BackToFeed"]
                </a>
            </div>
            <div class="social-cover-body hcs-social-profile-card__content">
                @SocialAvatar(profile.UserId, profile.DisplayName, profile.AvatarUrl, "hcs-social-avatar--profile social-cover-avatar")
                <div class="social-cover-meta hcs-social-profile-card__identity">
                    <h1 id="social-my-profile-title">@profile.DisplayName</h1>
                    <p class="social-handle hcs-social-profile-card__username">@@@profile.UserName</p>
                    <ul class="social-contact hcs-social-profile-card__meta">
                        <li>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            @L["Social:Position"]: <span>@(profile.PositionName ?? L["Social:NoProfileValue"])</span>
                        </li>
                        @if (!string.IsNullOrWhiteSpace(profile.DepartmentName))
                        {
                            <li>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 21V8l8-4 8 4v13"/><path d="M9 21v-6h6v6"/></svg>
                                @L["Social:Department"]: <span>@profile.DepartmentName</span>
                            </li>
                        }
                        <li>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6.5 4h3l1.5 4-2 1.2a12 12 0 0 0 5.8 5.8L16 13l4 1.5v3A16 16 0 0 1 6.5 4z"/></svg>
                            @L["Social:Phone"]: <span>@(profile.PhoneNumber ?? L["Social:NoProfileValue"])</span>
                        </li>
                        <li>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
                            @L["Social:Email"]:
                            @if (!string.IsNullOrWhiteSpace(profile.Email))
                            {
                                <a href="mailto:@profile.Email">@profile.Email</a>
                            }
                            else
                            {
                                <span>@L["Social:NoProfileValue"]</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </section>
    }

    <div class="social-toolbar card @(isChangingVisibility ? "is-loading" : null)">
        <div class="social-toolbar-main">
            <span class="social-toolbar-label">@L["Social:ViewLabel"]</span>
            <div class="social-pills" role="tablist" aria-label='@L["Social:ViewLabel"]' aria-busy="@(isChangingVisibility)">
                @if (isProfile)
                {
                    <button type="button" class="social-pill @(IsVisibilitySelected(null) ? "is-active" : null)"
                            role="tab" aria-selected="@IsVisibilitySelected(null)" @onclick="() => SelectVisibilityAsync(null)"
                            disabled="@(isLoading || isChangingVisibility)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M16 11a3 3 0 1 0-4-5 3 3 0 0 0 4 5z"/><path d="M8 14a3 3 0 1 0-4-5 3 3 0 0 0 4 5z"/><path d="M20 20a5 5 0 0 0-8 0"/><path d="M12 20a5 5 0 0 0-8 0"/></svg>
                        @L["Social:All"]
                    </button>
                }
                <button type="button" class="social-pill @(IsVisibilitySelected(SocialPostVisibility.Public) ? "is-active" : null)"
                        role="tab" aria-selected="@IsVisibilitySelected(SocialPostVisibility.Public)" @onclick="() => SelectVisibilityAsync(SocialPostVisibility.Public)"
                        disabled="@(isLoading || isChangingVisibility)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 3 3.8 6 3.8 9S14.5 18 12 21c-2.5-3-3.8-6-3.8-9S9.5 6 12 3z"/></svg>
                    @L["Social:Public"]
                </button>
                <button type="button" class="social-pill @(IsVisibilitySelected(SocialPostVisibility.Internal) ? "is-active" : null)"
                        role="tab" aria-selected="@IsVisibilitySelected(SocialPostVisibility.Internal)" @onclick="() => SelectVisibilityAsync(SocialPostVisibility.Internal)"
                        title='@L["Social:InternalHint"]' disabled="@(isLoading || isChangingVisibility)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                    @L["Social:Internal"]
                </button>
                @if (isChangingVisibility)
                {
                    <span class="social-toolbar-status" role="status" aria-live="polite">
                        @SocialSpinner()
                        <span>@L["Social:Loading"]</span>
                    </span>
                }
            </div>
            <button class="icon-btn social-search-toggle @(HasSearchFilters() ? "is-filtered" : null)" type="button"
                    aria-expanded="@searchOpen.ToString().ToLowerInvariant()" aria-controls="social-search-form"
                    aria-label='@L["Social:Search"]' @onclick="ToggleSearchPanel">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
            </button>
        </div>

        <form id="social-search-form" class="social-search-form hcs-social-search" hidden="@(!searchOpen)" @onsubmit="ApplySearchAsync" @onsubmit:preventDefault>
            <div class="social-search-head hcs-social-search__heading">
                <h2 id="social-search-title" class="sr-only">@L["Social:SearchTitle"]</h2>
                <div class="social-search-modes hcs-social-search__modes" role="tablist" aria-label='@L["Social:SearchTitle"]'>
                    <button type="button" class="social-mode hcs-social-search__mode @(!peopleSearchMode ? "is-active" : null)"
                            role="tab" aria-selected="@(!peopleSearchMode)" @onclick="() => SelectSearchMode(false)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16v10H7l-3 3V6z"/></svg>
                        @L["Social:SearchTitle"]
                    </button>
                    <button type="button" class="social-mode hcs-social-search__mode @(peopleSearchMode ? "is-active" : null)"
                            role="tab" aria-selected="@peopleSearchMode" @onclick="() => SelectSearchMode(true)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
                        @L["Social:PeopleSearch"]
                    </button>
                </div>
            </div>
            <div class="social-search-row">
                <div class="social-search-fields">
                    <div class="field hcs-social-search__field hcs-social-search__field--keyword">
                        <label class="field-label" for="social-search-keyword">@(peopleSearchMode ? L["Social:PeopleSearch"] : L["Social:Keyword"])</label>
                        <input id="social-search-keyword" class="input" @bind="keywordInput"
                               placeholder='@(peopleSearchMode ? L["Social:PeopleSearchPlaceholder"] : L["Social:KeywordPlaceholder"])' autocomplete="off" />
                    </div>
                    @if (!peopleSearchMode)
                    {
                        <div class="field hcs-social-search__field">
                            <label class="field-label" for="social-search-hashtag">@L["Social:Hashtag"]</label>
                            <input id="social-search-hashtag" class="input" @bind="hashtagInput"
                                   placeholder="#hcs" autocomplete="off" />
                        </div>
                    }
                </div>
                <div class="social-search-actions hcs-social-search__actions">
                    <button class="btn btn-primary social-search-btn hcs-social-search__submit" type="submit">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                        @L["Social:Search"]
                    </button>
                    @if (!peopleSearchMode)
                    {
                        <button class="btn btn-ghost hcs-social-search__clear" type="button" @onclick="ClearSearchAsync"
                                disabled="@(!HasSearchFilters())">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                            @L["Social:ClearSearch"]
                        </button>
                    }
                </div>
            </div>
        </form>
    </div>
    @if (!string.IsNullOrWhiteSpace(searchError))
    {
        <p class="social-inline-error" role="alert">@SocialWarningIcon()@searchError</p>
    }

    <div class="social-split hcs-social-layout">
        <div class="social-main hcs-social-stream">
            @if (peopleSearchMode && peopleSearchExecuted)
            {
                <section class="people-grid hcs-social-people-results" aria-labelledby="social-people-results-title">
                    <h2 id="social-people-results-title" class="sr-only">@L["Social:PeopleResults"]</h2>
                    @if (isSearchingPeople)
                    {
                        <p class="social-empty" role="status">@SocialSpinner()@L["Social:Loading"]</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(peopleSearchError))
                    {
                        <p class="social-inline-error" role="alert">@peopleSearchError</p>
                    }
                    else if (people.Count == 0)
                    {
                        <p class="social-empty">@L["Social:PeopleEmpty"]</p>
                    }
                    else
                    {
                        @foreach (var person in people)
                        {
                            <article class="people-card">
                                @SocialAvatar(person.UserId, person.DisplayName, person.AvatarUrl)
                                <span>
                                    <strong>@person.DisplayName</strong>
                                    <span>@(person.PositionName ?? L["Social:NoProfileValue"])</span>
                                    @if (!string.IsNullOrWhiteSpace(person.DepartmentName))
                                    {
                                        <span>@person.DepartmentName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(person.Email))
                                    {
                                        <a href="mailto:@person.Email">@person.Email</a>
                                    }
                                </span>
                            </article>
                        }
                    }
                </section>
            }
            <section class="card social-composer hcs-social-composer" aria-labelledby="social-composer-title">
                <div class="social-composer-head hcs-social-card-heading">
                    @SocialAvatar(currentUserId ?? Guid.Empty, CurrentDisplayName(), null, "hcs-social-avatar--accent chat-avatar")
                    <div>
                        <h2 id="social-composer-title">@L["Social:ComposerTitle"]</h2>
                        <p>@L["Social:ContentLabel"]</p>
                    </div>
                </div>
                <form class="hcs-social-composer__form" @onsubmit="CreatePostAsync" @onsubmit:preventDefault>
                    <label class="sr-only" for="social-content">@L["Social:ContentLabel"]</label>
                    <textarea id="social-content" class="input social-textarea" rows="3" @bind="content" @bind:event="oninput"
                              placeholder='@L["Social:ContentPlaceholder"]' disabled="@isPosting"></textarea>
                    <div class="social-composer-foot hcs-social-composer__controls">
                        <label class="vis-switch" for="social-visibility-toggle">
                            <input id="social-visibility-toggle" class="vis-switch-input" type="checkbox"
                                   checked="@(visibility == SocialPostVisibility.Internal)"
                                   @onchange="OnComposerVisibilityToggle"
                                   disabled="@isPosting" aria-label='@L["Social:VisibilityLabel"]' />
                            <span class="vis-switch-track" aria-hidden="true"><span class="vis-switch-thumb"></span></span>
                            <span class="vis-switch-text">@(visibility == SocialPostVisibility.Internal ? L["Social:Internal"] : L["Social:Public"])</span>
                        </label>
                    <label class="btn btn-ghost social-media-picker" for="social-media">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="m21 15-4.5-4.5L7 20"/></svg>
                        @L["Social:ChooseMedia"]
                        <InputFile id="social-media" class="sr-only" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm"
                                   multiple OnChange="UploadMediaAsync" disabled="@(isPosting || isUploadingMedia)" />
                    </label>
                    <button class="btn btn-primary hcs-social-submit" type="submit" disabled="@(isPosting || isUploadingMedia || (string.IsNullOrWhiteSpace(content) && uploadedMedia.Count == 0))">
                        @if (isPosting)
                        {
                            @SocialSpinner()
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                        }
                        @(isPosting ? L["Social:Posting"] : L["Social:Post"])
                    </button>
                    </div>
                </form>
                @if (isUploadingMedia)
                {
                    <p class="social-progress" role="status">@SocialSpinner()@L["Social:Posting"]</p>
                }
                @if (uploadedMedia.Count > 0)
                {
                    <div class="social-selected-media" aria-label='@L["Social:SelectedMedia"]'>
                        @foreach (var media in uploadedMedia)
                        {
                            <span class="social-media-chip">
                                @if (media.Kind == SocialMediaKind.Video)
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10 9 6 4-6 4V9z"/></svg>
                                }
                                else
                                {
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="m21 15-4.5-4.5L7 20"/></svg>
                                }
                                <span>@media.FileName</span>
                                <button type="button" class="icon-btn" title='@L["Social:RemoveMedia"]' aria-label='@L["Social:RemoveMedia"] @media.FileName'
                                        @onclick="() => RemoveMediaAsync(media)" disabled="@isPosting">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                                </button>
                            </span>
                        }
                    </div>
                }
            </section>

            @if (!(peopleSearchMode && peopleSearchExecuted))
            {
            @if (isLoading || isChangingVisibility)
            {
                <div class="social-empty" role="status">
                    @SocialSpinner()@L["Social:Loading"]
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="social-empty social-empty--error" role="alert">
                    @SocialWarningIcon()
                    <span>@loadError</span>
                    <button class="btn btn-ghost" type="button" @onclick="LoadAsync">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 2l-2 2m-7.5 7.5 6-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 16l-2 2m7.5-7.5-6 6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
                        @L["Chat:Retry"]
                    </button>
                </div>
            }
            else if (posts.Count == 0)
            {
                <p class="social-empty">
                    @(isProfile ? L["Social:EmptyProfile"] : L["Social:EmptyFeed"])
                </p>
            }
            else
            {
                <div class="social-stream">
                @foreach (var post in posts)
                {
                    <article class="post-card hcs-social-post" aria-labelledby="post-@post.Id">
                        <header class="post-head hcs-social-post__header">
                            @SocialAvatar(post.AuthorUserId, post.AuthorName, post.AvatarUrl, "chat-avatar")
                            <div class="post-meta hcs-social-post__author">
                                <a class="post-author" id="post-@post.Id">@post.AuthorName</a>
                                <p>
                                    <time datetime="@post.CreatedAt.ToString("O")" title="@post.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")">
                                        @post.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </time>
                                    ·
                                    <span class="post-vis @(post.Visibility == SocialPostVisibility.Internal ? "is-internal" : "is-public") hcs-social-visibility-badge @(post.Visibility == SocialPostVisibility.Internal ? "is-internal" : null)"
                                          title="@(post.Visibility == SocialPostVisibility.Internal ? L["Social:Internal"] : L["Social:Public"])"
                                          aria-label="@(post.Visibility == SocialPostVisibility.Internal ? L["Social:Internal"] : L["Social:Public"])">
                                        @if (post.Visibility == SocialPostVisibility.Internal)
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                        }
                                    </span>
                                </p>
                            </div>
                            @if (IsOwnPost(post))
                            {
                                <div class="post-more @(postMenuId == post.Id ? "is-open" : null)" @onclick:stopPropagation="true">
                                    <button class="icon-btn post-more-toggle" type="button"
                                            aria-haspopup="true" aria-expanded="@(postMenuId == post.Id ? "true" : "false")"
                                            aria-label='@L["Social:PostActions"]'
                                            title='@L["Social:PostActions"]'
                                            @onclick="() => TogglePostMenu(post.Id)"
                                            disabled="@(isUpdatingPost || deletingPostId == post.Id)">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                            <circle cx="5" cy="12" r="1.7"/>
                                            <circle cx="12" cy="12" r="1.7"/>
                                            <circle cx="19" cy="12" r="1.7"/>
                                        </svg>
                                    </button>
                                    @if (postMenuId == post.Id)
                                    {
                                        <div class="post-more-menu" role="menu">
                                            <button type="button" class="post-more-item" role="menuitem" @onclick="() => BeginEditPost(post)"
                                                    disabled="@(isUpdatingPost || deletingPostId == post.Id)">
                                                <span class="post-more-icon" aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                                </span>
                                                <span>@L["Social:Edit"]</span>
                                            </button>
                                            <button type="button" class="post-more-item is-danger" role="menuitem" @onclick="() => AskDeletePost(post)"
                                                    disabled="@(isUpdatingPost || deletingPostId == post.Id)">
                                                <span class="post-more-icon" aria-hidden="true">
                                                    @if (deletingPostId == post.Id)
                                                    {
                                                        @SocialSpinner()
                                                    }
                                                    else
                                                    {
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16"/><path d="M10 11v6M14 11v6"/><path d="M6 7l1 14h10l1-14"/><path d="M9 7V4h6v3"/></svg>
                                                    }
                                                </span>
                                                <span>@L["Social:Delete"]</span>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </header>

                        @if (editingPostId == post.Id)
                        {
                            <form class="social-post-edit" @onsubmit="() => UpdatePostAsync(post)" @onsubmit:preventDefault>
                                <label class="sr-only" for="edit-social-content-@post.Id">@L["Social:ContentLabel"]</label>
                                <textarea id="edit-social-content-@post.Id" class="input social-textarea" rows="4"
                                          @bind="editingContent" @bind:event="oninput" disabled="@isUpdatingPost"></textarea>
                                <div class="social-composer-foot">
                                    <label class="vis-switch" for="edit-social-visibility-@post.Id">
                                        <input id="edit-social-visibility-@post.Id" class="vis-switch-input" type="checkbox"
                                               checked="@(editingVisibility == SocialPostVisibility.Internal)"
                                               @onchange="OnEditVisibilityToggle"
                                               disabled="@isUpdatingPost" aria-label='@L["Social:VisibilityLabel"]' />
                                        <span class="vis-switch-track" aria-hidden="true"><span class="vis-switch-thumb"></span></span>
                                        <span class="vis-switch-text">@(editingVisibility == SocialPostVisibility.Internal ? L["Social:Internal"] : L["Social:Public"])</span>
                                    </label>
                                    <button class="btn btn-ghost" type="button" @onclick="CancelEditPost" disabled="@isUpdatingPost">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                                        @L["Social:Cancel"]
                                    </button>
                                    <button class="btn btn-primary" type="submit" disabled="@isUpdatingPost">
                                        @if (isUpdatingPost)
                                        {
                                            @SocialSpinner()
                                        }
                                        else
                                        {
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                        }
                                        @(isUpdatingPost ? L["Social:Updating"] : L["Social:SaveChanges"])
                                    </button>
                                </div>
                            </form>
                        }
                        else if (!string.IsNullOrWhiteSpace(post.Text))
                        {
                            <div class="post-body">
                                <p>@RenderSocialPostText(post.Text)</p>
                            </div>
                        }
                        @if (post.Media.Count > 0)
                        {
                            <div class="post-media hcs-social-media-grid @(post.Media.Count == 1 ? "is-single" : null)">
                                @foreach (var media in post.Media)
                                {
                                    @if (media.Kind == SocialMediaKind.Video)
                                    {
                                        <video controls preload="metadata" crossorigin="use-credentials" aria-label="@media.FileName">
                                            <source src="@SocialMediaUrl(media.Id)" type="@media.ContentType" />
                                        </video>
                                    }
                                    else
                                    {
                                        <button class="social-media-open" type="button" title='@L["Chat:ViewImage"]' aria-label='@L["Chat:ViewImage"] @media.FileName'
                                                @onclick="() => OpenImagePreview(SocialMediaUrl(media.Id), media.FileName)">
                                            <img src="@SocialMediaUrl(media.Id)" crossorigin="use-credentials" loading="lazy" alt="@media.FileName" />
                                        </button>
                                    }
                                }
                            </div>
                        }

                        @if (post.LinkPreview is { } linkPreview)
                        {
                            <a class="social-link-preview @(string.IsNullOrWhiteSpace(linkPreview.ImageUrl) ? "is-text-only" : null)"
                               href="@linkPreview.Url" target="_blank" rel="noopener noreferrer">
                                @if (!string.IsNullOrWhiteSpace(linkPreview.ImageUrl))
                                {
                                    <img src="@linkPreview.ImageUrl" loading="lazy" referrerpolicy="no-referrer" alt="@(linkPreview.Title ?? linkPreview.Url)" />
                                }
                                <span class="social-link-preview__body">
                                    <small>@(linkPreview.SiteName ?? L["Social:LinkPreview"])</small>
                                    <strong>@(linkPreview.Title ?? linkPreview.Url)</strong>
                                    @if (!string.IsNullOrWhiteSpace(linkPreview.Description))
                                    {
                                        <span>@linkPreview.Description</span>
                                    }
                                    <small class="social-link-preview__url">@linkPreview.Url</small>
                                </span>
                            </a>
                        }

                        <div class="post-actions">
                            <div class="react-wrap">
                                <button class="post-action @(post.Reactions.CurrentUserReaction is not null ? $"is-on {ReactionColorClass(post.Reactions.CurrentUserReaction.Value)}" : null)"
                                        type="button" data-react-open
                                        disabled="@(reactionLoadingPostId == post.Id)" aria-haspopup="listbox">
                                    @if (post.Reactions.CurrentUserReaction is { } currentReaction)
                                    {
                                        @((MarkupString)ReactionGlyph(currentReaction))
                                        <span>@ReactionLabel(currentReaction)</span>
                                    }
                                    else
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 11v10H5a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2h3zm0 0 4.2-7.2A2 2 0 0 1 16 5v4h4.3a2 2 0 0 1 2 2.3l-1.2 8A2 2 0 0 1 19.1 21H8"/></svg>
                                        <span>@L["Social:React"]</span>
                                    }
                                </button>
                                <div class="react-bar" role="listbox" aria-label='@L["Social:React"]'>
                                    @foreach (var reactionType in ReactionTypes)
                                    {
                                        <button type="button"
                                                class="react-choice @ReactionColorClass(reactionType) @(post.Reactions.CurrentUserReaction == reactionType ? "is-on" : null)"
                                                @onclick="() => ReactToPostAsync(post, reactionType)"
                                                disabled="@(reactionLoadingPostId == post.Id)"
                                                title='@ReactionLabel(reactionType)'
                                                aria-label='@ReactionLabel(reactionType)'>
                                            @((MarkupString)ReactionGlyph(reactionType))
                                        </button>
                                    }
                                </div>
                            </div>
                            <button class="post-action" type="button" data-comment-toggle @onclick="() => ToggleCommentsAsync(post)"
                                    aria-expanded="@expandedPostIds.Contains(post.Id)">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16v10H7l-3 3V6z"/></svg>
                                <span>@L["Social:Comment"]</span>
                            </button>
                            <button class="post-action" type="button" data-share @onclick="() => SharePostAsync(post)"
                                    disabled="@(shareLoadingPostId == post.Id)" aria-label='@L["Social:Share"]'>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 17l5-5-5-5"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg>
                                <span>@L["Social:Share"]</span>
                            </button>
                            <div class="post-actions-meta">
                                @if (post.Reactions.TotalCount > 0)
                                {
                                    <span data-react-summary class="post-react-summary" aria-label='@L["Social:ReactionSummary"]'>
                                        @foreach (var reaction in post.Reactions.Counts.Take(3))
                                        {
                                            <span class="@ReactionColorClass(reaction.Type)" title='@ReactionLabel(reaction.Type)'>
                                                @((MarkupString)ReactionGlyph(reaction.Type))
                                            </span>
                                        }
                                        <span>@post.Reactions.TotalCount</span>
                                    </span>
                                }
                                <button type="button" data-comment-toggle @onclick="() => OpenCommentsAsync(post)"
                                        aria-expanded="@expandedPostIds.Contains(post.Id)">
                                    @post.CommentCount @L["Social:Comments"]
                                    @if (post.ShareCount > 0)
                                    {
                                        <span> · @post.ShareCount @L["Social:Shares"]</span>
                                    }
                                </button>
                            </div>
                        </div>

                        @if (expandedPostIds.Contains(post.Id))
                        {
                            <section class="post-comments" aria-label='@L["Social:Comment"]'>
                                @if (commentLoadingPostId == post.Id)
                                {
                                    <p class="social-comments-state" role="status">@SocialSpinner()@L["Social:LoadingComments"]</p>
                                }
                                else if (commentsByPost.TryGetValue(post.Id, out var comments) && comments.Count > 0)
                                {
                                    @foreach (var thread in ThreadedComments(comments))
                                    {
                                        @CommentItem(post, thread.Root, isReply: false)
                                        @if (thread.Replies.Count > 0)
                                        {
                                            <div class="comment-replies" role="group" aria-label='@L["Social:Reply"]'>
                                                @foreach (var reply in thread.Replies)
                                                {
                                                    @CommentItem(post, reply, isReply: true)
                                                }
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <p class="social-comments-state">@L["Social:EmptyComments"]</p>
                                }

                                @if (commentsByPost.TryGetValue(post.Id, out var loadedComments) &&
                                    commentTotalCounts.TryGetValue(post.Id, out var commentTotal) && loadedComments.Count < commentTotal)
                                {
                                    <button class="btn btn-ghost social-load-more" type="button"
                                            @onclick="() => LoadMoreCommentsAsync(post)"
                                            disabled="@(commentLoadingMorePostId == post.Id)"
                                            aria-label='@L["Social:LoadMoreComments"]'>
                                        @if (commentLoadingMorePostId == post.Id)
                                        {
                                            @SocialSpinner()
                                        }
                                        else
                                        {
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
                                        }
                                        @(commentLoadingMorePostId == post.Id ? L["Social:LoadingMoreComments"] : L["Social:LoadMoreComments"])
                                    </button>
                                }

                                @if (commentErrorPostId == post.Id)
                                {
                                    <p class="social-inline-error" role="alert">@L["Social:CommentError"]</p>
                                }
                                <form class="comment-form" @onsubmit="() => SubmitCommentAsync(post.Id)" @onsubmit:preventDefault>
                                    @if (replyingToPostId == post.Id && replyingToCommentId.HasValue)
                                    {
                                        <div class="comment-replying">
                                            <span>@(string.IsNullOrWhiteSpace(replyingToName) ? L["Social:ReplyingTo"] : string.Format(L["Social:ReplyingToName"], replyingToName))</span>
                                            <button type="button" data-reply @onclick="CancelReply">@L["Social:CancelReply"]</button>
                                        </div>
                                    }
                                    <div class="comment-compose">
                                        @SocialAvatar(currentUserId ?? Guid.Empty, CurrentDisplayName(), null, "chat-avatar sm")
                                        <label class="sr-only" for="comment-@post.Id">@L["Social:Comment"]</label>
                                        <input id="comment-@post.Id" class="input" type="text" autocomplete="off"
                                               @bind="commentDraft" @bind:event="oninput"
                                               placeholder='@L["Social:CommentPlaceholder"]' disabled="@isSubmittingComment" />
                                        <label class="icon-btn comment-attach" for="@($"comment-attachment-{post.Id:D}")"
                                               title='@L["Social:AddCommentAttachment"]'>
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.5 12.5 21a6 6 0 0 1-8.5-8.5l9-9a4 4 0 0 1 5.7 5.7l-9.2 9.1a2 2 0 1 1-2.8-2.8l8.1-8.2"/></svg>
                                            <span class="sr-only">@L["Social:AddCommentAttachment"]</span>
                                            <InputFile id="@($"comment-attachment-{post.Id:D}")" class="sr-only" multiple
                                                       accept="image/jpeg,image/png,image/gif,image/webp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt"
                                                       OnChange="args => UploadCommentAttachmentsAsync(post.Id, args)"
                                                       disabled="@(isSubmittingComment || isUploadingCommentAttachment)" />
                                        </label>
                                        <button class="btn btn-primary btn-sm" type="submit"
                                                disabled="@(isSubmittingComment || isUploadingCommentAttachment || (string.IsNullOrWhiteSpace(commentDraft) && commentAttachments.Count == 0))">
                                            @if (isSubmittingComment)
                                            {
                                                @SocialSpinner()
                                            }
                                            else
                                            {
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg>
                                            }
                                            @L["Social:SendComment"]
                                        </button>
                                    </div>
                                    @if (isUploadingCommentAttachment)
                                    {
                                        <p class="social-progress" role="status">@SocialSpinner()@L["Social:Loading"]</p>
                                    }
                                    @if (commentAttachments.Count > 0)
                                    {
                                        <div class="social-selected-media" aria-label='@L["Social:CommentAttachments"]'>
                                            @foreach (var attachment in commentAttachments)
                                            {
                                                var chipBadge = FileBadge(attachment.FileName);
                                                <span class="social-media-chip">
                                                    @if (IsImageAttachment(attachment.ContentType))
                                                    {
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="m21 15-4.5-4.5L7 20"/></svg>
                                                    }
                                                    else
                                                    {
                                                        <span class="chat-thumb-ext @chipBadge.Css">@chipBadge.Label</span>
                                                    }
                                                    <span>@attachment.FileName</span>
                                                    <button type="button" class="icon-btn" title='@L["Social:RemoveCommentAttachment"]'
                                                            aria-label='@L["Social:RemoveCommentAttachment"] @attachment.FileName'
                                                            @onclick="() => RemoveCommentAttachmentAsync(attachment)" disabled="@isSubmittingComment">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                                                    </button>
                                                </span>
                                            }
                                        </div>
                                    }
                                </form>
                            </section>
                        }
                    </article>
                }
                @if (posts.Count < totalCount)
                {
                    <button class="btn btn-ghost social-load-more" type="button" @onclick="LoadMoreAsync" disabled="@isLoadingMore">
                        @if (isLoadingMore)
                        {
                            @SocialSpinner()
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
                        }
                        @(isLoadingMore ? L["Social:Loading"] : L["Chat:OlderMessages"])
                    </button>
                }
                </div>
            }
            }
        </div>

        <aside class="social-aside" aria-label='@L["Social:Shortcuts"]'>
            <section class="card social-aside-card is-hint" hidden="@(!isProfile)">
                <div class="social-aside-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 5 6v6c0 5 3.4 7.8 7 9 3.6-1.2 7-4 7-9V6z"/></svg>
                </div>
                <h2>@L["Social:Internal"]</h2>
                <p>@L["Social:InternalHint"]</p>
            </section>
            <section class="card social-aside-card" hidden="@isProfile">
                <h2>@L["Social:Shortcuts"]</h2>
                <a class="social-shortcut" href="/social/profile">
                    <span class="chat-avatar sm">@(Initials(CurrentDisplayName()))</span>
                    @L["Social:OpenProfile"]
                </a>
                <a class="social-shortcut" href="/chat">
                    <span class="social-shortcut-icon" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16v10H7l-3 3V6z"/></svg>
                    </span>
                    @L["Chat:Title"]
                </a>
                <p>@L["Social:PublicHint"]</p>
            </section>
        </aside>
    </div>
    </div>
    @if (previewImageUrl is not null)
    {
        <div class="modal-overlay is-open" role="dialog" aria-modal="true" aria-labelledby="social-preview-title" @onclick="CloseImagePreview">
            <div class="chat-preview-dialog" @onclick:stopPropagation>
                <div class="chat-dialog-head">
                    <h2 id="social-preview-title">@L["Chat:ViewImage"]</h2>
                    <button class="icon-btn" type="button" aria-label='@L["Chat:ClosePreview"]' @onclick="CloseImagePreview">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>
                <img src="@previewImageUrl" crossorigin="use-credentials" alt="@L["Chat:ViewImage"]" />
            </div>
        </div>
    }
    @if (postPendingDelete is { } pendingPost)
    {
        <div class="modal-overlay is-open" role="dialog" aria-modal="true" aria-labelledby="social-delete-post-title" @onclick="CloseDeletePost">
            <div class="chat-dialog" @onclick:stopPropagation>
                <div class="chat-dialog-head">
                    <h2 id="social-delete-post-title">@L["Social:Delete"]</h2>
                    <button class="icon-btn" type="button" aria-label='@L["Social:Cancel"]' @onclick="CloseDeletePost">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>
                <div class="chat-dialog-view">
                    <p class="chat-dialog-copy">@string.Format(L["Social:DeletePostConfirmation"].Value, pendingPost.AuthorName)</p>
                </div>
                <div class="chat-dialog-foot">
                    <button class="btn btn-outline" type="button" @onclick="CloseDeletePost">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                        <span>@L["Social:Cancel"]</span>
                    </button>
                    <button class="btn btn-danger" type="button" @onclick="ConfirmDeletePostAsync" disabled="@deletingPostId.HasValue">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M6 7l1 13h10l1-13"/></svg>
                        <span>@L["Social:Delete"]</span>
                    </button>
                </div>
            </div>
        </div>
    }
    @if (commentPendingDelete is not null && commentPendingDeletePost is not null)
    {
        <div class="modal-overlay is-open" role="dialog" aria-modal="true" aria-labelledby="social-delete-comment-title" @onclick="CloseDeleteComment">
            <div class="chat-dialog" @onclick:stopPropagation>
                <div class="chat-dialog-head">
                    <h2 id="social-delete-comment-title">@L["Social:DeleteComment"]</h2>
                    <button class="icon-btn" type="button" aria-label='@L["Social:Cancel"]' @onclick="CloseDeleteComment">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>
                <div class="chat-dialog-view">
                    <p class="chat-dialog-copy">@L["Social:DeleteCommentConfirmation"]</p>
                </div>
                <div class="chat-dialog-foot">
                    <button class="btn btn-outline" type="button" @onclick="CloseDeleteComment">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                        <span>@L["Social:Cancel"]</span>
                    </button>
                    <button class="btn btn-danger" type="button" @onclick="ConfirmDeleteCommentAsync" disabled="@deletingCommentId.HasValue">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M6 7l1 13h10l1-13"/></svg>
                        <span>@L["Social:DeleteAction"]</span>
                    </button>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private const int CommentsPageSize = 10;
    private static readonly Regex HashtagPattern = new(
        @"(?<!\w)#(?<tag>[\p{L}\p{N}_-]{1,64})",
        RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private readonly List<SocialPostDto> posts = [];
    private readonly Dictionary<Guid, IReadOnlyList<SocialCommentDto>> commentsByPost = [];
    private readonly Dictionary<Guid, long> commentTotalCounts = [];
    private readonly HashSet<Guid> expandedPostIds = [];
    private readonly List<UploadSocialMediaResult> uploadedMedia = [];
    private readonly List<UploadSocialCommentAttachmentResult> commentAttachments = [];
    private readonly List<SocialPersonDto> people = [];
    private readonly HashSet<string> avatarLoadFailures = new(StringComparer.Ordinal);
    private readonly SemaphoreSlim routeLoadGate = new(1, 1);
    private static readonly SocialReactionType[] ReactionTypes = Enum.GetValues<SocialReactionType>();
    private bool isProfile;
    private bool routeLoaded;
    private bool isLoading;
    private bool isChangingVisibility;
    private bool isLoadingMore;
    private bool isPosting;
    private bool isUploadingMedia;
    private bool isUploadingCommentAttachment;
    private bool isSearchingPeople;
    private bool peopleSearchMode;
    private bool searchOpen;
    private bool peopleSearchExecuted;
    private bool isSubmittingComment;
    private Guid? reactionLoadingPostId;
    private Guid? reactionLoadingCommentId;
    private Guid? shareLoadingPostId;
    private Guid? currentUserId;
    private Guid? commentAttachmentPostId;
    private SocialPersonDto? myProfile;
    private string? personalAvatarDataUrl;
    private Guid? editingPostId;
    private Guid? postMenuId;
    private Guid? deletingPostId;
    private Guid? deletingCommentId;
    private SocialPostDto? postPendingDelete;
    private SocialPostDto? commentPendingDeletePost;
    private SocialCommentDto? commentPendingDelete;
    private bool isUpdatingPost;
    private string editingContent = string.Empty;
    private SocialPostVisibility editingVisibility;
    private string content = string.Empty;
    private string commentDraft = string.Empty;
    private string keywordInput = string.Empty;
    private string hashtagInput = string.Empty;
    private SocialPostVisibility visibility = SocialPostVisibility.Public;
    private string? loadError;
    private string? searchError;
    private string? peopleSearchError;
    private Guid? commentLoadingPostId;
    private Guid? commentLoadingMorePostId;
    private Guid? commentErrorPostId;
    private Guid? replyingToPostId;
    private Guid? replyingToCommentId;
    private string? replyingToName;
    private string? previewImageUrl;
    private string? previewImageName;
    private long totalCount;
    private string currentDisplayName = "HCS";
    private SocialPostVisibility? visibilityFilter;
    private Guid? selectedPostId;
    private Guid? pendingScrollPostId;
    private string routeStateKey = string.Empty;
    private string keywordFilter = string.Empty;
    private string hashtagFilter = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(authenticationState.User.FindFirst("sub")?.Value
                ?? authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            out var userId))
        {
            currentUserId = userId;
        }
        else
        {
            currentUserId = null;
        }
        currentDisplayName = authenticationState.User.FindFirst("name")?.Value
            ?? authenticationState.User.Identity?.Name ?? L["Auth:UserFallback"].Value;
        await ReloadForCurrentRouteAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            await ReloadForCurrentRouteAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadForCurrentRouteAsync(bool force = false)
    {
        await routeLoadGate.WaitAsync();
        try
        {
            var route = ReadRouteState();
            if (!force && route.Key == routeStateKey && routeLoaded)
                return;

            isProfile = route.IsProfile;
            visibilityFilter = route.Visibility;
            selectedPostId = route.PostId;
            pendingScrollPostId = route.PostId;
            keywordFilter = route.Keyword;
            hashtagFilter = route.Hashtag;
            keywordInput = keywordFilter;
            hashtagInput = hashtagFilter;
            searchOpen = searchOpen || !string.IsNullOrWhiteSpace(keywordFilter) || !string.IsNullOrWhiteSpace(hashtagFilter);
            searchError = null;
            people.Clear();
            peopleSearchExecuted = false;
            peopleSearchError = null;
            routeStateKey = route.Key;
            await LoadAsync();
        }
        finally
        {
            isChangingVisibility = false;
            routeLoadGate.Release();
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        routeLoaded = false;
        try
        {
            await LoadPersonalAvatarAsync();
            var result = isProfile
                    ? await Social.GetProfilePostsAsync(visibility: visibilityFilter, keyword: keywordFilter,
                    hashtag: hashtagFilter, postId: selectedPostId)
                : await Social.GetFeedAsync(keyword: keywordFilter, hashtag: hashtagFilter, postId: selectedPostId);
            posts.Clear();
            posts.AddRange(result.Items);
            totalCount = result.TotalCount;
            if (isProfile)
            {
                try { myProfile = await Social.GetMyProfileAsync(); }
                catch { myProfile = null; }
            }
            else
            {
                myProfile = null;
            }
            commentsByPost.Clear();
            commentTotalCounts.Clear();
            expandedPostIds.Clear();
            routeLoaded = true;
        }
        catch
        {
            posts.Clear();
            totalCount = 0;
            loadError = L["Social:LoadError"].Value;
        }
        finally { isLoading = false; }
    }

    private async Task LoadPersonalAvatarAsync()
    {
        personalAvatarDataUrl = null;
        avatarLoadFailures.Clear();
        if (!currentUserId.HasValue)
            return;

        try
        {
            var avatar = await Account.TryGetAvatarAsync();
            personalAvatarDataUrl = avatar?.ToDataUrl();
        }
        catch
        {
            // The initials fallback keeps the social page usable when the avatar store is unavailable.
        }
    }

    private async Task LoadMoreAsync()
    {
        if (isLoadingMore || posts.Count >= totalCount) return;
        isLoadingMore = true;
        try
        {
            var result = isProfile
                ? await Social.GetProfilePostsAsync(posts.Count, visibility: visibilityFilter, keyword: keywordFilter,
                    hashtag: hashtagFilter, postId: selectedPostId)
                : await Social.GetFeedAsync(posts.Count, keyword: keywordFilter, hashtag: hashtagFilter, postId: selectedPostId);
            posts.AddRange(result.Items);
            totalCount = result.TotalCount;
        }
        catch { loadError = L["Social:LoadError"].Value; }
        finally { isLoadingMore = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingScrollPostId is not { } postId)
            return;

        pendingScrollPostId = null;
        await JS.InvokeVoidAsync("hcsSocial.scrollToPost", postId.ToString("D"));
    }

    private async Task ReactToPostAsync(SocialPostDto post, SocialReactionType reactionType)
    {
        if (reactionLoadingPostId.HasValue || shareLoadingPostId.HasValue)
            return;

        reactionLoadingPostId = post.Id;
        try
        {
            var result = await Social.ReactToPostAsync(post.Id, reactionType,
                post.Reactions.CurrentUserReaction == reactionType);
            var index = posts.FindIndex(item => item.Id == post.Id);
            if (index >= 0)
                posts[index] = posts[index] with { Reactions = result.Reactions };
        }
        catch { await NotifyErrorAsync(L["Social:ReactionError"]); }
        finally { reactionLoadingPostId = null; }
    }

    private async Task ReactToCommentAsync(SocialPostDto post, SocialCommentDto comment,
        SocialReactionType reactionType)
    {
        if (reactionLoadingCommentId.HasValue)
            return;

        reactionLoadingCommentId = comment.Id;
        try
        {
            var result = await Social.ReactToCommentAsync(comment.Id, reactionType,
                comment.Reactions.CurrentUserReaction == reactionType);
            if (commentsByPost.TryGetValue(post.Id, out var current))
            {
                var comments = current.ToArray();
                var index = Array.FindIndex(comments, item => item.Id == comment.Id);
                if (index >= 0)
                {
                    comments[index] = comments[index] with { Reactions = result.Reactions };
                    commentsByPost[post.Id] = comments;
                }
            }
        }
        catch { await NotifyErrorAsync(L["Social:ReactionError"]); }
        finally { reactionLoadingCommentId = null; }
    }

    private async Task SharePostAsync(SocialPostDto post)
    {
        if (shareLoadingPostId.HasValue || reactionLoadingPostId.HasValue)
            return;

        shareLoadingPostId = post.Id;
        try
        {
            var result = await Social.SharePostAsync(post.Id);
            var index = posts.FindIndex(item => item.Id == post.Id);
            if (index >= 0)
                posts[index] = posts[index] with { ShareCount = result.ShareCount };

            var shareUrl = new Uri(new Uri(Navigation.BaseUri), result.ShareUrl).ToString();
            var outcome = await JS.InvokeAsync<string>("hcsSocial.share", shareUrl,
                post.LinkPreview?.Title ?? L["Social:Title"].Value, post.Text);
            if (outcome == "copied")
                await NotifySuccessAsync(L["Social:ShareCopied"]);
            else if (outcome == "shared")
                await NotifySuccessAsync(L["Social:ShareCompleted"]);
            else if (outcome == "failed")
                await NotifyErrorAsync(L["Social:ShareError"]);
        }
        catch { await NotifyErrorAsync(L["Social:ShareError"]); }
        finally { shareLoadingPostId = null; }
    }

