    private Task ConfirmDeleteCommentAsync()
    {
        if (commentPendingDeletePost is not { } post || commentPendingDelete is not { } comment)
            return Task.CompletedTask;
        commentPendingDeletePost = null;
        commentPendingDelete = null;
        return DeleteCommentAsync(post, comment);
    }

    private async Task DeleteCommentAsync(SocialPostDto post, SocialCommentDto comment)
    {
        if (!IsOwnComment(comment) || deletingCommentId.HasValue)
            return;

        deletingCommentId = comment.Id;
        try
        {
            await Social.DeleteCommentAsync(comment.Id);
            if (commentsByPost.TryGetValue(post.Id, out var current))
            {
                commentsByPost[post.Id] = current
                    .Where(item => item.Id != comment.Id)
                    .Select(item => item.ParentCommentId == comment.Id
                        ? item with { ParentCommentId = null }
                        : item)
                    .ToArray();
            }
            if (commentTotalCounts.TryGetValue(post.Id, out var commentTotal))
                commentTotalCounts[post.Id] = Math.Max(0, commentTotal - 1);

            var index = posts.FindIndex(item => item.Id == post.Id);
            if (index >= 0)
                posts[index] = posts[index] with { CommentCount = Math.Max(0, posts[index].CommentCount - 1) };

            if (replyingToCommentId == comment.Id)
                CancelReply();
            await NotifySuccessAsync(L["Social:CommentDeleted"]);
        }
        catch
        {
            await NotifyErrorAsync(L["Social:DeleteCommentError"]);
        }
        finally { deletingCommentId = null; }
    }

