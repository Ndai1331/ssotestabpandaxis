    private bool IsOwnPost(SocialPostDto post) => currentUserId == post.AuthorUserId;

    private void BeginEditPost(SocialPostDto post)
    {
        if (!IsOwnPost(post) || isUpdatingPost || deletingPostId.HasValue)
            return;

        editingPostId = post.Id;
        editingContent = post.Text;
        editingVisibility = post.Visibility;
    }

    private void CancelEditPost()
    {
        if (isUpdatingPost)
            return;

        editingPostId = null;
        editingContent = string.Empty;
    }

    private async Task UpdatePostAsync(SocialPostDto post)
    {
        if (editingPostId != post.Id || !IsOwnPost(post) || isUpdatingPost)
            return;

        isUpdatingPost = true;
        try
        {
            var updated = await Social.UpdatePostAsync(post.Id, new UpdateSocialPostInput
            {
                Text = editingContent,
                Visibility = editingVisibility
            });
            var index = posts.FindIndex(item => item.Id == post.Id);
            if (index >= 0)
            {
                var noLongerMatchesView = (!isProfile && updated.Visibility != SocialPostVisibility.Public)
                    || (isProfile && visibilityFilter.HasValue && updated.Visibility != visibilityFilter.Value);
                if (noLongerMatchesView)
                {
                    posts.RemoveAt(index);
                    totalCount = Math.Max(0, totalCount - 1);
                    commentsByPost.Remove(post.Id);
                    expandedPostIds.Remove(post.Id);
                }
                else
                {
                    posts[index] = updated;
                }
            }
            editingPostId = null;
            editingContent = string.Empty;
            await NotifySuccessAsync(L["Social:PostUpdated"]);
        }
        catch { await NotifyErrorAsync(L["Social:UpdateError"]); }
        finally { isUpdatingPost = false; }
    }

    private async Task DeletePostAsync(SocialPostDto post)
    {
        if (!IsOwnPost(post) || deletingPostId.HasValue || isUpdatingPost)
            return;
        if (!await UiMessageService.Confirm(string.Format(L["Social:DeletePostConfirmation"].Value, post.AuthorName)))
            return;

        deletingPostId = post.Id;
        try
        {
            await Social.DeletePostAsync(post.Id);
            if (selectedPostId == post.Id)
            {
                Navigation.NavigateTo(isProfile ? "/social/profile" : "/social");
                return;
            }

            var index = posts.FindIndex(item => item.Id == post.Id);
            if (index >= 0)
            {
                posts.RemoveAt(index);
                totalCount = Math.Max(0, totalCount - 1);
            }
            commentsByPost.Remove(post.Id);
            expandedPostIds.Remove(post.Id);
            editingPostId = null;
            await NotifySuccessAsync(L["Social:PostDeleted"]);
        }
        catch { await NotifyErrorAsync(L["Social:DeleteError"]); }
        finally { deletingPostId = null; }
    }

    private async Task SelectVisibilityAsync(SocialPostVisibility? selectedVisibility)
    {
        var target = isProfile
            ? BuildViewUri(true, selectedVisibility, keywordFilter, fromDateFilter, toDateFilter, hashtagFilter)
            : BuildViewUri(selectedVisibility == SocialPostVisibility.Internal,
                selectedVisibility == SocialPostVisibility.Internal ? SocialPostVisibility.Internal : SocialPostVisibility.Public,
                keywordFilter, fromDateFilter, toDateFilter, hashtagFilter);
        var targetKey = BuildRouteStateKey(target);

        if (targetKey == routeStateKey)
        {
            await ReloadForCurrentRouteAsync(force: true);
            return;
        }

        Navigation.NavigateTo(target);
    }

    private async Task ApplySearchAsync()
    {
        searchError = null;
        DateOnly? from = fromDateInput.HasValue ? DateOnly.FromDateTime(fromDateInput.Value) : null;
        DateOnly? to = toDateInput.HasValue ? DateOnly.FromDateTime(toDateInput.Value) : null;

        if (from.HasValue && to.HasValue && from.Value > to.Value)
        {
            searchError = L["Social:InvalidDateRange"].Value;
            return;
        }

        keywordFilter = keywordInput.Trim();
        fromDateFilter = from;
        toDateFilter = to;
        hashtagFilter = hashtagInput.Trim();
        var target = BuildViewUri(isProfile, visibilityFilter, keywordFilter, fromDateFilter, toDateFilter, hashtagFilter);
        if (BuildRouteStateKey(target) == routeStateKey)
            await ReloadForCurrentRouteAsync(force: true);
        else
            Navigation.NavigateTo(target);
    }

    private async Task ClearSearchAsync()
    {
        keywordInput = string.Empty;
        fromDateInput = null;
        toDateInput = null;
        hashtagInput = string.Empty;
        keywordFilter = string.Empty;
        fromDateFilter = null;
        toDateFilter = null;
        hashtagFilter = string.Empty;
        searchError = null;
        var target = BuildViewUri(isProfile, visibilityFilter, keywordFilter, fromDateFilter, toDateFilter, hashtagFilter);
        if (BuildRouteStateKey(target) == routeStateKey)
            await ReloadForCurrentRouteAsync(force: true);
        else
            Navigation.NavigateTo(target);
    }

    private bool HasSearchFilters() => !string.IsNullOrWhiteSpace(keywordInput) ||
        fromDateInput.HasValue || toDateInput.HasValue ||
        !string.IsNullOrWhiteSpace(hashtagInput);

    private bool IsVisibilitySelected(SocialPostVisibility? selectedVisibility) => visibilityFilter == selectedVisibility;

    private (bool IsProfile, SocialPostVisibility? Visibility, Guid? PostId, string Keyword, DateOnly? From,
        DateOnly? To, string Hashtag, string Key) ReadRouteState()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var queryStart = relative.IndexOf('?');
        var path = (queryStart >= 0 ? relative[..queryStart] : relative).Trim('/');
        var isCurrentProfile = path.EndsWith("social/profile", StringComparison.OrdinalIgnoreCase);
        var selectedVisibility = isCurrentProfile ? ReadVisibility(relative, queryStart) : SocialPostVisibility.Public;
        var postId = ReadGuid(ReadQueryValue(relative, queryStart, "post"));
        var keyword = ReadQueryValue(relative, queryStart, "keyword") ?? string.Empty;
        var from = ReadDate(ReadQueryValue(relative, queryStart, "from"));
        var to = ReadDate(ReadQueryValue(relative, queryStart, "to"));
        var hashtag = ReadQueryValue(relative, queryStart, "hashtag") ?? string.Empty;
        return (isCurrentProfile, selectedVisibility, postId, keyword, from, to, hashtag,
            BuildRouteStateKey(isCurrentProfile, selectedVisibility, keyword, from, to, hashtag, postId));
    }

    private static SocialPostVisibility? ReadVisibility(string relative, int queryStart)
    {
        var value = ReadQueryValue(relative, queryStart, "visibility");
        return Enum.TryParse<SocialPostVisibility>(value, true, out var visibility) ? visibility : null;
    }

    private static DateOnly? ReadDate(string? value) =>
        DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var date) ? date : null;

    private static Guid? ReadGuid(string? value) =>
        Guid.TryParse(value, out var id) ? id : null;

    private static string? ReadQueryValue(string relative, int queryStart, string key)
    {
        if (queryStart < 0)
            return null;

        var query = relative[(queryStart + 1)..].Split('#')[0];
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && pair[0].Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(pair[1].Replace('+', ' '));
        }

        return null;
    }

    private static string BuildRouteStateKey(bool profile, SocialPostVisibility? selectedVisibility,
        string keyword = "", DateOnly? from = null, DateOnly? to = null, string hashtag = "", Guid? postId = null) =>
        $"{(profile ? "profile" : "feed")}:{selectedVisibility?.ToString() ?? "all"}|post={postId}|q={keyword}|from={from?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}|to={to?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}|tag={hashtag}";

    private static string BuildRouteStateKey(string target)
    {
        var queryStart = target.IndexOf('?');
        var path = (queryStart >= 0 ? target[..queryStart] : target).Trim('/');
        var isTargetProfile = path.Equals("social/profile", StringComparison.OrdinalIgnoreCase);
        SocialPostVisibility? selectedVisibility = isTargetProfile ? ReadVisibility(target, queryStart) : SocialPostVisibility.Public;
        var postId = ReadGuid(ReadQueryValue(target, queryStart, "post"));
        return BuildRouteStateKey(isTargetProfile, selectedVisibility,
            ReadQueryValue(target, queryStart, "keyword") ?? string.Empty,
            ReadDate(ReadQueryValue(target, queryStart, "from")),
            ReadDate(ReadQueryValue(target, queryStart, "to")),
            ReadQueryValue(target, queryStart, "hashtag") ?? string.Empty, postId);
    }

    private static string BuildViewUri(bool profile, SocialPostVisibility? selectedVisibility,
        string? keyword = null, DateOnly? from = null, DateOnly? to = null, string? hashtag = null, Guid? postId = null)
    {
        var uri = profile
            ? "/social/profile"
            : "/social";
        if (profile && selectedVisibility.HasValue)
            uri += $"?visibility={selectedVisibility.Value.ToString().ToLowerInvariant()}";

        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(keyword))
            parameters.Add($"keyword={Uri.EscapeDataString(keyword.Trim())}");
        if (from.HasValue)
            parameters.Add($"from={from.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}");
        if (to.HasValue)
            parameters.Add($"to={to.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}");
        if (!string.IsNullOrWhiteSpace(hashtag))
            parameters.Add($"hashtag={Uri.EscapeDataString(hashtag.Trim())}");
        if (postId.HasValue)
            parameters.Add($"post={postId.Value:D}");

        if (parameters.Count > 0)
            uri += uri.Contains('?') ? "&" : "?";
        return uri + string.Join('&', parameters);
    }

    private async Task UploadMediaAsync(InputFileChangeEventArgs args)
    {
        if (isUploadingMedia) return;
        isUploadingMedia = true;
        try
        {
            var remaining = SocialPostRules.MaxMediaItems - uploadedMedia.Count;
            if (remaining <= 0) return;
            foreach (var file in args.GetMultipleFiles(remaining))
            {
                if (file.Size > 25 * 1024 * 1024)
                {
                    await NotifyErrorAsync(L["Social:MediaTooLarge"]);
                    continue;
                }

                try { uploadedMedia.Add(await Social.UploadMediaAsync(file)); }
                catch (CollaborationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.RequestEntityTooLarge)
                { await NotifyErrorAsync(L["Social:MediaTooLarge"]); }
                catch { await NotifyErrorAsync(L["Social:UploadError"]); }
            }
        }
        catch { await NotifyErrorAsync(L["Social:UploadError"]); }
        finally { isUploadingMedia = false; }
    }

    private async Task RemoveMediaAsync(UploadSocialMediaResult media)
    {
        try
        {
            await Social.DeleteUnattachedMediaAsync(media.Id);
            uploadedMedia.RemoveAll(item => item.Id == media.Id);
        }
        catch { await NotifyErrorAsync(L["Social:UploadError"]); }
    }

    private async Task CreatePostAsync()
    {
        if (isPosting || (string.IsNullOrWhiteSpace(content) && uploadedMedia.Count == 0)) return;
        isPosting = true;
        try
        {
            await Social.CreatePostAsync(new CreateSocialPostInput
            {
                Text = content,
                Visibility = visibility,
                MediaIds = uploadedMedia.Select(media => media.Id).ToArray()
            });
            content = string.Empty;
            uploadedMedia.Clear();
            await LoadAsync();
        }
        catch { await NotifyErrorAsync(L["Social:PostError"]); }
        finally { isPosting = false; }
    }

    private async Task ToggleCommentsAsync(SocialPostDto post)
    {
        if (!expandedPostIds.Add(post.Id))
        {
            expandedPostIds.Remove(post.Id);
            return;
        }
        if (commentsByPost.ContainsKey(post.Id)) return;
        commentLoadingPostId = post.Id;
        commentErrorPostId = null;
        try { commentsByPost[post.Id] = await Social.GetCommentsAsync(post.Id); }
        catch { commentErrorPostId = post.Id; }
        finally { commentLoadingPostId = null; }
    }

    private void BeginReply(SocialPostDto post, SocialCommentDto comment)
    {
        expandedPostIds.Add(post.Id);
        replyingToPostId = post.Id;
        replyingToCommentId = comment.Id;
        commentDraft = string.Empty;
    }

    private void CancelReply()
    {
        replyingToPostId = null;
        replyingToCommentId = null;
        commentDraft = string.Empty;
    }

    private async Task SubmitCommentAsync(Guid postId)
    {
        if (isSubmittingComment || string.IsNullOrWhiteSpace(commentDraft)) return;
        isSubmittingComment = true;
        commentErrorPostId = null;
        try
        {
            var parentId = replyingToPostId == postId ? replyingToCommentId : null;
            var comment = await Social.CreateCommentAsync(postId, new CreateSocialCommentInput
            {
                Text = commentDraft,
                ParentCommentId = parentId
            });
            var current = commentsByPost.GetValueOrDefault(postId, []);
            commentsByPost[postId] = current.Append(comment).ToArray();
            var index = posts.FindIndex(post => post.Id == postId);
            if (index >= 0) posts[index] = posts[index] with { CommentCount = posts[index].CommentCount + 1 };
            commentDraft = string.Empty;
            CancelReply();
        }
        catch { commentErrorPostId = postId; }
        finally { isSubmittingComment = false; }
    }

    private string CurrentDisplayName() => currentDisplayName;

    private static string Initials(string? value)
    {
        var parts = (value ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }

        return parts.Length == 1 ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Navigation.LocationChanged -= OnLocationChanged;
            routeLoadGate.Dispose();
        }

        base.Dispose(disposing);
    }
