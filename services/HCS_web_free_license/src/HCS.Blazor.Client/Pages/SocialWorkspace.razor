    private (bool IsProfile, SocialPostVisibility? Visibility, Guid? PostId, string Keyword,
        string Hashtag, string Key) ReadRouteState()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var queryStart = relative.IndexOf('?');
        var path = (queryStart >= 0 ? relative[..queryStart] : relative).Trim('/');
        var isCurrentProfile = path.EndsWith("social/profile", StringComparison.OrdinalIgnoreCase);
        var selectedVisibility = isCurrentProfile ? ReadVisibility(relative, queryStart) : SocialPostVisibility.Public;
        var postId = ReadGuid(ReadQueryValue(relative, queryStart, "post"));
        var keyword = ReadQueryValue(relative, queryStart, "keyword") ?? string.Empty;
        var hashtag = ReadQueryValue(relative, queryStart, "hashtag") ?? string.Empty;
        return (isCurrentProfile, selectedVisibility, postId, keyword, hashtag,
            BuildRouteStateKey(isCurrentProfile, selectedVisibility, keyword, hashtag: hashtag, postId: postId));
    }

    private static SocialPostVisibility? ReadVisibility(string relative, int queryStart)
    {
        var value = ReadQueryValue(relative, queryStart, "visibility");
        return Enum.TryParse<SocialPostVisibility>(value, true, out var visibility) ? visibility : null;
    }

    private static Guid? ReadGuid(string? value) =>
        Guid.TryParse(value, out var id) ? id : null;

    private static string? ReadQueryValue(string relative, int queryStart, string key)
    {
        if (queryStart < 0)
            return null;

        var query = relative[(queryStart + 1)..].Split('#')[0];
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && pair[0].Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(pair[1].Replace('+', ' '));
        }

        return null;
    }

    private static string BuildRouteStateKey(bool profile, SocialPostVisibility? selectedVisibility,
        string keyword = "", string hashtag = "", Guid? postId = null) =>
        $"{(profile ? "profile" : "feed")}:{selectedVisibility?.ToString() ?? "all"}|post={postId}|q={keyword}|tag={hashtag}";

    private static string BuildRouteStateKey(string target)
    {
        var queryStart = target.IndexOf('?');
        var path = (queryStart >= 0 ? target[..queryStart] : target).Trim('/');
        var isTargetProfile = path.Equals("social/profile", StringComparison.OrdinalIgnoreCase);
        SocialPostVisibility? selectedVisibility = isTargetProfile ? ReadVisibility(target, queryStart) : SocialPostVisibility.Public;
        var postId = ReadGuid(ReadQueryValue(target, queryStart, "post"));
        return BuildRouteStateKey(isTargetProfile, selectedVisibility,
            ReadQueryValue(target, queryStart, "keyword") ?? string.Empty,
            ReadQueryValue(target, queryStart, "hashtag") ?? string.Empty, postId);
    }

    private static string BuildViewUri(bool profile, SocialPostVisibility? selectedVisibility,
        string? keyword = null, string? hashtag = null, Guid? postId = null)
    {
        var uri = profile
            ? "/social/profile"
            : "/social";
        if (profile && selectedVisibility.HasValue)
            uri += $"?visibility={selectedVisibility.Value.ToString().ToLowerInvariant()}";

        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(keyword))
            parameters.Add($"keyword={Uri.EscapeDataString(keyword.Trim())}");
        if (!string.IsNullOrWhiteSpace(hashtag))
            parameters.Add($"hashtag={Uri.EscapeDataString(hashtag.Trim())}");
        if (postId.HasValue)
            parameters.Add($"post={postId.Value:D}");

        if (parameters.Count > 0)
            uri += uri.Contains('?') ? "&" : "?";
        return uri + string.Join('&', parameters);
    }

    private async Task UploadMediaAsync(InputFileChangeEventArgs args)
    {
        if (isUploadingMedia) return;
        isUploadingMedia = true;
        try
        {
            var remaining = SocialPostRules.MaxMediaItems - uploadedMedia.Count;
            if (remaining <= 0) return;
            foreach (var file in args.GetMultipleFiles(remaining))
            {
                if (file.Size > 25 * 1024 * 1024)
                {
                    await NotifyErrorAsync(L["Social:MediaTooLarge"]);
                    continue;
                }

                try { uploadedMedia.Add(await Social.UploadMediaAsync(file)); }
                catch (CollaborationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.RequestEntityTooLarge)
                { await NotifyErrorAsync(L["Social:MediaTooLarge"]); }
                catch { await NotifyErrorAsync(L["Social:UploadError"]); }
            }
        }
        catch { await NotifyErrorAsync(L["Social:UploadError"]); }
        finally { isUploadingMedia = false; }
    }

    private async Task RemoveMediaAsync(UploadSocialMediaResult media)
    {
        try
        {
            await Social.DeleteUnattachedMediaAsync(media.Id);
            uploadedMedia.RemoveAll(item => item.Id == media.Id);
        }
        catch { await NotifyErrorAsync(L["Social:UploadError"]); }
    }

    private async Task UploadCommentAttachmentsAsync(Guid postId, InputFileChangeEventArgs args)
    {
        if (isUploadingCommentAttachment)
            return;

        if (commentAttachmentPostId is { } existingPostId && existingPostId != postId)
        {
            foreach (var attachment in commentAttachments.ToArray())
            {
                try { await Social.DeleteUnattachedCommentAttachmentAsync(attachment.Id); }
                catch { /* A later cleanup request can remove an abandoned upload. */ }
            }
            commentAttachments.Clear();
        }

        commentAttachmentPostId = postId;
        isUploadingCommentAttachment = true;
        try
        {
            var remaining = SocialPostRules.MaxCommentAttachments - commentAttachments.Count;
            if (remaining <= 0)
                return;

            foreach (var file in args.GetMultipleFiles(remaining))
            {
                if (file.Size > 25 * 1024 * 1024)
                {
                    await NotifyErrorAsync(L["Social:MediaTooLarge"]);
                    continue;
                }

                if (!IsSupportedCommentAttachment(file))
                {
                    await NotifyErrorAsync(L["Social:CommentAttachmentTypeError"]);
                    continue;
                }

                try
                {
                    commentAttachments.Add(await Social.UploadCommentAttachmentAsync(file));
                }
                catch (CollaborationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.RequestEntityTooLarge)
                {
                    await NotifyErrorAsync(L["Social:MediaTooLarge"]);
                }
                catch
                {
                    await NotifyErrorAsync(L["Social:CommentAttachmentUploadError"]);
                }
            }
        }
        catch
        {
            await NotifyErrorAsync(L["Social:CommentAttachmentUploadError"]);
        }
        finally
        {
            isUploadingCommentAttachment = false;
        }
    }

    private async Task RemoveCommentAttachmentAsync(UploadSocialCommentAttachmentResult attachment)
    {
        try
        {
            await Social.DeleteUnattachedCommentAttachmentAsync(attachment.Id);
            commentAttachments.RemoveAll(item => item.Id == attachment.Id);
            if (commentAttachments.Count == 0)
                commentAttachmentPostId = null;
        }
        catch
        {
            await NotifyErrorAsync(L["Social:CommentAttachmentUploadError"]);
        }
    }

    private static bool IsSupportedCommentAttachment(IBrowserFile file)
    {
        var contentType = file.ContentType?.Trim();
        if (contentType is "image/jpeg" or "image/png" or "image/gif" or "image/webp" or
            "text/plain" or "application/pdf" or "application/msword" or
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document" or
            "application/vnd.ms-excel" or "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" or
            "application/vnd.ms-powerpoint" or "application/vnd.openxmlformats-officedocument.presentationml.presentation")
            return true;

        return Path.GetExtension(file.Name).ToLowerInvariant() is
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".txt" or ".pdf" or
            ".doc" or ".docx" or ".xls" or ".xlsx" or ".ppt" or ".pptx";
    }

    private async Task CreatePostAsync()
    {
        if (isPosting || (string.IsNullOrWhiteSpace(content) && uploadedMedia.Count == 0)) return;
        isPosting = true;
        try
        {
            await Social.CreatePostAsync(new CreateSocialPostInput
            {
                Text = content,
                Visibility = visibility,
                MediaIds = uploadedMedia.Select(media => media.Id).ToArray()
            });
            content = string.Empty;
            uploadedMedia.Clear();
            await LoadAsync();
        }
        catch { await NotifyErrorAsync(L["Social:PostError"]); }
        finally { isPosting = false; }
    }

