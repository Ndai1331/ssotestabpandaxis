@page "/social"
@page "/social/profile"
@using Microsoft.AspNetCore.Components.Routing
@using HCS.Blazor.Client.Account
@using System.Threading
@using System.IO
@using System.Text.RegularExpressions
@attribute [Authorize(Policy = CollaborationPermissions.Social)]
@inherits HCSComponentBase
@inject SocialClient Social
@inject AccountProfileClient Account
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>@(isProfile ? L["Social:ProfileTitle"] : L["Social:Title"]) · HCS</PageTitle>

<section class="hcs-social-page" aria-label='@(isProfile ? L["Social:ProfileTitle"] : L["Social:Title"])'>
    @if (!isProfile)
    {
        <header class="hcs-social-hero">
            <div>
                <p class="hcs-social-eyebrow"><i class="fa fa-users" aria-hidden="true"></i> HCS Community</p>
                <h1 id="social-title">@L["Social:Title"]</h1>
                <p>@L["Social:Subtitle"]</p>
            </div>
            <a class="hcs-social-outline-button" href="/social/profile">
                <i class="fa fa-user" aria-hidden="true"></i>
                @L["Social:OpenProfile"]
            </a>
        </header>
    }

    @if (isProfile && myProfile is { } profile)
    {
        <section class="hcs-social-profile-card hcs-social-profile-card--top" aria-labelledby="social-my-profile-title">
            <div class="hcs-social-profile-card__cover">
                <a class="hcs-social-profile-card__back" href="/social">
                    <i class="fa fa-house" aria-hidden="true"></i>
                    @L["Social:BackToFeed"]
                </a>
            </div>
            <div class="hcs-social-profile-card__content">
                @SocialAvatar(profile.UserId, profile.DisplayName, profile.AvatarUrl, "hcs-social-avatar--profile")
                <div class="hcs-social-profile-card__identity">
                    <h2 id="social-my-profile-title">@profile.DisplayName</h2>
                    <p class="hcs-social-profile-card__username">@@@profile.UserName</p>
                    <div class="hcs-social-profile-card__meta">
                        <span><i class="fa fa-id-badge" aria-hidden="true"></i><b>@L["Social:Position"]:</b> @(profile.PositionName ?? L["Social:NoProfileValue"])</span>
                        @if (!string.IsNullOrWhiteSpace(profile.DepartmentName))
                        {
                            <span><i class="fa fa-building" aria-hidden="true"></i><b>@L["Social:Department"]:</b> @profile.DepartmentName</span>
                        }
                        <span><i class="fa fa-phone" aria-hidden="true"></i><b>@L["Social:Phone"]:</b> @(profile.PhoneNumber ?? L["Social:NoProfileValue"])</span>
                        <span><i class="fa fa-envelope" aria-hidden="true"></i><b>@L["Social:Email"]:</b> @(profile.Email ?? L["Social:NoProfileValue"])</span>
                    </div>
                </div>
            </div>
        </section>
    }

    <nav class="hcs-social-scope-tabs @(isChangingVisibility ? "is-loading" : null)"
         aria-label='@L["Social:ViewLabel"]' aria-busy="@(isChangingVisibility)">
        <span class="hcs-social-scope-tabs__label">@L["Social:ViewLabel"]</span>
        @if (isProfile)
        {
            <button type="button" class="hcs-social-scope-tab @(IsVisibilitySelected(null) ? "is-active" : null)"
                    aria-pressed="@IsVisibilitySelected(null)" @onclick="() => SelectVisibilityAsync(null)"
                    disabled="@(isLoading || isChangingVisibility)">
                <i class="fa fa-layer-group" aria-hidden="true"></i>@L["Social:All"]
            </button>
        }
        <button type="button" class="hcs-social-scope-tab @(IsVisibilitySelected(SocialPostVisibility.Public) ? "is-active" : null)"
                aria-pressed="@IsVisibilitySelected(SocialPostVisibility.Public)" @onclick="() => SelectVisibilityAsync(SocialPostVisibility.Public)"
                disabled="@(isLoading || isChangingVisibility)">
            <i class="fa fa-globe" aria-hidden="true"></i>@L["Social:Public"]
        </button>
        <button type="button" class="hcs-social-scope-tab @(IsVisibilitySelected(SocialPostVisibility.Internal) ? "is-active" : null)"
                aria-pressed="@IsVisibilitySelected(SocialPostVisibility.Internal)" @onclick="() => SelectVisibilityAsync(SocialPostVisibility.Internal)"
                title='@L["Social:InternalHint"]' disabled="@(isLoading || isChangingVisibility)">
            <i class="fa fa-lock" aria-hidden="true"></i>@L["Social:Internal"]
        </button>
        @if (isChangingVisibility)
        {
            <span class="hcs-social-scope-tabs__loading" role="status" aria-live="polite">
                <i class="fa fa-spinner fa-spin" aria-hidden="true"></i>
                <span>@L["Social:Loading"]</span>
            </span>
        }
    </nav>

    <form class="hcs-social-search" @onsubmit="ApplySearchAsync" @onsubmit:preventDefault>
        <div class="hcs-social-search__heading">
            <i class="fa fa-magnifying-glass" aria-hidden="true"></i>
            <span>@L["Social:SearchTitle"]</span>
        </div>
        <div class="hcs-social-search__modes" role="group" aria-label='@L["Social:SearchTitle"]'>
            <button type="button" class="hcs-social-search__mode @(!peopleSearchMode ? "is-active" : null)"
                    aria-pressed="@(!peopleSearchMode)" @onclick="() => SelectSearchMode(false)">
                <i class="fa fa-newspaper" aria-hidden="true"></i>@L["Social:SearchTitle"]
            </button>
            <button type="button" class="hcs-social-search__mode @(peopleSearchMode ? "is-active" : null)"
                    aria-pressed="@peopleSearchMode" @onclick="() => SelectSearchMode(true)">
                <i class="fa fa-user-group" aria-hidden="true"></i>@L["Social:PeopleSearch"]
            </button>
        </div>
        <div class="hcs-social-search__field hcs-social-search__field--keyword">
            <label for="social-search-keyword">@(peopleSearchMode ? L["Social:PeopleSearch"] : L["Social:Keyword"])</label>
            <input id="social-search-keyword" class="form-control" @bind="keywordInput"
                   placeholder='@(peopleSearchMode ? L["Social:PeopleSearchPlaceholder"] : L["Social:KeywordPlaceholder"])' autocomplete="off" />
        </div>
        @if (!peopleSearchMode)
        {
            <div class="hcs-social-search__field">
                <label for="social-search-hashtag">@L["Social:Hashtag"]</label>
                <input id="social-search-hashtag" class="form-control" @bind="hashtagInput"
                       placeholder="#hcs" autocomplete="off" />
            </div>
        }
        <div class="hcs-social-search__actions">
            <button class="hcs-social-search__submit" type="submit">
                <i class="fa fa-search" aria-hidden="true"></i>@L["Social:Search"]
            </button>
            @if (!peopleSearchMode)
            {
                <button class="hcs-social-search__clear" type="button" @onclick="ClearSearchAsync"
                        disabled="@(!HasSearchFilters())">@L["Social:ClearSearch"]</button>
            }
        </div>
    </form>
    @if (!string.IsNullOrWhiteSpace(searchError))
    {
        <p class="hcs-social-search__error" role="alert"><i class="fa fa-triangle-exclamation" aria-hidden="true"></i>@searchError</p>
    }

    <div class="hcs-social-layout">
        <main class="hcs-social-stream">
            @if (peopleSearchMode && peopleSearchExecuted)
            {
                <section class="hcs-social-people-results" aria-labelledby="social-people-results-title">
                    <div class="hcs-social-card-heading">
                        <span class="hcs-social-card-heading__icon" aria-hidden="true"><i class="fa fa-user-group"></i></span>
                        <div>
                            <h2 id="social-people-results-title">@L["Social:PeopleResults"]</h2>
                            <p>@keywordInput</p>
                        </div>
                    </div>
                    @if (isSearchingPeople)
                    {
                        <p class="hcs-social-state hcs-social-state--compact" role="status"><i class="fa fa-spinner fa-spin" aria-hidden="true"></i>@L["Social:Loading"]</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(peopleSearchError))
                    {
                        <p class="hcs-social-inline-error" role="alert">@peopleSearchError</p>
                    }
                    else if (people.Count == 0)
                    {
                        <p class="hcs-social-state hcs-social-state--compact">@L["Social:PeopleEmpty"]</p>
                    }
                    else
                    {
                        <div class="hcs-social-people-grid">
                            @foreach (var person in people)
                            {
                                <article class="hcs-social-person-card">
                                    @SocialAvatar(person.UserId, person.DisplayName, person.AvatarUrl)
                                    <div class="hcs-social-person-card__body">
                                        <h3>@person.DisplayName</h3>
                                        <p class="hcs-social-person-card__position">@(person.PositionName ?? L["Social:NoProfileValue"])</p>
                                        @if (!string.IsNullOrWhiteSpace(person.DepartmentName))
                                        {
                                            <p class="hcs-social-person-card__department"><i class="fa fa-building" aria-hidden="true"></i>@person.DepartmentName</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(person.Email))
                                        {
                                            <a href="mailto:@person.Email" class="hcs-social-person-card__contact"><i class="fa fa-envelope" aria-hidden="true"></i>@person.Email</a>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(person.PhoneNumber))
                                        {
                                            <a href="tel:@person.PhoneNumber" class="hcs-social-person-card__contact"><i class="fa fa-phone" aria-hidden="true"></i>@person.PhoneNumber</a>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            }
            <section class="hcs-social-composer" aria-labelledby="social-composer-title">
                <div class="hcs-social-card-heading">
                    @SocialAvatar(currentUserId ?? Guid.Empty, CurrentDisplayName(), null, "hcs-social-avatar--accent")
                    <div>
                        <h2 id="social-composer-title">@L["Social:ComposerTitle"]</h2>
                        <p>@L["Social:ContentLabel"]</p>
                    </div>
                </div>
                <form class="hcs-social-composer__form" @onsubmit="CreatePostAsync" @onsubmit:preventDefault>
                    <label class="visually-hidden" for="social-content">@L["Social:ContentLabel"]</label>
                    <textarea id="social-content" class="form-control" rows="3" @bind="content" @bind:event="oninput"
                              placeholder='@L["Social:ContentPlaceholder"]' disabled="@isPosting"></textarea>
                    <div class="hcs-social-composer__controls">
                        <div class="hcs-social-visibility">
                            <label for="social-visibility">@L["Social:VisibilityLabel"]</label>
                            <select id="social-visibility" class="form-select" @bind="visibility" disabled="@isPosting">
                                <option value="@SocialPostVisibility.Public">@L["Social:Public"]</option>
                                <option value="@SocialPostVisibility.Internal">@L["Social:Internal"]</option>
                            </select>
                        </div>
                        <label class="hcs-social-media-picker" for="social-media">
                            <i class="fa fa-photo-film" aria-hidden="true"></i>@L["Social:ChooseMedia"]
                            <InputFile id="social-media" class="visually-hidden" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm"
                                       multiple OnChange="UploadMediaAsync" disabled="@(isPosting || isUploadingMedia)" />
                        </label>
                        <button class="hcs-social-submit" type="submit" disabled="@(isPosting || isUploadingMedia || (string.IsNullOrWhiteSpace(content) && uploadedMedia.Count == 0))">
                            <i class="fa @(isPosting ? "fa-spinner fa-spin" : "fa-paper-plane")" aria-hidden="true"></i>
                            @(isPosting ? L["Social:Posting"] : L["Social:Post"])
                        </button>
                    </div>
                </form>
                @if (isUploadingMedia)
                {
                    <p class="hcs-social-progress" role="status"><i class="fa fa-spinner fa-spin" aria-hidden="true"></i>@L["Social:Posting"]</p>
                }
                @if (uploadedMedia.Count > 0)
                {
                    <div class="hcs-social-selected-media" aria-label='@L["Social:SelectedMedia"]'>
                        @foreach (var media in uploadedMedia)
                        {
                            <span class="hcs-social-media-chip">
                                <i class="fa @(media.Kind == SocialMediaKind.Video ? "fa-video" : "fa-image")" aria-hidden="true"></i>
                                <span>@media.FileName</span>
                                <button type="button" title='@L["Social:RemoveMedia"]' aria-label='@L["Social:RemoveMedia"] @media.FileName'
                                        @onclick="() => RemoveMediaAsync(media)" disabled="@isPosting">
                                    <i class="fa fa-xmark" aria-hidden="true"></i>
                                </button>
                            </span>
                        }
                    </div>
                }
            </section>

            @if (isLoading || isChangingVisibility)
            {
                <div class="hcs-social-state hcs-social-state--loading" role="status">
                    <i class="fa fa-spinner fa-spin" aria-hidden="true"></i>@L["Social:Loading"]
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="hcs-social-state hcs-social-state--error" role="alert">
                    <i class="fa fa-triangle-exclamation" aria-hidden="true"></i><span>@loadError</span>
                    <button type="button" @onclick="LoadAsync">@L["Chat:Retry"]</button>
                </div>
            }
            else if (posts.Count == 0)
            {
                <div class="hcs-social-state hcs-social-state--empty">
                    <i class="fa fa-comments" aria-hidden="true"></i>
                    <h2>@(isProfile ? L["Social:EmptyProfile"] : L["Social:EmptyFeed"])</h2>
                    <p>@L["Social:ComposerTitle"]</p>
                </div>
            }
            else
            {
                @foreach (var post in posts)
                {
                    <article class="hcs-social-post" aria-labelledby="post-@post.Id">
                        <header class="hcs-social-post__header">
                            @SocialAvatar(post.AuthorUserId, post.AuthorName, post.AvatarUrl)
                            <div class="hcs-social-post__author">
                                <h2 id="post-@post.Id">@post.AuthorName</h2>
                                <time datetime="@post.CreatedAt.ToString("O")" title="@post.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")">
                                    @post.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </time>
                            </div>
                            <span class="hcs-social-visibility-badge @(post.Visibility == SocialPostVisibility.Internal ? "is-internal" : null)">
                                <i class="fa @(post.Visibility == SocialPostVisibility.Internal ? "fa-lock" : "fa-globe")" aria-hidden="true"></i>
                                @(post.Visibility == SocialPostVisibility.Internal ? L["Social:Internal"] : L["Social:Public"])
                            </span>
                            @if (IsOwnPost(post))
                            {
                                <div class="hcs-social-post__actions" aria-label='@L["Social:PostActions"]'>
                                    <button type="button" class="hcs-social-post__action" title='@L["Social:Edit"]'
                                            aria-label='@L["Social:Edit"]' @onclick="() => BeginEditPost(post)"
                                            disabled="@(isUpdatingPost || deletingPostId == post.Id)">
                                        <i class="fa fa-pen" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="hcs-social-post__action hcs-social-post__action--danger"
                                            title='@L["Social:Delete"]' aria-label='@L["Social:Delete"]'
                                            @onclick="() => DeletePostAsync(post)"
                                            disabled="@(isUpdatingPost || deletingPostId == post.Id)">
                                        <i class="fa @(deletingPostId == post.Id ? "fa-spinner fa-spin" : "fa-trash")" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                        </header>

                        @if (editingPostId == post.Id)
                        {
                            <form class="hcs-social-post__edit" @onsubmit="() => UpdatePostAsync(post)" @onsubmit:preventDefault>
                                <label for="edit-social-content-@post.Id">@L["Social:ContentLabel"]</label>
                                <textarea id="edit-social-content-@post.Id" class="form-control" rows="4"
                                          @bind="editingContent" @bind:event="oninput" disabled="@isUpdatingPost"></textarea>
                                <div class="hcs-social-post__edit-controls">
                                    <label for="edit-social-visibility-@post.Id">@L["Social:VisibilityLabel"]</label>
                                    <select id="edit-social-visibility-@post.Id" class="form-select" @bind="editingVisibility" disabled="@isUpdatingPost">
                                        <option value="@SocialPostVisibility.Public">@L["Social:Public"]</option>
                                        <option value="@SocialPostVisibility.Internal">@L["Social:Internal"]</option>
                                    </select>
                                    <button type="button" class="hcs-social-post__edit-cancel" @onclick="CancelEditPost" disabled="@isUpdatingPost">
                                        @L["Social:Cancel"]
                                    </button>
                                    <button type="submit" class="hcs-social-post__edit-save" disabled="@isUpdatingPost">
                                        <i class="fa @(isUpdatingPost ? "fa-spinner fa-spin" : "fa-floppy-disk")" aria-hidden="true"></i>
                                        @(isUpdatingPost ? L["Social:Updating"] : L["Social:SaveChanges"])
                                    </button>
                                </div>
                            </form>
                        }
                        else if (!string.IsNullOrWhiteSpace(post.Text))
                        {
                            <p class="hcs-social-post__text">@RenderSocialPostText(post.Text)</p>
                        }
                        @if (post.Media.Count > 0)
                        {
                            <div class="hcs-social-media-grid @(post.Media.Count == 1 ? "is-single" : null)">
                                @foreach (var media in post.Media)
                                {
                                    @if (media.Kind == SocialMediaKind.Video)
                                    {
                                        <video controls preload="metadata" crossorigin="use-credentials" aria-label="@media.FileName">
                                            <source src="@ResolveSocialResourceUrl(media.Url)" type="@media.ContentType" />
                                        </video>
                                    }
                                    else
                                    {
                                        <img src="@ResolveSocialResourceUrl(media.Url)" crossorigin="use-credentials" loading="lazy" alt="@media.FileName" />
                                    }
                                }
                            </div>
                        }

                        @if (post.LinkPreview is { } linkPreview)
                        {
                            <a class="hcs-social-link-preview @(string.IsNullOrWhiteSpace(linkPreview.ImageUrl) ? "is-text-only" : null)"
                               href="@linkPreview.Url" target="_blank" rel="noopener noreferrer">
                                @if (!string.IsNullOrWhiteSpace(linkPreview.ImageUrl))
                                {
                                    <img src="@linkPreview.ImageUrl" loading="lazy" referrerpolicy="no-referrer" alt="@(linkPreview.Title ?? linkPreview.Url)" />
                                }
                                <span class="hcs-social-link-preview__body">
                                    <small>@(linkPreview.SiteName ?? L["Social:LinkPreview"])</small>
                                    <strong>@(linkPreview.Title ?? linkPreview.Url)</strong>
                                    @if (!string.IsNullOrWhiteSpace(linkPreview.Description))
                                    {
                                        <span>@linkPreview.Description</span>
                                    }
                                    <small class="hcs-social-link-preview__url">@linkPreview.Url</small>
                                </span>
                            </a>
                        }

                        <div class="hcs-social-post__engagement">
                            <div class="hcs-social-reaction-summary" aria-label='@L["Social:ReactionSummary"]'>
                                @foreach (var reaction in post.Reactions.Counts.Take(3))
                                {
                                    <span class="@ReactionColorClass(reaction.Type)" title='@ReactionLabel(reaction.Type)'>
                                        <i class="fa @ReactionIcon(reaction.Type)" aria-hidden="true"></i>@reaction.Count
                                    </span>
                                }
                                @if (post.Reactions.TotalCount > 0)
                                {
                                    <span>@post.Reactions.TotalCount</span>
                                }
                            </div>
                            <span class="hcs-social-engagement-counts">
                                @if (post.CommentCount > 0)
                                {
                                    <button type="button" class="hcs-social-engagement-count hcs-social-engagement-count--comments"
                                            @onclick="() => OpenCommentsAsync(post)"
                                            aria-expanded="@expandedPostIds.Contains(post.Id)">
                                        @post.CommentCount @L["Social:Comments"]
                                    </button>
                                }
                                @if (post.ShareCount > 0)
                                {
                                    <span>@post.ShareCount @L["Social:Shares"]</span>
                                }
                            </span>
                        </div>
                        <div class="hcs-social-post__footer">
                            <div class="hcs-social-reaction-actions" aria-label='@L["Social:React"]'>
                                @foreach (var reactionType in ReactionTypes)
                                {
                                    <button type="button"
                                            class="hcs-social-reaction-button @ReactionColorClass(reactionType) @(post.Reactions.CurrentUserReaction == reactionType ? "is-selected" : null)"
                                            @onclick="() => ReactToPostAsync(post, reactionType)"
                                            disabled="@(reactionLoadingPostId == post.Id)"
                                            title='@ReactionLabel(reactionType)'
                                            aria-label='@ReactionLabel(reactionType)'>
                                        <i class="fa @ReactionIcon(reactionType)" aria-hidden="true"></i>
                                    </button>
                                }
                            </div>
                            <button type="button" class="hcs-social-comment-toggle" @onclick="() => ToggleCommentsAsync(post)"
                                    aria-expanded="@expandedPostIds.Contains(post.Id)">
                                <i class="fa fa-comment" aria-hidden="true"></i>@L["Social:Comment"]
                            </button>
                            <button type="button" class="hcs-social-share-button" @onclick="() => SharePostAsync(post)"
                                    disabled="@(shareLoadingPostId == post.Id)" aria-label='@L["Social:Share"]'>
                                <i class="fa @(shareLoadingPostId == post.Id ? "fa-spinner fa-spin" : "fa-share-nodes")" aria-hidden="true"></i>@L["Social:Share"]
                            </button>
                        </div>

                        @if (expandedPostIds.Contains(post.Id))
                        {
                            <section class="hcs-social-comments" aria-label='@L["Social:Comment"]'>
                                @if (commentLoadingPostId == post.Id)
                                {
                                    <p class="hcs-social-comments__state" role="status"><i class="fa fa-spinner fa-spin" aria-hidden="true"></i>@L["Social:LoadingComments"]</p>
                                }
                                else if (commentsByPost.TryGetValue(post.Id, out var comments) && comments.Count > 0)
                                {
                                    @foreach (var comment in comments)
                                    {
                                        <article class="hcs-social-comment @(comment.ParentCommentId.HasValue ? "is-reply" : null)">
                                            @SocialAvatar(comment.AuthorUserId, comment.AuthorName, comment.AvatarUrl, "hcs-social-avatar--small")
                                            <div class="hcs-social-comment__body">
                                                <div class="hcs-social-comment__bubble">
                                                    <strong>@comment.AuthorName</strong>
                                                    @if (!string.IsNullOrWhiteSpace(comment.Text))
                                                    {
                                                        <p>@comment.Text</p>
                                                    }
                                                    @if (comment.Attachments.Count > 0)
                                                    {
                                                        <div class="hcs-social-comment__attachments" aria-label='@L["Social:CommentAttachments"]'>
                                                            @foreach (var attachment in comment.Attachments)
                                                            {
                                                                @if (IsImageAttachment(attachment.ContentType))
                                                                {
                                                                    <a href="@ResolveSocialResourceUrl(attachment.Url)" target="_blank" rel="noopener" title='@L["Social:CommentAttachmentPreview"]'>
                                                                        <img src="@ResolveSocialResourceUrl(attachment.Url)" crossorigin="use-credentials" loading="lazy" alt="@attachment.FileName" />
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <a class="hcs-social-comment__file" href="@ResolveSocialResourceUrl(attachment.Url)" target="_blank" rel="noopener" title='@L["Social:CommentAttachmentPreview"]'>
                                                                        <i class="fa @FileIcon(attachment.FileName)" aria-hidden="true"></i>
                                                                        <span>@attachment.FileName</span>
                                                                        <small>@FormatFileSize(attachment.Size)</small>
                                                                    </a>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                    @if (comment.LinkPreview is { } commentLinkPreview)
                                                    {
                                                        <a class="hcs-social-link-preview hcs-social-link-preview--comment @(string.IsNullOrWhiteSpace(commentLinkPreview.ImageUrl) ? "is-text-only" : null)"
                                                           href="@commentLinkPreview.Url" target="_blank" rel="noopener noreferrer">
                                                            @if (!string.IsNullOrWhiteSpace(commentLinkPreview.ImageUrl))
                                                            {
                                                                <img src="@commentLinkPreview.ImageUrl" loading="lazy" referrerpolicy="no-referrer"
                                                                     alt="@(commentLinkPreview.Title ?? commentLinkPreview.Url)" />
                                                            }
                                                            <span class="hcs-social-link-preview__body">
                                                                <small>@(commentLinkPreview.SiteName ?? L["Social:LinkPreview"])</small>
                                                                <strong>@(commentLinkPreview.Title ?? commentLinkPreview.Url)</strong>
                                                                <small class="hcs-social-link-preview__url">@commentLinkPreview.Url</small>
                                                            </span>
                                                        </a>
                                                    }
                                                </div>
                                                <div class="hcs-social-comment__actions">
                                                    <time datetime="@comment.CreatedAt.ToString("O")">@comment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                                                    <button type="button" @onclick="() => BeginReply(post, comment)">@L["Social:Reply"]</button>
                                                    @if (IsOwnComment(comment))
                                                    {
                                                        <button type="button" class="hcs-social-comment-delete"
                                                                title='@L["Social:DeleteComment"]' aria-label='@L["Social:DeleteComment"]'
                                                                @onclick="() => DeleteCommentAsync(post, comment)"
                                                                disabled="@(deletingCommentId == comment.Id)">
                                                            <i class="fa @(deletingCommentId == comment.Id ? "fa-spinner fa-spin" : "fa-trash")" aria-hidden="true"></i>
                                                            @L["Social:DeleteComment"]
                                                        </button>
                                                    }
                                                </div>
                                                <div class="hcs-social-comment__reaction-actions" aria-label='@L["Social:React"]'>
                                                    @foreach (var reactionType in ReactionTypes)
                                                    {
                                                        <button type="button"
                                                                class="hcs-social-comment-reaction @ReactionColorClass(reactionType) @(comment.Reactions.CurrentUserReaction == reactionType ? "is-selected" : null)"
                                                                @onclick="() => ReactToCommentAsync(post, comment, reactionType)"
                                                                disabled="@(reactionLoadingCommentId == comment.Id)"
                                                                title='@ReactionLabel(reactionType)'
                                                                aria-label='@ReactionLabel(reactionType)'>
                                                            <i class="fa @ReactionIcon(reactionType)" aria-hidden="true"></i>
                                                            @if (comment.Reactions.Counts.FirstOrDefault(item => item.Type == reactionType) is { } reactionCount)
                                                            {
                                                                <span>@reactionCount.Count</span>
                                                            }
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </article>
                                    }
                                }
                                else
                                {
                                    <p class="hcs-social-comments__state">@L["Social:EmptyComments"]</p>
                                }

                                @if (commentsByPost.TryGetValue(post.Id, out var loadedComments) &&
                                    commentTotalCounts.TryGetValue(post.Id, out var commentTotal) && loadedComments.Count < commentTotal)
                                {
                                    <button type="button" class="hcs-social-load-more hcs-social-load-more--comments"
                                            @onclick="() => LoadMoreCommentsAsync(post)"
                                            disabled="@(commentLoadingMorePostId == post.Id)"
                                            aria-label='@L["Social:LoadMoreComments"]'>
                                        <i class="fa @(commentLoadingMorePostId == post.Id ? "fa-spinner fa-spin" : "fa-arrow-down")" aria-hidden="true"></i>
                                        @(commentLoadingMorePostId == post.Id ? L["Social:LoadingMoreComments"] : L["Social:LoadMoreComments"])
                                    </button>
                                }

                                @if (commentErrorPostId == post.Id)
                                {
                                    <p class="hcs-social-inline-error" role="alert">@L["Social:CommentError"]</p>
                                }
                                <form class="hcs-social-comment-form" @onsubmit="() => SubmitCommentAsync(post.Id)" @onsubmit:preventDefault>
                                    @if (replyingToPostId == post.Id && replyingToCommentId.HasValue)
                                    {
                                        <div class="hcs-social-replying">
                                            <span><i class="fa fa-reply" aria-hidden="true"></i>@L["Social:ReplyingTo"]</span>
                                            <button type="button" @onclick="CancelReply">@L["Social:CancelReply"]</button>
                                        </div>
                                    }
                                    <label class="visually-hidden" for="comment-@post.Id">@L["Social:Comment"]</label>
                                    <textarea id="comment-@post.Id" class="form-control" rows="2" @bind="commentDraft" @bind:event="oninput"
                                              placeholder='@L["Social:CommentPlaceholder"]' disabled="@isSubmittingComment"></textarea>
                                    <div class="hcs-social-comment-form__footer">
                                        <label class="hcs-social-comment-attachment-picker" for="@($"comment-attachment-{post.Id:D}")"
                                               title='@L["Social:AddCommentAttachment"]'>
                                            <i class="fa fa-paperclip" aria-hidden="true"></i><span>@L["Social:AddCommentAttachment"]</span>
                                            <InputFile id="@($"comment-attachment-{post.Id:D}")" class="visually-hidden" multiple
                                                       accept="image/jpeg,image/png,image/gif,image/webp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt"
                                                       OnChange="args => UploadCommentAttachmentsAsync(post.Id, args)"
                                                       disabled="@(isSubmittingComment || isUploadingCommentAttachment)" />
                                        </label>
                                        <button class="hcs-social-comment-submit" type="submit"
                                                disabled="@(isSubmittingComment || isUploadingCommentAttachment || (string.IsNullOrWhiteSpace(commentDraft) && commentAttachments.Count == 0))">
                                            <i class="fa @(isSubmittingComment ? "fa-spinner fa-spin" : "fa-paper-plane")" aria-hidden="true"></i>@L["Social:SendComment"]
                                        </button>
                                    </div>
                                    @if (isUploadingCommentAttachment)
                                    {
                                        <p class="hcs-social-progress" role="status"><i class="fa fa-spinner fa-spin" aria-hidden="true"></i>@L["Social:Loading"]</p>
                                    }
                                    @if (commentAttachments.Count > 0)
                                    {
                                        <div class="hcs-social-selected-media hcs-social-selected-media--comments" aria-label='@L["Social:CommentAttachments"]'>
                                            @foreach (var attachment in commentAttachments)
                                            {
                                                <span class="hcs-social-media-chip">
                                                    <i class="fa @(IsImageAttachment(attachment.ContentType) ? "fa-image" : FileIcon(attachment.FileName))" aria-hidden="true"></i>
                                                    <span>@attachment.FileName</span>
                                                    <button type="button" title='@L["Social:RemoveCommentAttachment"]'
                                                            aria-label='@L["Social:RemoveCommentAttachment"] @attachment.FileName'
                                                            @onclick="() => RemoveCommentAttachmentAsync(attachment)" disabled="@isSubmittingComment">
                                                        <i class="fa fa-xmark" aria-hidden="true"></i>
                                                    </button>
                                                </span>
                                            }
                                        </div>
                                    }
                                </form>
                            </section>
                        }
                    </article>
                }
                @if (posts.Count < totalCount)
                {
                    <button type="button" class="hcs-social-load-more" @onclick="LoadMoreAsync" disabled="@isLoadingMore">
                        <i class="fa @(isLoadingMore ? "fa-spinner fa-spin" : "fa-arrow-down")" aria-hidden="true"></i>
                        @(isLoadingMore ? L["Social:Loading"] : L["Chat:OlderMessages"])
                    </button>
                }
            }
        </main>

        <aside class="hcs-social-aside" aria-label="HCS Community">
            <div class="hcs-social-aside__card">
                <span class="hcs-social-aside__icon" aria-hidden="true"><i class="fa fa-shield-heart"></i></span>
                <h2>@L["Social:Internal"]</h2>
                <p>@L["Social:InternalHint"]</p>
            </div>
            <div class="hcs-social-aside__card hcs-social-aside__card--soft">
                <span class="hcs-social-aside__icon" aria-hidden="true"><i class="fa fa-circle-info"></i></span>
                <p>@L["Social:PublicHint"]</p>
            </div>
        </aside>
    </div>
</section>

@code {
    private const int CommentsPageSize = 10;
    private static readonly Regex HashtagPattern = new(
        @"(?<!\w)#(?<tag>[\p{L}\p{N}_-]{1,64})",
        RegexOptions.Compiled | RegexOptions.CultureInvariant);
    private readonly List<SocialPostDto> posts = [];
    private readonly Dictionary<Guid, IReadOnlyList<SocialCommentDto>> commentsByPost = [];
    private readonly Dictionary<Guid, long> commentTotalCounts = [];
    private readonly HashSet<Guid> expandedPostIds = [];
    private readonly List<UploadSocialMediaResult> uploadedMedia = [];
    private readonly List<UploadSocialCommentAttachmentResult> commentAttachments = [];
    private readonly List<SocialPersonDto> people = [];
    private readonly HashSet<string> avatarLoadFailures = new(StringComparer.Ordinal);
    private readonly SemaphoreSlim routeLoadGate = new(1, 1);
    private static readonly SocialReactionType[] ReactionTypes = Enum.GetValues<SocialReactionType>();
    private bool isProfile;
    private bool routeLoaded;
    private bool isLoading;
    private bool isChangingVisibility;
    private bool isLoadingMore;
    private bool isPosting;
    private bool isUploadingMedia;
    private bool isUploadingCommentAttachment;
    private bool isSearchingPeople;
    private bool peopleSearchMode;
    private bool peopleSearchExecuted;
    private bool isSubmittingComment;
    private Guid? reactionLoadingPostId;
    private Guid? reactionLoadingCommentId;
    private Guid? shareLoadingPostId;
    private Guid? currentUserId;
    private Guid? commentAttachmentPostId;
    private SocialPersonDto? myProfile;
    private string? personalAvatarDataUrl;
    private Guid? editingPostId;
    private Guid? deletingPostId;
    private Guid? deletingCommentId;
    private bool isUpdatingPost;
    private string editingContent = string.Empty;
    private SocialPostVisibility editingVisibility;
    private string content = string.Empty;
    private string commentDraft = string.Empty;
    private string keywordInput = string.Empty;
    private string hashtagInput = string.Empty;
    private SocialPostVisibility visibility = SocialPostVisibility.Public;
    private string? loadError;
    private string? searchError;
    private string? peopleSearchError;
    private Guid? commentLoadingPostId;
    private Guid? commentLoadingMorePostId;
    private Guid? commentErrorPostId;
    private Guid? replyingToPostId;
    private Guid? replyingToCommentId;
    private long totalCount;
    private string currentDisplayName = "HCS";
    private SocialPostVisibility? visibilityFilter;
    private Guid? selectedPostId;
    private Guid? pendingScrollPostId;
    private string routeStateKey = string.Empty;
    private string keywordFilter = string.Empty;
    private string hashtagFilter = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(authenticationState.User.FindFirst("sub")?.Value
                ?? authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            out var userId))
        {
            currentUserId = userId;
        }
        else
        {
            currentUserId = null;
        }
        currentDisplayName = authenticationState.User.FindFirst("name")?.Value
            ?? authenticationState.User.Identity?.Name ?? L["Auth:UserFallback"].Value;
        await ReloadForCurrentRouteAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            await ReloadForCurrentRouteAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadForCurrentRouteAsync(bool force = false)
    {
        await routeLoadGate.WaitAsync();
        try
        {
            var route = ReadRouteState();
            if (!force && route.Key == routeStateKey && routeLoaded)
                return;

            isProfile = route.IsProfile;
            visibilityFilter = route.Visibility;
            selectedPostId = route.PostId;
            pendingScrollPostId = route.PostId;
            keywordFilter = route.Keyword;
            hashtagFilter = route.Hashtag;
            keywordInput = keywordFilter;
            hashtagInput = hashtagFilter;
            searchError = null;
            people.Clear();
            peopleSearchExecuted = false;
            peopleSearchError = null;
            routeStateKey = route.Key;
            await LoadAsync();
        }
        finally
        {
            isChangingVisibility = false;
            routeLoadGate.Release();
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        routeLoaded = false;
        try
        {
            await LoadPersonalAvatarAsync();
            var result = isProfile
                    ? await Social.GetProfilePostsAsync(visibility: visibilityFilter, keyword: keywordFilter,
                    hashtag: hashtagFilter, postId: selectedPostId)
                : await Social.GetFeedAsync(keyword: keywordFilter, hashtag: hashtagFilter, postId: selectedPostId);
            posts.Clear();
            posts.AddRange(result.Items);
            totalCount = result.TotalCount;
            if (isProfile)
            {
                try { myProfile = await Social.GetMyProfileAsync(); }
                catch { myProfile = null; }
            }
            else
            {
                myProfile = null;
            }
            commentsByPost.Clear();
            commentTotalCounts.Clear();
            expandedPostIds.Clear();
            routeLoaded = true;
        }
        catch
        {
            posts.Clear();
            totalCount = 0;
            loadError = L["Social:LoadError"].Value;
        }
        finally { isLoading = false; }
    }

    private async Task LoadPersonalAvatarAsync()
    {
        personalAvatarDataUrl = null;
        avatarLoadFailures.Clear();
        if (!currentUserId.HasValue)
            return;

        try
        {
            var avatar = await Account.TryGetAvatarAsync();
            personalAvatarDataUrl = avatar?.ToDataUrl();
        }
        catch
        {
            // The initials fallback keeps the social page usable when the avatar store is unavailable.
        }
    }

    private async Task LoadMoreAsync()
    {
        if (isLoadingMore || posts.Count >= totalCount) return;
        isLoadingMore = true;
        try
        {
            var result = isProfile
                ? await Social.GetProfilePostsAsync(posts.Count, visibility: visibilityFilter, keyword: keywordFilter,
                    hashtag: hashtagFilter, postId: selectedPostId)
                : await Social.GetFeedAsync(posts.Count, keyword: keywordFilter, hashtag: hashtagFilter, postId: selectedPostId);
            posts.AddRange(result.Items);
            totalCount = result.TotalCount;
        }
        catch { loadError = L["Social:LoadError"].Value; }
        finally { isLoadingMore = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingScrollPostId is not { } postId)
            return;

        pendingScrollPostId = null;
        await JS.InvokeVoidAsync("hcsSocial.scrollToPost", postId.ToString("D"));
    }

    private async Task ReactToPostAsync(SocialPostDto post, SocialReactionType reactionType)
    {
        if (reactionLoadingPostId.HasValue || shareLoadingPostId.HasValue)
            return;

        reactionLoadingPostId = post.Id;
        try
        {
            var result = await Social.ReactToPostAsync(post.Id, reactionType,
                post.Reactions.CurrentUserReaction == reactionType);
            var index = posts.FindIndex(item => item.Id == post.Id);
            if (index >= 0)
                posts[index] = posts[index] with { Reactions = result.Reactions };
        }
        catch { await NotifyErrorAsync(L["Social:ReactionError"]); }
        finally { reactionLoadingPostId = null; }
    }

    private async Task ReactToCommentAsync(SocialPostDto post, SocialCommentDto comment,
        SocialReactionType reactionType)
    {
        if (reactionLoadingCommentId.HasValue)
            return;

        reactionLoadingCommentId = comment.Id;
        try
        {
            var result = await Social.ReactToCommentAsync(comment.Id, reactionType,
                comment.Reactions.CurrentUserReaction == reactionType);
            if (commentsByPost.TryGetValue(post.Id, out var current))
            {
                var comments = current.ToArray();
                var index = Array.FindIndex(comments, item => item.Id == comment.Id);
                if (index >= 0)
                {
                    comments[index] = comments[index] with { Reactions = result.Reactions };
                    commentsByPost[post.Id] = comments;
                }
            }
        }
        catch { await NotifyErrorAsync(L["Social:ReactionError"]); }
        finally { reactionLoadingCommentId = null; }
    }

    private async Task SharePostAsync(SocialPostDto post)
    {
        if (shareLoadingPostId.HasValue || reactionLoadingPostId.HasValue)
            return;

        shareLoadingPostId = post.Id;
        try
        {
            var result = await Social.SharePostAsync(post.Id);
            var index = posts.FindIndex(item => item.Id == post.Id);
            if (index >= 0)
                posts[index] = posts[index] with { ShareCount = result.ShareCount };

            var shareUrl = new Uri(new Uri(Navigation.BaseUri), result.ShareUrl).ToString();
            var outcome = await JS.InvokeAsync<string>("hcsSocial.share", shareUrl,
                post.LinkPreview?.Title ?? L["Social:Title"].Value, post.Text);
            if (outcome == "copied")
                await NotifySuccessAsync(L["Social:ShareCopied"]);
            else if (outcome == "shared")
                await NotifySuccessAsync(L["Social:ShareCompleted"]);
            else if (outcome == "failed")
                await NotifyErrorAsync(L["Social:ShareError"]);
        }
        catch { await NotifyErrorAsync(L["Social:ShareError"]); }
        finally { shareLoadingPostId = null; }
    }

    private string ReactionLabel(SocialReactionType reactionType) =>
        L[$"Social:Reaction:{reactionType}"].Value;

    private static string ReactionIcon(SocialReactionType reactionType) => reactionType switch
    {
        SocialReactionType.Like => "fa-thumbs-up",
        SocialReactionType.Love => "fa-heart",
        SocialReactionType.Haha => "fa-face-laugh",
        SocialReactionType.Wow => "fa-face-surprise",
        SocialReactionType.Sad => "fa-face-sad-cry",
        SocialReactionType.Angry => "fa-face-angry",
        _ => "fa-thumbs-up"
    };

    private static string ReactionColorClass(SocialReactionType reactionType) => reactionType switch
    {
        SocialReactionType.Like => "is-like",
        SocialReactionType.Love => "is-love",
        SocialReactionType.Haha => "is-haha",
        SocialReactionType.Wow => "is-wow",
        SocialReactionType.Sad => "is-sad",
        SocialReactionType.Angry => "is-angry",
        _ => "is-like"
    };

    private bool IsOwnPost(SocialPostDto post) => currentUserId == post.AuthorUserId;

    private bool IsOwnComment(SocialCommentDto comment) => currentUserId == comment.AuthorUserId;

    private void BeginEditPost(SocialPostDto post)
    {
        if (!IsOwnPost(post) || isUpdatingPost || deletingPostId.HasValue)
            return;

        editingPostId = post.Id;
        editingContent = post.Text;
        editingVisibility = post.Visibility;
    }

    private void CancelEditPost()
    {
        if (isUpdatingPost)
            return;

        editingPostId = null;
        editingContent = string.Empty;
    }

    private async Task UpdatePostAsync(SocialPostDto post)
    {
        if (editingPostId != post.Id || !IsOwnPost(post) || isUpdatingPost)
            return;

        isUpdatingPost = true;
        try
        {
            var updated = await Social.UpdatePostAsync(post.Id, new UpdateSocialPostInput
            {
                Text = editingContent,
                Visibility = editingVisibility
            });
            var index = posts.FindIndex(item => item.Id == post.Id);
            if (index >= 0)
            {
                var noLongerMatchesView = (!isProfile && updated.Visibility != SocialPostVisibility.Public)
                    || (isProfile && visibilityFilter.HasValue && updated.Visibility != visibilityFilter.Value);
                if (noLongerMatchesView)
                {
                    posts.RemoveAt(index);
                    totalCount = Math.Max(0, totalCount - 1);
                    commentsByPost.Remove(post.Id);
                    expandedPostIds.Remove(post.Id);
                }
                else
                {
                    posts[index] = updated;
                }
            }
            editingPostId = null;
            editingContent = string.Empty;
            await NotifySuccessAsync(L["Social:PostUpdated"]);
        }
        catch { await NotifyErrorAsync(L["Social:UpdateError"]); }
        finally { isUpdatingPost = false; }
    }

    private async Task DeletePostAsync(SocialPostDto post)
    {
        if (!IsOwnPost(post) || deletingPostId.HasValue || isUpdatingPost)
            return;
        if (!await UiMessageService.Confirm(string.Format(L["Social:DeletePostConfirmation"].Value, post.AuthorName)))
            return;

        deletingPostId = post.Id;
        try
        {
            await Social.DeletePostAsync(post.Id);
            if (selectedPostId == post.Id)
            {
                Navigation.NavigateTo(isProfile ? "/social/profile" : "/social");
                return;
            }

            var index = posts.FindIndex(item => item.Id == post.Id);
            if (index >= 0)
            {
                posts.RemoveAt(index);
                totalCount = Math.Max(0, totalCount - 1);
            }
            commentsByPost.Remove(post.Id);
            expandedPostIds.Remove(post.Id);
            editingPostId = null;
            await NotifySuccessAsync(L["Social:PostDeleted"]);
        }
        catch { await NotifyErrorAsync(L["Social:DeleteError"]); }
        finally { deletingPostId = null; }
    }

    private async Task DeleteCommentAsync(SocialPostDto post, SocialCommentDto comment)
    {
        if (!IsOwnComment(comment) || deletingCommentId.HasValue)
            return;
        if (!await UiMessageService.Confirm(L["Social:DeleteCommentConfirmation"].Value))
            return;

        deletingCommentId = comment.Id;
        try
        {
            await Social.DeleteCommentAsync(comment.Id);
            if (commentsByPost.TryGetValue(post.Id, out var current))
            {
                commentsByPost[post.Id] = current
                    .Where(item => item.Id != comment.Id)
                    .Select(item => item.ParentCommentId == comment.Id
                        ? item with { ParentCommentId = null }
                        : item)
                    .ToArray();
            }
            if (commentTotalCounts.TryGetValue(post.Id, out var commentTotal))
                commentTotalCounts[post.Id] = Math.Max(0, commentTotal - 1);

            var index = posts.FindIndex(item => item.Id == post.Id);
            if (index >= 0)
                posts[index] = posts[index] with { CommentCount = Math.Max(0, posts[index].CommentCount - 1) };

            if (replyingToCommentId == comment.Id)
                CancelReply();
            await NotifySuccessAsync(L["Social:CommentDeleted"]);
        }
        catch
        {
            await NotifyErrorAsync(L["Social:DeleteCommentError"]);
        }
        finally { deletingCommentId = null; }
    }

    private async Task SelectVisibilityAsync(SocialPostVisibility? selectedVisibility)
    {
        if (isChangingVisibility)
            return;

        var target = isProfile
            ? BuildViewUri(true, selectedVisibility, keywordFilter, hashtagFilter)
            : BuildViewUri(selectedVisibility == SocialPostVisibility.Internal,
                selectedVisibility == SocialPostVisibility.Internal ? SocialPostVisibility.Internal : SocialPostVisibility.Public,
                keywordFilter, hashtagFilter);
        var targetKey = BuildRouteStateKey(target);
        isChangingVisibility = true;

        if (targetKey == routeStateKey)
        {
            await ReloadForCurrentRouteAsync(force: true);
            return;
        }

        try
        {
            Navigation.NavigateTo(target);
        }
        catch
        {
            isChangingVisibility = false;
            throw;
        }
    }

    private async Task ApplySearchAsync()
    {
        if (peopleSearchMode)
        {
            await SearchPeopleAsync();
            return;
        }

        searchError = null;
        keywordFilter = keywordInput.Trim();
        hashtagFilter = hashtagInput.Trim();
        var target = BuildViewUri(isProfile, visibilityFilter, keywordFilter, hashtagFilter);
        if (BuildRouteStateKey(target) == routeStateKey)
            await ReloadForCurrentRouteAsync(force: true);
        else
            Navigation.NavigateTo(target);
    }

    private void SelectSearchMode(bool searchPeople)
    {
        peopleSearchMode = searchPeople;
        searchError = null;
        peopleSearchError = null;
        if (!searchPeople)
        {
            people.Clear();
            peopleSearchExecuted = false;
        }
    }

    private async Task SearchPeopleAsync()
    {
        peopleSearchExecuted = true;
        peopleSearchError = null;
        people.Clear();
        var search = keywordInput.Trim();
        if (string.IsNullOrWhiteSpace(search))
            return;

        isSearchingPeople = true;
        try
        {
            people.AddRange(await Social.SearchPeopleAsync(search, 30));
        }
        catch
        {
            peopleSearchError = L["Social:PeopleError"].Value;
        }
        finally
        {
            isSearchingPeople = false;
        }
    }

    private async Task ClearSearchAsync()
    {
        keywordInput = string.Empty;
        hashtagInput = string.Empty;
        keywordFilter = string.Empty;
        hashtagFilter = string.Empty;
        searchError = null;
        var target = BuildViewUri(isProfile, visibilityFilter, keywordFilter, hashtagFilter);
        if (BuildRouteStateKey(target) == routeStateKey)
            await ReloadForCurrentRouteAsync(force: true);
        else
            Navigation.NavigateTo(target);
    }

    private bool HasSearchFilters() => !string.IsNullOrWhiteSpace(keywordInput) ||
        !string.IsNullOrWhiteSpace(hashtagInput);

    private bool IsVisibilitySelected(SocialPostVisibility? selectedVisibility) => visibilityFilter == selectedVisibility;

    private (bool IsProfile, SocialPostVisibility? Visibility, Guid? PostId, string Keyword,
        string Hashtag, string Key) ReadRouteState()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var queryStart = relative.IndexOf('?');
        var path = (queryStart >= 0 ? relative[..queryStart] : relative).Trim('/');
        var isCurrentProfile = path.EndsWith("social/profile", StringComparison.OrdinalIgnoreCase);
        var selectedVisibility = isCurrentProfile ? ReadVisibility(relative, queryStart) : SocialPostVisibility.Public;
        var postId = ReadGuid(ReadQueryValue(relative, queryStart, "post"));
        var keyword = ReadQueryValue(relative, queryStart, "keyword") ?? string.Empty;
        var hashtag = ReadQueryValue(relative, queryStart, "hashtag") ?? string.Empty;
        return (isCurrentProfile, selectedVisibility, postId, keyword, hashtag,
            BuildRouteStateKey(isCurrentProfile, selectedVisibility, keyword, hashtag: hashtag, postId: postId));
    }

    private static SocialPostVisibility? ReadVisibility(string relative, int queryStart)
    {
        var value = ReadQueryValue(relative, queryStart, "visibility");
        return Enum.TryParse<SocialPostVisibility>(value, true, out var visibility) ? visibility : null;
    }

    private static Guid? ReadGuid(string? value) =>
        Guid.TryParse(value, out var id) ? id : null;

    private static string? ReadQueryValue(string relative, int queryStart, string key)
    {
        if (queryStart < 0)
            return null;

        var query = relative[(queryStart + 1)..].Split('#')[0];
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && pair[0].Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(pair[1].Replace('+', ' '));
        }

        return null;
    }

    private static string BuildRouteStateKey(bool profile, SocialPostVisibility? selectedVisibility,
        string keyword = "", string hashtag = "", Guid? postId = null) =>
        $"{(profile ? "profile" : "feed")}:{selectedVisibility?.ToString() ?? "all"}|post={postId}|q={keyword}|tag={hashtag}";

    private static string BuildRouteStateKey(string target)
    {
        var queryStart = target.IndexOf('?');
        var path = (queryStart >= 0 ? target[..queryStart] : target).Trim('/');
        var isTargetProfile = path.Equals("social/profile", StringComparison.OrdinalIgnoreCase);
        SocialPostVisibility? selectedVisibility = isTargetProfile ? ReadVisibility(target, queryStart) : SocialPostVisibility.Public;
        var postId = ReadGuid(ReadQueryValue(target, queryStart, "post"));
        return BuildRouteStateKey(isTargetProfile, selectedVisibility,
            ReadQueryValue(target, queryStart, "keyword") ?? string.Empty,
            ReadQueryValue(target, queryStart, "hashtag") ?? string.Empty, postId);
    }

    private static string BuildViewUri(bool profile, SocialPostVisibility? selectedVisibility,
        string? keyword = null, string? hashtag = null, Guid? postId = null)
    {
        var uri = profile
            ? "/social/profile"
            : "/social";
        if (profile && selectedVisibility.HasValue)
            uri += $"?visibility={selectedVisibility.Value.ToString().ToLowerInvariant()}";

        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(keyword))
            parameters.Add($"keyword={Uri.EscapeDataString(keyword.Trim())}");
        if (!string.IsNullOrWhiteSpace(hashtag))
            parameters.Add($"hashtag={Uri.EscapeDataString(hashtag.Trim())}");
        if (postId.HasValue)
            parameters.Add($"post={postId.Value:D}");

        if (parameters.Count > 0)
            uri += uri.Contains('?') ? "&" : "?";
        return uri + string.Join('&', parameters);
    }

    private async Task UploadMediaAsync(InputFileChangeEventArgs args)
    {
        if (isUploadingMedia) return;
        isUploadingMedia = true;
        try
        {
            var remaining = SocialPostRules.MaxMediaItems - uploadedMedia.Count;
            if (remaining <= 0) return;
            foreach (var file in args.GetMultipleFiles(remaining))
            {
                if (file.Size > 25 * 1024 * 1024)
                {
                    await NotifyErrorAsync(L["Social:MediaTooLarge"]);
                    continue;
                }

                try { uploadedMedia.Add(await Social.UploadMediaAsync(file)); }
                catch (CollaborationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.RequestEntityTooLarge)
                { await NotifyErrorAsync(L["Social:MediaTooLarge"]); }
                catch { await NotifyErrorAsync(L["Social:UploadError"]); }
            }
        }
        catch { await NotifyErrorAsync(L["Social:UploadError"]); }
        finally { isUploadingMedia = false; }
    }

    private async Task RemoveMediaAsync(UploadSocialMediaResult media)
    {
        try
        {
            await Social.DeleteUnattachedMediaAsync(media.Id);
            uploadedMedia.RemoveAll(item => item.Id == media.Id);
        }
        catch { await NotifyErrorAsync(L["Social:UploadError"]); }
    }

    private async Task UploadCommentAttachmentsAsync(Guid postId, InputFileChangeEventArgs args)
    {
        if (isUploadingCommentAttachment)
            return;

        if (commentAttachmentPostId is { } existingPostId && existingPostId != postId)
        {
            foreach (var attachment in commentAttachments.ToArray())
            {
                try { await Social.DeleteUnattachedCommentAttachmentAsync(attachment.Id); }
                catch { /* A later cleanup request can remove an abandoned upload. */ }
            }
            commentAttachments.Clear();
        }

        commentAttachmentPostId = postId;
        isUploadingCommentAttachment = true;
        try
        {
            var remaining = SocialPostRules.MaxCommentAttachments - commentAttachments.Count;
            if (remaining <= 0)
                return;

            foreach (var file in args.GetMultipleFiles(remaining))
            {
                if (file.Size > 25 * 1024 * 1024)
                {
                    await NotifyErrorAsync(L["Social:MediaTooLarge"]);
                    continue;
                }

                if (!IsSupportedCommentAttachment(file))
                {
                    await NotifyErrorAsync(L["Social:CommentAttachmentTypeError"]);
                    continue;
                }

                try
                {
                    commentAttachments.Add(await Social.UploadCommentAttachmentAsync(file));
                }
                catch (CollaborationApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.RequestEntityTooLarge)
                {
                    await NotifyErrorAsync(L["Social:MediaTooLarge"]);
                }
                catch
                {
                    await NotifyErrorAsync(L["Social:CommentAttachmentUploadError"]);
                }
            }
        }
        catch
        {
            await NotifyErrorAsync(L["Social:CommentAttachmentUploadError"]);
        }
        finally
        {
            isUploadingCommentAttachment = false;
        }
    }

    private async Task RemoveCommentAttachmentAsync(UploadSocialCommentAttachmentResult attachment)
    {
        try
        {
            await Social.DeleteUnattachedCommentAttachmentAsync(attachment.Id);
            commentAttachments.RemoveAll(item => item.Id == attachment.Id);
            if (commentAttachments.Count == 0)
                commentAttachmentPostId = null;
        }
        catch
        {
            await NotifyErrorAsync(L["Social:CommentAttachmentUploadError"]);
        }
    }

    private static bool IsSupportedCommentAttachment(IBrowserFile file)
    {
        var contentType = file.ContentType?.Trim();
        if (contentType is "image/jpeg" or "image/png" or "image/gif" or "image/webp" or
            "text/plain" or "application/pdf" or "application/msword" or
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document" or
            "application/vnd.ms-excel" or "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" or
            "application/vnd.ms-powerpoint" or "application/vnd.openxmlformats-officedocument.presentationml.presentation")
            return true;

        return Path.GetExtension(file.Name).ToLowerInvariant() is
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".txt" or ".pdf" or
            ".doc" or ".docx" or ".xls" or ".xlsx" or ".ppt" or ".pptx";
    }

    private async Task CreatePostAsync()
    {
        if (isPosting || (string.IsNullOrWhiteSpace(content) && uploadedMedia.Count == 0)) return;
        isPosting = true;
        try
        {
            await Social.CreatePostAsync(new CreateSocialPostInput
            {
                Text = content,
                Visibility = visibility,
                MediaIds = uploadedMedia.Select(media => media.Id).ToArray()
            });
            content = string.Empty;
            uploadedMedia.Clear();
            await LoadAsync();
        }
        catch { await NotifyErrorAsync(L["Social:PostError"]); }
        finally { isPosting = false; }
    }

    private async Task OpenCommentsAsync(SocialPostDto post)
    {
        if (expandedPostIds.Contains(post.Id))
            return;

        expandedPostIds.Add(post.Id);
        if (!commentsByPost.ContainsKey(post.Id))
            await LoadCommentsAsync(post.Id, 0);
    }

    private async Task ToggleCommentsAsync(SocialPostDto post)
    {
        if (!expandedPostIds.Add(post.Id))
        {
            expandedPostIds.Remove(post.Id);
            return;
        }
        if (!commentsByPost.ContainsKey(post.Id))
            await LoadCommentsAsync(post.Id, 0);
    }

    private async Task LoadMoreCommentsAsync(SocialPostDto post)
    {
        if (commentLoadingPostId.HasValue || commentLoadingMorePostId.HasValue ||
            !commentsByPost.TryGetValue(post.Id, out var comments) ||
            !commentTotalCounts.TryGetValue(post.Id, out var total) || comments.Count >= total)
            return;

        await LoadCommentsAsync(post.Id, comments.Count);
    }

    private async Task LoadCommentsAsync(Guid postId, int skip)
    {
        if (skip == 0)
            commentLoadingPostId = postId;
        else
            commentLoadingMorePostId = postId;
        commentErrorPostId = null;
        try
        {
            var result = await Social.GetCommentsAsync(postId, skip, CommentsPageSize);
            if (skip == 0)
            {
                commentsByPost[postId] = result.Items;
            }
            else
            {
                var current = commentsByPost.GetValueOrDefault(postId, []);
                commentsByPost[postId] = current.Concat(result.Items)
                    .GroupBy(comment => comment.Id)
                    .Select(group => group.First())
                    .ToArray();
            }
            commentTotalCounts[postId] = result.TotalCount;
        }
        catch
        {
            commentErrorPostId = postId;
        }
        finally
        {
            if (skip == 0)
                commentLoadingPostId = null;
            else
                commentLoadingMorePostId = null;
        }
    }

    private void BeginReply(SocialPostDto post, SocialCommentDto comment)
    {
        expandedPostIds.Add(post.Id);
        replyingToPostId = post.Id;
        replyingToCommentId = comment.Id;
        commentDraft = string.Empty;
    }

    private void CancelReply()
    {
        replyingToPostId = null;
        replyingToCommentId = null;
        commentDraft = string.Empty;
    }

    private async Task SubmitCommentAsync(Guid postId)
    {
        if (isSubmittingComment || isUploadingCommentAttachment ||
            (string.IsNullOrWhiteSpace(commentDraft) && commentAttachments.Count == 0) ||
            (commentAttachmentPostId.HasValue && commentAttachmentPostId != postId)) return;
        isSubmittingComment = true;
        commentErrorPostId = null;
        try
        {
            var parentId = replyingToPostId == postId ? replyingToCommentId : null;
            var comment = await Social.CreateCommentAsync(postId, new CreateSocialCommentInput
            {
                Text = commentDraft,
                ParentCommentId = parentId,
                AttachmentIds = commentAttachments.Select(attachment => attachment.Id).ToArray()
            });
            var current = commentsByPost.GetValueOrDefault(postId, []);
            commentsByPost[postId] = current.Prepend(comment).Take(CommentsPageSize).ToArray();
            commentTotalCounts[postId] = commentTotalCounts.GetValueOrDefault(postId) + 1;
            var index = posts.FindIndex(post => post.Id == postId);
            if (index >= 0) posts[index] = posts[index] with { CommentCount = posts[index].CommentCount + 1 };
            commentDraft = string.Empty;
            commentAttachments.Clear();
            commentAttachmentPostId = null;
            CancelReply();
        }
        catch { commentErrorPostId = postId; }
        finally { isSubmittingComment = false; }
    }

    private RenderFragment RenderSocialPostText(string text) => builder =>
    {
        var position = 0;
        var sequence = 0;
        foreach (System.Text.RegularExpressions.Match match in HashtagPattern.Matches(text))
        {
            if (match.Index > position)
                builder.AddContent(sequence++, text[position..match.Index]);

            var hashtag = match.Groups["tag"].Value;
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "class", "hcs-social-hashtag");
            builder.AddAttribute(sequence++, "href", BuildViewUri(isProfile, visibilityFilter, hashtag: hashtag));
            builder.AddAttribute(sequence++, "title", string.Format(L["Social:SearchHashtag"].Value, match.Value));
            builder.AddAttribute(sequence++, "aria-label", string.Format(L["Social:SearchHashtag"].Value, match.Value));
            builder.AddContent(sequence++, match.Value);
            builder.CloseElement();
            position = match.Index + match.Length;
        }

        if (position < text.Length)
            builder.AddContent(sequence, text[position..]);
    };

    private string CurrentDisplayName() => currentDisplayName;

    private RenderFragment SocialAvatar(Guid userId, string displayName, string? avatarUrl = null, string extraClass = "") => builder =>
    {
        var resolvedAvatarUrl = ResolveSocialAvatarUrl(userId, avatarUrl);
        var baseClass = string.IsNullOrWhiteSpace(extraClass)
            ? "hcs-social-avatar"
            : $"hcs-social-avatar {extraClass}";

        if (!string.IsNullOrWhiteSpace(resolvedAvatarUrl) && !avatarLoadFailures.Contains(resolvedAvatarUrl))
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "class", $"{baseClass} hcs-social-avatar--image");
            builder.AddAttribute(2, "src", resolvedAvatarUrl);
            builder.AddAttribute(3, "loading", "lazy");
            builder.AddAttribute(4, "crossorigin", "use-credentials");
            builder.AddAttribute(5, "alt", "");
            builder.AddAttribute(6, "aria-hidden", "true");
            builder.AddAttribute(7, "onerror",
                EventCallback.Factory.Create(this, () => MarkAvatarLoadFailure(resolvedAvatarUrl)));
            builder.CloseElement();
            return;
        }

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", $"{baseClass} hcs-social-avatar--accent");
        builder.AddAttribute(2, "aria-hidden", "true");
        builder.AddContent(3, Initials(displayName));
        builder.CloseElement();
    };

    private string? ResolveSocialAvatarUrl(Guid userId, string? avatarUrl)
    {
        if (userId != Guid.Empty && currentUserId == userId && !string.IsNullOrWhiteSpace(personalAvatarDataUrl))
            return personalAvatarDataUrl;

        return ResolveSocialResourceUrl(avatarUrl);
    }

    private string? ResolveSocialResourceUrl(string? resourceUrl)
    {
        if (string.IsNullOrWhiteSpace(resourceUrl))
            return null;
        if (Uri.TryCreate(resourceUrl, UriKind.Absolute, out _))
            return resourceUrl;

        // Media is protected by the Gateway. Use the same configured HttpClient
        // base address as the social API calls instead of the UI host as fallback.
        var gatewayResourceUrl = Social.BuildResourceUrl(resourceUrl);
        if (Uri.TryCreate(gatewayResourceUrl, UriKind.Absolute, out _))
            return gatewayResourceUrl;

        var configuredOrigin = Configuration["Bff:PublicOrigin"] ?? Configuration["RemoteServices:Default:BaseUrl"];
        if (!Uri.TryCreate(configuredOrigin, UriKind.Absolute, out var origin))
            return resourceUrl;

        return new Uri(origin, resourceUrl.TrimStart('/')).AbsoluteUri;
    }

    private void MarkAvatarLoadFailure(string avatarUrl) => avatarLoadFailures.Add(avatarUrl);

    private static bool IsImageAttachment(string? contentType) =>
        contentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;

    private static string FileIcon(string? fileName)
    {
        return Path.GetExtension(fileName ?? string.Empty).ToLowerInvariant() switch
        {
            ".pdf" => "fa-file-pdf",
            ".doc" or ".docx" => "fa-file-word",
            ".xls" or ".xlsx" => "fa-file-excel",
            ".ppt" or ".pptx" => "fa-file-powerpoint",
            ".txt" => "fa-file-lines",
            _ => "fa-file"
        };
    }

    private static string FormatFileSize(long size)
    {
        if (size < 1024)
            return $"{size} B";
        if (size < 1024 * 1024)
            return $"{size / 1024d:0.#} KB";
        return $"{size / (1024d * 1024d):0.#} MB";
    }

    private static string Initials(string? value)
    {
        var parts = (value ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }

        return parts.Length == 1 ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Navigation.LocationChanged -= OnLocationChanged;
            routeLoadGate.Dispose();
        }

        base.Dispose(disposing);
    }
