@page "/event-dashboard"
@attribute [Authorize(Policy = "WorkManagement.Events")]
@inherits HCSComponentBase
@inject WorkManagementClient Work
@inject NavigationManager Navigation

<PageTitle>@L["Menu:EventDashboard"] · HCS</PageTitle>
<section class="page page-wf hcs-event-page" aria-labelledby="event-dashboard-title">
    <div class="page-head">
        <h1 id="event-dashboard-title">@L["Menu:EventDashboard"]</h1>
        <div class="page-actions">
            <a class="btn btn-outline" href="/events">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 7h12M8 12h12M8 17h12"/><path d="M4 7h.01M4 12h.01M4 17h.01"/></svg>
                @L["Menu:ManagedEvents"]
            </a>
            <a class="btn btn-primary" href="/events">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                @L["Event:Create"]
            </a>
        </div>
    </div>

    <form class="docs-toolbar event-filter" @onsubmit="LoadAsync" @onsubmit:preventDefault>
        <span class="filter-label">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
            @L["Work:FilterByDateRange"]
        </span>
        <HcsDatePicker TValue="IReadOnlyList<DateTime?>"
                       Value="selectedDates"
                       ValueChanged="OnRangeChanged"
                       InputMode="DateInputMode.Date"
                       SelectionMode="DateInputSelectionMode.Range"
                       DisplayFormat="dd/MM/yyyy"
                       Placeholder="@L["Work:SelectDateRange"]" />
        <button class="btn btn-primary" type="submit" disabled="@isLoading">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
            @L["Catalog:SearchButton"]
        </button>
    </form>

    @if (isLoading)
    {
        <DocsEmpty Loading="true" />
    }
    else if (dashboard is not null)
    {
        <section class="event-kpis" aria-label="@L["Menu:EventDashboard"]">
            <article class="card event-kpi">
                <span class="event-kpi-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg></span>
                <div><div class="event-kpi-value">@dashboard.TotalEvents</div><div class="event-kpi-label">@L["Event:TotalEvents"]</div></div>
            </article>
            <article class="card event-kpi">
                <span class="event-kpi-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 5 5L20 7"/></svg></span>
                <div><div class="event-kpi-value">@dashboard.CompletedEvents</div><div class="event-kpi-label">@L["Event:CompletedEvents"]</div></div>
            </article>
            <article class="card event-kpi">
                <span class="event-kpi-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg></span>
                <div><div class="event-kpi-value">@dashboard.OngoingEvents</div><div class="event-kpi-label">@L["Event:OngoingEvents"]</div></div>
            </article>
            <article class="card event-kpi">
                <span class="event-kpi-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
                <div><div class="event-kpi-value">@dashboard.UpcomingEvents</div><div class="event-kpi-label">@L["Event:UpcomingEvents"]</div></div>
            </article>
            <article class="card event-kpi">
                <span class="event-kpi-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 11a4 4 0 1 0-8 0"/><path d="M4 20a8 8 0 0 1 16 0"/></svg></span>
                <div><div class="event-kpi-value">@dashboard.TotalAttendees</div><div class="event-kpi-label">@L["Event:TotalAttendees"]</div></div>
            </article>
        </section>
        <section class="event-panel" aria-labelledby="upcoming-title">
            <div class="event-panel-head">
                <div>
                    <p class="event-panel-kicker">@L["Event:UpcomingList"]</p>
                    <h2 id="upcoming-title">@L["Event:UpcomingList"]</h2>
                </div>
                <a class="event-link" href="/events">
                    @L["Event:ViewAll"]
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
            </div>
            @if (dashboard.Upcoming.Count == 0)
            {
                <DocsEmpty Compact="true" Title="@L["Event:NoUpcoming"]" Hint="@L["Event:NoUpcomingDescription"]">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/><path d="M9 15h6"/></svg>
                </DocsEmpty>
            }
            else
            {
                <div class="hcs-event-timeline">
                    @foreach (var item in dashboard.Upcoming)
                    {
                        <a class="hcs-event-timeline__item" href="@($"/events/{item.Id:D}")">
                            <time datetime="@item.StartTime.ToString("O")"><strong>@item.StartTime.ToLocalTime().ToString("dd")</strong><span>@item.StartTime.ToLocalTime().ToString("MMM").ToUpperInvariant()</span></time>
                            <span class="hcs-event-timeline__line" aria-hidden="true"></span>
                            <span class="hcs-event-timeline__content"><strong>@item.Name</strong><small>#@item.Code · @item.StartTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm") – @item.EndTime.ToLocalTime().ToString("HH:mm")</small><small>@(item.Location ?? L["Event:OnlineOrNotSet"])</small></span>
                            <span class="@StatusClass(item.Status)">@StatusLabel(item.Status)</span>
                        </a>
                    }
                </div>
            }
        </section>
    }
</section>

@code {
    private EventDashboardDto? dashboard;
    private DateTime? fromDate = DateTime.Today.AddMonths(-1);
    private DateTime? toDate = DateTime.Today.AddMonths(3);
    private IReadOnlyList<DateTime?> selectedDates = [DateTime.Today.AddMonths(-1), DateTime.Today.AddMonths(3)];
    private bool isLoading;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private Task OnRangeChanged(IReadOnlyList<DateTime?> dates)
    {
        selectedDates = dates;
        if (dates.Count >= 2 && dates[0] is { } start && dates[1] is { } end)
        {
            fromDate = (start <= end ? start : end).Date;
            toDate = (start <= end ? end : start).Date;
            return LoadAsync();
        }

        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            var from = fromDate?.Date;
            var to = toDate?.Date.AddDays(1).AddTicks(-1);
            dashboard = await Work.GetEventDashboardAsync(from, to);
        }
        catch (Exception ex) { await NotifyErrorAsync(ex); }
        finally { isLoading = false; }
    }

    private string StatusLabel(string value) => value switch
    {
        "Preparing" => L["Event:Status.Preparing"].Value,
        "Ongoing" => L["Event:Status.Ongoing"].Value,
        "Completed" => L["Event:Status.Completed"].Value,
        "Cancelled" => L["Event:Status.Cancelled"].Value,
        _ => value
    };
    private static string StatusClass(string value) => value switch
    {
        "Ongoing" => "hcs-status-badge hcs-status-badge--success",
        "Completed" => "hcs-status-badge hcs-status-badge--todo",
        "Cancelled" => "hcs-status-badge hcs-status-badge--danger",
        _ => "hcs-status-badge hcs-status-badge--planning"
    };
}
