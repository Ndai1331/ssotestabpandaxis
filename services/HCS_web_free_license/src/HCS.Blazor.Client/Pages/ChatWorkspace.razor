@page "/chat"
@page "/chat/{RedirectToConversationId:guid}"
@page "/chat1"
@page "/chat1/{RedirectToConversationId:guid}"
@attribute [Authorize(Policy = CollaborationPermissions.Chat)]
@using System.Globalization
@using System.Net
@using HCS.CollaborationService.Contracts
@using HCS.Localization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Volo.Abp.AspNetCore.Components.Messages
@inject CollaborationClient Client
@inject ChatRealtimeConnection Realtime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject IStringLocalizer<HCSResource> Localizer
@inject ILogger<ChatWorkspace> Logger
@inject IUiMessageService UiMessageService
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>@T("Chat:Title") · HCS</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="prototype/chat.css" />
    <link rel="stylesheet" href="prototype/host.css" />
</HeadContent>

<main class="hcs-chat-page page-chat chat-app" aria-labelledby="chat-title" @onclick="CloseMessageMenu">
    <h1 id="chat-title" class="visually-hidden">@T("Chat:Title")</h1>
    <section class="hcs-chat chat-shell @(infoOpen ? "hcs-chat--info-open is-info-open" : "hcs-chat--info-collapsed") @(mobileView == MobileView.Thread ? "is-thread-open" : null)" aria-label="@T("Chat:Title")">
        <aside class="hcs-chat__conversations chat-list @(mobileView == MobileView.List ? "hcs-chat__panel--mobile-active" : null)" aria-label="@T("Chat:ConversationList")">
            <div class="hcs-chat__toolbar chat-list-toolbar">
                <label class="sr-only" for="chat-search">@T("Chat:Search")</label>
                <div class="hcs-chat__search chat-search">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                    <input id="chat-search" @bind="conversationSearch" @bind:event="oninput" type="search" placeholder="@T("Chat:Search")" autocomplete="off" />
                </div>
            </div>
            <nav class="hcs-chat__tabs chat-list-tabs" role="tablist" aria-label="@T("Chat:ConversationList")">
                <button class="chat-list-tab @(leftTab == LeftTab.Conversations ? "is-active" : null)" type="button" role="tab" aria-selected="@(leftTab == LeftTab.Conversations)" @onclick="() => leftTab = LeftTab.Conversations">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16v10H7l-3 3V6z"/></svg>
                    @T("Chat:ConversationsTab")
                </button>
                <button class="chat-list-tab @(leftTab == LeftTab.Contacts ? "is-active" : null)" type="button" role="tab" aria-selected="@(leftTab == LeftTab.Contacts)" @onclick="ShowContactsTabAsync">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>
                    @T("Chat:ContactsTab")
                </button>
            </nav>

            @* The contact picker backs both the "new conversation" panel and the contacts tab. *@
            @if (showNewConversation || leftTab == LeftTab.Contacts)
            {
                var contactListRole = showNewConversation ? "group" : "list";
                var contactListLabel = showNewConversation ? T("Chat:SelectContacts") : T("Chat:Directory");
                <section class="hcs-chat__new chat-list-body chat-contacts @(leftTab == LeftTab.Contacts && !showNewConversation ? "hcs-chat__new--directory" : null)" aria-labelledby="contact-picker-title">
                    @if (showNewConversation)
                    {
                        <div class="hcs-chat__new-heading">
                            <h2 id="contact-picker-title">@T("Chat:NewConversation")</h2>
                            <button class="hcs-chat__close icon-btn" type="button" @onclick="CloseNewConversation" aria-label="@T("Chat:Cancel")">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                            </button>
                        </div>
                    }
                    else
                    {
                        <h2 id="contact-picker-title" class="visually-hidden">@T("Chat:ContactsTab")</h2>
                    }
                    <div class="chat-search chat-contact-search">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
                        <input class="hcs-chat__contact-filter" @bind="contactSearch" @bind:event="oninput" type="search" placeholder="@T("Chat:Search")" autocomplete="off" />
                    </div>
                    @if (contactsLoading)
                    {
                        <p class="hcs-chat__state chat-empty">@T("Chat:LoadingContacts")</p>
                    }
                    else if (contactsError is not null)
                    {
                        <div class="hcs-chat__inline-error" role="alert"><span>@contactsError</span><button type="button" @onclick="LoadContactsAsync">@T("Chat:Retry")</button></div>
                    }
                    else if (!FilteredContacts.Any())
                    {
                        <p class="hcs-chat__state chat-empty">@T("Chat:EmptyContacts")</p>
                    }
                    else
                    {
                        <div class="hcs-chat__contacts chat-contact-list" role="@contactListRole" aria-label="@contactListLabel">
                            @foreach (var contact in FilteredContacts)
                            {
                                <label class="hcs-chat__contact chat-contact">
                                    <input type="checkbox" checked="@selectedContactIds.Contains(contact.Id)" @onchange="args => ToggleContact(contact.Id, args)" />
                                    @UserAvatar(contact.Id, contact.DisplayName, avatarUrl: contact.AvatarUrl)
                                    <span class="chat-contact-meta"><strong>@contact.DisplayName</strong><span>@@@contact.UserName</span></span>
                                </label>
                            }
                        </div>
                    }
                    <div class="chat-contact-foot">
                        @if (selectedContactIds.Count > 1)
                        {
                            <input class="hcs-chat__contact-filter chat-group-name" @bind="groupName" placeholder="@T("Chat:GroupNamePlaceholder")" maxlength="256" />
                        }
                        <button class="btn btn-primary" type="button" @onclick="CreateConversationAsync" disabled="@(isCreatingConversation || selectedContactIds.Count == 0)">
                            @if (isCreatingConversation)
                            {
                                <svg class="chat-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="40 20" stroke-linecap="round"/></svg>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                            }
                            <span class="btn-label">@(isCreatingConversation ? T("Chat:Loading") : T("Chat:CreateConversation"))</span>
                        </button>
                    </div>
                </section>
            }

            @if (leftTab == LeftTab.Conversations)
            {
                @if (isLoadingConversations)
                {
                    <p class="hcs-chat__state chat-empty chat-list-body" role="status">@T("Chat:Loading")</p>
                }
                else if (conversationError is not null)
                {
                    <div class="hcs-chat__state hcs-chat__state--error chat-list-body" role="alert"><p>@conversationError</p><button class="btn btn-light btn-sm" type="button" @onclick="LoadConversationsAsync">@T("Chat:Retry")</button></div>
                }
                else if (!FilteredConversations.Any())
                {
                    <p class="hcs-chat__state chat-empty chat-list-body">@T("Chat:EmptyConversations")</p>
                }
                else
                {
                    <nav class="hcs-chat__conversation-list chat-list-body">
                        @foreach (var conversation in FilteredConversations)
                        {
                            var isActive = selected?.Id == conversation.Id;
                            <button @key="conversation.Id" class="hcs-chat__conversation chat-item @(isActive ? "active is-active" : null) @(conversation.IsPinned ? "is-pinned" : null)" type="button" aria-current="@(isActive ? "true" : null)" @onclick="() => SelectAsync(conversation)">
                                @ConversationAvatar(conversation, isOnline: IsConversationOnline(conversation))
                                <span class="hcs-chat__conversation-copy chat-item-body">
                                    <span class="chat-item-top">
                                        <span class="chat-item-name">@ConversationTitle(conversation)</span>
                                        <span class="chat-item-end">
                                            @if (conversation.IsPinned)
                                            {
                                                <span class="chat-pin-mark" aria-label="@T("Chat:Pin")"></span>
                                            }
                                            <time datetime="@FormatMessageTimestamp(conversation.LastMessageAt)">@FormatConversationTime(conversation.LastMessageAt)</time>
                                        </span>
                                    </span>
                                    <span class="chat-item-preview">@(string.IsNullOrWhiteSpace(conversation.LastMessage) ? T("Chat:NoMessages") : conversation.LastMessage)</span>
                                </span>
                                @if (conversation.UnreadCount > 0)
                                {
                                    <em class="hcs-chat__unread" aria-label="@conversation.UnreadCount @T("Chat:Unread")">@conversation.UnreadCount</em>
                                }
                            </button>
                        }
                    </nav>
                }
            }
        </aside>

        <section class="hcs-chat__thread chat-thread @(mobileView == MobileView.Thread ? "hcs-chat__panel--mobile-active" : null)" aria-label="@T("Chat:Title")">
            @if (selected is null)
            {
                <div class="hcs-chat__empty chat-empty">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16v10H7l-3 3V6z"/></svg>
                    <h2>@T("Chat:ChooseConversation")</h2>
                    <p>@T("Chat:ChooseConversationDescription")</p>
                </div>
            }
            else
            {
                <header @key="selected.Id" class="hcs-chat__thread-header chat-thread-head">
                    <button class="hcs-chat__icon hcs-chat__back icon-btn chat-back" type="button" aria-label="@T("Chat:ConversationList")" @onclick="ShowList">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6 9 12l6 6"/></svg>
                    </button>
                    @ConversationAvatar(selected, isOnline: IsConversationOnline(selected))
                    <div class="hcs-chat__thread-title chat-thread-meta">
                        <h1>@ConversationTitle(selected)</h1>
                        <p class="hcs-chat__thread-status">
                            <span class="chat-status-dot @(IsConversationOnline(selected) ? "is-online" : null)" aria-hidden="true"></span>
                            @ThreadPresenceLabel(selected)
                        </p>
                    </div>
                    <button class="hcs-chat__icon icon-btn @(selected.IsPinned ? "is-active" : null)" type="button" id="chat-pin-conv" aria-pressed="@selected.IsPinned.ToString().ToLowerInvariant()" aria-label="@(selected.IsPinned ? T("Chat:Unpin") : T("Chat:Pin"))" @onclick="TogglePinnedAsync">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 17v5"/><path d="M8 3h8l-1 7a4 4 0 1 1-6 0z"/></svg>
                    </button>
                    <div class="hcs-chat__thread-actions chat-more">
                        <button class="hcs-chat__icon hcs-chat__info-button icon-btn @(infoOpen ? "is-active" : null)" type="button" aria-pressed="@infoOpen.ToString().ToLowerInvariant()" aria-label="@(infoOpen ? T("Chat:HideInformation") : T("Chat:Information"))" @onclick="ToggleInfo">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="12" cy="19" r="1.4"/></svg>
                        </button>
                    </div>
                </header>
                @if (realtimeUnavailable)
                {
                    <p class="hcs-chat__realtime-warning" role="status">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 8 4 12l4 4M16 8l4 4-4 4"/><path d="M10 16 14 8"/></svg>
                        @T("Chat:ConnectionUnavailable")
                    </p>
                }
                @if (pinnedMessages.Count > 0)
                {
                    <div class="hcs-chat__pinned-bar chat-pin-bar @(pinnedPanelOpen ? "is-open" : null)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 17v5"/><path d="M8 3h8l-1 7a4 4 0 1 1-6 0z"/></svg>
                        <button class="chat-pin-bar-body" type="button" aria-expanded="@pinnedPanelOpen.ToString().ToLowerInvariant()" aria-label="@T("Chat:ViewPinned")" @onclick="TogglePinnedPanel">
                            <strong>@T("Chat:PinnedMessages")</strong>
                            <span>@PreviewText(pinnedMessages[0].Text, pinnedMessages[0].Attachments.FirstOrDefault()?.FileName)</span>
                        </button>
                        <button class="icon-btn" type="button" aria-label="@T("Chat:ViewPinned")" @onclick="TogglePinnedPanel">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="@(pinnedPanelOpen ? "M6 6l12 12M18 6 6 18" : "m6 9 6 6 6-6")"/></svg>
                        </button>
                    </div>
                    @if (pinnedPanelOpen)
                    {
                        <div class="hcs-chat__pinned-panel" role="list">
                            @foreach (var pinned in pinnedMessages)
                            {
                                <button class="hcs-chat__pinned-item" type="button" @onclick="() => OpenPinnedMessageAsync(pinned)">
                                    <strong>@MemberName(pinned.SenderUserId)</strong>
                                    <span>@PreviewText(pinned.Text, pinned.Attachments.FirstOrDefault()?.FileName)</span>
                                </button>
                            }
                        </div>
                    }
                }

                <div id="hcs-chat-messages" class="hcs-chat__messages chat-msgs is-active" aria-live="polite" @onscroll="OnMessagesScrollAsync" @onclick="CloseMessageMenu">
                    @if (messages.Count < totalMessageCount)
                    {
                        <button class="hcs-chat__older" type="button" @onclick="LoadOlderMessagesAsync" disabled="@isLoadingMessages">@T("Chat:OlderMessages")</button>
                    }
                    @if (isLoadingMessages && messages.Count == 0)
                    {
                        <div class="hcs-chat__message-skeleton" role="status" aria-label="@T("Chat:LoadingMessages")">
                            <span class="hcs-chat__message-skeleton-bubble hcs-chat__message-skeleton-bubble--wide" aria-hidden="true"></span>
                            <span class="hcs-chat__message-skeleton-bubble hcs-chat__message-skeleton-bubble--mine" aria-hidden="true"></span>
                            <span class="hcs-chat__message-skeleton-bubble" aria-hidden="true"></span>
                        </div>
                    }
                    else if (messageError is not null && messages.Count == 0)
                    {
                        <div class="hcs-chat__state hcs-chat__state--error" role="alert"><p>@messageError</p><button class="btn btn-light btn-sm" type="button" @onclick="() => LoadMessagesAsync(reset: true)">@T("Chat:Retry")</button></div>
                    }
                    else if (messages.Count == 0)
                    {
                        <p class="hcs-chat__state chat-empty">@T("Chat:NoMessages")</p>
                    }
                    else
                    {
                        @foreach (var message in messages)
                        {
                            var isMine = message.SenderUserId == currentUserId;
                            var deletedClass = message.IsDeleted ? "is-recalled" : null;
                            <div class="msg @(isMine ? "is-out" : "is-in") @(message.IsPinned ? "is-pinned" : null) @deletedClass @(messageMenuId == message.Id ? "is-menu-open" : null)">
                                @if (!isMine)
                                {
                                    @UserAvatar(message.SenderUserId, MemberName(message.SenderUserId), "sm", isOnline: IsUserOnline(message.SenderUserId))
                                }
                                <div class="msg-stack">
                                    @if (isMine && !message.IsDeleted)
                                    {
                                        @MessageMoreMenu(message)
                                    }
                                    <div id="@MessageElementId(message.Id)" class="msg-bubble @(IsImageOnly(message) ? "msg-media" : null) @(highlightedMessageId == message.Id ? "is-jump" : null)">
                                        @if (!isMine)
                                        {
                                            <span class="msg-name">@MemberName(message.SenderUserId)</span>
                                        }
                                        @if (message.IsDeleted)
                                        {
                                            <p>@T("Chat:DeletedMessage")</p>
                                        }
                                        else
                                        {
                                            @if (message.ReplyTo is not null || message.ReplyToMessageId is not null)
                                            {
                                                <button class="msg-quote" type="button" @onclick="() => JumpToMessageAsync(message.ReplyToMessageId ?? message.ReplyTo?.Id ?? Guid.Empty)">
                                                    <strong>@(message.ReplyTo is null ? T("Chat:ReplyTo") : $"{T("Chat:ReplyTo")} {MemberName(message.ReplyTo.SenderUserId)}")</strong>
                                                    <span>@(message.ReplyTo?.IsDeleted == true ? T("Chat:DeletedMessage") : PreviewText(message.ReplyTo?.Text))</span>
                                                </button>
                                            }
                                            @if (message.ForwardedFrom is not null || message.ForwardedFromMessageId is not null)
                                            {
                                                <div class="msg-quote">
                                                    <strong>@T("Chat:ForwardedMessage")</strong>
                                                    <span>@(message.ForwardedFrom?.IsDeleted == true ? T("Chat:DeletedMessage") : PreviewText(message.ForwardedFrom?.Text, message.Text))</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(message.Text) && message.ForwardedFromMessageId is null)
                                            {
                                                <p>@message.Text</p>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(message.Text) && message.Text != ChatModerationRules.ForwardedPlaceholder)
                                            {
                                                <p>@message.Text</p>
                                            }
                                            @foreach (var attachment in message.Attachments)
                                            {
                                                @if (IsImage(attachment))
                                                {
                                                    <button class="msg-media-card chat-thumb-img is-teal" type="button" title="@T("Chat:ViewImage")" @onclick="() => OpenPreview(attachment)">
                                                        <img src="@AttachmentUrl(attachment.Id)" crossorigin="use-credentials" alt="@attachment.FileName" />
                                                    </button>
                                                    <span class="msg-media-caption">@attachment.FileName</span>
                                                }
                                                else
                                                {
                                                    var badge = FileBadge(attachment.FileName);
                                                    <a class="msg-file" href="@AttachmentUrl(attachment.Id)" target="_blank" rel="noopener" title="@T("Chat:DownloadFile")" aria-label="@attachment.FileName">
                                                        <span class="chat-thumb-ext @badge.Css">@badge.Label</span>
                                                        <span class="msg-file-name">@attachment.FileName</span>
                                                    </a>
                                                }
                                            }
                                        }
                                        <time class="msg-time" datetime="@FormatMessageTimestamp(message.CreatedAt)">@FormatMessageClock(message.CreatedAt)</time>
                                    </div>
                                    @if (!isMine && !message.IsDeleted)
                                    {
                                        @MessageMoreMenu(message)
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (permissions?.CanSend == true)
                {
                    <form class="chat-compose" @onsubmit="SendAsync" @onsubmit:preventDefault>
                        @if (replyingTo is not null)
                        {
                            <div class="chat-compose-banner">
                                <div>
                                    <strong>@T("Chat:ReplyingTo") @MemberName(replyingTo.SenderUserId)</strong>
                                    <p>@PreviewText(replyingTo.Text)</p>
                                </div>
                                <button class="icon-btn" type="button" aria-label="@T("Chat:CancelReply")" @onclick="CancelReply">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                                </button>
                            </div>
                        }
                        @if (pendingFiles.Count > 0)
                        {
                            <div class="chat-compose-files" aria-label="@T("Chat:Attach")">
                                @foreach (var file in pendingFiles.ToArray())
                                {
                                    var chipBadge = FileBadge(file.Name);
                                    <span class="chat-file-chip">
                                        <span class="chat-thumb-ext @chipBadge.Css">@chipBadge.Label</span>
                                        <span>@file.Name</span>
                                        <button class="icon-btn" type="button" aria-label="@T("Chat:RemoveAttachment")" @onclick="() => RemovePendingFile(file)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                        @if (messageError is not null && messages.Count > 0)
                        {
                            <p class="hcs-chat__composer-error" role="alert">@messageError</p>
                        }
                        <label class="icon-btn chat-attach" title="@T("Chat:Attach")">
                            <InputFile class="sr-only" OnChange="OnFilesSelected" multiple accept="image/*,.pdf,.txt,.docx,.xlsx,.mp4,.mp3" />
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21.4 11.6 12.8 20a5 5 0 0 1-7.1-7.1l9.2-9.2a3.2 3.2 0 0 1 4.5 4.5L10.2 17.4a1.4 1.4 0 1 1-2-2l8.2-8.2"/></svg>
                            <span class="sr-only">@T("Chat:Attach")</span>
                        </label>
                        <label class="sr-only" for="chat-input">@T("Chat:MessagePlaceholder")</label>
                        <div class="chat-input-wrap">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16v10H7l-3 3V6z"/></svg>
                            <textarea id="chat-input" @bind="messageText" @bind:event="oninput" @onkeydown="OnComposerKeyDown" @onkeydown:preventDefault="preventComposerDefault" rows="1" maxlength="4000" placeholder="@T("Chat:MessagePlaceholder")"></textarea>
                        </div>
                        <button class="chat-send" type="submit" disabled="@(isSending || !CanSend)" title="@T("Chat:Send")" aria-label="@T("Chat:Send")">
                            @if (isSending)
                            {
                                <svg class="chat-spin" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="40 20" stroke-linecap="round"/></svg>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg>
                            }
                        </button>
                    </form>
                }
            }
        </section>

        <aside class="hcs-chat__info chat-info @(mobileView == MobileView.Info ? "hcs-chat__panel--mobile-active" : null)" hidden="@(!infoOpen)" aria-label="@T("Chat:Information")">
            @if (selected is null)
            {
                <div class="hcs-chat__info-empty">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/></svg>
                    <p>@T("Chat:ChooseConversation")</p>
                </div>
            }
            else
            {
                <header class="hcs-chat__panel-header chat-info-head">
                    <button class="hcs-chat__icon hcs-chat__back icon-btn chat-back" type="button" aria-label="@T("Chat:HideInformation")" @onclick="CloseInfo">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6 9 12l6 6"/></svg>
                    </button>
                    <p class="chat-info-kicker">@T("Chat:Information")</p>
                </header>
                <div class="hcs-chat__info-body chat-info-body">
                    <div class="chat-info-profile">
                        @ConversationAvatar(selected, "lg", isOnline: IsConversationOnline(selected))
                        @if (isEditingName && permissions?.CanRename == true)
                        {
                            <form class="chat-rename-form" @onsubmit="RenameAsync" @onsubmit:preventDefault>
                                <label class="sr-only" for="chat-rename">@T("Chat:Rename")</label>
                                <input @ref="renameInputRef" class="input chat-rename-input" id="chat-rename" @bind="renameText" @bind:event="oninput" @onkeydown="OnRenameKeyDown" maxlength="80" autocomplete="off" disabled="@isRenaming" />
                                <button class="btn btn-primary btn-sm" type="submit" disabled="@(isRenaming || string.IsNullOrWhiteSpace(renameText))">
                                    @if (isRenaming)
                                    {
                                        <svg class="chat-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="40 20" stroke-linecap="round"/></svg>
                                    }
                                    else
                                    {
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12l4 4L19 6"/></svg>
                                    }
                                    @T("Chat:Save")
                                </button>
                            </form>
                        }
                        else
                        {
                            <button class="chat-name-btn" type="button" disabled="@(permissions?.CanRename != true)" aria-label="@T("Chat:Rename")" @onclick="BeginRename">
                                <span>@ConversationTitle(selected)</span>
                                @if (permissions?.CanRename == true)
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                }
                            </button>
                        }
                        <p class="hcs-chat__info-type">@ConversationTypeLabel(selected.Type)</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(selected.Description))
                    {
                        <p class="hcs-chat__description">@selected.Description</p>
                    }
                    <div class="hcs-chat__info-actions chat-info-actions">
                        <button class="btn btn-outline btn-block" type="button" @onclick="TogglePinnedAsync">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 17v5"/><path d="M8 3h8l-1 7a4 4 0 1 1-6 0z"/></svg>
                            <span>@(selected.IsPinned ? T("Chat:UnpinConversation") : T("Chat:PinConversation"))</span>
                        </button>
                    </div>
                    <section class="hcs-chat__info-section chat-info-section" aria-labelledby="chat-members-label">
                        <div class="chat-info-section-head">
                            <h3 id="chat-members-label">@T("Chat:Members")</h3>
                            @if (CanManageGroupMembers)
                            {
                                <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenAddMembersAsync">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                                    @T("Chat:AddMembers")
                                </button>
                            }
                        </div>
                        <ul class="chat-member-list">
                        @foreach (var member in selected.Members)
                        {
                            <li class="chat-member">
                                @UserAvatar(member.UserId, MemberName(member.UserId), "sm", isOnline: member.UserId != currentUserId ? IsUserOnline(member.UserId) : null)
                                <span class="chat-member-meta"><strong>@MemberName(member.UserId)</strong><span>@(member.Role == ConversationMemberRole.Admin ? T("Chat:Administrator") : T("Chat:Member"))</span></span>
                                @if (CanRemoveMember(member))
                                {
                                    <button class="doc-action is-danger" type="button" title="@T("Chat:RemoveMember")" aria-label="@T("Chat:RemoveMember")" @onclick="() => AskRemoveMember(member)" disabled="@isRemovingMember">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M6 7l1 13h10l1-13"/></svg>
                                    </button>
                                }
                            </li>
                        }
                        </ul>
                    </section>
                    <section class="hcs-chat__info-section chat-info-section" aria-labelledby="chat-pins-label">
                        <h3 id="chat-pins-label">@T("Chat:PinnedSection")</h3>
                        @if (pinnedMessages.Count == 0)
                        {
                            <p class="chat-media-empty">@T("Chat:NoPinnedMessages")</p>
                        }
                        else
                        {
                            @foreach (var pinned in pinnedMessages)
                            {
                                <button class="chat-pin-info" type="button" @onclick="() => OpenPinnedMessageAsync(pinned)">
                                    <strong>@T("Chat:PinnedSection")</strong>
                                    <span>@PreviewText(pinned.Text, pinned.Attachments.FirstOrDefault()?.FileName)</span>
                                </button>
                            }
                        }
                    </section>
                    <section class="hcs-chat__info-section chat-info-section" aria-labelledby="chat-media-label">
                        <h3 id="chat-media-label">@T("Chat:SharedMedia")</h3>
                        <div class="chat-media-tabs" role="tablist" aria-label="@T("Chat:SharedMedia")">
                            <button class="chat-media-tab @(mediaPanel == MediaPanel.Photos ? "is-active" : null)" type="button" role="tab" id="chat-tab-photos" aria-selected="@(mediaPanel == MediaPanel.Photos)" aria-controls="chat-media-photos" @onclick="() => SetMediaPanel(MediaPanel.Photos)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="m21 15-4.5-4.5L7 20"/></svg>
                                @T("Chat:Photos")
                            </button>
                            <button class="chat-media-tab @(mediaPanel == MediaPanel.Files ? "is-active" : null)" type="button" role="tab" id="chat-tab-files" aria-selected="@(mediaPanel == MediaPanel.Files)" aria-controls="chat-media-files" @onclick="() => SetMediaPanel(MediaPanel.Files)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/></svg>
                                @T("Chat:Files")
                            </button>
                        </div>
                        @if (mediaPanel == MediaPanel.Photos)
                        {
                            <div class="chat-media-grid" id="chat-media-photos" role="tabpanel" aria-labelledby="chat-tab-photos">
                                @if (!ConversationPhotos.Any())
                                {
                                    <p class="chat-media-empty">@T("Chat:NoPhotos")</p>
                                }
                                else
                                {
                                    @foreach (var attachment in ConversationPhotos)
                                    {
                                        <button class="chat-thumb" type="button" title="@T("Chat:ViewImage")" aria-label="@attachment.FileName" @onclick="() => OpenPreview(attachment)">
                                            <img src="@AttachmentUrl(attachment.Id)" crossorigin="use-credentials" alt="@attachment.FileName" />
                                        </button>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="chat-media-grid" id="chat-media-files" role="tabpanel" aria-labelledby="chat-tab-files">
                                @if (!ConversationFiles.Any())
                                {
                                    <p class="chat-media-empty">@T("Chat:NoFiles")</p>
                                }
                                else
                                {
                                    @foreach (var attachment in ConversationFiles)
                                    {
                                        <a class="chat-thumb chat-thumb-file" href="@AttachmentUrl(attachment.Id)" target="_blank" rel="noopener" title="@T("Chat:DownloadFile")" aria-label="@attachment.FileName">
                                            @{ var mediaBadge = FileBadge(attachment.FileName); }
                                            <span class="chat-thumb-ext @mediaBadge.Css">@mediaBadge.Label</span>
                                            <span class="chat-thumb-name">@attachment.FileName</span>
                                        </a>
                                    }
                                }
                            </div>
                        }
                    </section>
                    @if (permissions?.CanLeave == true)
                    {
                        <div class="hcs-chat__info-actions chat-info-actions">
                            <button class="btn btn-danger btn-block" type="button" @onclick="LeaveAsync" disabled="@isLeaving">
                                @if (isLeaving)
                                {
                                    <svg class="chat-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="40 20" stroke-linecap="round"/></svg>
                                }
                                else
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 7H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/><path d="M16 3h5v5"/><path d="M10 14 21 3"/></svg>
                                }
                                @T("Chat:Leave")
                            </button>
                        </div>
                    }
                </div>
            }
        </aside>
    </section>
    @if (messageMenuId is { } openMenuId && messages.FirstOrDefault(item => item.Id == openMenuId) is { } menuMessage)
    {
        <div class="msg-menu" id="chat-msg-menu" role="menu" aria-label="@T("Chat:MessageActions")" @onclick:stopPropagation="true">
            <button type="button" role="menuitem" disabled="@isPinningMessage" @onclick="() => ToggleMessagePinnedAsync(menuMessage)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 17v5"/><path d="M8 3h8l-1 7a4 4 0 1 1-6 0z"/></svg>
                @(menuMessage.IsPinned ? T("Chat:UnpinMessage") : T("Chat:PinMessage"))
            </button>
            <button type="button" role="menuitem" @onclick="() => ForwardFromMenu(menuMessage)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 17l5-5-5-5"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg>
                @T("Chat:Forward")
            </button>
            <button type="button" role="menuitem" @onclick="() => ReplyFromMenu(menuMessage)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
                @T("Chat:Reply")
            </button>
            @if (CanDeleteMessage(menuMessage))
            {
                <button class="is-danger" type="button" role="menuitem" disabled="@isDeletingMessage" @onclick="() => DeleteFromMenuAsync(menuMessage)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M6 7l1 13h10l1-13"/></svg>
                    @T("Chat:Delete")
                </button>
            }
        </div>
    }
    @if (previewAttachment is not null)
    {
        <div class="modal-overlay is-open" role="dialog" aria-modal="true" aria-labelledby="chat-preview-title" @onclick="ClosePreview">
            <div class="chat-preview-dialog" @onclick:stopPropagation>
                <div class="chat-dialog-head">
                    <h2 id="chat-preview-title">@T("Chat:ViewImage")</h2>
                    <button class="icon-btn" type="button" aria-label="@T("Chat:ClosePreview")" @onclick="ClosePreview">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>
                @if (IsImage(previewAttachment))
                {
                    <img src="@AttachmentUrl(previewAttachment.Id)" crossorigin="use-credentials" alt="@T("Chat:ViewImage")" />
                }
            </div>
        </div>
    }
    @if (forwardingMessage is not null)
    {
        <div class="modal-overlay is-open" role="dialog" aria-modal="true" aria-labelledby="chat-forward-title" @onclick="CloseForward">
            <div class="chat-dialog" @onclick:stopPropagation>
                <div class="chat-dialog-head">
                    <h2 id="chat-forward-title">@T("Chat:Forward")</h2>
                    <button class="icon-btn" type="button" aria-label="@T("Chat:Cancel")" @onclick="CloseForward">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>
                <div class="chat-dialog-view">
                    <input class="input" @bind="forwardSearch" @bind:event="oninput" type="search" placeholder="@T("Chat:Search")" />
                    <div class="forward-list" role="listbox" aria-label="@T("Chat:ForwardTo")">
                        @foreach (var conversation in ForwardTargets)
                        {
                            <button class="forward-option @(forwardTargetId == conversation.Id ? "is-selected" : null)" type="button" role="option" aria-selected="@(forwardTargetId == conversation.Id)" @onclick="() => forwardTargetId = conversation.Id">
                                @ConversationAvatar(conversation, "sm")
                                <span>@ConversationTitle(conversation)</span>
                            </button>
                        }
                    </div>
                    <label class="field-label" for="forward-note">@T("Chat:ForwardCommentPlaceholder")</label>
                    <input class="input" id="forward-note" @bind="forwardComment" maxlength="4000" placeholder="@T("Chat:ForwardCommentPlaceholder")" />
                </div>
                <div class="chat-dialog-foot">
                    <button class="btn btn-outline" type="button" @onclick="CloseForward">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                        <span>@T("Chat:Cancel")</span>
                    </button>
                    <button class="btn btn-primary" type="button" @onclick="ForwardAsync" disabled="@(isForwarding || forwardTargetId is null)">
                        @if (isForwarding)
                        {
                            <svg class="chat-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="40 20" stroke-linecap="round"/></svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 17l5-5-5-5"/><path d="M4 18v-2a4 4 0 0 1 4-4h12"/></svg>
                        }
                        <span class="btn-label">@T("Chat:Forward")</span>
                    </button>
                </div>
            </div>
        </div>
    }
    @if (showTransferAdmin && selected is not null)
    {
        <div class="modal-overlay is-open" role="dialog" aria-modal="true" aria-labelledby="chat-transfer-title" @onclick="CloseTransferAdmin">
            <div class="chat-dialog" @onclick:stopPropagation>
                <div class="chat-dialog-head">
                    <h2 id="chat-transfer-title">@T("Chat:TransferAdmin")</h2>
                    <button class="icon-btn" type="button" aria-label="@T("Chat:Cancel")" @onclick="CloseTransferAdmin">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>
                <div class="chat-dialog-view">
                    <p class="chat-dialog-copy">@T("Chat:TransferAdminHint")</p>
                    @if (messageError is not null)
                    {
                        <p class="chat-dialog-copy" role="alert">@messageError</p>
                    }
                    <div class="forward-list" role="listbox" aria-label="@T("Chat:TransferAdmin")">
                        @foreach (var member in TransferCandidates)
                        {
                            <button class="forward-option @(transferAdminTo == member.UserId ? "is-selected" : null)" type="button" role="option" aria-selected="@(transferAdminTo == member.UserId)" @onclick="() => transferAdminTo = member.UserId">
                                <span>@MemberName(member.UserId)</span>
                            </button>
                        }
                    </div>
                </div>
                <div class="chat-dialog-foot">
                    <button class="btn btn-outline" type="button" @onclick="CloseTransferAdmin">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                        <span>@T("Chat:Cancel")</span>
                    </button>
                    <button class="btn btn-primary" type="button" @onclick="ConfirmTransferLeaveAsync" disabled="@(isLeaving || transferAdminTo is null)">
                        @if (isLeaving)
                        {
                            <svg class="chat-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="40 20" stroke-linecap="round"/></svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 7H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/><path d="M16 3h5v5"/><path d="M10 14 21 3"/></svg>
                        }
                        <span class="btn-label">@T("Chat:Leave")</span>
                    </button>
                </div>
            </div>
        </div>
    }
    @if (showAddMembers)
    {
        <div class="modal-overlay is-open" role="dialog" aria-modal="true" aria-labelledby="chat-add-members-title" @onclick="CloseAddMembers">
            <div class="chat-dialog" @onclick:stopPropagation>
                <div class="chat-dialog-head">
                    <h2 id="chat-add-members-title">@T("Chat:AddMembers")</h2>
                    <button class="icon-btn" type="button" aria-label="@T("Chat:Cancel")" @onclick="CloseAddMembers">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>
                <div class="chat-dialog-view">
                    <label class="sr-only" for="chat-add-member-search">@T("Chat:SearchPeople")</label>
                    <input class="input" id="chat-add-member-search" @bind="addMemberSearch" @bind:event="oninput" type="search" placeholder="@T("Chat:SearchPeople")" autocomplete="off" />
                    <div class="forward-list" role="listbox" aria-multiselectable="true" aria-label="@T("Chat:SelectMembers")">
                        @if (!FilteredAddMemberContacts.Any())
                        {
                            <p class="chat-dialog-copy">@T("Chat:NoMembersToAdd")</p>
                        }
                        else
                        {
                            @foreach (var contact in FilteredAddMemberContacts)
                            {
                                var selectedContact = selectedMemberIds.Contains(contact.Id);
                                <button class="forward-option @(selectedContact ? "is-selected" : null)" type="button" role="option" aria-selected="@selectedContact" @onclick="() => ToggleMemberId(contact.Id)">
                                    @UserAvatar(contact.Id, contact.DisplayName, "sm", avatarUrl: contact.AvatarUrl)
                                    <span>@contact.DisplayName</span>
                                </button>
                            }
                        }
                    </div>
                </div>
                <div class="chat-dialog-foot">
                    <button class="btn btn-outline" type="button" @onclick="CloseAddMembers">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                        <span>@T("Chat:Cancel")</span>
                    </button>
                    <button class="btn btn-primary" type="button" @onclick="AddMembersAsync" disabled="@(isAddingMembers || selectedMemberIds.Count == 0)">
                        @if (isAddingMembers)
                        {
                            <svg class="chat-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="40 20" stroke-linecap="round"/></svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        }
                        <span class="btn-label">@T("Chat:AddMembers")</span>
                    </button>
                </div>
            </div>
        </div>
    }
    @if (memberPendingRemoval is { } pendingMember)
    {
        <div class="modal-overlay is-open" role="dialog" aria-modal="true" aria-labelledby="chat-remove-member-title" @onclick="CloseRemoveMember">
            <div class="chat-dialog" @onclick:stopPropagation>
                <div class="chat-dialog-head">
                    <h2 id="chat-remove-member-title">@T("Chat:RemoveMember")</h2>
                    <button class="icon-btn" type="button" aria-label="@T("Chat:Cancel")" @onclick="CloseRemoveMember">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>
                <div class="chat-dialog-view">
                    <p class="chat-dialog-copy">@T("Chat:RemoveMemberConfirm")</p>
                    <p class="chat-dialog-copy"><strong>@MemberName(pendingMember.UserId)</strong></p>
                </div>
                <div class="chat-dialog-foot">
                    <button class="btn btn-outline" type="button" @onclick="CloseRemoveMember">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                        <span>@T("Chat:Cancel")</span>
                    </button>
                    <button class="btn btn-danger" type="button" @onclick="ConfirmRemoveMemberAsync" disabled="@isRemovingMember">
                        @if (isRemovingMember)
                        {
                            <svg class="chat-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke-dasharray="40 20" stroke-linecap="round"/></svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M6 7l1 13h10l1-13"/></svg>
                        }
                        <span class="btn-label">@T("Chat:RemoveMember")</span>
                    </button>
                </div>
            </div>
        </div>
    }
</main>

@code {
    [Parameter] public Guid? RedirectToConversationId { get; set; }

    private readonly HashSet<Guid> onlineUserIds = [];
    private readonly HashSet<Guid> selectedContactIds = [];
    private readonly HashSet<Guid> selectedMemberIds = [];
    private readonly HashSet<string> avatarLoadFailures = new(StringComparer.Ordinal);
    private readonly List<IBrowserFile> pendingFiles = [];
    private readonly List<ChatMessageDto> messages = [];
    private IReadOnlyList<ConversationDto> conversations = [];
    private IReadOnlyList<ChatContactDto> contacts = [];
    private ConversationDto? selected;
    private ConversationPermissionDto? permissions;
    private Guid? currentUserId;
    private string conversationSearch = string.Empty;
    private string contactSearch = string.Empty;
    private string groupName = string.Empty;
    private string messageText = string.Empty;
    private string renameText = string.Empty;
    private string addMemberSearch = string.Empty;
    private bool isEditingName;
    private bool showAddMembers;
    private bool focusRenameAfterRender;
    private ElementReference renameInputRef;
    private ConversationMemberDto? memberPendingRemoval;
    private string? conversationError;
    private string? contactsError;
    private string? messageError;
    private bool isLoadingConversations;
    private bool contactsLoading;
    private bool isLoadingMessages;
    private bool isSending;
    private bool isCreatingConversation;
    private bool isRenaming;
    private bool isAddingMembers;
    private bool isLeaving;
    private bool showNewConversation;
    private LeftTab leftTab = LeftTab.Conversations;
    private bool realtimeUnavailable;
    private int messageSkip;
    private long totalMessageCount;
    private MobileView mobileView = MobileView.List;
    private bool infoOpen;
    private bool preventComposerDefault;
    private MessageAttachmentDto? previewAttachment;
    private MediaPanel mediaPanel = MediaPanel.Photos;
    private ChatMessageDto? replyingTo;
    private ChatMessageDto? forwardingMessage;
    private Guid? highlightedMessageId;
    private Guid? messageMenuId;
    private Guid? jumpToMessageIdAfterRender;
    private Guid? forwardTargetId;
    private bool scrollToBottomAfterRender;
    private bool isDeletingMessage;
    private bool isPinningMessage;
    private bool isForwarding;
    private bool isRemovingMember;
    private bool allowOlderScroll;
    private bool pinnedPanelOpen;
    private readonly List<ChatMessageDto> pinnedMessages = [];
    private string forwardComment = string.Empty;
    private string forwardSearch = string.Empty;
    private bool showTransferAdmin;
    private Guid? transferAdminTo;

    private bool CanSend => !string.IsNullOrWhiteSpace(messageText) || pendingFiles.Count > 0;

    private IEnumerable<MessageAttachmentDto> ConversationPhotos => ConversationAttachments.Where(IsImage);

    private IEnumerable<MessageAttachmentDto> ConversationFiles => ConversationAttachments.Where(attachment => !IsImage(attachment));

    private IEnumerable<MessageAttachmentDto> ConversationAttachments => messages
        .Where(message => !message.IsDeleted)
        .SelectMany(message => message.Attachments)
        .GroupBy(attachment => attachment.Id)
        .Select(group => group.First());

    private IEnumerable<ConversationDto> FilteredConversations => conversations.Where(conversation =>
        string.IsNullOrWhiteSpace(conversationSearch) ||
        ConversationTitle(conversation).Contains(conversationSearch.Trim(), StringComparison.CurrentCultureIgnoreCase) ||
        (conversation.LastMessage?.Contains(conversationSearch.Trim(), StringComparison.CurrentCultureIgnoreCase) ?? false))
        .OrderByDescending(conversation => conversation.IsPinned)
        .ThenByDescending(conversation => conversation.LastMessageAt ?? DateTime.MinValue);

    private IEnumerable<ChatContactDto> FilteredContacts => contacts.Where(contact =>
        string.IsNullOrWhiteSpace(contactSearch) ||
        contact.DisplayName.Contains(contactSearch.Trim(), StringComparison.CurrentCultureIgnoreCase) ||
        contact.UserName.Contains(contactSearch.Trim(), StringComparison.CurrentCultureIgnoreCase));

    private bool CanManageGroupMembers =>
        selected is not null &&
        permissions?.CanManageMembers == true &&
        selected.Type != ConversationType.User;

    private IEnumerable<ChatContactDto> AvailableMemberContacts => selected is null
        ? []
        : contacts.Where(contact => !selected.Members.Any(member => member.UserId == contact.Id));

    private IEnumerable<ChatContactDto> FilteredAddMemberContacts => AvailableMemberContacts.Where(contact =>
        string.IsNullOrWhiteSpace(addMemberSearch) ||
        contact.DisplayName.Contains(addMemberSearch.Trim(), StringComparison.CurrentCultureIgnoreCase) ||
        contact.UserName.Contains(addMemberSearch.Trim(), StringComparison.CurrentCultureIgnoreCase));

    private IEnumerable<ConversationDto> ForwardTargets => conversations.Where(conversation =>
        selected is not null &&
        conversation.Id != selected.Id &&
        (string.IsNullOrWhiteSpace(forwardSearch) ||
         ConversationTitle(conversation).Contains(forwardSearch.Trim(), StringComparison.CurrentCultureIgnoreCase)));

    private bool IsSoleAdminWithOthers =>
        selected is not null &&
        currentUserId is Guid me &&
        selected.Members.Any(member => member.UserId == me && member.Role == ConversationMemberRole.Admin) &&
        selected.Members.Count(member => member.Role == ConversationMemberRole.Admin) == 1 &&
        selected.Members.Any(member => member.UserId != me);

    private IEnumerable<ConversationMemberDto> TransferCandidates =>
        selected?.Members.Where(member => member.UserId != currentUserId) ?? [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(
                state.User.FindFirst("sub")?.Value ??
                state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            out var userId))
        {
            currentUserId = userId;
        }

        Realtime.Changed += HandleRealtimeChangeAsync;
        Realtime.MessageReceived += HandleMessageReceivedAsync;
        Realtime.MessageDeleted += HandleMessageDeletedAsync;
        Realtime.PresenceChanged += HandlePresenceChangedAsync;
        Realtime.PresenceSnapshot += HandlePresenceSnapshotAsync;
        Realtime.StatusChanged += HandleRealtimeStatusAsync;
        try
        {
            await Realtime.EnsureStartedAsync();
            realtimeUnavailable = !Realtime.IsConnected;
        }
        catch (Exception exception)
        {
            LogChatError(exception, "start realtime connection");
            realtimeUnavailable = true;
        }

        await LoadContactsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadConversationsAsync();
        if (RedirectToConversationId is { } redirectId && conversations.FirstOrDefault(item => item.Id == redirectId) is { } target)
        {
            await SelectAsync(target);
        }
    }

    private async Task LoadConversationsAsync()
    {
        isLoadingConversations = true;
