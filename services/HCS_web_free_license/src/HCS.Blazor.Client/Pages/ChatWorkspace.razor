    private static (string Css, string Label) FileBadge(string? fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName ?? string.Empty).TrimStart('.').ToUpperInvariant();
        var css = ext switch
        {
            "PDF" => "is-pdf",
            "DOC" or "DOCX" => "is-doc",
            "XLS" or "XLSX" => "is-xls",
            "PPT" or "PPTX" => "is-doc",
            "TXT" => "is-txt",
            _ => "is-txt"
        };
        var label = string.IsNullOrEmpty(ext) ? "FILE" : (ext.Length > 4 ? ext[..4] : ext);
        return (css, label);
    }

    private static string FormatMessageClock(DateTime value) =>
        value.Year < 2 ? string.Empty : ToLocal(value).ToString("h:mm tt");

    private static string FormatMessageTimestamp(DateTime? value) =>
        value is not { Year: > 1 } ? string.Empty : ToLocal(value.Value).ToUniversalTime().ToString("O");

    private string FormatConversationTime(DateTime? value)
    {
        if (value is not { Year: > 1 }) return string.Empty;
        var local = ToLocal(value.Value);
        var now = DateTime.Now;
        var delta = now - local;
        if (delta.TotalMinutes < 1) return T("Chat:JustNow");
        if (delta.TotalHours < 1) return string.Format(T("Chat:MinutesAgo"), Math.Max(1, (int)delta.TotalMinutes));
        if (local.Date == now.Date) return local.ToString("h:mm tt");
        if (local.Date == now.Date.AddDays(-1)) return T("Chat:Yesterday");
        return local.ToString("dd/MM");
    }

    private static DateTime ToLocal(DateTime value) =>
        value.Kind == DateTimeKind.Utc ? value.ToLocalTime() : DateTime.SpecifyKind(value, DateTimeKind.Utc).ToLocalTime();

    private async Task HandleRealtimeChangeAsync()
    {
        await InvokeAsync(async () =>
        {
            await LoadConversationsAsync();
            StateHasChanged();
        });
    }

    private async Task HandleRealtimeStatusAsync(HubConnectionState state)
    {
        await InvokeAsync(() =>
        {
            realtimeUnavailable = state != HubConnectionState.Connected;
            if (state != HubConnectionState.Connected)
            {
                onlineUserIds.Clear();
            }

            StateHasChanged();
        });
    }

    private async Task HandlePresenceChangedAsync(PresenceChangedDto change)
    {
        await InvokeAsync(() =>
        {
            if (change.IsOnline)
            {
                onlineUserIds.Add(change.UserId);
            }
            else
            {
                onlineUserIds.Remove(change.UserId);
            }

            StateHasChanged();
        });
    }

    private async Task HandlePresenceSnapshotAsync(IReadOnlyList<Guid> userIds)
    {
        await InvokeAsync(() =>
        {
            onlineUserIds.Clear();
            foreach (var userId in userIds)
            {
                onlineUserIds.Add(userId);
            }

            StateHasChanged();
        });
    }

    private bool IsUserOnline(Guid userId) => onlineUserIds.Contains(userId);

    private bool IsConversationOnline(ConversationDto conversation)
    {
        if (conversation.Type == ConversationType.User)
        {
            var peer = conversation.Members.FirstOrDefault(member => member.UserId != currentUserId);
            return peer is not null && IsUserOnline(peer.UserId);
        }

        return conversation.Members.Any(member => member.UserId != currentUserId && IsUserOnline(member.UserId));
    }

    private int OnlineMemberCount(ConversationDto conversation) =>
        conversation.Members.Count(member => member.UserId != currentUserId && IsUserOnline(member.UserId));

    private string ThreadPresenceLabel(ConversationDto conversation)
    {
        var typeLabel = ConversationTypeLabel(conversation.Type);
        if (conversation.Type == ConversationType.User)
        {
            return $"{(IsConversationOnline(conversation) ? T("Chat:Active") : T("Chat:Offline"))} · {typeLabel}";
        }

        var onlineCount = OnlineMemberCount(conversation);
        return onlineCount > 0
            ? $"{string.Format(T("Chat:MembersOnline"), onlineCount)} · {typeLabel}"
            : $"{T("Chat:Offline")} · {typeLabel}";
    }

    private string ConversationTitle(ConversationDto conversation)
    {
        if (!string.IsNullOrWhiteSpace(conversation.Name))
        {
            return conversation.Name;
        }

        if (conversation.Type == ConversationType.User)
        {
            var other = conversation.Members.FirstOrDefault(member => member.UserId != currentUserId);
            return other is null ? T("Chat:DirectConversation") : MemberName(other.UserId);
        }

        return ConversationTypeLabel(conversation.Type);
    }

    private string ConversationTypeLabel(ConversationType type) => type switch
    {
        ConversationType.User => T("Chat:DirectConversation"),
        ConversationType.Group => T("Chat:GroupConversation"),
        ConversationType.Project => T("Chat:ProjectConversation"),
        ConversationType.Task => T("Chat:TaskConversation"),
        _ => T("Chat:UnknownConversation")
    };

    private string ConversationInitials(ConversationDto conversation) => Initials(ConversationTitle(conversation));

    private Guid? DirectConversationUserId(ConversationDto conversation) =>
        conversation.Type == ConversationType.User
            ? conversation.Members.FirstOrDefault(member => member.UserId != currentUserId)?.UserId
            : null;

