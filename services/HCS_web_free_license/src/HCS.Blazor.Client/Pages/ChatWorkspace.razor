            if (selected is not null && conversations.FirstOrDefault(item => item.Id == selected.Id) is { } current)
            {
                selected = current;
            }
        }
        catch (Exception exception)
        {
            conversationError = MapChatError(exception, "Chat:LoadError");
        }
        finally
        {
            isLoadingConversations = false;
        }
    }

