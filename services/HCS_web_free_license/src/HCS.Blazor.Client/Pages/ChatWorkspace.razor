    private async Task LeaveAsync()
    {
        if (selected is null || isLeaving)
        {
            return;
        }

        if (IsSoleAdminWithOthers)
        {
            transferAdminTo = TransferCandidates.FirstOrDefault()?.UserId;
            showTransferAdmin = true;
            return;
        }

        if (!await UiMessageService.Confirm(T("Chat:LeaveConfirm")))
        {
            return;
        }

        await ExecuteLeaveAsync(null);
    }

    private Task ConfirmTransferLeaveAsync() => ExecuteLeaveAsync(transferAdminTo);

    private void CloseTransferAdmin()
    {
        showTransferAdmin = false;
        transferAdminTo = null;
    }

    private async Task ExecuteLeaveAsync(Guid? successorAdminId)
    {
        if (selected is null || isLeaving)
        {
            return;
        }

        isLeaving = true;
        try
        {
            await Client.LeaveAsync(selected.Id, successorAdminId);
            selected = null;
            permissions = null;
            messages.Clear();
            Realtime.ActiveConversationId = null;
            showTransferAdmin = false;
            transferAdminTo = null;
            await LoadConversationsAsync();
            ShowList();
        }
        catch (Exception exception)
        {
            messageError = MapChatError(exception, "Chat:LoadError");
        }
        finally
        {
            isLeaving = false;
        }
    }

