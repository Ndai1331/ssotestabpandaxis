@page "/chat"
@page "/chat/{RedirectToConversationId:guid}"
@page "/chat1"
@page "/chat1/{RedirectToConversationId:guid}"
@attribute [Authorize(Policy = CollaborationPermissions.Chat)]
@using System.Globalization
@using System.Net
@using HCS.CollaborationService.Contracts
@using HCS.Localization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Volo.Abp.AspNetCore.Components.Messages
@inject CollaborationClient Client
@inject ChatRealtimeConnection Realtime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<HCSResource> Localizer
@inject ILogger<ChatWorkspace> Logger
@inject IUiMessageService UiMessageService
@implements IAsyncDisposable

<PageTitle>@T("Chat:Title") · HCS</PageTitle>

<main class="hcs-chat-page" aria-labelledby="chat-title">
    <section class="hcs-chat" aria-label="@T("Chat:Title")">
        <aside class="hcs-chat__conversations @(mobileView == MobileView.List ? "hcs-chat__panel--mobile-active" : null)" aria-label="@T("Chat:ConversationList")">
            <header class="hcs-chat__panel-header">
                <div>
                    <small>@T("Chat:Directory")</small>
                    <h1 id="chat-title">@T("Chat:Title")</h1>
                </div>
                <div class="hcs-chat__header-actions">
                    <button class="hcs-chat__icon" type="button" title="@T("Chat:Retry")" aria-label="@T("Chat:Retry")" @onclick="LoadConversationsAsync" disabled="@isLoadingConversations">
                        <i class="fa fa-rotate @(isLoadingConversations ? "fa-spin" : null)" aria-hidden="true"></i>
                    </button>
                    <button class="hcs-chat__icon hcs-chat__icon--primary" type="button" title="@T("Chat:NewConversation")" aria-label="@T("Chat:NewConversation")" @onclick="OpenNewConversation">
                        <i class="fa fa-pen-to-square" aria-hidden="true"></i>
                    </button>
                </div>
            </header>

            <label class="hcs-chat__search">
                <span class="visually-hidden">@T("Chat:Search")</span>
                <i class="fa fa-magnifying-glass" aria-hidden="true"></i>
                <input @bind="conversationSearch" @bind:event="oninput" type="search" placeholder="@T("Chat:Search")" />
            </label>
            <nav class="hcs-chat__tabs" role="tablist">
                <button class="@(leftTab == LeftTab.Conversations ? "is-active" : null)" type="button" role="tab" @onclick="() => leftTab = LeftTab.Conversations">@T("Chat:ConversationsTab")</button>
                <button class="@(leftTab == LeftTab.Contacts ? "is-active" : null)" type="button" role="tab" @onclick="ShowContactsTabAsync">@T("Chat:ContactsTab")</button>
            </nav>

            @* The contact picker backs both the "new conversation" panel and the contacts tab. *@
            @if (showNewConversation || leftTab == LeftTab.Contacts)
            {
                var contactListRole = showNewConversation ? "group" : "list";
                var contactListLabel = showNewConversation ? T("Chat:SelectContacts") : T("Chat:Directory");
                <section class="hcs-chat__new" aria-labelledby="contact-picker-title">
                    @if (showNewConversation)
                    {
                        <div class="hcs-chat__new-heading">
                            <h2 id="contact-picker-title">@T("Chat:NewConversation")</h2>
                            <button class="hcs-chat__close" type="button" @onclick="CloseNewConversation" aria-label="@T("Chat:Cancel")"><i class="fa fa-xmark" aria-hidden="true"></i></button>
                        </div>
                    }
                    else
                    {
                        <h2 id="contact-picker-title" class="visually-hidden">@T("Chat:ContactsTab")</h2>
                    }
                    <input class="hcs-chat__contact-filter" @bind="contactSearch" @bind:event="oninput" type="search" placeholder="@T("Chat:Search")" />
                    @if (contactsLoading)
                    {
                        <p class="hcs-chat__state">@T("Chat:LoadingContacts")</p>
                    }
                    else if (contactsError is not null)
                    {
                        <div class="hcs-chat__inline-error" role="alert"><span>@contactsError</span><button type="button" @onclick="LoadContactsAsync">@T("Chat:Retry")</button></div>
                    }
                    else if (!FilteredContacts.Any())
                    {
                        <p class="hcs-chat__state">@T("Chat:EmptyContacts")</p>
                    }
                    else
                    {
                        <div class="hcs-chat__contacts" role="@contactListRole" aria-label="@contactListLabel">
                            @foreach (var contact in FilteredContacts)
                            {
                                <label class="hcs-chat__contact">
                                    <input type="checkbox" checked="@selectedContactIds.Contains(contact.Id)" @onchange="args => ToggleContact(contact.Id, args)" />
                                    <span class="hcs-chat__avatar">@Initials(contact.DisplayName)</span>
                                    <span><strong>@contact.DisplayName</strong><small>@@@contact.UserName</small></span>
                                </label>
                            }
                        </div>
                    }
                    @if (selectedContactIds.Count > 1)
                    {
                        <input class="hcs-chat__contact-filter" @bind="groupName" placeholder="@T("Chat:GroupNamePlaceholder")" maxlength="256" />
                    }
                    <button class="btn btn-primary w-100" type="button" @onclick="CreateConversationAsync" disabled="@(isCreatingConversation || selectedContactIds.Count == 0)">
                        <i class="fa @(isCreatingConversation ? "fa-spinner fa-spin" : "fa-plus")" aria-hidden="true"></i>
                        @(isCreatingConversation ? T("Chat:Loading") : T("Chat:CreateConversation"))
                    </button>
                </section>
            }

            @if (leftTab == LeftTab.Conversations)
            {
                @if (isLoadingConversations)
                {
                    <p class="hcs-chat__state" role="status">@T("Chat:Loading")</p>
                }
                else if (conversationError is not null)
                {
                    <div class="hcs-chat__state hcs-chat__state--error" role="alert"><p>@conversationError</p><button class="btn btn-light btn-sm" type="button" @onclick="LoadConversationsAsync">@T("Chat:Retry")</button></div>
                }
                else if (!FilteredConversations.Any())
                {
                    <p class="hcs-chat__state">@T("Chat:EmptyConversations")</p>
                }
                else
                {
                    <nav class="hcs-chat__conversation-list">
                        @foreach (var conversation in FilteredConversations)
                        {
                            <button class="hcs-chat__conversation @(selected?.Id == conversation.Id ? "active" : null)" type="button" @onclick="() => SelectAsync(conversation)">
                                <span class="hcs-chat__avatar" aria-hidden="true">@ConversationInitials(conversation)</span>
                                <span class="hcs-chat__conversation-copy">
                                    <strong>@ConversationTitle(conversation)</strong>
                                    <small>@(string.IsNullOrWhiteSpace(conversation.LastMessage) ? T("Chat:NoMessages") : conversation.LastMessage)</small>
                                </span>
                                <span class="hcs-chat__conversation-meta">
                                    @if (conversation.IsPinned)
                                    {
                                        <i class="fa fa-thumbtack" aria-label="@T("Chat:Pin")"></i>
                                    }
                                    @if (conversation.UnreadCount > 0)
                                    {
                                        <em aria-label="@conversation.UnreadCount @T("Chat:Unread")">@conversation.UnreadCount</em>
                                    }
                                </span>
                            </button>
                        }
                    </nav>
                }
            }
        </aside>

        <section class="hcs-chat__thread @(mobileView == MobileView.Thread ? "hcs-chat__panel--mobile-active" : null)" aria-label="@T("Chat:Title")">
            @if (selected is null)
            {
                <div class="hcs-chat__empty"><i class="fa fa-comments" aria-hidden="true"></i><h2>@T("Chat:ChooseConversation")</h2><p>@T("Chat:ChooseConversationDescription")</p></div>
            }
            else
            {
                <header class="hcs-chat__thread-header">
                    <button class="hcs-chat__icon hcs-chat__back" type="button" aria-label="@T("Chat:ConversationList")" @onclick="ShowList"><i class="fa fa-arrow-left" aria-hidden="true"></i></button>
                    <span class="hcs-chat__avatar">@ConversationInitials(selected)</span>
                    <div class="hcs-chat__thread-title"><h2>@ConversationTitle(selected)</h2><small>@ConversationTypeLabel(selected.Type)</small></div>
                    <button class="hcs-chat__icon hcs-chat__info-button" type="button" aria-label="@T("Chat:Information")" @onclick="ShowInfo"><i class="fa fa-circle-info" aria-hidden="true"></i></button>
                </header>
                @if (realtimeUnavailable)
                {
                    <p class="hcs-chat__realtime-warning" role="status"><i class="fa fa-plug-circle-xmark" aria-hidden="true"></i>@T("Chat:ConnectionUnavailable")</p>
                }

                <div class="hcs-chat__messages" aria-live="polite">
                    @if (messages.Count < totalMessageCount)
                    {
                        <button class="hcs-chat__older" type="button" @onclick="LoadOlderMessagesAsync" disabled="@isLoadingMessages">@T("Chat:OlderMessages")</button>
                    }
                    @if (isLoadingMessages && messages.Count == 0)
                    {
                        <p class="hcs-chat__state">@T("Chat:LoadingMessages")</p>
                    }
                    else if (messageError is not null && messages.Count == 0)
                    {
                        <div class="hcs-chat__state hcs-chat__state--error" role="alert"><p>@messageError</p><button class="btn btn-light btn-sm" type="button" @onclick="() => LoadMessagesAsync(reset: true)">@T("Chat:Retry")</button></div>
                    }
                    else if (messages.Count == 0)
                    {
                        <p class="hcs-chat__state">@T("Chat:NoMessages")</p>
                    }
                    else
                    {
                        @foreach (var message in messages)
                        {
                            <article class="hcs-chat__message @(message.SenderUserId == currentUserId ? "hcs-chat__message--mine" : null)">
                                <div class="hcs-chat__message-meta"><strong>@MemberName(message.SenderUserId)</strong><time datetime="@message.CreatedAt.ToUniversalTime().ToString("O")">@message.CreatedAt.ToLocalTime().ToString("g")</time></div>
                                @if (message.IsDeleted)
                                {
                                    <p class="hcs-chat__message-deleted">@T("Chat:DeletedMessage")</p>
                                }
                                else
                                {
                                    <p>@message.Text</p>
                                    @if (message.Attachments.Count > 0)
                                    {
                                        <div class="hcs-chat__attachments">
                                            @foreach (var attachment in message.Attachments)
                                            {
                                                <a href="@AttachmentUrl(attachment.Id)" target="_blank" rel="noopener"><i class="fa fa-paperclip" aria-hidden="true"></i>@attachment.FileName</a>
                                            }
                                        </div>
                                    }
                                }
                            </article>
                        }
                    }
                </div>

                @if (permissions?.CanSend == true)
                {
                    <form class="hcs-chat__composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
                        @if (pendingFiles.Count > 0)
                        {
                            <div class="hcs-chat__pending-files" aria-label="@T("Chat:Attach")">
                                @foreach (var file in pendingFiles)
                                {
                                    <span><i class="fa fa-paperclip" aria-hidden="true"></i>@file.Name</span>
                                }
                            </div>
                        }
                        @if (messageError is not null && messages.Count > 0)
                        {
                            <p class="hcs-chat__composer-error" role="alert">@messageError</p>
                        }
                        <div class="hcs-chat__composer-row">
                            <label class="hcs-chat__attach" title="@T("Chat:Attach")">
                                <InputFile OnChange="OnFilesSelected" multiple accept="image/*,.pdf,.txt,.docx,.xlsx,.mp4,.mp3" />
                                <i class="fa fa-paperclip" aria-hidden="true"></i><span class="visually-hidden">@T("Chat:Attach")</span>
                            </label>
                            <textarea @bind="messageText" @bind:event="oninput" rows="1" maxlength="4000" placeholder="@T("Chat:MessagePlaceholder")" aria-label="@T("Chat:MessagePlaceholder")"></textarea>
                            <button class="btn btn-primary hcs-chat__send" type="submit" disabled="@(isSending || string.IsNullOrWhiteSpace(messageText))">
                                <i class="fa @(isSending ? "fa-spinner fa-spin" : "fa-paper-plane")" aria-hidden="true"></i><span>@T("Chat:Send")</span>
                            </button>
                        </div>
                    </form>
                }
            }
        </section>

        <aside class="hcs-chat__info @(mobileView == MobileView.Info ? "hcs-chat__panel--mobile-active" : null)" aria-label="@T("Chat:Information")">
            @if (selected is null)
            {
                <div class="hcs-chat__info-empty"><i class="fa fa-circle-info" aria-hidden="true"></i><p>@T("Chat:ChooseConversation")</p></div>
            }
            else
            {
                <header class="hcs-chat__panel-header"><div><small>@T("Chat:Information")</small><h2>@ConversationTitle(selected)</h2></div><button class="hcs-chat__icon hcs-chat__back" type="button" aria-label="@T("Chat:Title")" @onclick="ShowThread"><i class="fa fa-arrow-left" aria-hidden="true"></i></button></header>
                <div class="hcs-chat__info-body">
                    <span class="hcs-chat__avatar hcs-chat__avatar--large">@ConversationInitials(selected)</span>
                    <p class="hcs-chat__info-type">@ConversationTypeLabel(selected.Type)</p>
                    @if (!string.IsNullOrWhiteSpace(selected.Description))
                    {
                        <p class="hcs-chat__description">@selected.Description</p>
                    }
                    @if (permissions?.CanRename == true)
                    {
                        <form class="hcs-chat__rename" @onsubmit="RenameAsync" @onsubmit:preventDefault>
                            <label for="chat-rename">@T("Chat:Rename")</label>
                            <input id="chat-rename" @bind="renameText" maxlength="256" />
                            <button class="btn btn-sm btn-outline-primary" type="submit" disabled="@isRenaming">@T("Chat:Save")</button>
                        </form>
                    }
                    <div class="hcs-chat__info-section"><h3>@T("Chat:Members")</h3><ul>
                        @foreach (var member in selected.Members)
                        {
                            <li><span class="hcs-chat__avatar hcs-chat__avatar--small">@Initials(MemberName(member.UserId))</span><span><strong>@MemberName(member.UserId)</strong><small>@(member.Role == ConversationMemberRole.Admin ? T("Chat:Administrator") : T("Chat:Member"))</small></span></li>
                        }
                    </ul></div>
                    @if (permissions?.CanManageMembers == true && selected.Type != ConversationType.User && AvailableMemberContacts.Any())
                    {
                        <div class="hcs-chat__info-section">
                            <h3>@T("Chat:AddMembers")</h3>
                            <div class="hcs-chat__member-picker" role="group" aria-label="@T("Chat:SelectMembers")">
                                @foreach (var contact in AvailableMemberContacts)
                                {
                                    <label class="hcs-chat__contact">
                                        <input type="checkbox" checked="@selectedMemberIds.Contains(contact.Id)" @onchange="args => ToggleMember(contact.Id, args)" />
                                        <span class="hcs-chat__avatar hcs-chat__avatar--small">@Initials(contact.DisplayName)</span>
                                        <span><strong>@contact.DisplayName</strong><small>@@@contact.UserName</small></span>
                                    </label>
                                }
                            </div>
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddMembersAsync" disabled="@(isAddingMembers || selectedMemberIds.Count == 0)">
                                <i class="fa @(isAddingMembers ? "fa-spinner fa-spin" : "fa-user-plus")" aria-hidden="true"></i>@T("Chat:AddMembers")
                            </button>
                        </div>
                    }
                    <div class="hcs-chat__info-actions">
                        <button class="btn btn-light" type="button" @onclick="TogglePinnedAsync"><i class="fa fa-thumbtack" aria-hidden="true"></i>@(selected.IsPinned ? T("Chat:Unpin") : T("Chat:Pin"))</button>
                        @if (permissions?.CanLeave == true)
                        {
                            <button class="btn btn-outline-danger" type="button" @onclick="LeaveAsync" disabled="@isLeaving"><i class="fa @(isLeaving ? "fa-spinner fa-spin" : "fa-arrow-right-from-bracket")" aria-hidden="true"></i>@T("Chat:Leave")</button>
                        }
                    </div>
                </div>
            }
        </aside>
    </section>
</main>

@code {
    [Parameter] public Guid? RedirectToConversationId { get; set; }

    private readonly HashSet<Guid> selectedContactIds = [];
    private readonly HashSet<Guid> selectedMemberIds = [];
    private readonly List<IBrowserFile> pendingFiles = [];
    private readonly List<ChatMessageDto> messages = [];
    private IReadOnlyList<ConversationDto> conversations = [];
    private IReadOnlyList<ChatContactDto> contacts = [];
    private ConversationDto? selected;
    private ConversationPermissionDto? permissions;
    private Guid? currentUserId;
    private string conversationSearch = string.Empty;
    private string contactSearch = string.Empty;
    private string groupName = string.Empty;
    private string messageText = string.Empty;
    private string renameText = string.Empty;
    private string? conversationError;
    private string? contactsError;
    private string? messageError;
    private bool isLoadingConversations;
    private bool contactsLoading;
    private bool isLoadingMessages;
    private bool isSending;
    private bool isCreatingConversation;
    private bool isRenaming;
    private bool isAddingMembers;
    private bool isLeaving;
    private bool showNewConversation;
    private LeftTab leftTab = LeftTab.Conversations;
    private bool realtimeUnavailable;
    private int messageSkip;
    private long totalMessageCount;
    private MobileView mobileView = MobileView.List;

    private IEnumerable<ConversationDto> FilteredConversations => conversations.Where(conversation =>
        string.IsNullOrWhiteSpace(conversationSearch) ||
        ConversationTitle(conversation).Contains(conversationSearch.Trim(), StringComparison.CurrentCultureIgnoreCase) ||
        (conversation.LastMessage?.Contains(conversationSearch.Trim(), StringComparison.CurrentCultureIgnoreCase) ?? false));

    private IEnumerable<ChatContactDto> FilteredContacts => contacts.Where(contact =>
        string.IsNullOrWhiteSpace(contactSearch) ||
        contact.DisplayName.Contains(contactSearch.Trim(), StringComparison.CurrentCultureIgnoreCase) ||
        contact.UserName.Contains(contactSearch.Trim(), StringComparison.CurrentCultureIgnoreCase));

    private IEnumerable<ChatContactDto> AvailableMemberContacts => selected is null
        ? []
        : contacts.Where(contact => !selected.Members.Any(member => member.UserId == contact.Id));

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(
                state.User.FindFirst("sub")?.Value ??
                state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            out var userId))
        {
            currentUserId = userId;
        }

        Realtime.Changed += HandleRealtimeChangeAsync;
        Realtime.StatusChanged += HandleRealtimeStatusAsync;
        try
        {
            await Realtime.EnsureStartedAsync();
            realtimeUnavailable = !Realtime.IsConnected;
        }
        catch (Exception exception)
        {
            LogChatError(exception, "start realtime connection");
            realtimeUnavailable = true;
        }

        await LoadContactsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadConversationsAsync();
        if (RedirectToConversationId is { } redirectId && conversations.FirstOrDefault(item => item.Id == redirectId) is { } target)
        {
            await SelectAsync(target);
        }
    }

    private async Task LoadConversationsAsync()
    {
        isLoadingConversations = true;
        conversationError = null;
        try
        {
            conversations = await Client.GetConversationsAsync();
            if (selected is not null && conversations.FirstOrDefault(item => item.Id == selected.Id) is { } current)
            {
                selected = current;
            }
        }
        catch (Exception exception)
        {
            conversationError = MapChatError(exception, "Chat:LoadError");
        }
        finally
        {
            isLoadingConversations = false;
        }
    }

    private async Task LoadContactsAsync()
    {
        contactsLoading = true;
        contactsError = null;
        try
        {
            contacts = await Client.GetContactsAsync(string.Empty);
        }
        catch (Exception exception)
        {
            contactsError = MapChatError(exception, "Chat:ContactsError");
        }
        finally
        {
            contactsLoading = false;
        }
    }

    private async Task SelectAsync(ConversationDto value)
    {
        selected = value;
        permissions = null;
        messageError = null;
        renameText = value.Name ?? string.Empty;
        messages.Clear();
        messageSkip = 0;
        totalMessageCount = 0;
        mobileView = MobileView.Thread;

        try
        {
            selected = await Client.GetConversationAsync(value.Id);
            permissions = await Client.GetPermissionsAsync(value.Id);
            renameText = selected.Name ?? string.Empty;
            await LoadMessagesAsync(reset: true);
            await Client.MarkReadAsync(value.Id);
            await LoadConversationsAsync();
        }
        catch (Exception exception)
        {
            messageError = MapChatError(exception, "Chat:MessagesError");
        }
    }

    private async Task LoadMessagesAsync(bool reset)
    {
        if (selected is null)
        {
            return;
        }

        isLoadingMessages = true;
        messageError = null;
        try
        {
            var skip = reset ? 0 : messageSkip;
            var response = await Client.GetMessagesAsync(selected.Id, skip, 50);
            var incoming = response.Items.OrderBy(item => item.CreatedAt).ToList();
            if (reset)
            {
                messages.Clear();
            }

            messages.InsertRange(0, incoming);
            messageSkip += incoming.Count;
            totalMessageCount = response.TotalCount;
        }
        catch (Exception exception)
        {
            messageError = MapChatError(exception, "Chat:MessagesError");
        }
        finally
        {
            isLoadingMessages = false;
        }
    }

    private Task LoadOlderMessagesAsync() => LoadMessagesAsync(reset: false);

    private async Task SendAsync()
    {
        if (selected is null || isSending || string.IsNullOrWhiteSpace(messageText))
        {
            return;
        }

        isSending = true;
        messageError = null;
        try
        {
            var attachmentIds = new List<Guid>();
            foreach (var file in pendingFiles)
            {
                var attachment = await Client.UploadAttachmentAsync(selected.Id, file);
                attachmentIds.Add(attachment.Id);
            }

            var sent = await Client.SendMessageAsync(new SendMessageInput
            {
                ConversationId = selected.Id,
                Text = messageText.Trim(),
                ClientMessageId = Guid.NewGuid(),
                AttachmentIds = attachmentIds
            });
            messages.Add(sent);
            messageSkip = messages.Count;
            totalMessageCount = Math.Max(totalMessageCount, messages.Count);
            messageText = string.Empty;
            pendingFiles.Clear();
            await Client.MarkReadAsync(selected.Id);
            await LoadConversationsAsync();
        }
        catch (CollaborationApiException exception) when (exception.StatusCode == HttpStatusCode.RequestEntityTooLarge)
        {
            messageError = T("Chat:AttachmentTooLarge");
        }
        catch (Exception exception)
        {
            messageError = MapChatError(exception, "Chat:SendError");
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task CreateConversationAsync()
    {
        if (currentUserId is not { } userId || selectedContactIds.Count == 0 || isCreatingConversation)
        {
            return;
        }

        isCreatingConversation = true;
        conversationError = null;
        try
        {
            var contactIds = selectedContactIds.ToArray();
            var isDirect = contactIds.Length == 1;
            var created = await Client.CreateConversationAsync(new CreateConversationInput
            {
                Type = isDirect ? ConversationType.User : ConversationType.Group,
                Name = isDirect ? null : (string.IsNullOrWhiteSpace(groupName) ? T("Chat:GroupConversation") : groupName.Trim()),
                TargetUserId = isDirect ? contactIds[0] : null,
                MemberUserIds = [userId, .. contactIds]
            });
            showNewConversation = false;
            leftTab = LeftTab.Conversations;
            selectedContactIds.Clear();
            groupName = string.Empty;
            await LoadConversationsAsync();
            await SelectAsync(created);
        }
        catch (Exception exception)
        {
            conversationError = MapChatError(exception, "Chat:LoadError");
        }
        finally
        {
            isCreatingConversation = false;
        }
    }

    private async Task TogglePinnedAsync()
    {
        if (selected is null)
        {
            return;
        }

        try
        {
            await Client.SetConversationPinnedAsync(selected.Id, !selected.IsPinned);
            await LoadConversationsAsync();
            selected = conversations.FirstOrDefault(item => item.Id == selected.Id) ?? selected;
        }
        catch (Exception exception)
        {
            messageError = MapChatError(exception, "Chat:LoadError");
        }
    }

    private async Task RenameAsync()
    {
        if (selected is null || string.IsNullOrWhiteSpace(renameText) || isRenaming)
        {
            return;
        }

        isRenaming = true;
        try
        {
            await Client.RenameConversationAsync(selected.Id, renameText.Trim());
            await LoadConversationsAsync();
            selected = conversations.FirstOrDefault(item => item.Id == selected.Id) ?? selected;
        }
        catch (Exception exception)
        {
            messageError = MapChatError(exception, "Chat:LoadError");
        }
        finally
        {
            isRenaming = false;
        }
    }

    private async Task AddMembersAsync()
    {
        if (selected is null || selectedMemberIds.Count == 0 || isAddingMembers)
        {
            return;
        }

        isAddingMembers = true;
        try
        {
            await Client.AddMembersAsync(selected.Id, selectedMemberIds.ToArray());
            selectedMemberIds.Clear();
            selected = await Client.GetConversationAsync(selected.Id);
            permissions = await Client.GetPermissionsAsync(selected.Id);
            await LoadConversationsAsync();
        }
        catch (Exception exception)
        {
            messageError = MapChatError(exception, "Chat:LoadError");
        }
        finally
        {
            isAddingMembers = false;
        }
    }

    private async Task LeaveAsync()
    {
        if (selected is null || isLeaving || !await UiMessageService.Confirm(T("Chat:LeaveConfirm")))
        {
            return;
        }

        isLeaving = true;
        try
        {
            await Client.LeaveAsync(selected.Id);
            selected = null;
            permissions = null;
            messages.Clear();
            await LoadConversationsAsync();
            ShowList();
        }
        catch (Exception exception)
        {
            messageError = MapChatError(exception, "Chat:LoadError");
        }
        finally
        {
            isLeaving = false;
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs args)
    {
        pendingFiles.Clear();
        foreach (var file in args.GetMultipleFiles(20))
        {
            if (file.Size <= 25 * 1024 * 1024)
            {
                pendingFiles.Add(file);
            }
            else
            {
                messageError = T("Chat:AttachmentTooLarge");
            }
        }
    }

    private void ToggleContact(Guid contactId, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool boolean && boolean || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (isChecked)
        {
            selectedContactIds.Add(contactId);
        }
        else
        {
            selectedContactIds.Remove(contactId);
        }
    }

    private void ToggleMember(Guid userId, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool boolean && boolean || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (isChecked)
        {
            selectedMemberIds.Add(userId);
        }
        else
        {
            selectedMemberIds.Remove(userId);
        }
    }

    private void OpenNewConversation()
    {
        leftTab = LeftTab.Contacts;
        showNewConversation = true;
        contactSearch = string.Empty;
        selectedContactIds.Clear();
    }

    private void CloseNewConversation()
    {
        showNewConversation = false;
        selectedContactIds.Clear();
    }

    private Task ShowContactsTabAsync()
    {
        leftTab = LeftTab.Contacts;
        showNewConversation = false;
        return contacts.Count == 0 ? LoadContactsAsync() : Task.CompletedTask;
    }

    private void ShowList() => mobileView = MobileView.List;
    private void ShowThread() => mobileView = MobileView.Thread;
    private void ShowInfo() => mobileView = MobileView.Info;

    private async Task HandleRealtimeChangeAsync()
    {
        await InvokeAsync(async () =>
        {
            await LoadConversationsAsync();
            if (selected is not null && conversations.Any(item => item.Id == selected.Id))
            {
                await LoadMessagesAsync(reset: true);
            }

            StateHasChanged();
        });
    }

    private async Task HandleRealtimeStatusAsync(HubConnectionState state)
    {
        await InvokeAsync(() =>
        {
            realtimeUnavailable = state != HubConnectionState.Connected;
            StateHasChanged();
        });
    }

    private string ConversationTitle(ConversationDto conversation)
    {
        if (!string.IsNullOrWhiteSpace(conversation.Name))
        {
            return conversation.Name;
        }

        if (conversation.Type == ConversationType.User)
        {
            var other = conversation.Members.FirstOrDefault(member => member.UserId != currentUserId);
            return other is null ? T("Chat:DirectConversation") : MemberName(other.UserId);
        }

        return ConversationTypeLabel(conversation.Type);
    }

    private string ConversationTypeLabel(ConversationType type) => type switch
    {
        ConversationType.User => T("Chat:DirectConversation"),
        ConversationType.Group => T("Chat:GroupConversation"),
        ConversationType.Project => T("Chat:ProjectConversation"),
        ConversationType.Task => T("Chat:TaskConversation"),
        _ => T("Chat:UnknownConversation")
    };

    private string ConversationInitials(ConversationDto conversation) => Initials(ConversationTitle(conversation));

    private string MemberName(Guid userId)
    {
        if (userId == currentUserId)
        {
            return T("Chat:CurrentUser");
        }

        return contacts.FirstOrDefault(contact => contact.Id == userId)?.DisplayName
            ?? $"{userId.ToString()[..8]}…";
    }

    private static string Initials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "HC";
        }

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    private static string AttachmentUrl(Guid id) => $"/api/chat/attachments/{id:D}";
    private string T(string key) => Localizer[key];

    private string MapChatError(Exception exception, string fallbackKey)
    {
        LogChatError(exception, fallbackKey);
        if (exception is CollaborationApiException api)
        {
            if (api.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
                return T("Chat:NoPermission");
            if (api.StatusCode is HttpStatusCode.BadGateway or HttpStatusCode.ServiceUnavailable or HttpStatusCode.GatewayTimeout)
                return T("Catalog:ServiceUnavailable");
        }
        return T(fallbackKey);
    }

    private void LogChatError(Exception exception, string operation)
    {
        var statusCode = exception is CollaborationApiException apiException
            ? apiException.StatusCode.ToString()
            : null;
        Logger.LogError(
            exception,
            "Chat operation {Operation} failed. Culture={Culture}; StatusCode={StatusCode}",
            operation,
            CultureInfo.CurrentUICulture.Name,
            statusCode ?? "n/a");
    }

    public ValueTask DisposeAsync()
    {
        Realtime.Changed -= HandleRealtimeChangeAsync;
        Realtime.StatusChanged -= HandleRealtimeStatusAsync;
        return ValueTask.CompletedTask;
    }

    private enum MobileView
    {
        List,
        Thread,
        Info
    }

    private enum LeftTab
    {
        Conversations,
        Contacts
    }
}
