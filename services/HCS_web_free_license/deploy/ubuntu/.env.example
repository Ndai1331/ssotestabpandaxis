# Copy to deploy/ubuntu/.env (untracked) on both servers. Fill every value.
# Domain placeholders — replace if DNS differs.

HCS_DATA_HOST=10.17.227.64
HCS_APPS_HOST=10.17.227.58

HCS_PUBLIC_HOST=hcs.binhduong.vn
HCS_AUTH_PUBLIC_HOST=auth.hcs.binhduong.vn
HCS_SSO_PUBLIC_HOST=sso.binhduong.vn

HCS_IMAGE_TAG=ubuntu

HCS_POSTGRES_USER=hcs
HCS_POSTGRES_PASSWORD=replace-with-long-password
HCS_REDIS_PASSWORD=replace-with-long-password
HCS_RABBITMQ_USER=hcs-events
HCS_RABBITMQ_PASSWORD=replace-with-long-password
HCS_MINIO_ROOT_USER=hcs-minio
HCS_MINIO_ROOT_PASSWORD=replace-with-long-password

HCS_ADMIN_PASSWORD=replace-with-strong-admin-password
HCS_GATEWAY_CLIENT_SECRET=replace-with-openiddict-client-secret
HCS_KEYCLOAK_ADMIN=admin
HCS_KEYCLOAK_ADMIN_PASSWORD=replace-with-long-password
HCS_KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret

# Absolute paths on the apps server (10.17.227.58). Never commit the PFX files.
HCS_OPENIDDICT_PFX=/etc/hcs/certs/openiddict.pfx
HCS_OPENIDDICT_PFX_PASSWORD=replace-with-pfx-password
HCS_DATAPROTECTION_PFX=/etc/hcs/certs/dataprotection.pfx
HCS_DATAPROTECTION_PFX_PASSWORD=replace-with-pfx-password
