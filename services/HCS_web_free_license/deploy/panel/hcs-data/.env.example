# Copy to .env in this folder (hcs-data stack only).

# IP/LAN address containers on the apps server use to reach Postgres/Redis/Rabbit/MinIO.
# Same machine: use this server's private IP (not 127.0.0.1).
HCS_DATA_HOST=10.17.227.64

HCS_POSTGRES_USER=hcs
HCS_POSTGRES_PASSWORD=replace-with-long-password
HCS_REDIS_PASSWORD=replace-with-long-password
HCS_RABBITMQ_USER=hcs-events
HCS_RABBITMQ_PASSWORD=replace-with-long-password
HCS_MINIO_ROOT_USER=hcs-minio
HCS_MINIO_ROOT_PASSWORD=replace-with-long-password
